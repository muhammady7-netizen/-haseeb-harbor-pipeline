{
  "task_id": "bus-b50_b10-streaming-target-variance-attribution",
  "verifiers": [
    {
      "name": "register_exists",
      "metadata": {
        "how_justification": "Checks shortfall_attribution.csv is present as a file in the workspace.",
        "why_justification": "The per-channel attribution register is delivered.",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "filesystem",
          "command": "check_path_exists",
          "arguments": {
            "path": "shortfall_attribution.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": true,
        "deterministic": {
          "path": "$.is_file",
          "comparison": "equals"
        }
      }
    },
    {
      "name": "register_header",
      "metadata": {
        "how_justification": "Parses shortfall_attribution.csv with csv.inspect_table and compares the parsed header field list (in file order) to the expected header with equals; the CSV parser handles quoting, embedded delimiters, BOM and line endings rather than a regex over raw text.",
        "why_justification": "The contract document pins the header verbatim. Entailed by: \"Header, exactly: `channel_id,counted_placements,placements_effect_streams,conversion_effect_streams,residual_reach_effect_streams,shortfall_to_target_streams`\"",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "inspect_table",
          "arguments": {
            "path": "shortfall_attribution.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": [
          "channel_id",
          "counted_placements",
          "placements_effect_streams",
          "conversion_effect_streams",
          "residual_reach_effect_streams",
          "shortfall_to_target_streams"
        ],
        "deterministic": {
          "path": "$.header",
          "comparison": "equals"
        }
      }
    },
    {
      "name": "register_table_trap_ch04",
      "metadata": {
        "how_justification": "Parses shortfall_attribution.csv with csv.read_rows and applies table_equals to every graded cell of the CH-04 row (matched by 'channel_id'); a failure names the exact cell.",
        "why_justification": "Every channel's counted placement count, three parts and shortfall to target are graded, and the row population is locked to the channels in the plan file's order, so a register that drops a channel, duplicates one or invents one cannot pass; the parts re-adding to the shortfall is graded cell by cell rather than as a tolerance. Entailed by: \"One row per channel in `input/channel_plan.csv`, in that file's order. `counted_placements` is a whole number of placements; every other figure is a whole number of streams, a part that is zero written `0` and a part that ran the other way written with a leading minus sign.\"",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "read_rows",
          "arguments": {
            "path": "shortfall_attribution.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": {
          "id_column": "channel_id",
          "rows": {
            "CH-04": {
              "counted_placements": "6",
              "placements_effect_streams": "0",
              "conversion_effect_streams": "3940",
              "residual_reach_effect_streams": "0",
              "shortfall_to_target_streams": "3940"
            }
          },
          "cell_types": {
            "counted_placements": "number",
            "placements_effect_streams": "number",
            "conversion_effect_streams": "number",
            "residual_reach_effect_streams": "number",
            "shortfall_to_target_streams": "number"
          }
        },
        "deterministic": {
          "path": "$",
          "comparison": "table_equals"
        }
      }
    },
    {
      "name": "register_table",
      "metadata": {
        "how_justification": "Parses shortfall_attribution.csv with csv.read_rows and applies table_equals: every graded cell of 5 rows plus the full 6-row population as a row_set lock (duplicate-row and cross-product dumps fail the lock; a duplicated graded id is rejected outright), the delivered row order equal to the stated order, and the delivered column set closed to the stated header, with declared cell types {'counted_placements': 'number', 'placements_effect_streams': 'number', 'conversion_effect_streams': 'number', 'residual_reach_effect_streams': 'number', 'shortfall_to_target_streams': 'number'} normalised on both sides. A failure names the exact row and column.",
        "why_justification": "Every channel's counted placement count, three parts and shortfall to target are graded, and the row population is locked to the channels in the plan file's order, so a register that drops a channel, duplicates one or invents one cannot pass; the parts re-adding to the shortfall is graded cell by cell rather than as a tolerance. Entailed by: \"One row per channel in `input/channel_plan.csv`, in that file's order. `counted_placements` is a whole number of placements; every other figure is a whole number of streams, a part that is zero written `0` and a part that ran the other way written with a leading minus sign.\"",
        "tag": "core"
      },
