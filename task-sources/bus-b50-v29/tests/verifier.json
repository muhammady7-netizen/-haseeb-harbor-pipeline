    {
      "name": "memo_exists",
      "metadata": {
        "how_justification": "Checks campaign_review.md is present as a file in the workspace.",
        "why_justification": "The note for the label head is delivered.",
        "tag": "core"
      },
      "source": {
        "type": "file",
