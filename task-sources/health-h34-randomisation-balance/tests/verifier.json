    {
      "name": "balance_covers_both_factors",
      "metadata": {
        "how_justification": "Opens stratum_balance.csv with csv.extract_text and applies regex_match.",
        "why_justification": "Verifies both site and severity factors appear in the balance table."
      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "extract_text",
          "arguments": {
            "path": "stratum_balance.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?mis)(?:^severity\\s*,.*\\nsite\\s*,|^site\\s*,.*\\nseverity\\s*,)",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
    {
      "name": "site_levels_use_canonical_S_codes",
      "metadata": {
        "how_justification": "Opens stratum_balance.csv with csv.extract_text and applies regex_match.",
        "why_justification": "Verifies site levels use canonical S1/S2/S3 labels (not just S1)."
      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "extract_text",
          "arguments": {
            "path": "stratum_balance.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?mi)^site\\s*,\\s*[\"\\x22]?S[123]\\x22?\\s*,",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
