    {
      "name": "results_figures",
      "metadata": {
        "how_justification": "Reads results.json with json.read_file and applies object_equals over the 4 graded keys with the key set closed; numeric keys compare within an absolute tolerance and a failure names the exact key.",
        "why_justification": "The four totals are rebuilt from the review table and the key set is closed.",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "json",
          "command": "read_file",
          "arguments": {
