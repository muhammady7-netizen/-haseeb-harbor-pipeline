      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "extract_text",
          "arguments": {
            "path": "letter_line_review.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?i)\\A\\x22?line_id\\x22?[ \\t]*,[ \\t]*\\x22?verdict\\x22?[ \\t]*,[ \\t]*\\x22?record_entry\\x22?[ \\t]*\\r?\\n",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
