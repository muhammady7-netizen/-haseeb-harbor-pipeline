    {
      "name": "answer_at_odds_figure",
      "metadata": {
        "how_justification": "Opens answer.md with md.extract_text and applies regex_match to the label-colon-figure format from submission_format.md.",
        "why_justification": "One at odds figure stands next to its label in the sentence that names the label.",
        "tag": "incidental"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "md",
          "command": "extract_text",
          "arguments": {
            "path": "answer.md"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?is)Letter\\s+lines\\s+at\\s+odds\\s+with\\s+the\\s+record\\s*:\\s*(?:18|18\\.0|18\\.00|eighteen)\\b",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
    {
      "name": "answer_at_odds_figure_exactly_one",
      "metadata": {
        "how_justification": "Opens answer.md with md.extract_text and applies not_regex_match.",
        "why_justification": "A hedge is not an answer: the Letter lines at odds with the record figure may not be offered as one of several candidates in its own sentence. One at odds figure stands next to its label in the sentence that names the label.",
        "tag": "incidental"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "md",
          "command": "extract_text",
          "arguments": {
            "path": "answer.md"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?is)(?:\\bL[-_ ]?e[-_ ]?t[-_ ]?t[-_ ]?e[-_ ]?r[-_\\s]*l[-_ ]?i[-_ ]?n[-_ ]?e[-_ ]?s[-_\\s]*a[-_ ]?t[-_\\s]*o[-_ ]?d[-_ ]?d[-_ ]?s[-_\\s]*w[-_ ]?i[-_ ]?t[-_ ]?h[-_\\s]*t[-_ ]?h[-_ ]?e[-_\\s]*r[-_ ]?e[-_ ]?c[-_ ]?o[-_ ]?r[-_ ]?d\\w*\\b(?:(?![.!?](?:\\s|$)|\\n).){0,70}?(?:(?<![\\d.])\\d[\\d,]*(?:\\.\\d+)?(?!\\d)(?!\\.\\d)|\\b(?:zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty)\\b)[^\\w\\n;.|/]*(?:\\b(?:or|alternatively|possibly|either|maybe|perhaps)\\b|\\s/\\s)[^\\w\\n;.|/]*(?:(?<![\\d.])\\d[\\d,]*(?:\\.\\d+)?(?!\\d)(?!\\.\\d)|\\b(?:zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty)\\b)(?!\\s*(?:raw|total|vs|versus)\\b)|(?:(?<![\\d.])\\d[\\d,]*(?:\\.\\d+)?(?!\\d)(?!\\.\\d)|\\b(?:zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty)\\b)[^\\w\\n;.|/]*(?:\\b(?:or|alternatively|possibly|either|maybe|perhaps)\\b|\\s/\\s)[^\\w\\n;.|/]*(?:(?<![\\d.])\\d[\\d,]*(?:\\.\\d+)?(?!\\d)(?!\\.\\d)|\\b(?:zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty)\\b)(?!\\s*(?:raw|total|vs|versus)\\b)(?:(?![.!?](?:\\s|$)|\\n).){0,70}?\\bL[-_ ]?e[-_ ]?t[-_ ]?t[-_ ]?e[-_ ]?r[-_\\s]*l[-_ ]?i[-_ ]?n[-_ ]?e[-_ ]?s[-_\\s]*a[-_ ]?t[-_\\s]*o[-_ ]?d[-_ ]?d[-_ ]?s[-_\\s]*w[-_ ]?i[-_ ]?t[-_ ]?h[-_\\s]*t[-_ ]?h[-_ ]?e[-_\\s]*r[-_ ]?e[-_ ]?c[-_ ]?o[-_ ]?r[-_ ]?d\\w*\\b)",
        "deterministic": {
          "path": "$.text",
          "comparison": "not_regex_match"
        }
