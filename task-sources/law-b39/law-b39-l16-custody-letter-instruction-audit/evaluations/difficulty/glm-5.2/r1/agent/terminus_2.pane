[?2004h[01;32mappuser@a6811c071403[00m:[01;34m/app[00m$ cat > /tmp/review_letter.py <<'PY'
[?2004l[?2004h> import csv, json, re, collections
[?2004l[?2004h> 
[?2004l[?2004h> INPUT='/app/input/letter_lines.csv'
[?2004l[?2004h> 
[?2004l[?2004h> # Record entries by id
[?2004l[?2004h> records = {}
[?2004l[?2004h> for path in ['/app/input/original_instruction.md','/app/input/clarification.md']:
[?2004l[?2004h>     txt=open(path).read()
[?2004l[?2004h>     for m in re.finditer(r'^## (OI-\d+|CL-\d+) `([^`]+)`\n(.*?)(?=\n## |\Z)', txt, re.M|re.S):
[?2004l[?2004h>         eid, subject, body = m.groups()
[?2004l[?2004h>         records[eid]=(subject, body.strip())
[?2004l[?2004h> 
[?2004l[?2004h> orig_subjects = {eid: subj for eid,(subj,_) in records.items() if eid.startswith('OI-')}
[?2004l[?2004h> clar_subjects = {eid: subj for eid,(subj,_) in records.items() if eid.startswith('CL-')}
[?2004l[?2004h> subject_to_orig = {subj:eid for eid,subj in orig_subjects.items()}
[?2004l[?2004h> subject_to_clar = {subj:eid for eid,subj in clar_subjects.items()}
[?2004l[?2004h> 
[?2004lw[?2004h> # Verified position strings for each governing entry.
[?2004l[?2004h> verified_by_entry = {
[?2004ls[?2004h>     'OI-201': {'father','father\'s attorney','the father attorney','the father\'s attorney'},
[?2004l[?2004h>     'CL-301': {'mother','mother\'s attorney'},
[?2004l[?2004h> 
[?2004l[?2004h>     'OI-202': {'agreed by the father','father agreed','full'},
[?2004l[?2004h> 
[?2004l[?2004h>     'OI-203': {'both children with ages','both children, with their ages','both with ages'},
[?2004l[?2004h> 
[?2004l[?2004h>     'OI-204': {'full','home or sitter both','several occasions at her home or with a sitter'},
[?2004l[?2004h> 
[?2004l[?2004h>     'OI-205': {'all four','all four audiences'},
[?2004l[?2004h> 
[?2004l[?2004h>     'OI-206': {'both limbs','both limbs old'},
[?2004l[?2004h>     'CL-309': {'position only','narrower concern only position','position limb only'},
[?2004l[?2004h> 
[?2004l[?2004h>     'OI-207': {'confidence stability setback','old full setback'},
[?2004le[?2004h>     'CL-308': {'CL match confidence-only setback','full CL match','confidence stability peer confidence-only'},
[?2004l[?2004h> 
[?2004l[?2004h>     'OI-208': {'CL match','CL wording exact','CL wording paraphrase','neither child overnight unless father present','no overnight stays in her care unless the father is present','no overnight stays unless father present','no overnight unless father present'},
[?2004l[?2004h>     'CL-302': {'CL match','CL wording exact','CL wording paraphrase','neither child overnight unless father present','no overnight stays in her care unless the father is present','no overnight stays unless father present','no overnight unless father present'},
[?2004l[?2004h> 
[?2004l[?2004h>     'OI-209': {'a certified copy of the custodial plan','certified','certified copy','certified copy enclosed'},
[?2004l[?2004h>     'CL-303': {'a certified copy of the custodial plan','certified','certified copy','certified copy enclosed'},
[?2004l[?2004h> 
[?2004l[?2004h>     'OI-210': {'soft formal succinct'},
[?2004l[?2004h>     'CL-307': {'firm formal brief'},
[?2004l[?2004h> 
[?2004lelivery met[?2004h>     'OI-211': {'full name','own name','the sender\'s own name'},
[?2004l[?2004h> 
[?2004lu[?2004h>     'CL-304': {'Dear Counsel'},
[?2004l[?2004h> 
[?2004l[?2004h>     'CL-305': {'copy nobody','nobody'},
[?2004l[?2004h> 
[?2004l[?2004h>     'CL-306': {'by post','post'},
[?2004l[?2004h> 
[?2004l[?2004h>     'CL-310': {'all three addressed together','all three aspects jointly','all three aspects together','confidence stability peer relations all three','confidence stability peer relations jointly'},
[?2004l[?2004h> 
[?2004l[?2004h>     'CL-311': {'conciliatory and open','gentle settlement tone','soft and measured','soft conciliatory tone','soft tone settlement offer'},
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> not_in_record_subjects = {
[?2004l[?2004h>     'court_listing','expert_report','hearing_bundle','legal_fees',
[?2004l[?2004h>     'mediation_offer','mediation_terms','reply_deadline','school_reference'
[?2004ls[?2004h> }
[?2004l[?2004h> 
[?2004l([?2004h> def governing_entry(row):
[?2004l[?2004h>     s=row['subject']; c=row['cited_entry']
[?2004l[?2004h>     if s in not_in_record_subjects:
[?2004lf[?2004h>         return 'NONE'
[?2004l[?2004h>     # RP-407: if cited is an existing CL entry for a different subject, and the line's subject has an original entry, original governs.
[?2004l[?2004h>     if c.startswith('CL-') and c in records and records[c][0] != s and s in subject_to_orig:
[?2004l[?2004h>         return subject_to_orig[s]
[?2004l[?2004h>     # If the clarification speaks to the subject, clarification governs (RP-401/RP-402).
[?2004l[?2004h>     if s in subject_to_clar:
[?2004l[?2004h>         return subject_to_clar[s]
[?2004l[?2004h>     # If only the original speaks to the subject, original governs (RP-403).
[?2004l[?2004h>     if s in subject_to_orig:
[?2004l[?2004h>         return subject_to_orig[s]
[?2004l[?2004h>     # Neither record speaks to the subject (RP-404).
[?2004l[?2004h>     return 'NONE'
[?2004l[?2004h> 
[?2004l[?2004h> def verdict(row, gov):
[?2004l[?2004h>     if gov == 'NONE':
