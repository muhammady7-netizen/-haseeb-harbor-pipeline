[?2004l[?2004h> import re, csv
[?2004l[?2004h> records={}
[?2004l[?2004h> for path, prefix in [('/app/input/original_instruction.md','OI'),('/app/input/clarification.md','CL')]:
[?2004l[?2004h>     txt=open(path).read()
[?2004l[?2004h>     for m in re.finditer(r'^## (OI-\d+|CL-\d+) `([^`]+)`\n(.*?)(?=\n## |\Z)', txt, re.M|re.S):
[?2004l[?2004h>         eid, subject, body = m.groups()
[?2004l[?2004h>         records[eid]=(subject, body.strip())
[?2004l[?2004h> print('Record entries:')
