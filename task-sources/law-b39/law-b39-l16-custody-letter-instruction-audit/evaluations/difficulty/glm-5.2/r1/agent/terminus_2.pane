[?2004h[01;32mappuser@a6811c071403[00m:[01;34m/app[00m$ python3 - <<'PY' > /tmp/positions_by_subject.txt
[?2004l[?2004h> import csv, collections
[?2004l[?2004h> rows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))
[?2004l[?2004h> by=collections.defaultdict(list)
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     by[r['subject']].append(r['position'])
[?2004l[?2004h> for s in sorted(by):
[?2004l[?2004h>     print(f'### {s} ({len(by[s])})')
[?2004l[?2004h>     for p,n in sorted(collections.Counter(by[s]).items()):
[?2004l[?2004h>         print(f'{n}\t{p}')
[?2004l[?2004h> PY
