[?2004l[?2004h> print('rows', len(rows))
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     print(r['line_id'], '|', r['subject'], '|', r['position'], '|', r['cited_entry'], '|', r['wording'])
[?2004l[?2004h> PY
