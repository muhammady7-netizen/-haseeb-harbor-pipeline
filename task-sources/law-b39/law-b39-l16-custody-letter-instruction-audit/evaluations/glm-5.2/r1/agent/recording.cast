[124.97963, "o", "\u001b[?2004h> "]
[124.980053, "o", "    'verified_count': counts['VERIFIED'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.980594, "o", "    'at_odds_count': counts['AT_ODDS'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.980883, "o", "> "]
[124.9813, "o", "    'not_in_record_count': counts['NOT_IN_RECORD'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.981677, "o", "    'clarification_governed_count': clar_count,\r\n\u001b[?2004l\r"]
[124.981772, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[124.982122, "o", "\u001b[?2004h> "]
