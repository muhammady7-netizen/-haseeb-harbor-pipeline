[43.68814, "i", "python3 - <<'PY'\nimport csv,collections\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nprint('rows',len(rows))\nprint('subjects', collections.Counter(r['subject'] for r in rows))\nprint('cited', collections.Counter(r['cited_entry'] for r in rows))\nprint('positions by subject:')\nfor s in sorted(set(r['subject'] for r in rows)):\n    print('\\\\n',s)\n    for p,c in collections.Counter(r['position'] for r in rows if r['subject']==s).most_common():\n        print(' ',c,p)\nprint('\\\\nfirst 20 rows:')\nfor r in rows[:20]:\n    print(r['line_id'], r['subject'], '|', r['position'], '|', r['cited_entry'], '|', r['wording'])\nPY\n"]
