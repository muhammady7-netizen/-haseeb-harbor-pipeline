[316.423074, "i", "python3 - <<'PY'\nimport csv, collections\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nout=list(csv.DictReader(open('/app/letter_line_review.csv')))\nmixed=[]\nfor s in sorted(set(r['subject'] for r in rows)):\n    by_pos=collections.defaultdict(list)\n    for r,o in zip(rows,out):\n        if r['subject']==s:\n            by_pos[r['position']].append((r['line_id'], o['verdict'], r['wording']))\n    for p,items in by_pos.items():\n        verdicts=set(v for _,v,_ in items)\n        if len(verdicts)>1:\n            mixed.append((s,p,items))\nprint('mixed subject/position groups:', len(mixed))\nfor s,p,items in mixed:\n    print(f'\\n### {s} | {p}')\n    for line_id,v,w in items:\n        print(f'{line_id} | {v} | {w}')\nPY\n"]
