[198.712123, "i", "python3 - <<'PY'\nimport csv, json, collections\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nout=list(csv.DictReader(open('/app/letter_line_review.csv')))\nres=json.load(open('/app/results.json'))\nprint('rows in/out:', len(rows), len(out))\nprint('header:', ','.join(out[0].keys()))\nprint('verdict counts:', collections.Counter(r['verdict'] for r in out))\nprint('results:', res)\nprint('results keys:', sorted(res))\nfor s in ['copies','delivery','concern','request','overnight_stays','inconsistent_accounts','children_named','right_of_first_refusal','enclosure','salutation','sender_signature']:\n    print('\\\\n###', s)\n    for r,o in zip(rows,out):\n        if r['subject']==s:\n            print(f\"{r['line_id']} | {o['verdict']} | {o['record_entry']} | {r['position']} | {r['wording']}\")\nPY\n"]
