[124.912696, "i", "})\n\ncounts = {v: sum(1 for x in out_rows if x['verdict']==v) for v in ['VERIFIED','AT_ODDS','NOT_IN_RECORD']}\nclar_count = sum(1 for x in out_rows if x['record_entry'].startswith('CL-'))\nprint('counts', counts, 'clar', clar_count, 'rows', len(out_rows))\n\n# Print samples for each subject\nfrom collections import defaultdict\nby_sub = defaultdict(list)\nfor r, o in zip(rows, out_rows):\n    by_sub[r['subject']].append((r['line_id'], o['verdict'], o['record_entry'], r['position'], r['wording']))\nfor s in sorted(by_sub):\n    print('\\\\n###', s)\n    for item in by_sub[s][:5]:\n        print(item)\n\n# Write deliverables\nwith open('/app/letter_line_review.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['line_id','verdict','record_entry'])\n    writer.writeheader()\n    writer.writerows(out_rows)\n\nresults = {\n    'verified_count': counts['VERIFIED'],\n    'at_odds_count': counts['AT_ODDS'],\n    'not_in_record_count': counts['NOT_IN_RECORD'],\n    'clarification_governed_count': clar_count,\n}\nwith open('/"]
