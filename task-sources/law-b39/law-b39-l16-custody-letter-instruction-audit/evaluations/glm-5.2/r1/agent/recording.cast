[405.750711, "i", "python3 - <<'PY'\nimport csv, collections\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nout=list(csv.DictReader(open('/app/letter_line_review.csv')))\nprint('Compact subject/position summary:')\nfor s in sorted(set(r['subject'] for r in rows)):\n    print(f'\\n### {s}')\n    groups=collections.defaultdict(list)\n    for r,o in zip(rows,out):\n        if r['subject']==s:\n            groups[r['position']].append((r['line_id'], o['verdict'], o['record_entry'], r['wording']))\n    for p,items in sorted(groups.items()):\n        print(f\"{p} -> {items[0][1]} ({items[0][2]}) | {items[0][3]}\")\n        if len(items)>1:\n            print(f\"  ... {len(items)} rows total, ids: {', '.join(i[0] for i in items)}\")\nprint('\\nchildren_named rows with digits:')\nfor r,o in zip(rows,out):\n    if r['subject']=='children_named' and any(ch.isdigit() for ch in r['wording']):\n        print(f\"{r['line_id']} | {o['verdict']} | {r['position']} | {r['wording']}\")\nPY\n"]
