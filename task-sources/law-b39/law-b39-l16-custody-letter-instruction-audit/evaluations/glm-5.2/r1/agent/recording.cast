[124.926991, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.927259, "o", "> def verdict_for(r):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.928009, "o", "    s = r['subject']\r\n\u001b[?2004l\r"]
[124.92833, "o", "\u001b[?2004h> "]
[124.928811, "o", "    w = r['wording']\r\n\u001b[?2004l\r"]
[124.929318, "o", "\u001b[?2004h> "]
[124.929627, "o", "    L = w.lower()\r\n\u001b[?2004l\r` g\u001b[?2004h> "]
[124.93014, "o", "    if s not in governing:\r\n\u001b[?2004l\r"]
[124.930558, "o", "\u001b[?2004h> "]
[124.931117, "o", "        return 'NOT_IN_RECORD'\r\n\u001b[?2004l\r,\u001b[?2004h"]
[124.931388, "o", "> "]
[124.931929, "o", "    if s == 'addressee':\r\n\u001b[?2004l\r"]
[124.933694, "o", "\u001b[?2004h> "]
[124.936982, "o", "        return 'VERIFIED' if (('mother' in L or 'catherine' in L or 'ms corwin' in L) and 'father' not in L and 'adam' not in L) else 'AT_ODDS'\r\n\u001b[?2004l\r"]
[124.937241, "o", "\u001b[?2004h"]
[124.937542, "o", "> "]
[124.937921, "o", "    if s == 'behavioural_plan':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.940563, "o", "        return 'VERIFIED' if ('confidence' in L and 'stability' in L and 'peer' in L and 'confidence only' in L) else 'AT_ODDS'\r\n\u001b[?2004l\r"]
[124.940892, "o", "\u001b[?2004h> "]
[124.941215, "o", "    if s == 'children_named':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.943496, "o", "        return 'VERIFIED' if ('noor' in L and 'imogen' in L and 'seven' in L and 'twelve' in L) else 'AT_ODDS'\r\n\u001b[?2004l\r"]
[124.943841, "o", "\u001b[?2004h> "]
[124.944626, "o", "    if s == 'concern':\r\n"]
[124.944903, "o", "\u001b[?2004l\r"]
[124.94528, "o", "\u001b[?2004h> "]
[124.94949, "o", "        return 'VERIFIED' if ('position' in L and 'violation' not in L and 'violate' not in L and 'appreciate' not in L) else 'AT_ODDS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.949831, "o", "> "]
[124.950326, "o", "    if s == 'copies':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.952586, "o", "        return 'VERIFIED' if ('not copy' in L or 'nobody' in L or 'no one' in L or 'no-one' in L) else 'AT_ODDS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.952872, "o", "    if s == 'delivery':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.953355, "o", "        return 'VERIFIED' if ('post' in L) else 'AT_ODDS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.953732, "o", ">     if s == 'enclosure':\r\n\u001b[?2004l\r"]
[124.954003, "o", "\u001b[?2004h> "]
[124.954665, "o", "        return 'VERIFIED' if ('certified' in L and 'custodial plan' in L) else 'AT_ODDS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.954922, "o", "> "]
[124.955208, "o", "    if s == 'inconsistent_accounts':\r\n\u001b[?2004l\r"]
[124.955525, "o", "\u001b[?2004h> "]
[124.956708, "o", "        return 'VERIFIED' if ('school' in L and ('clinician' in L) and ('to me' in L or 'sitter to me' in L or 'babysitter to me' in L) and ('neighbour' in L or 'neighbor' in L)) else 'AT_ODDS'\r\n\u001b[?2004l\r"]
[124.957047, "o", "\u001b[?2004h> "]
[124.957329, "o", "    if s == 'overnight_stays':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.958252, "o", "        return 'VERIFIED' if ('both children' in L and 'several' in L and 'home' in L and 'sitter' in L) else 'AT_ODDS'\r\n\u001b[?2004l\r"]
[124.958596, "o", "\u001b[?2004h> "]
[124.959008, "o", "    if s == 'request':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.959293, "o", "        if 'meeting' in L:\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.959446, "o", "> "]
[124.959951, "o", "            return 'AT_ODDS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.960826, "o", "        return 'VERIFIED' if ('overnight' in L and 'unless' in L and ('father' in L or 'mr adler' in L) and 'mother' not in L and 'parent' not in L) else 'AT_ODDS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.961099, "o", "> "]
[124.961348, "o", "    if s == 'right_of_first_refusal':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.962754, "o", "        return 'VERIFIED' if ('right of first refusal' in L and ('mr adler' in L or 'father' in L) and 'agreed' in L and 'overnight' in L and ('without him' in L or 'without him present' in L)) else 'AT_ODDS'\r\n\u001b[?2004l\r"]
[124.963032, "o", "\u001b[?2004h> "]
[124.963474, "o", "    if s == 'salutation':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.963756, "o", "        return 'VERIFIED' if 'dear counsel' in L else 'AT_ODDS'\r\n"]
[124.964056, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[124.964527, "o", "    if s == 'sender_signature':\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.964875, "o", "> "]
[124.965304, "o", "        return 'VERIFIED' if ('delphine marr' in L and 'solicitor' not in L and 'for delphine' not in L) else 'AT_ODDS'\r\n\u001b[?2004l\r"]
[124.96553, "o", "\u001b[?2004h"]
[124.965911, "o", "> "]
[124.966174, "o", "    if s == 'tone':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.966791, "o", "        return 'VERIFIED' if ('firm' in L and 'formal' in L and 'brief' in L) else 'AT_ODDS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.967113, "o", "> "]
[124.967439, "o", "    return 'NOT_IN_RECORD'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[124.967739, "o", "\u001b[?2004h> "]
[124.96827, "o", "out_rows = []\r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r"]
[124.968669, "o", "\u001b[?2004h>     v = verdict_for(r)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.968961, "o", "    entry = governing.get(r['subject'], 'NONE')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.969904, "o", "    out_rows.append({'line_id': r['line_id'], 'verdict': v, 'record_entry': entry})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.970503, "o", "counts = {v: sum(1 for x in out_rows if x['verdict']==v) for v in ['VERIFIED','AT_ODDS','NOT_IN_RECORD']}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.970954, "o", "clar_count = sum(1 for x in out_rows if x['record_entry'].startswith('CL-'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.97124, "o", "> "]
[124.971681, "o", "print('counts', counts, 'clar', clar_count, 'rows', len(out_rows))\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.972219, "o", "> \r\n\u001b[?2004l\r"]
[124.972481, "o", "\u001b[?2004h> # Print samples for each subject\r\n\u001b[?2004l\r"]
[124.972886, "o", "\u001b[?2004h> "]
[124.973172, "o", "from collections import defaultdict\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.973468, "o", "by_sub = defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.973719, "o", "for r, o in zip(rows, out_rows):\r\n"]
[124.974004, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[124.974492, "o", "    by_sub[r['subject']].append((r['line_id'], o['verdict'], o['record_entry'], r['position'], r['wording']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.974841, "o", "> for s in sorted(by_sub):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.975242, "o", "    print('\\\\n###', s)\r\n\u001b[?2004l\r\u001b[?2004h>     for item in by_sub[s][:5]:\r\n\u001b[?2004l\r"]
[124.975492, "o", "\u001b[?2004h> "]
[124.975737, "o", "        print(item)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.976026, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.976312, "o", "# Write deliverables\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.976943, "o", "with open('/app/letter_line_review.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.977655, "o", "    writer = csv.DictWriter(f, fieldnames=['line_id','verdict','record_entry'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.977938, "o", "    writer.writeheader()\r\n\u001b[?2004l\r"]
[124.978106, "o", "\u001b[?2004h> "]
