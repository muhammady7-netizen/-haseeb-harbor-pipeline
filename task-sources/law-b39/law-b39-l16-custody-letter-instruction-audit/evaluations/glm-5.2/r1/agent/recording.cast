[73.522525, "i", "python3 - <<'PY'\nimport csv\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nwith open('/tmp/rows_grouped.txt','w') as f:\n    for s in sorted(set(r['subject'] for r in rows)):\n        f.write(f\"### {s}\\n\")\n        for r in rows:\n            if r['subject']==s:\n                f.write(f\"{r['line_id']} | {r['position']} | {r['cited_entry']} | {r['wording']}\\n\")\n        f.write(\"\\n\")\nprint('rows', len(rows), 'lines written')\nPY\n"]
