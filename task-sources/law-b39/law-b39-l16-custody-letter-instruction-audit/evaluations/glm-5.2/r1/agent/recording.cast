[29.459485, "o", "line_id,subject,position,cited_entry,wording\r\r\nST-101,right_of_first_refusal,agreed by the father,OI-202,\"Mr Adler agreed to a right of first refusal, so the children are not to be left overnight without him present.\"\r\r\nST-102,children_named,\"both children, with their ages\",OI-203,\"This concerns Noor, aged seven, and Imogen, aged twelve.\"\r\r\nST-103,overnight_stays,several occasions at her home or with a sitter,OI-204,On several occasions both children have stayed overnight at Ms Corwin's home or with a sitter while Mr Adler was away.\r\r\nST-104,addressee,the father's attorney,OI-201,To counsel for Mr Adler.\r\r\n"]
