[124.925122, "o", "    'inconsistent_accounts': 'OI-205',\r\n\u001b[?2004l\r"]
[124.925383, "o", "\u001b[?2004h> "]
[124.926133, "o", "    'sender_signature': 'OI-211',\r\n\u001b[?2004l\r"]
