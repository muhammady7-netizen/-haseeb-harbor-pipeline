[?2004l[?2004h>     for r,o in zip(rows,out):
[?2004l[?2004h>         if r['subject']==s:
[?2004l[?2004h>             print(f"{r['line_id']} | {o['verdict']} | {o['record_entry']} | {r['position']} | {r['wording']}")
