[?2004l[?2004h> out=list(csv.DictReader(open('/app/letter_line_review.csv')))
[?2004l[?2004h> print('input rows', len(rows), 'output rows', len(out))
[?2004l[?2004h> print('output header', out[0].keys() if out else None)
[?2004l[?2004h> print('verdict counts', collections.Counter(r['verdict'] for r in out))
[?2004l[?2004h> print('entry counts', collections.Counter(r['record_entry'] for r in out))
