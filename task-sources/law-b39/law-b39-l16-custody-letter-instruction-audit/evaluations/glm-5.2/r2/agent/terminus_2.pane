[?2004l[?2004h> 
[?2004l[?2004h> def classify(r):
[?2004l[?2004h>     subj=r['subject']; w=r['wording']; pos=r['position']
[?2004l[?2004h>     if subj in cl_subjects:
[?2004l[?2004h>         gov=cl_subjects[subj]
[?2004l[?2004h>         if subj=='addressee':
[?2004l[?2004h>             verified = (('Ms Corwin' in w) or ('mother' in w) or ("Catherine's attorney" in w)) and ('father' not in w) and ('Mr Adler' not in w) and ('Adam' not in w)
[?2004l[?2004h>         elif subj=='request':
[?2004l[?2004h>             verified = ('overnight' in w) and ('unless' in w) and (('father' in w) or ('Mr Adler' in w)) and not ('Ms Corwin is present' in w) and not ('mother' in w) and not ('parent' in w) and not ('guardian' in w) and not ('either child may' in w) and not ('away' in w) and not ('post' in w) and not ('meeting' in w)
[?2004l[?2004h>         elif subj=='enclosure':
[?2004l[?2004h>             verified = ('certified' in w) and ('custodial plan' in w) and ('enclosed' in w)
[?2004l[?2004h>         elif subj=='salutation':
[?2004l[?2004h>             verified = w.strip().startswith('Dear Counsel')
[?2004l[?2004h>         elif subj=='copies':
[?2004l[?2004h>             verified = pos in ('nobody','copy nobody') or 'do not copy anyone' in w or 'no copy' in w.lower() or 'not copy anyone' in w.lower() or 'copy nobody' in w.lower()
[?2004l[?2004h>         elif subj=='delivery':
[?2004l[?2004h>             verified = ('post' in w) and ('counsel' in w) and not ('email' in w) and not ('courier' in w) and not ('hand' in w) and not ('Dear Counsel' in w)
[?2004l[?2004h>         elif subj=='tone':
[?2004l[?2004h>             verified = ('firm' in w) and ('formal' in w) and ('brief' in w) and not ('soft' in w) and not ('detailed' in w) and not ('direct' in w) and not ('at length' in w) and not ('warm' in w) and not ('personal' in w) and not ('copy' in w)
[?2004l[?2004h>         elif subj=='behavioural_plan':
[?2004l[?2004h>             verified = ('confidence' in w) and ('stability' in w) and ('peer relations' in w) and ('set back confidence only' in w)
[?2004l[?2004h>         elif subj=='concern':
[?2004l[?2004h>             verified = ('position' in w) and ('put in' in w or 'placed in' in w) and ('appreciate' not in w) and ('violate' not in w) and ('order' not in w) and ('stays' not in w) and ('enclosed' not in w)
[?2004l[?2004h>         else:
[?2004l[?2004h>             verified=False
[?2004l[?2004h>         return ('VERIFIED' if verified else 'AT_ODDS', gov)
[?2004l[?2004h>     if subj in oi_subjects:
[?2004l[?2004h>         gov=oi_subjects[subj]
[?2004l[?2004h>         if subj=='right_of_first_refusal':
[?2004l[?2004h>             verified = (('Mr Adler' in w) or ('father' in w)) and ('right of first refusal' in w) and ('not to be left overnight without him present' in w) and ('Ms Corwin' not in w) and ('still permitted' not in w) and ('either parent' not in w) and ('anyone but' not in w)
[?2004l[?2004h>         elif subj=='children_named':
