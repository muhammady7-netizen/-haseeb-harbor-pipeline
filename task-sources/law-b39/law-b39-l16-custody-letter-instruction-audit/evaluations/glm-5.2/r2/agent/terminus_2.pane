[?2004l[?2004h> import csv
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> rows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))
[?2004l[?2004h> by=defaultdict(list)
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     by[r['subject']].append(r)
[?2004l[?2004h> for subj in ['right_of_first_refusal','overnight_stays','inconsistent_accounts','children_named','sender_signature']:
[?2004l[?2004h>     print(f'======== {subj} ========')
[?2004l[?2004h>     seen=set()
[?2004l[?2004h>     for r in by[subj]:
[?2004l[?2004h>         key=(r['position'],r['wording'])
[?2004l[?2004h>         if key in seen: continue
[?2004l[?2004h>         seen.add(key)
[?2004l[?2004h>         print(f"{r['line_id']} | pos={r['position']} | cite={r['cited_entry']} | {r['wording']}")
[?2004l[?2004h>     print()
[?2004l[?2004h> PY
