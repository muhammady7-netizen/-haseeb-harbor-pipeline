[?2004l[?2004h>         else:
[?2004l[?2004h>             verified=False
[?2004l[?2004h>         return ('VERIFIED' if verified else 'AT_ODDS', gov)
[?2004l[?2004h>     if subj in oi_subjects:
[?2004l[?2004h>         gov=oi_subjects[subj]
[?2004l[?2004h>         if subj=='right_of_first_refusal':
[?2004l[?2004h>             verified = (('Mr Adler' in w) or ('father' in w)) and ('right of first refusal' in w) and ('not to be left overnight without him present' in w) and ('Ms Corwin' not in w) and ('still permitted' not in w) and ('either parent' not in w) and ('anyone but' not in w)
[?2004l[?2004h>         elif subj=='children_named':
[?2004l[?2004h>             verified = ('Noor' in w) and ('aged seven' in w) and ('Imogen' in w) and ('aged twelve' in w)
[?2004l[?2004h>         elif subj=='overnight_stays':
[?2004l[?2004h>             verified = ('several occasions' in w) and ('both children' in w) and ('home' in w) and ('sitter' in w) and (('Mr Adler was away' in w) or ('father was away' in w))
[?2004l[?2004h>         elif subj=='inconsistent_accounts':
[?2004l[?2004h>             verified = ('wife' in w) and ('school' in w) and ('clinicians' in w) and ('babysitter' in w or 'sitter' in w) and ('me' in w) and ('partner' in w) and ('neighbours' in w)
[?2004l[?2004h>         elif subj=='sender_signature':
[?2004l[?2004h>             verified = ('Delphine Marr' in w) and ('for ' not in w) and ('solicitor' not in w) and not w.rstrip().endswith('Delphine.')
[?2004l[?2004h>         else:
[?2004l[?2004h>             verified=False
[?2004l[?2004h>         return ('VERIFIED' if verified else 'AT_ODDS', gov)
[?2004l[?2004h>     return ('NOT_IN_RECORD','NONE')
[?2004l[?2004h> 
[?2004l[?2004h> by=defaultdict(list)
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     v,g=classify(r)
[?2004l[?2004h>     by[r['subject']].append((r['position'],r['wording'],v,g,r['line_id'],r['cited_entry']))
[?2004l[?2004h> 
[?2004l[?2004h> for subj in ['addressee','request','enclosure','salutation','copies','delivery','tone','concern','behavioural_plan']:
[?2004l[?2004h>     print(f'======== {subj} ========')
[?2004l[?2004h>     seen=set()
[?2004l[?2004h>     for pos,w,v,g,lid,cite in by[subj]:
[?2004l[?2004h>         if (pos,w) in seen: continue
[?2004l[?2004h>         seen.add((pos,w))
[?2004l[?2004h>         print(f"{lid} | {v} | {g} | pos={pos} | cite={cite} | {w}")
[?2004l[?2004h>     print()
