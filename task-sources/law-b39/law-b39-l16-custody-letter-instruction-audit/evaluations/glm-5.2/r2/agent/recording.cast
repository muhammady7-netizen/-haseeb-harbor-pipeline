[616.121852, "o", "\u001b[?2004h\u001b[01;32mappuser@efd392b3b2df\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[616.589247, "i", "python3 - <<'PY'\nimport csv, json\nfrom collections import Counter, defaultdict\nrows=list(csv.DictReader(open('/app/letter_line_review.csv', newline='')))\nprint('rows:', len(rows))\nprint('verdict counts:', Counter(r['verdict'] for r in rows))\nprint('governing counts:', Counter(r['record_entry'] for r in rows))\nprint('clarification_governed_count:', sum(1 for r in rows if r['record_entry'].startswith('CL-')))\nprint('json:', json.load(open('/app/results.json')))\nby=defaultdict(Counter)\nfor r in rows:\n    by[r['record_entry']][r['verdict']]+=1\nfor g in sorted(by):\n    print(g, dict(by[g]))\nPY\n"]
[616.589589, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[616.589815, "o", "\u001b[?2004h> "]
