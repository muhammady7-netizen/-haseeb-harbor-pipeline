[166.040175, "i", "python3 - <<'PY'\nimport csv\nfrom collections import defaultdict\nrows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\nby=defaultdict(list)\nfor r in rows:\n    by[r['subject']].append(r)\nfor subj in ['concern','request','tone','behavioural_plan']:\n    print(f'======== {subj} ========')\n    seen=set()\n    for r in by[subj]:\n        key=(r['position'],r['wording'])\n        if key in seen: continue\n        seen.add(key)\n        print(f\"{r['line_id']} | pos={r['position']} | cite={r['cited_entry']} | {r['wording']}\")\n    print()\nPY\n"]
