[614.640302, "i", "cat > /tmp/generate_deliverables.py <<'PY'\nimport csv, json\nfrom pathlib import Path\n\nrows = list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\n\norig = {\n    'addressee': 'OI-201',\n    'right_of_first_refusal': 'OI-202',\n    'children_named': 'OI-203',\n    'overnight_stays': 'OI-204',\n    'inconsistent_accounts': 'OI-205',\n    'concern': 'OI-206',\n    'behavioural_plan': 'OI-207',\n    'request': 'OI-208',\n    'enclosure': 'OI-209',\n    'tone': 'OI-210',\n    'sender_signature': 'OI-211',\n}\n\nclar = {\n    'addressee': 'CL-301',\n    'request': 'CL-302',\n    'enclosure': 'CL-303',\n    'salutation': 'CL-304',\n    'copies': 'CL-305',\n    'delivery': 'CL-306',\n    'tone': 'CL-307',\n    'behavioural_plan': 'CL-308',\n    'concern': 'CL-309',\n    'interim_contact': 'CL-310',\n    'without_prejudice': 'CL-311',\n}\nclar_subject = {entry: subj for subj, entry in clar.items()}\n\ndef governing_entry(subject, cited_entry):\n    if subject not in orig and subject not in clar:\n        return 'NONE'\n    if subject"]
[614.640678, "i", " in clar:\n        if cited_entry in clar_subject and clar_subject[cited_entry] != subject and subject in orig:\n            return orig[subject]\n        return clar[subject]\n    return orig[subject]\n\nverified_positions = {\n    ('addressee', 'CL-301'): {\"mother's attorney\", \"mother\"},\n    ('addressee', 'OI-201'): {\"father's attorney\", \"the father attorney\", \"the father's attorney\", \"father\"},\n    ('right_of_first_refusal', 'OI-202'): {\"agreed by the father\", \"father agreed\", \"full\"},\n    ('children_named', 'OI-203'): {\"both children, with their ages\", \"both children with ages\", \"both with ages\"},\n    ('overnight_stays', 'OI-204'): {\"several occasions at her home or with a sitter\", \"full\", \"home or sitter both\"},\n    ('inconsistent_accounts', 'OI-205'): {\"all four\", \"all four audiences\"},\n    ('concern', 'OI-206'): {\"both limbs\", \"both limbs old\"},\n    ('concern', 'CL-309'): {\"position only\", \"position limb only\", \"narrower concern only position\"},\n    ('behavioural_plan', 'OI-207'): {\"confidence stability setba"]
[614.640991, "o", "cat > /tmp/generate_deliverables.py <<'PY'\r\n\u001b[?2004l\r"]
[614.641095, "i", "ck\", \"old full setback\"},\n    ('behavioural_plan', 'CL-308'): {\"confidence stability peer confidence-only\", \"full CL match\"},\n    ('request', 'OI-208'): {\"CL match\", \"CL wording exact\", \"CL wording paraphrase\", \"neither child overnight unless father present\", \"no overnight stays in her care unless the father is present\", \"no overnight stays unless father present\", \"no overnight unless father present\"},\n    ('request', 'CL-302'): {\"CL match\", \"CL wording exact\", \"CL wording paraphrase\", \"neither child overnight unless father present\", \"no overnight stays in her care unless the father is present\", \"no overnight stays unless father present\", \"no overnight unless father present\"},\n    ('enclosure', 'OI-209'): {\"a certified copy of the custodial plan\", \"certified\", \"certified copy\", \"certified copy enclosed\"},\n    ('enclosure', 'CL-303'): {\"a certified copy of the custodial plan\", \"certified\", \"certified copy\", \"certified copy enclosed\"},\n    ('salutation', 'CL-304'): {\"Dear Counsel\"},\n    ('copies', 'CL-305'): {\""]
[614.641461, "o", "\u001b[?2004h> "]
[614.641759, "i", "copy nobody\", \"nobody\"},\n    ('delivery', 'CL-306'): {\"by post\", \"post\"},\n    ('tone', 'OI-210'): {\"soft formal succinct\"},\n    ('tone', 'CL-307'): {\"firm formal brief\"},\n    ('sender_signature', 'OI-211'): {\"the sender's own name\", \"own name\", \"full name\"},\n    ('interim_contact', 'CL-310'): {\"all three addressed together\", \"all three aspects jointly\", \"all three aspects together\", \"confidence stability peer relations jointly\", \"confidence stability peer relations all three\"},\n    ('without_prejudice', 'CL-311'): {\"soft conciliatory tone\", \"soft tone settlement offer\", \"conciliatory and open\", \"soft and measured\", \"gentle settlement tone\"},\n}\n\nout_rows = []\nfor r in rows:\n    g = governing_entry(r['subject'], r['cited_entry'])\n    if g == 'NONE':\n        verdict = 'NOT_IN_RECORD'\n    elif r['position'] in verified_positions.get((r['subject'], g), set()):\n        verdict = 'VERIFIED'\n    else:\n        verdict = 'AT_ODDS'\n    out_rows.append({'line_id': r['line_id'], 'verdict': verdict, 'record_entry': g})\n\nwi"]
