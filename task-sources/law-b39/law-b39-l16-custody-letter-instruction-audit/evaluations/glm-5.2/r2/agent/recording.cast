[766.82771, "i", "python3 - <<'PY'\nimport csv\nfrom collections import defaultdict\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\nrev={r['line_id']: r for r in csv.DictReader(open('/app/letter_line_review.csv', newline=''))}\ncombos=defaultdict(list)\nfor r in rows:\n    g=rev[r['line_id']]\n    combos[(r['subject'],r['position'],r['cited_entry'],g['record_entry'],g['verdict'])].append(r['line_id'])\nwith open('/tmp/verdict_combos.txt','w') as f:\n    for k,ids in sorted(combos.items()):\n        subj,pos,cite,g,ver=k\n        f.write(f'{subj}\\t{pos}\\t{cite}\\t{g}\\t{ver}\\t{len(ids)}\\t{\",\".join(ids)}\\n')\nprint('written', len(combos), 'combos')\nPY\n"]
