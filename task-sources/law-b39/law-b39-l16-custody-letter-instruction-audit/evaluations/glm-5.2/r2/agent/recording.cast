[305.382916, "i", "py' in w)\n        elif subj=='behavioural_plan':\n            verified = ('confidence' in w) and ('stability' in w) and ('peer relations' in w) and ('set back confidence only' in w)\n        elif subj=='concern':\n            verified = ('position' in w) and ('put in' in w or 'placed in' in w) and ('appreciate' not in w) and ('violate' not in w) and ('order' not in w) and ('stays' not in w) and ('enclosed' not in w)\n        else:\n            verified=False\n        return ('VERIFIED' if verified else 'AT_ODDS', gov)\n    if subj in oi_subjects:\n        gov=oi_subjects[subj]\n        if subj=='right_of_first_refusal':\n            verified = (('Mr Adler' in w) or ('father' in w)) and ('right of first refusal' in w) and ('not to be left overnight without him present' in w) and ('Ms Corwin' not in w) and ('still permitted' not in w) and ('either parent' not in w) and ('anyone but' not in w)\n        elif subj=='children_named':\n            verified = ('Noor' in w) and ('aged seven' in w) and ('Imogen' in w) and ('aged t"]
[305.38316, "o", "import csv\r\n\u001b[?2004l\r\u001b[?2004h> from collections import defaultdict\r\n\u001b[?2004l\r"]
[305.383452, "i", "welve' in w)\n        elif subj=='overnight_stays':\n            verified = ('several occasions' in w) and ('both children' in w) and ('home' in w) and ('sitter' in w) and (('Mr Adler was away' in w) or ('father was away' in w))\n        elif subj=='inconsistent_accounts':\n            verified = ('wife' in w) and ('school' in w) and ('clinicians' in w) and ('babysitter' in w or 'sitter' in w) and ('me' in w) and ('partner' in w) and ('neighbours' in w)\n        elif subj=='sender_signature':\n            verified = ('Delphine Marr' in w) and ('for ' not in w) and ('solicitor' not in w) and not w.rstrip().endswith('Delphine.')\n        else:\n            verified=False\n        return ('VERIFIED' if verified else 'AT_ODDS', gov)\n    return ('NOT_IN_RECORD','NONE')\n\nby=defaultdict(list)\nfor r in rows:\n    v,g=classify(r)\n    by[r['subject']].append((r['position'],r['wording'],v,g,r['line_id'],r['cited_entry']))\n\nfor subj in ['right_of_first_refusal','children_named','overnight_stays','inconsistent_accounts','sender_sig"]
