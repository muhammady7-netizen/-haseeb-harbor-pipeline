[259.34728, "i", "python3 - <<'PY'\nimport csv\nfrom collections import defaultdict\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\nd=defaultdict(list)\nfor r in rows:\n    d[(r['subject'], r['position'], r['cited_entry'])].append(r['line_id'])\nwith open('/tmp/combos.txt','w') as f:\n    for (subj,pos,cite),ids in sorted(d.items()):\n        f.write(f'{subj}\\t{pos}\\t{cite}\\t{len(ids)}\\t{\",\".join(ids)}\\n')\nprint('written', len(d), 'combos')\nPY\n"]
