[400.728827, "o", "        elif subj == 'overnight_stays':\r\n\u001b[?2004l\r\u001b[?2004h"]
[400.729024, "o", "> "]
[400.730423, "o", "            verified = 'several occasions' in w and 'both children' in w and 'home' in w and 'sitter' in w and ('Mr Adler was away' in w or 'father was away' in w)\r\n\u001b[?2004l\r"]
[400.730753, "o", "\u001b[?2004h> "]
[400.731151, "o", "        elif subj == 'inconsistent_accounts':\r\n\u001b[?2004l\r"]
[400.731465, "o", "\u001b[?2004h"]
[400.731709, "o", "> "]
[400.733311, "o", "            verified = 'wife' in lw and 'school' in lw and 'clinicians' in lw and ('babysitter' in lw or 'sitter' in lw) and 'me' in lw and 'partner' in lw and 'neighbours' in lw\r\n\u001b[?2004l\r"]
[400.733514, "o", "\u001b[?2004h> "]
[400.733874, "o", "        elif subj == 'sender_signature':\r\n\u001b[?2004l\r"]
[400.734118, "o", "\u001b[?2004h> "]
[400.735329, "o", "            verified = 'Delphine Marr' in w and 'for ' not in w and 'solicitor' not in w and not w.rstrip().endswith('Delphine.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.735747, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[400.736034, "o", "> "]
[400.736359, "o", "            verified = False\r\n\u001b[?2004l\r"]
[400.736475, "o", "\u001b[?2004h> "]
[400.73705, "o", "        return ('VERIFIED' if verified else 'AT_ODDS', gov)\r\n\u001b[?2004l\r"]
[400.737211, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[400.737383, "o", "\u001b[?2004h"]
[400.737607, "o", "> "]
[400.737809, "o", "    return ('NOT_IN_RECORD', 'NONE')"]
[400.738059, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[400.738312, "o", "> \r\n\u001b[?2004l\r"]
[400.738508, "o", "\u001b[?2004h> "]
[400.73884, "o", "verdicts = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[400.739056, "o", "> "]
[400.739175, "o", "for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.739469, "o", "    v, g = classify(r)\r\n\u001b[?2004l\r"]
[400.73968, "o", "\u001b[?2004h> "]
[400.740143, "o", "    verdicts.append((r['line_id'], v, g))\r\n\u001b[?2004l\r"]
[400.740272, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[400.740521, "o", "\u001b[?2004h"]
[400.740783, "o", "> "]
[400.741005, "o", "cnt = Counter(v for _, v, _ in verdicts)\r\n\u001b[?2004l\r"]
[400.74125, "o", "\u001b[?2004h> "]
[400.741838, "o", "clar_count = sum(1 for _, v, g in verdicts if g.startswith('CL-'))\r\n\u001b[?2004l\r"]
[400.742068, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.742716, "o", "with open('letter_line_review.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r"]
[400.743006, "o", "\u001b[?2004h> "]
[400.74322, "o", "    writer = csv.writer(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[400.743477, "o", "> "]
[400.744037, "o", "    writer.writerow(['line_id', 'verdict', 'record_entry'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[400.744298, "o", ">     for row in verdicts:\r\n\u001b[?2004l\r"]
[400.744524, "o", "\u001b[?2004h> "]
[400.744765, "o", "        writer.writerow(row)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[400.744983, "o", "> results = {\r\n\u001b[?2004l\r"]
[400.745233, "o", "\u001b[?2004h> "]
[400.745478, "o", "    'verified_count': cnt['VERIFIED'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.745687, "o", "    'at_odds_count': cnt['AT_ODDS'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.746015, "o", "    'not_in_record_count': cnt['NOT_IN_RECORD'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.746292, "o", "    'clarification_governed_count': clar_count,\r\n\u001b[?2004l\r\u001b[?2004h"]
[400.746501, "o", "> }\r\n\u001b[?2004l\r"]
[400.746616, "o", "\u001b[?2004h> "]
[400.746861, "o", "with open('results.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.747066, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.747318, "o", "    f.write('\\n')\r\n\u001b[?2004l\r"]
[400.747426, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[400.747709, "o", "\u001b[?2004h> "]
[400.748327, "o", "answer = f\"\"\"# Review of the draft letter against the client's record\r\n\u001b[?2004l\r"]
[400.748566, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[400.74884, "o", "> "]
[400.750751, "o", "The draft was checked line by line against the client's first message and later clarification. Under the review protocol, the clarification prevails on every subject it speaks to, the original instruction governs only the subjects the clarification leaves alone, and subjects neither message addresses have no governing record entry. Each line was therefore weighed against the entry that governs its subject, not against the entry the draft happens to cite.\r\n\u001b[?2004l\r"]
[400.750962, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[400.751176, "o", "\u001b[?2004h> "]
[400.751273, "o", "Letter lines at odds with the record: {cnt['AT_ODDS']}\r\n\u001b[?2004l\r\u001b[?2004h"]
[400.75171, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.754317, "o", "Of the 290 draft lines, {cnt['VERIFIED']} are verified by the governing record entry, {cnt['AT_ODDS']} are at odds with it, and {cnt['NOT_IN_RECORD']} are not in the record at all because neither the original instruction nor the clarification speaks to their subject. {clar_count} lines are governed by a clarification entry rather than an original instruction entry. The most common failures are lines that cite an original entry after the clarification has superseded it, lines that give only part of a required position, and lines that address the father or his attorney when the clarification directs the letter to the mother's attorney.\r\n\u001b[?2004l\r"]
[400.754629, "o", "\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[400.754856, "o", "> with open('answer.md', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.755179, "o", "    f.write(answer)"]
[400.755427, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.755627, "o", "print(json.dumps(results, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[400.75589, "o", "> "]
[400.756196, "o", "print('rows_written', len(verdicts))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[400.814102, "o", "{\r\n  \"verified_count\": 86,\r\n  \"at_odds_count\": 155,\r\n  \"not_in_record_count\": 49,\r\n  \"clarification_governed_count\": 168\r\n}\r\nrows_written 290\r\n"]
[400.820221, "o", "\u001b[?2004h\u001b[01;32mappuser@8bef2e9355c8\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
