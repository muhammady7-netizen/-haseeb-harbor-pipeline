[305.383956, "i", "nature']:\n    print(f'======== {subj} ========')\n    seen=set()\n    for pos,w,v,g,lid,cite in by[subj]:\n        if (pos,w) in seen: continue\n        seen.add((pos,w))\n        print(f\"{lid} | {v} | {g} | pos={pos} | cite={cite} | {w}\")\n    print()\nPY\n"]
