[167.031304, "i", "python3 - <<'PY'\nimport csv\nfrom collections import defaultdict\nrows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\nby=defaultdict(list)\nfor r in rows:\n    by[r['subject']].append(r)\nfor subj in ['right_of_first_refusal','overnight_stays','inconsistent_accounts','children_named','sender_signature']:\n    print(f'======== {subj} ========')\n    seen=set()\n    for r in by[subj]:\n        key=(r['position'],r['wording'])\n        if key in seen: continue\n        seen.add(key)\n        print(f\"{r['line_id']} | pos={r['position']} | cite={r['cited_entry']} | {r['wording']}\")\n    print()\nPY\n"]
