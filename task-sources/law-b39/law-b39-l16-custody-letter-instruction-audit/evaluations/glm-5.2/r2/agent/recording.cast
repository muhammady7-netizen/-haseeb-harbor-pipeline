[247.32979, "i", "' in w) and ('aged twelve' in w)\n        elif subj=='overnight_stays':\n            verified = ('several occasions' in w) and ('both children' in w) and ('home' in w) and ('sitter' in w) and (('Mr Adler was away' in w) or ('father was away' in w))\n        elif subj=='inconsistent_accounts':\n            verified = ('wife' in w) and ('school' in w) and ('clinicians' in w) and ('babysitter' in w or 'sitter' in w) and ('me' in w) and ('partner' in w) and ('neighbours' in w)\n        elif subj=='sender_signature':\n            verified = ('Delphine Marr' in w) and ('for ' not in w) and ('solicitor' not in w) and not w.rstrip().endswith('Delphine.')\n        else:\n            verified=False\n        return ('VERIFIED' if verified else 'AT_ODDS', gov)\n    return ('NOT_IN_RECORD','NONE')\n\nout=[]\nfor r in rows:\n    v,g=classify(r)\n    out.append((r['line_id'],v,g,r['subject'],r['position'],r['cited_entry'],r['wording']))\n\ncnt=Counter(v for _,v,_,_,_,_,_ in out)\nprint(cnt)\nprint('clar_gov', sum(1 for _,v,g,_,_,_,_ in out if"]
