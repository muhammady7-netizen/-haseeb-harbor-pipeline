[305.38199, "i", "python3 - <<'PY'\nimport csv\nfrom collections import defaultdict\n\nrows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\n\ncl_subjects={'addressee':'CL-301','request':'CL-302','enclosure':'CL-303','salutation':'CL-304','copies':'CL-305','delivery':'CL-306','tone':'CL-307','behavioural_plan':'CL-308','concern':'CL-309'}\noi_subjects={'right_of_first_refusal':'OI-202','children_named':'OI-203','overnight_stays':'OI-204','inconsistent_accounts':'OI-205','sender_signature':'OI-211'}\n\ndef classify(r):\n    subj=r['subject']; w=r['wording']; pos=r['position']\n    if subj in cl_subjects:\n        gov=cl_subjects[subj]\n        if subj=='addressee':\n            verified = (('Ms Corwin' in w) or ('mother' in w) or (\"Catherine's attorney\" in w)) and ('father' not in w) and ('Mr Adler' not in w) and ('Adam' not in w)\n        elif subj=='request':\n            verified = ('overnight' in w) and ('unless' in w) and (('father' in w) or ('Mr Adler' in w)) and not ('Ms Corwin is present' in w) and not ('mother' in w) "]
[305.382386, "i", "and not ('parent' in w) and not ('guardian' in w) and not ('either child may' in w) and not ('away' in w) and not ('post' in w) and not ('meeting' in w)\n        elif subj=='enclosure':\n            verified = ('certified' in w) and ('custodial plan' in w) and ('enclosed' in w)\n        elif subj=='salutation':\n            verified = w.strip().startswith('Dear Counsel')\n        elif subj=='copies':\n            verified = pos in ('nobody','copy nobody') or 'do not copy anyone' in w or 'no copy' in w.lower() or 'not copy anyone' in w.lower() or 'copy nobody' in w.lower()\n        elif subj=='delivery':\n            verified = ('post' in w) and ('counsel' in w) and not ('email' in w) and not ('courier' in w) and not ('hand' in w) and not ('Dear Counsel' in w)\n        elif subj=='tone':\n            verified = ('firm' in w) and ('formal' in w) and ('brief' in w) and not ('soft' in w) and not ('detailed' in w) and not ('direct' in w) and not ('at length' in w) and not ('warm' in w) and not ('personal' in w) and not ('co"]
