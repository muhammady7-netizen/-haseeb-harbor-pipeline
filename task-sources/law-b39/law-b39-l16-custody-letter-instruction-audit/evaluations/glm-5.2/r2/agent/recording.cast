[941.024608, "i", "python3 - <<'PY'\nimport csv, json\nfrom collections import defaultdict\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\nrev={r['line_id']: r for r in csv.DictReader(open('/app/letter_line_review.csv', newline=''))}\ncombos=defaultdict(list)\nfor r in rows:\n    g=rev[r['line_id']]\n    if g['verdict']=='VERIFIED':\n        combos[(r['subject'],r['position'],g['record_entry'])].append(r['line_id'])\nprint('VERIFIED combos:')\nfor k,ids in sorted(combos.items()):\n    print(f'{k[0]} | {k[1]} | {k[2]} | {len(ids)} | {\",\".join(ids)}')\nprint('\\\\nValidation:')\nwith open('/app/letter_line_review.csv', newline='') as f:\n    reader=csv.DictReader(f)\n    assert reader.fieldnames==['line_id','verdict','record_entry'], reader.fieldnames\n    rev_rows=list(reader)\nassert len(rev_rows)==325\nassert all(r['verdict'] in {'VERIFIED','AT_ODDS','NOT_IN_RECORD'} for r in rev_rows)\nassert all(r['record_entry'] in {'NONE'} or r['record_entry'].startswith(('OI-','CL-')) for r in rev_rows)\nres=json.load(open('/app/res"]
[941.025067, "i", "ults.json'))\nassert set(res)=={'verified_count','at_odds_count','not_in_record_count','clarification_governed_count'}\nassert res['verified_count']==sum(1 for r in rev_rows if r['verdict']=='VERIFIED')\nassert res['at_odds_count']==sum(1 for r in rev_rows if r['verdict']=='AT_ODDS')\nassert res['not_in_record_count']==sum(1 for r in rev_rows if r['verdict']=='NOT_IN_RECORD')\nassert res['clarification_governed_count']==sum(1 for r in rev_rows if r['record_entry'].startswith('CL-'))\nans=open('/app/answer.md').read()\nassert 'Letter lines at odds with the record:' in ans\nassert len(ans.split())>=100\nprint('All validation checks passed.')\nprint(json.dumps(res, indent=2))\nPY\n"]
