[840.085685, "i", "python3 - <<'PY'\nimport csv\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\nrev={r['line_id']: r for r in csv.DictReader(open('/app/letter_line_review.csv', newline=''))}\nfor subj in ['request','overnight_stays']:\n    print(f'\\n===== {subj} =====')\n    for r in rows:\n        if r['subject']==subj:\n            g=rev[r['line_id']]\n            print(f\"{r['line_id']} | {r['cited_entry']} | {r['position']} | {r['wording']} | -> {g['record_entry']} | {g['verdict']}\")\nPY\n"]
