[247.350917, "o", "        elif subj=='behavioural_plan':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.351401, "o", "            verified = ('confidence' in w) and ('stability' in w) and ('peer relations' in w) and ('set back confidence only' in w)\r\n\u001b[?2004l\r\u001b[?2004h"]
[247.351698, "o", "> "]
[247.352084, "o", "        elif subj=='concern':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.353911, "o", "            verified = ('position' in w) and ('put in' in w or 'placed in' in w) and ('appreciate' not in w) and ('violate' not in w) and ('order' not in w) and ('stays' not in w) and ('enclosed' not in w)\r\n\u001b[?2004l\r"]
[247.354194, "o", "\u001b[?2004h> "]
[247.354452, "o", "        else:\r\n\u001b[?2004l\r"]
[247.354764, "o", "\u001b[?2004h> "]
[247.354923, "o", "            verified=False\r\n"]
[247.35512, "o", "\u001b[?2004l\r\u001b[?2004h"]
[247.355396, "o", "> "]
[247.356019, "o", "        return ('VERIFIED' if verified else 'AT_ODDS', gov)\r\n\u001b[?2004l\r"]
[247.35632, "o", "\u001b[?2004h> "]
[247.35653, "o", "    if subj in oi_subjects:"]
[247.356787, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.357105, "o", "        gov=oi_subjects[subj]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.357401, "o", "        if subj=='right_of_first_refusal':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.358569, "o", "            verified = (('Mr Adler' in w) or ('father' in w)) and ('right of first refusal' in w) and ('not to be left overnight without him present' in w) and ('Ms Corwin' not in w) and ('still permitted' not in w) and ('either parent' not in w) and ('anyone but' not in w)\r\n\u001b[?2004l\r\u001b[?2004h"]
[247.358832, "o", "> "]
[247.359065, "o", "        elif subj=='children_named':\r\n\u001b[?2004l\r"]
[247.359277, "o", "\u001b[?2004h> "]
[247.359642, "o", "            verified = ('Noor' in w) and ('aged seven' in w) and ('Imogen' in w) and ('aged twelve' in w)\r\n\u001b[?2004l\r"]
[247.359985, "o", "\u001b[?2004h> "]
[247.360248, "o", "        elif subj=='overnight_stays':\r\n\u001b[?2004l\r\u001b[?2004h"]
[247.360528, "o", "> "]
[247.361366, "o", "            verified = ('several occasions' in w) and ('both children' in w) and ('home' in w) and ('sitter' in w) and (('Mr Adler was away' in w) or ('father was away' in w))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.361622, "o", "        elif subj=='inconsistent_accounts':\r\n\u001b[?2004l\r\u001b[?2004h"]
[247.361953, "o", "> "]
[247.362574, "o", "            verified = ('wife' in w) and ('school' in w) and ('clinicians' in w) and ('babysitter' in w or 'sitter' in w) and ('me' in w) and ('partner' in w) and ('neighbours' in w)\r\n\u001b[?2004l\r\u001b[?2004h"]
[247.362809, "o", "> "]
[247.363034, "o", "        elif subj=='sender_signature':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.363574, "o", "            verified = ('Delphine Marr' in w) and ('for ' not in w) and ('solicitor' not in w) and not w.rstrip().endswith('Delphine.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.36394, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
