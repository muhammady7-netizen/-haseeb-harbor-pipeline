[350.99018, "i", "python3 - <<'PY'\nimport csv\nfrom collections import defaultdict\n\nrows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\ncl={'addressee':'CL-301','request':'CL-302','enclosure':'CL-303','salutation':'CL-304','copies':'CL-305','delivery':'CL-306','tone':'CL-307','behavioural_plan':'CL-308','concern':'CL-309'}\noi={'right_of_first_refusal':'OI-202','children_named':'OI-203','overnight_stays':'OI-204','inconsistent_accounts':'OI-205','sender_signature':'OI-211'}\n\ndef classify(r):\n    subj=r['subject']; w=r['wording']; lw=w.lower()\n    if subj in cl:\n        gov=cl[subj]\n        if subj=='addressee':\n            verified=(('ms corwin' in lw) or ('mother' in lw) or ('catherine' in lw)) and not (('father' in lw) or ('mr adler' in lw) or ('adam' in lw))\n        elif subj=='request':\n            verified=('overnight' in lw and 'unless' in lw and ('father' in lw or 'mr adler' in lw) and not ('ms corwin is present' in lw) and not ('mother' in lw) and not ('parent' in lw) and not ('guardian' in lw) and not "]
