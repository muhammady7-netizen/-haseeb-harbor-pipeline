[400.658475, "i", "python3 - <<'PY'\nimport csv, json\nfrom collections import Counter\n\nrows = list(csv.DictReader(open('input/letter_lines.csv', newline='')))\n\ncl_subjects = {\n    'addressee': 'CL-301',\n    'request': 'CL-302',\n    'enclosure': 'CL-303',\n    'salutation': 'CL-304',\n    'copies': 'CL-305',\n    'delivery': 'CL-306',\n    'tone': 'CL-307',\n    'behavioural_plan': 'CL-308',\n    'concern': 'CL-309',\n}\noi_subjects = {\n    'right_of_first_refusal': 'OI-202',\n    'children_named': 'OI-203',\n    'overnight_stays': 'OI-204',\n    'inconsistent_accounts': 'OI-205',\n    'sender_signature': 'OI-211',\n}\n\ndef classify(r):\n    subj = r['subject']\n    w = r['wording']\n    lw = w.lower()\n\n    if subj in cl_subjects:\n        gov = cl_subjects[subj]\n        if subj == 'addressee':\n            verified = (('ms corwin' in lw) or ('mother' in lw) or ('catherine' in lw)) and not (('father' in lw) or ('mr adler' in lw) or ('adam' in lw))\n        elif subj == 'request':\n            verified = (\n                'overnight' in lw and 'unless"]
[400.658922, "i", "' in lw and ('father' in lw or 'mr adler' in lw)\n                and 'ms corwin is present' not in lw\n                and 'mother' not in lw\n                and 'parent' not in lw\n                and 'guardian' not in lw\n                and 'either child may' not in lw\n                and 'away' not in lw\n                and 'post' not in lw\n                and 'meeting' not in lw\n            )\n        elif subj == 'enclosure':\n            verified = 'certified' in lw and 'custodial plan' in lw and 'enclosed' in lw\n        elif subj == 'salutation':\n            verified = w.strip().startswith('Dear Counsel')\n        elif subj == 'copies':\n            verified = (\n                'do not copy anyone' in lw\n                or 'no copy' in lw\n                or 'copy nobody' in lw\n                or 'not copy anyone' in lw\n                or 'no one is copied' in lw\n                or 'no copies' in lw\n                or 'nobody is copied' in lw\n                or 'nobody is to be copied' in lw\n            )\n   "]
