[304.919819, "o", "        gov=oi_subjects[subj]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.920128, "o", "        if subj=='right_of_first_refusal':\r\n\u001b[?2004l\r"]
[304.920372, "o", "\u001b[?2004h"]
[304.920498, "o", "> "]
[304.921741, "o", "            verified = (('Mr Adler' in w) or ('father' in w)) and ('right of first refusal' in w) and ('not to be left overnight without him present' in w) and ('Ms Corwin' not in w) and ('still permitted' not in w) and ('either parent' not in w) and ('anyone but' not in w)\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.921901, "o", "> "]
[304.922157, "o", "        elif subj=='children_named':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.922602, "o", "            verified = ('Noor' in w) and ('aged seven' in w) and ('Imogen' in w) and ('aged twelve' in w)\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.922844, "o", "> "]
[304.923093, "o", "        elif subj=='overnight_stays':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.92376, "o", "            verified = ('several occasions' in w) and ('both children' in w) and ('home' in w) and ('sitter' in w) and (('Mr Adler was away' in w) or ('father was away' in w))\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.924039, "o", "> "]
[304.924271, "o", "        elif subj=='inconsistent_accounts':\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.924525, "o", "> "]
[304.925675, "o", "            verified = ('wife' in w) and ('school' in w) and ('clinicians' in w) and ('babysitter' in w or 'sitter' in w) and ('me' in w) and ('partner' in w) and ('neighbours' in w)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.925996, "o", "        elif subj=='sender_signature':\r\n\u001b[?2004l\r"]
[304.926296, "o", "\u001b[?2004h> "]
[304.92665, "o", "            verified = ('Delphine Marr' in w) and ('for ' not in w) and ('solicitor' not in w) and not w.rstrip().endswith('Delphine.')\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.926848, "o", ">         else:\r\n\u001b[?2004l\r"]
[304.927084, "o", "\u001b[?2004h>             verified=False\r\n\u001b[?2004l\r"]
[304.927169, "o", "\u001b[?2004h> "]
[304.927526, "o", "        return ('VERIFIED' if verified else 'AT_ODDS', gov)\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.92762, "o", "> "]
[304.927937, "o", "    return ('NOT_IN_RECORD','NONE')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.928146, "o", "by=defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.92848, "o", "for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.928808, "o", "    v,g=classify(r)\r\n"]
[304.929079, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[304.929471, "o", "    by[r['subject']].append((r['position'],r['wording'],v,g,r['line_id'],r['cited_entry']))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[304.929681, "o", "\u001b[?2004l\r\u001b[?2004h"]
[304.929926, "o", "> "]
[304.930436, "o", "for subj in ['addressee','request','enclosure','salutation','copies','delivery','tone','concern','behavioural_plan']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.930644, "o", "> "]
[304.931108, "o", "    print(f'======== {subj} ========')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.931386, "o", "    seen=set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.931789, "o", "> "]
[304.932048, "o", "    for pos,w,v,g,lid,cite in by[subj]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.932436, "o", "        if (pos,w) in seen: continue\r\n\u001b[?2004l\r"]
[304.93275, "o", "\u001b[?2004h> "]
[304.933022, "o", "        seen.add((pos,w))\r\n\u001b[?2004l\r"]
[304.933267, "o", "\u001b[?2004h> "]
[304.93371, "o", "        print(f\"{lid} | {v} | {g} | pos={pos} | cite={cite} | {w}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.933968, "o", ">     print()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.934199, "o", "PY\r\n\u001b[?2004l\r"]
