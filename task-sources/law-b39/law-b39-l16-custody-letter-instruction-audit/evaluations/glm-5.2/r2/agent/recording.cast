[247.329206, "i", "' in w) and not ('copy' in w)\n        elif subj=='behavioural_plan':\n            verified = ('confidence' in w) and ('stability' in w) and ('peer relations' in w) and ('set back confidence only' in w)\n        elif subj=='concern':\n            verified = ('position' in w) and ('put in' in w or 'placed in' in w) and ('appreciate' not in w) and ('violate' not in w) and ('order' not in w) and ('stays' not in w) and ('enclosed' not in w)\n        else:\n            verified=False\n        return ('VERIFIED' if verified else 'AT_ODDS', gov)\n    if subj in oi_subjects:\n        gov=oi_subjects[subj]\n        if subj=='right_of_first_refusal':\n            verified = (('Mr Adler' in w) or ('father' in w)) and ('right of first refusal' in w) and ('not to be left overnight without him present' in w) and ('Ms Corwin' not in w) and ('still permitted' not in w) and ('either parent' not in w) and ('anyone but' not in w)\n        elif subj=='children_named':\n            verified = ('Noor' in w) and ('aged seven' in w) and ('Imogen"]
