[67.794025, "i", "python3 - <<'PY'\nimport csv\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\nwith open('/tmp/letter_groups.txt','w') as out:\n    for subj in sorted(set(r['subject'] for r in rows)):\n        out.write(f'\\n===== {subj} =====\\n')\n        for r in rows:\n            if r['subject']==subj:\n                out.write(f\"{r['line_id']} | {r['cited_entry']} | {r['position']} | {r['wording']}\\n\")\nprint('/tmp/letter_groups.txt written')\nPY\n"]
