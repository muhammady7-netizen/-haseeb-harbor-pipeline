[691.561601, "i", "python3 - <<'PY'\nimport csv\nfrom collections import defaultdict\nrows=list(csv.DictReader(open('/app/letter_lines.csv', newline='')))\nrev=list(csv.DictReader(open('/app/letter_line_review.csv', newline='')))\nrev_by={r['line_id']: r for r in rev}\nfor subj in sorted(set(r['subject'] for r in rows)):\n    print(f'\\n===== {subj} =====')\n    for r in rows:\n        if r['subject']==subj:\n            g=rev_by[r['line_id']]\n            print(f\"{r['line_id']} | {r['cited_entry']} | {r['position']} | -> {g['record_entry']} | {g['verdict']}\")\nPY\n"]
