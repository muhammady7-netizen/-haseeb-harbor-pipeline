[644.503267, "o", "with open('/app/answer.md', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.503475, "o", "    f.write(answer)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[644.503713, "o", "\u001b[?2004h> "]
[644.503977, "o", "print(json.dumps(results, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.504187, "o", "> "]
[644.504485, "o", "print('CSV rows:', len(out_rows))\r\n\u001b[?2004l\r"]
[644.504717, "o", "\u001b[?2004h> print('Verdict counts:', counts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.505072, "o", "print('Clarification-governed:', clar_count)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.505382, "o", "print('Answer words:', len(answer.split()))\r\n\u001b[?2004l\r\u001b[?2004h> PY"]
[644.505515, "o", "\r\n\u001b[?2004l\r"]
[644.60823, "o", "{\r\n  \"verified_count\": 85,\r\n  \"at_odds_count\": 156,\r\n  \"not_in_record_count\": 49,\r\n  \"clarification_governed_count\": 168\r\n}\r\nCSV rows: 290\r\nVerdict counts: {'VERIFIED': 85, 'AT_ODDS': 156, 'NOT_IN_RECORD': 49}\r\nClarification-governed: 168\r\n"]
[644.608554, "o", "Answer words: 168\r\n"]
[644.614416, "o", "\u001b[?2004h\u001b[01;32mappuser@c6d930b05da0\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[644.614702, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.614913, "o", "import csv, json, os\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.615141, "o", "> "]
[644.615439, "o", "for path in ['/app/answer.md', '/app/letter_line_review.csv', '/app/results.json']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.615648, "o", "> "]
[644.615927, "o", "    assert os.path.exists(path), path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.616327, "o", "rows = list(csv.DictReader(open('/app/letter_line_review.csv', newline='')))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.61655, "o", "assert len(rows) == 290\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.616862, "o", "assert list(rows[0].keys()) == ['line_id', 'verdict', 'record_entry']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.617257, "o", "assert all(r['verdict'] in {'VERIFIED', 'AT_ODDS', 'NOT_IN_RECORD'} for r in rows)\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.617495, "o", "> "]
[644.617995, "o", "assert all(r['record_entry'] == 'NONE' or r['record_entry'].startswith('OI-') or r['record_entry'].startswith('CL-') for r in rows)\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.618311, "o", "> "]
[644.61862, "o", "csv_counts = {'VERIFIED': 0, 'AT_ODDS': 0, 'NOT_IN_RECORD': 0}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.618866, "o", "for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.619123, "o", "    csv_counts[r['verdict']] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.61938, "o", "results = json.load(open('/app/results.json'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.619526, "o", "> "]
[644.620108, "o", "assert list(results.keys()) == ['verified_count', 'at_odds_count', 'not_in_record_count', 'clarification_governed_count']\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.620328, "o", "> "]
[644.620558, "o", "assert results['verified_count'] == csv_counts['VERIFIED']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.620758, "o", "assert results['at_odds_count'] == csv_counts['AT_ODDS']\r\n\u001b[?2004l\r"]
[644.620837, "o", "\u001b[?2004h> "]
[644.621425, "o", "assert results['not_in_record_count'] == csv_counts['NOT_IN_RECORD']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.62203, "o", "assert results['clarification_governed_count'] == sum(1 for r in rows if r['record_entry'].startswith('CL-'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.622541, "o", "assert results['verified_count'] + results['at_odds_count'] + results['not_in_record_count'] == 290\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.622624, "o", "> "]
[644.622877, "o", "answer = open('/app/answer.md').read()\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.623034, "o", "> "]
[644.623287, "o", "prefix = 'Letter lines at odds with the record:'\r\n\u001b[?2004l\r"]
[644.623527, "o", "\u001b[?2004h> assert prefix in answer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.623842, "o", "num = answer.split(prefix)[1].split()[0].rstrip('.')\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.624204, "o", "> "]
[644.624434, "o", "assert num.isdigit() and int(num) == results['at_odds_count']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.624696, "o", "assert len(answer.split()) >= 60\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.624959, "o", "print('Validation OK')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[644.663331, "o", "Validation OK\r\n"]
[644.669021, "o", "\u001b[?2004h\u001b[01;32mappuser@c6d930b05da0\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[644.669297, "o", "ls -l /app/answer.md /app/letter_line_review.csv /app/results.json\r\n\u001b[?2004l\r"]
[644.679613, "o", "-rw-r--r-- 1 appuser appuser 1041 Sep 17 14:25 /app/answer.md\r\n-rw-r--r-- 1 appuser appuser 6981 Sep 17 14:25 /app/letter_line_review.csv\r\n-rw-r--r-- 1 appuser appuser  119 Sep 17 14:25 /app/results.json\r\n"]
[644.680079, "o", "\u001b[?2004h\u001b[01;32mappuser@c6d930b05da0\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
