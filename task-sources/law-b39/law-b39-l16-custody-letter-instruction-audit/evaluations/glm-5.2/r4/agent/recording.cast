[423.177261, "i", "python3 - <<'PY'\nimport csv, json, re\n\nrows = list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\n\nclar_subjects = {\n    'addressee': 'CL-301',\n    'request': 'CL-302',\n    'enclosure': 'CL-303',\n    'salutation': 'CL-304',\n    'copies': 'CL-305',\n    'delivery': 'CL-306',\n    'tone': 'CL-307',\n    'behavioural_plan': 'CL-308',\n    'concern': 'CL-309',\n}\norig_subjects = {\n    'right_of_first_refusal': 'OI-202',\n    'children_named': 'OI-203',\n    'overnight_stays': 'OI-204',\n    'inconsistent_accounts': 'OI-205',\n    'sender_signature': 'OI-211',\n}\n\ndef w(row):\n    return row['wording'].lower()\n\ndef p(row):\n    return row['position'].lower()\n\ndef verified(row):\n    s = row['subject']\n    text = w(row)\n    pos = p(row)\n\n    if s == 'addressee':\n        mother_terms = ['mother', 'catherine', 'ms corwin']\n        father_terms = ['father', 'adam', 'mr adler']\n        is_mother = any(t in text for t in mother_terms)\n        is_father = any(t in text for t in father_terms)\n        return is_mother"]
[423.177993, "i", " and not (is_father and not is_mother)\n\n    if s == 'right_of_first_refusal':\n        if 'permitted' in text or 'mother' in text or 'ms corwin' in text:\n            return False\n        return ('mr adler agreed' in text or 'father agreed' in text) and 'without him present' in text\n\n    if s == 'children_named':\n        return all(k in text for k in ['noor', 'imogen', 'seven', 'twelve'])\n\n    if s == 'overnight_stays':\n        return all(k in text for k in ['several occasions', 'both children', 'home', 'sitter', 'away'])\n\n    if s == 'inconsistent_accounts':\n        return all(k in text for k in ['wife', 'school', 'clinicians', 'sitter', 'partner', 'neighbours'])\n\n    if s == 'concern':\n        if 'no concern' in pos or 'no concern' in text or 'violation' in pos or 'violate' in text or 'appreciate' in text or 'appreciate' in pos or 'wording' in pos or 'both limbs' in pos:\n            return False\n        if 'position' in pos:\n            return True\n        if 'position' in text and 'violate' not in text and '"]
