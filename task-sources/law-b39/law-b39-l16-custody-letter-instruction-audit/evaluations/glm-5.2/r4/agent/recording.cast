[214.786539, "o", "\u001b[?2004h\u001b[01;32mappuser@c6d930b05da0\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[326.671061, "i", "python3 - <<'PY'\nimport csv, json, os, re\n\nrows = list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\n\nclar_subjects = {\n    'addressee': 'CL-301',\n    'request': 'CL-302',\n    'enclosure': 'CL-303',\n    'salutation': 'CL-304',\n    'copies': 'CL-305',\n    'delivery': 'CL-306',\n    'tone': 'CL-307',\n    'behavioural_plan': 'CL-308',\n    'concern': 'CL-309',\n}\norig_subjects = {\n    'right_of_first_refusal': 'OI-202',\n    'children_named': 'OI-203',\n    'overnight_stays': 'OI-204',\n    'inconsistent_accounts': 'OI-205',\n    'sender_signature': 'OI-211',\n}\n\ndef wl(row):\n    return row['wording'].lower()\n\ndef pos(row):\n    return row['position'].lower()\n\ndef verified(row):\n    s = row['subject']\n    w = wl(row)\n    p = pos(row)\n\n    if s == 'addressee':\n        mother_terms = ['mother', 'catherine', 'ms corwin']\n        father_terms = ['father', 'adam', 'mr adler']\n        is_mother = any(t in w for t in mother_terms)\n        is_father = any(t in w for t in father_terms)\n        return is_mother "]
[326.672313, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import csv, json, os, re\r\n\u001b[?2004l\r"]
[326.672576, "i", "and not (is_father and not any(t in w for t in mother_terms))\n\n    if s == 'right_of_first_refusal':\n        if 'permitted' in w or 'mother' in w or 'ms corwin' in w:\n            return False\n        if ('mr adler agreed' in w or 'father agreed' in w) and 'without him present' in w:\n            return True\n        return False\n\n    if s == 'children_named':\n        return all(k in w for k in ['noor', 'imogen', 'seven', 'twelve'])\n\n    if s == 'overnight_stays':\n        return all(k in w for k in ['several occasions', 'both children', 'home', 'sitter', 'away'])\n\n    if s == 'inconsistent_accounts':\n        return all(k in w for k in ['wife', 'school', 'clinicians', 'sitter', 'partner', 'neighbours'])\n\n    if s == 'concern':\n        if 'no concern' in p or 'no concern' in w or 'violation' in p or 'violate' in w or 'appreciate' in w or 'appreciate' in p or 'wording' in p or 'both limbs' in p:\n            return False\n        if 'position' in p:\n            return True\n        if 'position' in w and 'violate' not"]
[326.672831, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[326.672922, "i", " in w and 'appreciate' not in w and 'no concern' not in w:\n            return True\n        return False\n\n    if s == 'behavioural_plan':\n        return 'peer relations' in w and 'confidence only' in w and 'stability' in w\n\n    if s == 'request':\n        if 'meeting' in w or 'post' in w or 'even if' in w or 'ms corwin is present' in w or 'parent or legal guardian' in w:\n            return False\n        if ('neither child' in w or 'no child' in w) and 'overnight' in w and 'unless' in w and ('father' in w or 'mr adler' in w):\n            return True\n        return False\n\n    if s == 'enclosure':\n        return 'certified' in w and 'custodial plan' in w and 'enclosed' in w\n\n    if s == 'salutation':\n        return 'dear counsel' in w\n\n    if s == 'copies':\n        return any(k in w for k in ['nobody', 'no copy line', 'do not copy anyone', 'no one is copied'])\n\n    if s == 'delivery':\n        return ('post' in w or 'posted' in w) and 'counsel' in w and 'email' not in w and 'courier' not in w and 'hand' not in w\n\n "]
[326.672963, "i", "   if s == 'tone':\n        return 'firm' in w and 'formal' in w and 'brief' in w and 'soft' not in w and 'detailed' not in w and 'at length' not in w and 'direct' not in w and 'long-winded' not in w\n\n    if s == 'sender_signature':\n        return 'delphine marr' in w and 'for delphine marr' not in w and 'solicitor' not in w\n\n    return False\n\ndef governing_entry(row):\n    s = row['subject']\n    return clar_subjects.get(s) or orig_subjects.get(s) or 'NONE'\n\nout_rows = []\ncounts = {'VERIFIED': 0, 'AT_ODDS': 0, 'NOT_IN_RECORD': 0}\nclar_count = 0\nsubject_stats = {}\n\nfor r in rows:\n    e = governing_entry(r)\n    if e == 'NONE':\n        v = 'NOT_IN_RECORD'\n    elif verified(r):\n        v = 'VERIFIED'\n    else:\n        v = 'AT_ODDS'\n    if e.startswith('CL-'):\n        clar_count += 1\n    counts[v] += 1\n    out_rows.append({'line_id': r['line_id'], 'verdict': v, 'record_entry': e})\n    s = r['subject']\n    subject_stats.setdefault(s, {'VERIFIED':0,'AT_ODDS':0,'NOT_IN_RECORD':0,'governing':e})\n    subject_stats[s][v] "]
[326.673399, "i", "+= 1\n\nwith open('/app/letter_line_review.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['line_id','verdict','record_entry'])\n    writer.writeheader()\n    writer.writerows(out_rows)\n\nresults = {\n    'verified_count': counts['VERIFIED'],\n    'at_odds_count': counts['AT_ODDS'],\n    'not_in_record_count': counts['NOT_IN_RECORD'],\n    'clarification_governed_count': clar_count,\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\\\n')\n\nanswer = f\"\"\"# Review of the draft letter lines\n\nI weighed every numbered line in `input/letter_lines.csv` against the client's two recorded messages, using `input/review_protocol.md`. Where the clarification speaks to a subject, it governs under RP-401 and RP-402; where only the original instruction speaks to a subject, that original entry governs under RP-403; where neither record speaks to a subject, the line is not in the record at all under RP-404. Each line was then compared with its governing entry under RP-405"]
[326.673667, "o", "rows = list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ri"]
[326.673772, "i", ".\n\nThe review shows that some lines are verified by the record, some are at odds with the record, and some are not in the record at all. The governing entry is named for every line in `letter_line_review.csv`, and the four totals appear in `results.json`. Letter lines at odds with the record: {counts['AT_ODDS']}. This count reflects the lines whose governing entry takes a position other than the line's, whether the line reverses the record, states something narrower, names a different person, or otherwise fails to match the entry that governs it.\n\"\"\"\nwith open('/app/answer.md', 'w') as f:\n    f.write(answer)\n\nprint(json.dumps(results, indent=2))\nprint('CSV rows:', len(out_rows))\nprint('Verdict counts:', counts)\nprint('Clarification-governed:', clar_count)\nprint('Word count in answer.md:', len(answer.split()))\nprint('--- per-subject summary ---')\nfor s in sorted(subject_stats):\n    st = subject_stats[s]\n    print(f\"{s}: {st['VERIFIED']} V / {st['AT_ODDS']} A / {st['NOT_IN_RECORD']} N | {st['governing']}\")\nPY\nl"]
