[644.420705, "i", "python3 - <<'PY'\nimport csv, json\n\nrows = list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\n\nclar_subjects = {\n    'addressee': 'CL-301',\n    'request': 'CL-302',\n    'enclosure': 'CL-303',\n    'salutation': 'CL-304',\n    'copies': 'CL-305',\n    'delivery': 'CL-306',\n    'tone': 'CL-307',\n    'behavioural_plan': 'CL-308',\n    'concern': 'CL-309',\n}\norig_subjects = {\n    'right_of_first_refusal': 'OI-202',\n    'children_named': 'OI-203',\n    'overnight_stays': 'OI-204',\n    'inconsistent_accounts': 'OI-205',\n    'sender_signature': 'OI-211',\n}\n\ndef text(row):\n    return row['wording'].lower()\n\ndef pos(row):\n    return row['position'].lower()\n\ndef verified(row):\n    s = row['subject']\n    w = text(row)\n    p = pos(row)\n\n    if s == 'addressee':\n        return any(t in w for t in ['mother', 'catherine', 'ms corwin'])\n\n    if s == 'right_of_first_refusal':\n        if 'permitted' in w or 'mother' in w or 'ms corwin' in w:\n            return False\n        return ('mr adler agreed' in w or 'fathe"]
[644.423409, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.424241, "i", "r agreed' in w) and 'without him present' in w\n\n    if s == 'children_named':\n        return all(k in w for k in ['noor', 'imogen', 'seven', 'twelve'])\n\n    if s == 'overnight_stays':\n        return all(k in w for k in ['several occasions', 'both children', 'home', 'sitter', 'away'])\n\n    if s == 'inconsistent_accounts':\n        return all(k in w for k in ['wife', 'school', 'clinicians', 'sitter', 'partner', 'neighbours'])\n\n    if s == 'concern':\n        if 'no concern' in p or 'no concern' in w or 'violation' in p or 'violate' in w or 'appreciate' in w or 'appreciate' in p or 'wording' in p or 'both limbs' in p:\n            return False\n        if 'position' in p:\n            return True\n        if 'position' in w and 'violate' not in w and 'appreciate' not in w and 'no concern' not in w:\n            return True\n        return False\n\n    if s == 'behavioural_plan':\n        return 'peer relations' in w and 'confidence only' in w and 'stability' in w\n\n    if s == 'request':\n        if 'meeting' in w or 'post' "]
[644.424583, "o", "import csv, json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> rows = list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> clar_subjects = {\r\n\u001b[?2004l\r\u001b[?2004h>     'addressee': 'CL-301',\r\n"]
[644.424889, "i", "in w or 'even if' in w or 'ms corwin is present' in w or 'parent or legal guardian' in w:\n            return False\n        return ('neither child' in w or 'no child' in w) and 'overnight' in w and 'unless' in w and ('father' in w or 'mr adler' in w)\n\n    if s == 'enclosure':\n        return 'certified' in w and 'uncertified' not in w and 'custodial plan' in w and 'enclosed' in w\n\n    if s == 'salutation':\n        return 'dear counsel' in w\n\n    if s == 'copies':\n        return any(k in w for k in ['nobody', 'no copy line', 'do not copy anyone', 'no one is copied'])\n\n    if s == 'delivery':\n        return ('post' in w or 'posted' in w) and 'counsel' in w and 'email' not in w and 'courier' not in w and 'hand' not in w\n\n    if s == 'tone':\n        soft_bad = 'soft' in w and 'not soft' not in w\n        long_bad = 'long-winded' in w and 'not long-winded' not in w\n        return 'firm' in w and 'formal' in w and 'brief' in w and not soft_bad and not long_bad and 'detailed' not in w and 'at length' not in w and 'dire"]
[644.425064, "o", "\u001b[?2004l\r\u001b[?2004h>     'request': 'CL-302',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.425378, "i", "ct' not in w\n\n    if s == 'sender_signature':\n        return 'delphine marr' in w and 'for delphine marr' not in w and 'solicitor' not in w\n\n    return False\n\ndef governing_entry(row):\n    return clar_subjects.get(row['subject']) or orig_subjects.get(row['subject']) or 'NONE'\n\nout_rows = []\ncounts = {'VERIFIED': 0, 'AT_ODDS': 0, 'NOT_IN_RECORD': 0}\nclar_count = 0\n\nfor r in rows:\n    e = governing_entry(r)\n    if e == 'NONE':\n        v = 'NOT_IN_RECORD'\n    elif verified(r):\n        v = 'VERIFIED'\n    else:\n        v = 'AT_ODDS'\n    if e.startswith('CL-'):\n        clar_count += 1\n    counts[v] += 1\n    out_rows.append({'line_id': r['line_id'], 'verdict': v, 'record_entry': e})\n\nwith open('/app/letter_line_review.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['line_id', 'verdict', 'record_entry'])\n    writer.writeheader()\n    writer.writerows(out_rows)\n\nresults = {\n    'verified_count': counts['VERIFIED'],\n    'at_odds_count': counts['AT_ODDS'],\n    'not_in_record_count': counts['NOT_IN"]
[644.425703, "o", "    'enclosure': 'CL-303',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.425987, "i", "_RECORD'],\n    'clarification_governed_count': clar_count,\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write(chr(10))\n\nanswer = f\"\"\"# Review of the draft letter lines\n\nI weighed every numbered line in `input/letter_lines.csv` against the client's record, using `input/review_protocol.md`. Where the clarification speaks to a subject, it governs under RP-401 and RP-402; where only the original instruction speaks to a subject, that original entry governs under RP-403; where neither record speaks to a subject, the line is not in the record at all under RP-404. Each line was then compared with its governing entry under RP-405.\n\nThe review shows that some lines are verified by the record, some are at odds with the record, and some are not in the record at all. The governing entry is named for every line in `letter_line_review.csv`, and the four totals appear in `results.json`. Letter lines at odds with the record: {counts['AT_ODDS']}. This count reflects the lines whose gove"]
[644.42627, "o", "    'salutation': 'CL-304',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.42652, "i", "rning entry takes a position other than the line's, whether the line reverses the client's record, states something narrower, names a different person, or otherwise fails to match the entry that governs it.\n\"\"\"\nwith open('/app/answer.md', 'w') as f:\n    f.write(answer)\n\nprint(json.dumps(results, indent=2))\nprint('CSV rows:', len(out_rows))\nprint('Verdict counts:', counts)\nprint('Clarification-governed:', clar_count)\nprint('Answer words:', len(answer.split()))\nPY\npython3 - <<'PY'\nimport csv, json, os\nfor path in ['/app/answer.md', '/app/letter_line_review.csv', '/app/results.json']:\n    assert os.path.exists(path), path\nrows = list(csv.DictReader(open('/app/letter_line_review.csv', newline='')))\nassert len(rows) == 290\nassert list(rows[0].keys()) == ['line_id', 'verdict', 'record_entry']\nassert all(r['verdict'] in {'VERIFIED', 'AT_ODDS', 'NOT_IN_RECORD'} for r in rows)\nassert all(r['record_entry'] == 'NONE' or r['record_entry'].startswith('OI-') or r['record_entry'].startswith('CL-') for r in rows)\ncsv_counts "]
[644.426763, "o", "    'copies': 'CL-305',"]
[644.426999, "i", "= {'VERIFIED': 0, 'AT_ODDS': 0, 'NOT_IN_RECORD': 0}\nfor r in rows:\n    csv_counts[r['verdict']] += 1\nresults = json.load(open('/app/results.json'))\nassert list(results.keys()) == ['verified_count', 'at_odds_count', 'not_in_record_count', 'clarification_governed_count']\nassert results['verified_count'] == csv_counts['VERIFIED']\nassert results['at_odds_count'] == csv_counts['AT_ODDS']\nassert results['not_in_record_count'] == csv_counts['NOT_IN_RECORD']\nassert results['clarification_governed_count'] == sum(1 for r in rows if r['record_entry'].startswith('CL-'))\nassert results['verified_count'] + results['at_odds_count'] + results['not_in_record_count'] == 290\nanswer = open('/app/answer.md').read()\nprefix = 'Letter lines at odds with the record:'\nassert prefix in answer\nnum = answer.split(prefix)[1].split()[0].rstrip('.')\nassert num.isdigit() and int(num) == results['at_odds_count']\nassert len(answer.split()) >= 60\nprint('Validation OK')\nPY\nls -l /app/answer.md /app/letter_line_review.csv /app/results.json\n"]
