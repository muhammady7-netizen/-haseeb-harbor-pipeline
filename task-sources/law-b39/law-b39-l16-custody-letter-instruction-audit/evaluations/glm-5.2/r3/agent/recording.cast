[429.675591, "o", "\u001b[?2004h> "]
[429.675964, "o", "        'neither child overnight unless father present',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.676248, "o", "        'CL match',\r\n\u001b[?2004l\r\u001b[?2004h>         'CL wording exact',\r\n\u001b[?2004l\r"]
[429.676466, "o", "\u001b[?2004h> "]
[429.676817, "o", "        'CL wording paraphrase',\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.677142, "o", "    'enclosure': {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.677288, "o", "        'a certified copy of the custodial plan',\r\n\u001b[?2004l\r\u001b[?2004h"]
[429.677495, "o", ">         'certified',\r\n\u001b[?2004l\r"]
[429.677773, "o", "\u001b[?2004h>         'certified copy',\r\n\u001b[?2004l\r"]
[429.678044, "o", "\u001b[?2004h> "]
[429.67829, "o", "        'certified copy enclosed',\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[429.678495, "o", "\u001b[?2004h> "]
[429.678756, "o", "    'tone': {'firm formal brief'},\r\n\u001b[?2004l\r"]
[429.679033, "o", "\u001b[?2004h> "]
[429.679678, "o", "    'sender_signature': {\"the sender's own name\", 'own name', 'full name'},\r\n\u001b[?2004l\r\u001b[?2004h> "]
