[544.604101, "i", "python3 - <<'PY'\nimport csv\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nfor s in ['addressee','request','tone','behavioural_plan','concern','interim_contact','without_prejudice','right_of_first_refusal','children_named','overnight_stays','inconsistent_accounts','sender_signature','enclosure','salutation','copies','delivery']:\n    print('\\n###',s)\n    for r in rows:\n        if r['subject']==s:\n            print(f\"{r['line_id']}|{r['position']}|{r['cited_entry']}|{r['wording']}\")\nPY\n"]
