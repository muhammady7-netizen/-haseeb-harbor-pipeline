[1168.349529, "i", "python3 - > /tmp/grouped_verdicts.txt <<'PY'\nimport csv\nfrom collections import defaultdict\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nrev={r['line_id']:(r['verdict'],r['record_entry']) for r in csv.DictReader(open('/app/letter_line_review.csv'))}\nby=defaultdict(list)\nfor r in rows: by[r['subject']].append(r)\nfor s in sorted(by):\n    print(f'### {s}')\n    pos_map=defaultdict(list)\n    for r in by[s]:\n        v,ge=rev[r['line_id']]\n        pos_map[(r['position'],v,ge)].append(r['line_id'])\n    for (pos,v,ge),ids in sorted(pos_map.items()):\n        print(f'{v:12s} {ge:6s} {pos:42s} {\", \".join(ids)}')\n    print()\nPY\nwc -l /tmp/grouped_verdicts.txt\nsed -n '1,80p' /tmp/grouped_verdicts.txt\n"]
