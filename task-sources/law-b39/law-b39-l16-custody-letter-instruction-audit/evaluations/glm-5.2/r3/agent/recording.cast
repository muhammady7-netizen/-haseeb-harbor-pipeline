[48.959694, "i", "python3 - <<'PY' > /tmp/line_summary.txt\nimport csv\nfrom collections import defaultdict\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\nby_subject=defaultdict(list)\nfor r in rows:\n    by_subject[r['subject']].append(r)\nfor s in sorted(by_subject):\n    print(f'## {s} ({len(by_subject[s])})')\n    seen=set()\n    for r in by_subject[s]:\n        key=(r['position'], r['cited_entry'])\n        if key in seen: continue\n        seen.add(key)\n        ids=','.join(x['line_id'] for x in by_subject[s] if (x['position'],x['cited_entry'])==key)\n        print(f\"{ids}\\tpos={r['position']}\\tcited={r['cited_entry']}\\t{r['wording']}\")\n    print()\nPY\n"]
