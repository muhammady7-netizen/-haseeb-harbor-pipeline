[728.002879, "o", "\u001b[?2004h\u001b[01;32mappuser@0bc9f97c24c8\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[754.026284, "i", "python3 - <<'PY'\nimport csv, json\nfrom collections import defaultdict, Counter\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nrev=list(csv.DictReader(open('/app/letter_line_review.csv')))\nrevmap={r['line_id']:(r['verdict'],r['record_entry']) for r in rev}\nby=defaultdict(list)\nfor r in rows:\n    by[r['subject']].append(r)\nprint('Verdict counts by subject:')\nfor s in sorted(by):\n    c=Counter(revmap[r['line_id']][0] for r in by[s])\n    print(f'{s:22s} {dict(c)}')\nprint('\\nDetailed for addressee/request/tone/concern/behavioural_plan/interim_contact/without_prejudice:')\nfor s in ['addressee','request','tone','concern','behavioural_plan','interim_contact','without_prejudice']:\n    print('\\n###',s)\n    for r in by[s]:\n        v,ge=revmap[r['line_id']]\n        print(f\"{r['line_id']}|{v}|{ge}|{r['position']}|{r['cited_entry']}|{r['wording'][:70]}\")\nPY\n"]
[754.026746, "o", "python3 - <<'PY'\r\n"]
