[1518.932883, "i", "cat > /tmp/review.py <<'PY'\nimport csv, json, re\n\noriginal = {\n    'addressee': 'OI-201',\n    'right_of_first_refusal': 'OI-202',\n    'children_named': 'OI-203',\n    'overnight_stays': 'OI-204',\n    'inconsistent_accounts': 'OI-205',\n    'concern': 'OI-206',\n    'behavioural_plan': 'OI-207',\n    'request': 'OI-208',\n    'enclosure': 'OI-209',\n    'tone': 'OI-210',\n    'sender_signature': 'OI-211',\n}\n\nclarification = {\n    'addressee': 'CL-301',\n    'request': 'CL-302',\n    'enclosure': 'CL-303',\n    'salutation': 'CL-304',\n    'copies': 'CL-305',\n    'delivery': 'CL-306',\n    'tone': 'CL-307',\n    'behavioural_plan': 'CL-308',\n    'concern': 'CL-309',\n    'interim_contact': 'CL-310',\n    'without_prejudice': 'CL-311',\n}\n\ncl_subjects = {v: k for k, v in clarification.items()}\n\ndef governing_entry(subject, cited_entry):\n    # RP-407: a cross-subject CL citation sends governing back to the original entry for the line's own subject.\n    if cited_entry in cl_subjects and cl_subjects[cited_entry] != subject and sub"]
[1518.934256, "i", "ject in original:\n        return original[subject]\n    # RP-401 / RP-403.\n    if subject in clarification:\n        return clarification[subject]\n    if subject in original:\n        return original[subject]\n    return 'NONE'\n\ndef addressee_father_ok(w):\n    return (('father' in w or 'mr adler' in w or 'adam' in w) and\n            ('attorney' in w or 'counsel' in w) and\n            not ('mother' in w or 'ms corwin' in w or 'catherine' in w))\n\ndef addressee_mother_ok(w):\n    return (('mother' in w or 'ms corwin' in w or 'catherine' in w) and\n            ('attorney' in w or 'counsel' in w) and\n            not ('father' in w or 'mr adler' in w or 'adam' in w))\n\ndef rofr_ok(w):\n    return (('agreed' in w or 'agreement' in w) and\n            ('mr adler' in w or 'father' in w) and\n            ('overnight' in w or 'not to be left' in w) and\n            ('without him' in w or 'without mr adler' in w or 'without the father' in w) and\n            'mother' not in w and 'ms corwin' not in w and 'her present' not in w and\n "]
