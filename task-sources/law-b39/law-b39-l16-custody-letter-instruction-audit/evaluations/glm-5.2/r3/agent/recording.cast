[429.654773, "i", "python3 - <<'PY'\nimport csv, json\nfrom pathlib import Path\n\nrows = list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\n\ngov = {\n    'addressee': 'CL-301',\n    'right_of_first_refusal': 'OI-202',\n    'children_named': 'OI-203',\n    'overnight_stays': 'OI-204',\n    'inconsistent_accounts': 'OI-205',\n    'concern': 'CL-309',\n    'behavioural_plan': 'CL-308',\n    'request': 'CL-302',\n    'enclosure': 'CL-303',\n    'tone': 'CL-307',\n    'sender_signature': 'OI-211',\n    'salutation': 'CL-304',\n    'copies': 'CL-305',\n    'delivery': 'CL-306',\n}\n\nverified = {\n    'addressee': {\"mother's attorney\", 'mother'},\n    'right_of_first_refusal': {'agreed by the father', 'father agreed', 'full'},\n    'children_named': {'both children, with their ages', 'both children with ages', 'both with ages'},\n    'overnight_stays': {'several occasions at her home or with a sitter', 'full', 'home or sitter both'},\n    'inconsistent_accounts': {'all four', 'all four audiences'},\n    'concern': {'narrower concern only po"]
[429.655113, "i", "sition', 'position limb only', 'position only'},\n    'behavioural_plan': {'confidence stability peer confidence-only', 'full CL match'},\n    'request': {\n        'no overnight stays in her care unless the father is present',\n        'no overnight stays unless father present',\n        'no overnight unless father present',\n        'neither child overnight unless father present',\n        'CL match',\n        'CL wording exact',\n        'CL wording paraphrase',\n    },\n    'enclosure': {\n        'a certified copy of the custodial plan',\n        'certified',\n        'certified copy',\n        'certified copy enclosed',\n    },\n    'tone': {'firm formal brief'},\n    'sender_signature': {\"the sender's own name\", 'own name', 'full name'},\n    'salutation': {'Dear Counsel'},\n    'copies': {'copy nobody', 'nobody'},\n    'delivery': {'by post', 'post'},\n}\n\nout_rows = []\ncounts = {'VERIFIED': 0, 'AT_ODDS': 0, 'NOT_IN_RECORD': 0}\nclarification_governed_count = 0\n\nfor r in rows:\n    subject = r['subject']\n    if subject not in"]
[429.655426, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[429.655635, "i", " gov:\n        verdict = 'NOT_IN_RECORD'\n        entry = 'NONE'\n    else:\n        entry = gov[subject]\n        verdict = 'VERIFIED' if r['position'] in verified[subject] else 'AT_ODDS'\n        if entry.startswith('CL-'):\n            clarification_governed_count += 1\n    counts[verdict] += 1\n    out_rows.append({'line_id': r['line_id'], 'verdict': verdict, 'record_entry': entry})\n\nwith open('/app/letter_line_review.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['line_id', 'verdict', 'record_entry'])\n    writer.writeheader()\n    writer.writerows(out_rows)\n\nresults = {\n    'verified_count': counts['VERIFIED'],\n    'at_odds_count': counts['AT_ODDS'],\n    'not_in_record_count': counts['NOT_IN_RECORD'],\n    'clarification_governed_count': clarification_governed_count,\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\n')\n\nanswer = \"\"\"# Review of the draft letter lines\n\nThe draft was weighed line by line against the client's two messages, using the "]
[429.655946, "o", "\u001b[?2004h> import csv, json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.656324, "i", "review protocol so that the clarification prevails on every subject it speaks to and the original instruction governs only where the clarification leaves the subject alone. Letter lines at odds with the record: 156. Where the clarification spoke, its entry governed no matter what the draft cited; where neither record spoke to a subject, the line was not in the record at all and nothing governed it. The table records each line's verdict and the governing entry, and the totals report how many lines were verified, how many were at odds, how many were not in the record, and how many were governed by the clarification rather than the original instruction.\n\"\"\"\nPath('/app/answer.md').write_text(answer)\n\nprint('Wrote deliverables.')\nprint(json.dumps(results, indent=2))\nprint('csv_rows', len(out_rows))\nPY\n"]
