[491.002615, "i", "python3 - <<'PY'\nimport csv, json\nfrom pathlib import Path\n\n# Re-read current CSV and rewrite with Unix line endings.\nwith open('/app/letter_line_review.csv', newline='') as f:\n    rows = list(csv.DictReader(f))\n\nwith open('/app/letter_line_review.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['line_id', 'verdict', 'record_entry'], lineterminator='\\n')\n    writer.writeheader()\n    writer.writerows(rows)\n\n# Validate counts against results.json.\nwith open('/app/results.json') as f:\n    results = json.load(f)\n\nfrom collections import Counter\nc = Counter(r['verdict'] for r in rows)\nclar = sum(1 for r in rows if r['record_entry'].startswith('CL-'))\n\nprint('csv_data_rows', len(rows))\nprint('verified_count', c['VERIFIED'])\nprint('at_odds_count', c['AT_ODDS'])\nprint('not_in_record_count', c['NOT_IN_RECORD'])\nprint('clarification_governed_count', clar)\nprint('results_json', results)\nassert c['VERIFIED'] == results['verified_count']\nassert c['AT_ODDS'] == results['at_odds_count']\nassert c['NOT_"]
[491.002922, "i", "IN_RECORD'] == results['not_in_record_count']\nassert clar == results['clarification_governed_count']\nPY\n"]
