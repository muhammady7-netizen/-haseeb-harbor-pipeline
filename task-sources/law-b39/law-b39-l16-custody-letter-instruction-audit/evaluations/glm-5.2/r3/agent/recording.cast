[301.312802, "i", "-only','full CL match'},\n'request': {'no overnight stays in her care unless the father is present','no overnight stays unless father present','no overnight unless father present','neither child overnight unless father present','CL match','CL wording exact','CL wording paraphrase'},\n'enclosure': {'a certified copy of the custodial plan','certified','certified copy','certified copy enclosed'},\n'tone': {'firm formal brief'},\n'sender_signature': {\"the sender's own name\",'own name','full name'},\n'salutation': {'Dear Counsel'},\n'copies': {'copy nobody','nobody'},\n'delivery': {'by post','post'},\n}\n\ncounts=defaultdict(int)\nby_sub=defaultdict(lambda: defaultdict(int))\nfor r in rows:\n    s=r['subject']\n    if s not in gov:\n        verdict='NOT_IN_RECORD'; entry='NONE'\n    else:\n        entry=gov[s]\n        verdict='VERIFIED' if r['position'] in verified[s] else 'AT_ODDS'\n    counts[verdict]+=1\n    by_sub[s][verdict]+=1\nprint('counts', dict(counts))\nprint('clar_gov', sum(1 for r in rows if gov.get(r['subject'],'').start"]
