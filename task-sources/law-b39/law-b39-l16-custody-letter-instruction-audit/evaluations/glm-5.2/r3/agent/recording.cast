[1055.883833, "o", "rows = list(csv.DictReader(open('/app/input/letter_lines.csv')))\r\n\u001b[?2004l\r\u001b[?2004h> out_rows = []\r\n\u001b[?2004l\r\u001b[?2004h> verdicts = {}\r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     ge = governing_entry(r['subject'], r['cited_entry'])\r\n\u001b[?2004l\r\u001b[?2004h>     if ge == 'NONE':\r\n\u001b[?2004l\r\u001b[?2004h>         verdict = 'NOT_IN_RECORD'\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1055.884715, "o", "        verdict = 'VERIFIED' if verify(ge, r) else 'AT_ODDS'\r\n\u001b[?2004l\r"]
[1055.885281, "o", "\u001b[?2004h> "]
[1055.88706, "o", "    out_rows.append({'line_id': r['line_id'], 'verdict': verdict, 'record_entry': ge})\r\n\u001b[?2004l\r"]
[1055.888433, "o", "\u001b[?2004h> "]
[1055.889596, "o", "    verdicts[r['line_id']] = (verdict, ge)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1055.890805, "o", "with open('/app/letter_line_review.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1055.891089, "o", "> "]
[1055.892627, "o", "    writer = csv.DictWriter(f, fieldnames=['line_id', 'verdict', 'record_entry'])\r\n\u001b[?2004l\r"]
[1055.892925, "o", "\u001b[?2004h> "]
[1055.893194, "o", "    writer.writeheader()\r\n\u001b[?2004l\r"]
[1055.893599, "o", "\u001b[?2004h> "]
[1055.893797, "o", "    writer.writerows(out_rows)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1055.894079, "o", "\u001b[?2004h> "]
[1055.894708, "o", "verified_count = sum(1 for v, _ in verdicts.values() if v == 'VERIFIED')\r\n\u001b[?2004l\r"]
[1055.894863, "o", "\u001b[?2004h> "]
[1055.89546, "o", "at_odds_count = sum(1 for v, _ in verdicts.values() if v == 'AT_ODDS')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1055.895729, "o", "> "]
