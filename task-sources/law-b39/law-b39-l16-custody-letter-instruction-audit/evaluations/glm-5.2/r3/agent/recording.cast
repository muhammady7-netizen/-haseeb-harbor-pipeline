[169.716218, "i", "python3 - <<'PY'\nimport csv\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\nwant = {\n('concern','narrower concern only position'),\n('concern','position limb only'),\n('concern','position only'),\n('concern','violation only'),\n('request','CL wording paraphrase'),\n('request','CL match'),\n('request','CL wording exact'),\n('right_of_first_refusal','father agreed'),\n('right_of_first_refusal','full'),\n('right_of_first_refusal','agreed by the father'),\n('overnight_stays','home or sitter both'),\n('overnight_stays','full'),\n('behavioural_plan','confidence stability peer confidence-only'),\n('behavioural_plan','full CL match'),\n('tone','firm formal brief'),\n('delivery','by post'),\n('delivery','post'),\n('addressee','mother'),\n('addressee','father'),\n}\nfor r in rows:\n    key=(r['subject'], r['position'])\n    if key in want:\n        print(f\"{r['line_id']}\\t{r['subject']}\\t{r['position']}\\t{r['cited_entry']}\\t{r['wording']}\")\nPY\n"]
