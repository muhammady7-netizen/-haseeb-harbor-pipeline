[126.326183, "i", "python3 - <<'PY'\nimport csv\nfrom collections import defaultdict\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nby=defaultdict(list)\nfor r in rows: by[r['subject']].append(r)\nfor s in sorted(by):\n    print('\\n###',s)\n    seen={}\n    for r in by[s]:\n        seen.setdefault(r['position'], (r['cited_entry'], r['wording']))\n    for pos,(ce,w) in sorted(seen.items()):\n        print(f\"{pos} | ex {ce} | {w[:90]}\")\nPY\n"]
