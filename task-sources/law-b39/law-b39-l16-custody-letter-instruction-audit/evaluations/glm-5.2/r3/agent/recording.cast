[429.682782, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[429.683128, "o", "for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.683465, "o", "    subject = r['subject']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.683726, "o", "    if subject not in gov:\r\n\u001b[?2004l\r\u001b[?2004h"]
[429.683905, "o", "> "]
[429.68417, "o", "        verdict = 'NOT_IN_RECORD'\r\n\u001b[?2004l\r"]
[429.684391, "o", "\u001b[?2004h> "]
[429.684685, "o", "        entry = 'NONE'\r\n\u001b[?2004l\r\u001b[?2004h"]
[429.684871, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.685084, "o", "        entry = gov[subject]\r\n\u001b[?2004l\r\u001b[?2004h"]
[429.685369, "o", "> "]
[429.685772, "o", "        verdict = 'VERIFIED' if r['position'] in verified[subject] else 'AT_ODDS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.686033, "o", "        if entry.startswith('CL-'):\r\n\u001b[?2004l\r"]
[429.686333, "o", "\u001b[?2004h> "]
[429.686687, "o", "            clarification_governed_count += 1\r\n\u001b[?2004l\r"]
[429.686922, "o", "\u001b[?2004h> "]
[429.687061, "o", "    counts[verdict] += 1"]
[429.687343, "o", "\r\n\u001b[?2004l\r"]
[429.687633, "o", "\u001b[?2004h> "]
[429.688351, "o", "    out_rows.append({'line_id': r['line_id'], 'verdict': verdict, 'record_entry': entry})\r\n\u001b[?2004l\r"]
