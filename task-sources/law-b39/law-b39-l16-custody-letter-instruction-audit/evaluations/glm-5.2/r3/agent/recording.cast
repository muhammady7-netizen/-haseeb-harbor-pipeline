[1055.897161, "o", "clarification_governed_count = sum(1 for _, ge in verdicts.values() if ge.startswith('CL-'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1055.897442, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
