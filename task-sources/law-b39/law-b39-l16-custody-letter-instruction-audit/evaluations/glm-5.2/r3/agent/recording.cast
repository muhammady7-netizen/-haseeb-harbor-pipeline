[1277.770432, "i", "python3 - <<'PY'\nimport csv\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nrev={r['line_id']:(r['verdict'],r['record_entry']) for r in csv.DictReader(open('/app/letter_line_review.csv'))}\nfor s in ['request','concern','tone','addressee','right_of_first_refusal','overnight_stays','inconsistent_accounts','children_named','enclosure','salutation','copies','delivery']:\n    print('\\n###',s)\n    for r in rows:\n        if r['subject']==s:\n            v,ge=rev[r['line_id']]\n            print(f\"{r['line_id']}|{v}|{ge}|{r['position']}|{r['cited_entry']}|{r['wording']}\")\nPY\n"]
