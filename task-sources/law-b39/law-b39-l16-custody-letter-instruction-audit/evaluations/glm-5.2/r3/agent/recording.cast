[1075.256518, "i", "python3 - <<'PY' > /tmp/current_review.txt\nimport csv\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nrev={r['line_id']:(r['verdict'],r['record_entry']) for r in csv.DictReader(open('/app/letter_line_review.csv'))}\nfor r in rows:\n    v,ge=rev[r['line_id']]\n    print(f\"{r['line_id']}|{r['subject']}|{v}|{ge}|{r['position']}|{r['cited_entry']}|{r['wording'][:100]}\")\nPY\nwc -l /tmp/current_review.txt\nsed -n '1,80p' /tmp/current_review.txt\n"]
