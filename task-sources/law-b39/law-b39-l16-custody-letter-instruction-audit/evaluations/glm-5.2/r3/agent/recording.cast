[36.403461, "i", "python3 - <<'PY'\nimport csv\nfrom collections import defaultdict\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\nprint('total', len(rows))\nby_subject=defaultdict(list)\nfor r in rows:\n    by_subject[r['subject']].append(r)\nprint('subjects:', len(by_subject))\nfor s in sorted(by_subject):\n    print('\\n##', s, 'count', len(by_subject[s]))\n    seen=set()\n    for r in by_subject[s]:\n        key=(r['position'], r['cited_entry'])\n        if key not in seen:\n            seen.add(key)\n            print(f\"  {r['line_id']} pos={r['position']!r} cited={r['cited_entry']!r} :: {r['wording']!r}\")\nPY\n"]
