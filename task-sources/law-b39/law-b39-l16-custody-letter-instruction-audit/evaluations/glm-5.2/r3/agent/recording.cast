[301.275341, "i", "python3 - > /tmp/subject_details.txt <<'PY'\nimport csv\nfrom collections import defaultdict, OrderedDict\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nby=defaultdict(list)\nfor r in rows: by[r['subject']].append(r)\nfor s in sorted(by):\n    print(f'### {s} ({len(by[s])})')\n    pos_map=OrderedDict()\n    for r in by[s]:\n        pos_map.setdefault(r['position'], []).append(r)\n    for pos, rs in pos_map.items():\n        ids=', '.join(r['line_id'] for r in rs)\n        ces=', '.join(sorted(set(r['cited_entry'] for r in rs)))\n        w=rs[0]['wording']\n        print(f'POS: {pos} | IDS: {ids} | CE: {ces} | EX: {w[:120]}')\n    print()\nPY\nwc -l /tmp/subject_details.txt\nsed -n '1,80p' /tmp/subject_details.txt\n"]
