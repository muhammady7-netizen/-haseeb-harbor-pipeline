[1518.936915, "i", "    if entry == 'CL-311':\n        return without_prejudice_ok(w)\n    return False\n\nrows = list(csv.DictReader(open('/app/input/letter_lines.csv')))\nout_rows = []\nverdicts = {}\nfor r in rows:\n    ge = governing_entry(r['subject'], r['cited_entry'])\n    if ge == 'NONE':\n        verdict = 'NOT_IN_RECORD'\n    else:\n        verdict = 'VERIFIED' if verify(ge, r) else 'AT_ODDS'\n    out_rows.append({'line_id': r['line_id'], 'verdict': verdict, 'record_entry': ge})\n    verdicts[r['line_id']] = (verdict, ge)\n\nwith open('/app/letter_line_review.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['line_id', 'verdict', 'record_entry'])\n    writer.writeheader()\n    writer.writerows(out_rows)\n\nverified_count = sum(1 for v, _ in verdicts.values() if v == 'VERIFIED')\nat_odds_count = sum(1 for v, _ in verdicts.values() if v == 'AT_ODDS')\nnot_in_record_count = sum(1 for v, _ in verdicts.values() if v == 'NOT_IN_RECORD')\nclarification_governed_count = sum(1 for _, ge in verdicts.values() if ge.startswith('CL-"]
