[11.976575, "o", "or directions within 28 days.\r\nST-365,court_listing,urgent hearing,CL-303,I will seek an urgent hearing if there is no reply.\r\nST-366,expert_report,psychologist,OI-207,A psychologist's report on Imogen is available on request.\r\nST-367,expert_report,joint expert,CL-304,I propose a joint expert on the overnight arrangements.\r\nST-368,interim_contact,supervised only,OI-208,\"Pending resolution, contact with Ms Corwin should be supervised only.\"\r\nST-369,interim_contact,video calls,CL-306,Interim contact may continue by video call twice weekly.\r\nST-401,inconsistent_accounts,all four audiences,CL-303,\"Mr Adler has described Ms Corwin as his wife to the school, as the person Imogen lives with to her clinicians, as a babysitter to me, and as his partner to the neighbours.\"\r\nST-402,inconsistent_accounts,all four audiences,OI-205,\"The father has called her his wife to the school, the person the child lives with to clinicians, a sitter to me, and his partner to the neighbours.\"\r\nST-403,overnight_stays,home or sitter both,"]
