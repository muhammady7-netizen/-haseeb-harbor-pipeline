[1587.951943, "i", "python3 - <<'PY'\nimport csv, json, re, os\nfiles=['/app/answer.md','/app/letter_line_review.csv','/app/results.json']\nfor f in files:\n    print(f, os.path.exists(f), os.path.getsize(f) if os.path.exists(f) else None)\nrows=list(csv.DictReader(open('/app/letter_line_review.csv')))\nprint('csv rows', len(rows))\nprint('header', rows[0].keys() if rows else None)\nallowed={'VERIFIED','AT_ODDS','NOT_IN_RECORD'}\nprint('bad verdicts', [r for r in rows if r['verdict'] not in allowed])\ncounts={v:0 for v in allowed}\nclar=0\nfor r in rows:\n    counts[r['verdict']]+=1\n    if r['record_entry'].startswith('CL-'): clar+=1\nres=json.load(open('/app/results.json'))\nprint('json', res)\nprint('csv counts', {'verified_count':counts['VERIFIED'],'at_odds_count':counts['AT_ODDS'],'not_in_record_count':counts['NOT_IN_RECORD'],'clarification_governed_count':clar})\nprint('counts match', res=={'verified_count':counts['VERIFIED'],'at_odds_count':counts['AT_ODDS'],'not_in_record_count':counts['NOT_IN_RECORD'],'clarification_governed_count':clar}"]
