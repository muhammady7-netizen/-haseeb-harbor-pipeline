[65.944638, "i", "python3 - <<'PY' > /tmp/combos.csv\nimport csv\nfrom collections import defaultdict\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\ncombos=defaultdict(list)\nfor r in rows:\n    combos[(r['subject'], r['position'], r['cited_entry'])].append(r['line_id'])\nprint('subject,position,cited_entry,count,line_ids')\nfor (s,p,c),ids in sorted(combos.items()):\n    print(f'{s!r},{p!r},{c!r},{len(ids)},\"{\" \".join(ids)}\"')\nPY\n"]
