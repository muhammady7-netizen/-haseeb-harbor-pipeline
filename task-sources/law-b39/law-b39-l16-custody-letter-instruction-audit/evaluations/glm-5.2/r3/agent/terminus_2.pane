counts=defaultdict(int)
by_sub=defaultdict(lambda: defaultdict(int))
for r in rows:
    s=r['subject']
    if s not in gov:
        verdict='NOT_IN_RECORD'; entry='NONE'
    else:
        entry=gov[s]
        verdict='VERIFIED' if r['position'] in verified[s] else 'AT_ODDS'
    counts[verdict]+=1
    by_sub[s][verdict]+=1
print('counts', dict(counts))
print('clar_gov', sum(1 for r in rows if gov.get(r['subject'],'').startswith('CL-')))
print()
for s in sorted(by_sub):
    print(s, dict(by_sub[s]))
print()
print('Record-subject AT_ODDS positions:')
for r in rows:
    s=r['subject']
    if s in gov and r['position'] not in verified[s]:
        print(r['line_id'], s, r['position'], r['cited_entry'], '->', gov[s])
PY
