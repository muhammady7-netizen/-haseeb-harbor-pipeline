[?2004l[?2004h> import csv
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> rows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))
[?2004l[?2004h> print('total', len(rows))
[?2004l[?2004h> by_subject=defaultdict(list)
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     by_subject[r['subject']].append(r)
[?2004l[?2004h> print('subjects:', len(by_subject))
[?2004l[?2004h> for s in sorted(by_subject):
[?2004l[?2004h>     print('\n##', s, 'count', len(by_subject[s]))
[?2004l[?2004h>     seen=set()
[?2004l[?2004h>     for r in by_subject[s]:
[?2004l[?2004h>         key=(r['position'], r['cited_entry'])
[?2004l[?2004h>         if key not in seen:
[?2004l[?2004h>             seen.add(key)
[?2004l[?2004h>             print(f"  {r['line_id']} pos={r['position']!r} cited={r['cited_entry']!r} :: {r['wording']!r}")
[?2004l[?2004h> PY
