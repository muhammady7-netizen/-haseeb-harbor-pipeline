[176.648931, "i", "python3 - <<'PY'\nimport csv, collections\nrows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\ngroups=collections.defaultdict(list)\nfor r in rows:\n    groups[(r['subject'],r['position'])].append(r)\nfor (subj,pos),items in sorted(groups.items()):\n    print(f\"{subj} | {pos} | n={len(items)} | ex={items[0]['line_id']}: {items[0]['wording'][:100]}\")\nPY\n"]
