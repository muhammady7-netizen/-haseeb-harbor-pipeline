[356.864117, "i", "python3 - <<'PY'\nimport csv, json, collections\nrev = list(csv.DictReader(open('letter_line_review.csv', newline='')))\ninp = {r['line_id']: r for r in csv.DictReader(open('input/letter_lines.csv', newline=''))}\nprint('rows:', len(rev))\nprint('keys:', list(rev[0].keys()))\ncounts = collections.Counter(r['verdict'] for r in rev)\nresults = json.load(open('results.json'))\nprint('csv counts:', dict(counts))\nprint('json:', results)\nprint('counts match:', results == {\n    'verified_count': counts['VERIFIED'],\n    'at_odds_count': counts['AT_ODDS'],\n    'not_in_record_count': counts['NOT_IN_RECORD'],\n    'clarification_governed_count': sum(1 for r in rev if r['record_entry'].startswith('CL-')),\n})\nprint('--- record-governed subject/position verdicts ---')\nfor subj in ['right_of_first_refusal','children_named','overnight_stays','addressee','inconsistent_accounts','concern','behavioural_plan','request','enclosure','tone','sender_signature','salutation','copies','delivery']:\n    pos = collections.defaultdict(collections.C"]
[356.864439, "i", "ounter)\n    for r in rev:\n        if inp[r['line_id']]['subject'] == subj:\n            pos[inp[r['line_id']]['position']][r['verdict']] += 1\n    print(f'### {subj}')\n    for p,c in sorted(pos.items()):\n        print(f'{p}: {dict(c)}')\nPY\n"]
