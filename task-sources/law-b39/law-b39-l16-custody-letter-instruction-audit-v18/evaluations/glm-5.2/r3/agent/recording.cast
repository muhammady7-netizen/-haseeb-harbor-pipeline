[407.180035, "i", "python3 - <<'PY'\nimport csv\nrev = list(csv.DictReader(open('letter_line_review.csv', newline='')))\ninp = {r['line_id']: r for r in csv.DictReader(open('input/letter_lines.csv', newline=''))}\nfor subj in ['sender_signature','behavioural_plan','concern']:\n    print(f'### {subj}')\n    for r in rev:\n        if inp[r['line_id']]['subject'] == subj:\n            print(f\"{r['line_id']} | {r['verdict']} | {r['record_entry']} | {inp[r['line_id']]['position']} | {inp[r['line_id']]['wording']}\")\nPY\n"]
