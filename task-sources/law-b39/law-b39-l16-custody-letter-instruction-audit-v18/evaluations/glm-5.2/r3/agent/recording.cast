[406.190568, "i", "python3 - <<'PY'\nimport csv, json, collections\nrev = list(csv.DictReader(open('letter_line_review.csv', newline='')))\ninp = {r['line_id']: r for r in csv.DictReader(open('input/letter_lines.csv', newline=''))}\nprint('rows:', len(rev))\nprint('header:', list(rev[0].keys()))\ncounts = collections.Counter(r['verdict'] for r in rev)\nresults = json.load(open('results.json'))\nexpected = {\n    'verified_count': counts['VERIFIED'],\n    'at_odds_count': counts['AT_ODDS'],\n    'not_in_record_count': counts['NOT_IN_RECORD'],\n    'clarification_governed_count': sum(1 for r in rev if r['record_entry'].startswith('CL-')),\n}\nprint('csv counts:', dict(counts))\nprint('json:', results)\nprint('expected:', expected)\nprint('json matches csv:', results == expected)\nprint('row count matches input:', len(rev) == len(inp))\nprint('--- per subject ---')\nfor subj in ['right_of_first_refusal','children_named','overnight_stays','addressee','inconsistent_accounts','concern','behavioural_plan','request','enclosure','tone','sender_signature','"]
[406.191076, "i", "salutation','copies','delivery','reply_deadline','school_reference','mediation_offer','mediation_terms','legal_fees','court_listing','expert_report','interim_contact','without_prejudice','hearing_bundle']:\n    c = collections.Counter(r['verdict'] for r in rev if inp[r['line_id']]['subject'] == subj)\n    print(f'{subj}: {dict(c)}')\nPY\n"]
[406.191416, "o", "python3 - <<'PY'\r\n\u001b[?2004l\rsalutation','copies','delivery','reply_deadline','school_reference','mediation_offer','"]
