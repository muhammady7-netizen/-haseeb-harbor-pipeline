[326.362211, "i", "python3 - <<'PY'\nimport csv, json, collections\nrows = list(csv.DictReader(open('letter_line_review.csv', newline='')))\nprint('rows:', len(rows))\nprint('keys:', list(rows[0].keys()))\ncounts = collections.Counter(r['verdict'] for r in rows)\nresults = json.load(open('results.json'))\nprint('csv counts:', dict(counts))\nprint('json:', results)\nprint('match:', results == {\n    'verified_count': counts['VERIFIED'],\n    'at_odds_count': counts['AT_ODDS'],\n    'not_in_record_count': counts['NOT_IN_RECORD'],\n    'clarification_governed_count': sum(1 for r in rows if r['record_entry'].startswith('CL-')),\n})\nPY\n"]
[326.36269, "o", "python3 - <<'PY'\r\n"]
