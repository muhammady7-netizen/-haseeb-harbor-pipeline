[249.115318, "i", "python3 - <<'PY'\nimport csv, json, collections\n\nrows = list(csv.DictReader(open('input/letter_lines.csv', newline='')))\n\ngoverning = {\n    'addressee': 'CL-301',\n    'request': 'CL-302',\n    'enclosure': 'CL-303',\n    'salutation': 'CL-304',\n    'copies': 'CL-305',\n    'delivery': 'CL-306',\n    'tone': 'CL-307',\n    'behavioural_plan': 'CL-308',\n    'concern': 'CL-309',\n    'right_of_first_refusal': 'OI-202',\n    'children_named': 'OI-203',\n    'overnight_stays': 'OI-204',\n    'inconsistent_accounts': 'OI-205',\n    'sender_signature': 'OI-211',\n}\n\ndef verdict(row):\n    s = row['subject']\n    p = row['position']\n    if s not in governing:\n        return 'NOT_IN_RECORD'\n\n    if s == 'right_of_first_refusal':\n        return 'VERIFIED' if p in ('agreed by the father', 'father agreed', 'full') else 'AT_ODDS'\n\n    if s == 'children_named':\n        return 'VERIFIED' if p in ('both children, with their ages', 'both children with ages', 'both with ages') else 'AT_ODDS'\n\n    if s == 'overnight_stays':\n        return 'V"]
