[327.385594, "i", "python3 - <<'PY'\nimport csv\nrev = list(csv.DictReader(open('letter_line_review.csv', newline='')))\ninp = {r['line_id']: r for r in csv.DictReader(open('input/letter_lines.csv', newline=''))}\nfor subj in ['overnight_stays','right_of_first_refusal','children_named','addressee','inconsistent_accounts','concern','behavioural_plan','request','enclosure','tone','sender_signature','salutation','copies','delivery']:\n    print(f'### {subj}')\n    for r in rev:\n        if inp[r['line_id']]['subject'] == subj:\n            print(f\"{r['line_id']} | {r['verdict']} | {r['record_entry']} | {inp[r['line_id']]['position']} | {inp[r['line_id']]['wording'][:80]}\")\nPY\n"]
