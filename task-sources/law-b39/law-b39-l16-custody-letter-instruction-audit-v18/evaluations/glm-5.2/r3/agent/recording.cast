[434.408335, "i", "python3 - <<'PY'\nimport csv, collections\nrev = list(csv.DictReader(open('letter_line_review.csv', newline='')))\ninp = {r['line_id']: r for r in csv.DictReader(open('input/letter_lines.csv', newline=''))}\nsubjects = ['right_of_first_refusal','children_named','overnight_stays','addressee','inconsistent_accounts','concern','behavioural_plan','request','enclosure','tone','sender_signature','salutation','copies','delivery']\nfor subj in subjects:\n    print(f'### {subj}')\n    pairs = collections.defaultdict(list)\n    for r in rev:\n        if inp[r['line_id']]['subject'] == subj:\n            pairs[inp[r['line_id']]['position']].append(r)\n    for pos, items in sorted(pairs.items()):\n        verdicts = collections.Counter(i['verdict'] for i in items)\n        sample = items[0]['line_id']\n        print(f\"{pos} | {dict(verdicts)} | ex={sample}: {inp[sample]['wording'][:100]}\")\nPY\n"]
