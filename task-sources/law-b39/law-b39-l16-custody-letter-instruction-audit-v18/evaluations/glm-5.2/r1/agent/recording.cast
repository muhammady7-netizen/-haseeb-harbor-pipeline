[70.092789, "i", "python3 - <<'PY' > /tmp/pairs.txt\nimport csv, collections\nrows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\npairs=collections.defaultdict(list)\nfor r in rows:\n    pairs[(r['subject'], r['position'])].append(r)\nfor (subj,pos), rs in sorted(pairs.items()):\n    print(f\"{subj} | {pos} | n={len(rs)} | cited={sorted(set(r['cited_entry'] for r in rs))} | ex={rs[0]['line_id']}: {rs[0]['wording']}\")\nPY\nwc -l /tmp/pairs.txt\nsed -n '1,80p' /tmp/pairs.txt\n"]
