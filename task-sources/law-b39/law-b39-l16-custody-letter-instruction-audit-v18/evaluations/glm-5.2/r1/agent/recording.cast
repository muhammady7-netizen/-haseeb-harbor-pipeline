[48.020337, "i", "python3 - <<'PY'\nimport csv, collections\nrows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\nprint('row_count', len(rows))\nprint('subjects', len(collections.Counter(r['subject'] for r in rows)))\nfor subj, cnt in sorted(collections.Counter(r['subject'] for r in rows).items()):\n    print(f'{cnt:3d} {subj}')\nprint('cited_entries', sorted(set(r['cited_entry'] for r in rows)))\nPY\n"]
