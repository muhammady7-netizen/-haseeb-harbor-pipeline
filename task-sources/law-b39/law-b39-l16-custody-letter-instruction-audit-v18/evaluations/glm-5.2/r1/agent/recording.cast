[138.853744, "o", "\u001b[?2004h> "]
[138.854115, "o", "counts = collections.Counter()\r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.854457, "o", "    subj = r['subject']\r\n\u001b[?2004l\r"]
[138.854788, "o", "\u001b[?2004h> "]
[138.85511, "o", "    entry = governing.get(subj, 'NONE')\r\n\u001b[?2004l\r"]
[138.85543, "o", "\u001b[?2004h> "]
[138.85592, "o", "    verdict = classify(subj, r['position'], r['wording']) if entry != 'NONE' else 'NOT_IN_RECORD'\r\n\u001b[?2004l\r"]
[138.856234, "o", "\u001b[?2004h> "]
[138.857009, "o", "    out_rows.append({'line_id': r['line_id'], 'verdict': verdict, 'record_entry': entry})\r\n\u001b[?2004l\r\u001b[?2004h"]
