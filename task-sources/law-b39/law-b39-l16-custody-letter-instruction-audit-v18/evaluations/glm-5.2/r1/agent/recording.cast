[138.676138, "i", "cat > /tmp/classify_letter.py <<'PY'\nimport csv, json, collections\n\nrows = list(csv.DictReader(open('input/letter_lines.csv', newline='')))\n\n# Governing entry by subject. Clarification prevails on any subject it speaks to.\ngoverning = {\n    'addressee': 'CL-301',\n    'request': 'CL-302',\n    'enclosure': 'CL-303',\n    'salutation': 'CL-304',\n    'copies': 'CL-305',\n    'delivery': 'CL-306',\n    'tone': 'CL-307',\n    'behavioural_plan': 'CL-308',\n    'concern': 'CL-309',\n    'right_of_first_refusal': 'OI-202',\n    'children_named': 'OI-203',\n    'overnight_stays': 'OI-204',\n    'inconsistent_accounts': 'OI-205',\n    'sender_signature': 'OI-211',\n}\n\ndef classify(subj, pos, wording):\n    w = wording.lower()\n    if subj == 'addressee':\n        # CL-301: to Catherine's/mother's attorney, not Adam's/father's.\n        if pos in ('mother', \"mother's attorney\", 'wording addressee mother') or ('mother' in w and 'father' not in w and 'adler' not in w):\n            return 'VERIFIED'\n        if pos in ('father', \"father's"]
