[505.286887, "i", "python3 - <<'PY'\nimport csv, json, os, collections\ndraft=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\nreview=list(csv.DictReader(open('letter_line_review.csv', newline='')))\nprint('files', {f: os.path.exists(f) for f in ['answer.md','letter_line_review.csv','results.json']})\nprint('csv_rows', len(review), 'order_ok', [r['line_id'] for r in review]==[r['line_id'] for r in draft])\nprint('header', ','.join(review[0].keys()))\nprint('verdict_values', sorted(set(r['verdict'] for r in review)))\nprint('results', json.dumps(json.load(open('results.json')), indent=2))\ndr={r['line_id']:r for r in draft}\ngroups=collections.defaultdict(list)\nfor r in review:\n    groups[(dr[r['line_id']]['subject'], dr[r['line_id']]['position'])].append(r)\nmixed=[]\nfor (subj,pos), rs in sorted(groups.items()):\n    if len(set(r['verdict'] for r in rs))>1 or len(set(r['record_entry'] for r in rs))>1:\n        mixed.append((subj,pos,[(r['line_id'],r['verdict'],r['record_entry'],dr[r['line_id']]['wording']) for r in rs]))\npr"]
[505.287197, "i", "int('mixed_groups', len(mixed))\nfor m in mixed:\n    print(m)\nprint('answer_has_count', 'Letter lines at odds with the record: 153' in open('answer.md').read())\nPY\n"]
