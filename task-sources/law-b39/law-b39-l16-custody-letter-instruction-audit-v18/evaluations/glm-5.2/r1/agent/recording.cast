[264.846319, "o", "csv_rows 290\r\nheader line_id,verdict,record_entry\r\n"]
[264.846619, "o", "{\r\n  \"verified_count\": 86,\r\n  \"at_odds_count\": 155,\r\n  \"not_in_record_count\": 49,\r\n  \"clarification_governed_count\": 168\r\n}\r\nverdict_counts {'VERIFIED': 86, 'AT_ODDS': 155, 'NOT_IN_RECORD': 49}\r\n"]
[264.846825, "o", "clarification_governed 168\r\nfirst_5 [{'line_id': 'ST-101', 'verdict': 'VERIFIED', 'record_entry': 'OI-202'}, {'line_id': 'ST-102', 'verdict': 'VERIFIED', 'record_entry': 'OI-203'}, {'line_id': 'ST-103', 'verdict': 'VERIFIED', 'record_entry': 'OI-204'}, {'line_id': 'ST-104', 'verdict': 'AT_ODDS', 'record_entry': 'CL-301'}, {'line_id': 'ST-105', 'verdict': 'AT_ODDS', 'record_entry': 'OI-205'}]\r\nlast_5 [{'line_id': 'ST-556', 'verdict': 'NOT_IN_RECORD', 'record_entry': 'NONE'}, {'line_id': 'ST-557', 'verdict': 'NOT_IN_RECORD', 'record_entry': 'NONE'}, {'line_id': 'ST-558', 'verdict': 'VERIFIED', 'record_entry': 'CL-307'}, {'line_id': 'ST-559', 'verdict': 'VERIFIED', 'record_entry': 'CL-309'}, {'line_id': 'ST-560', 'verdict': 'VERIFIED', 'record_entry': 'CL-308'}]\r\n"]
[264.851882, "o", "\u001b[?2004h\u001b[01;32mappuser@fec11b391fbd\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[276.528686, "i", "python3 - <<'PY'\nimport csv, collections\nrows=list(csv.DictReader(open('letter_line_review.csv')))\ndraft={r['line_id']:r for r in csv.DictReader(open('input/letter_lines.csv'))}\npairs=collections.defaultdict(collections.Counter)\nfor r in rows:\n    dr=draft[r['line_id']]\n    pairs[(dr['subject'], dr['position'], r['verdict'], r['record_entry'])]+=1\nfor (subj,pos,verdict,entry),cnt in sorted(pairs.items()):\n    print(f'{subj} | {pos} | {verdict} | {entry} | {cnt}')\nPY\n"]
