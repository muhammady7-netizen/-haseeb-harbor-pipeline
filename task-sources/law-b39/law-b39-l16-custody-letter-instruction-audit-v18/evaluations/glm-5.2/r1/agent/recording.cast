[427.504805, "i", "python3 - <<'PY'\nimport csv, collections\ndraft=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\nreview=list(csv.DictReader(open('letter_line_review.csv', newline='')))\ndr={r['line_id']:r for r in draft}\ngroups=collections.defaultdict(list)\nfor r in review:\n    d=dr[r['line_id']]\n    groups[(d['subject'], d['position'])].append(r)\nmixed=[]\nfor (subj,pos), rs in sorted(groups.items()):\n    verdicts=set(r['verdict'] for r in rs)\n    entries=set(r['record_entry'] for r in rs)\n    if len(verdicts)>1 or len(entries)>1:\n        mixed.append((subj,pos,verdicts,entries,[(r['line_id'],r['verdict'],r['record_entry'],dr[r['line_id']]['wording']) for r in rs]))\nprint('mixed_groups', len(mixed))\nfor m in mixed:\n    print(m[:4])\n    for item in m[4]:\n        print(' ', item)\nprint('subject_verdict_counts:')\nsvc=collections.defaultdict(collections.Counter)\nfor r in review:\n    svc[dr[r['line_id']]['subject']][r['verdict']]+=1\nfor subj in sorted(svc):\n    print(f'{subj}: verified={svc[subj][\"VERIFIED\"]}, at_od"]
[427.506133, "i", "ds={svc[subj][\"AT_ODDS\"]}, not_in_record={svc[subj][\"NOT_IN_RECORD\"]}')\nPY\n"]
