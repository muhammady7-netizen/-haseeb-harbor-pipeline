[459.994452, "i", "python3 - <<'PY'\nimport csv\ndraft=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\nreview={r['line_id']:r for r in csv.DictReader(open('letter_line_review.csv', newline=''))}\nfor subj in ['addressee','behavioural_plan','concern','copies','overnight_stays','request']:\n    print(f'===== {subj} =====')\n    for d in draft:\n        if d['subject']==subj:\n            r=review[d['line_id']]\n            print(f\"{d['line_id']} | {r['verdict']} | {r['record_entry']} | pos={d['position']} | {d['wording']}\")\nPY\n"]
