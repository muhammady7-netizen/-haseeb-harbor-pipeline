[263.520205, "o", "        # OI-202: Mr Adler/father agreed; children not left overnight without him present.\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.520354, "o", "> "]
[263.520778, "o", "        if (\"right of first refusal\" in w and (\"mr adler\" in w or \"father\" in w) and\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.52153, "o", "                (\"not to be left overnight\" in w or \"not left overnight\" in w or \"without him\" in w) and\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.521766, "o", "                \"permitted\" not in w):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.5221, "o", "            return \"VERIFIED\"\r\n\u001b[?2004l\r"]
[263.522345, "o", "\u001b[?2004h>         return \"AT_ODDS\""]
[263.522598, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.522908, "o", "    if subject == \"children_named\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.523234, "o", "        # OI-203: both children named with ages.\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.523442, "o", "> "]
[263.523825, "o", "        if \"noor\" in w and \"imogen\" in w and \"seven\" in w and \"twelve\" in w:\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.524047, "o", "> "]
[263.524392, "o", "            return \"VERIFIED\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.5246, "o", "        return \"AT_ODDS\""]
[263.52499, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.525501, "o", "    if subject == \"overnight_stays\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.526335, "o", "        # OI-204: several occasions, both children, her home or sitter, father away.\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.526652, "o", "> "]
[263.527392, "o", "        if (\"several occasions\" in w and \"both children\" in w and \"overnight\" in w and\r\n\u001b[?2004l\r"]
[263.527734, "o", "\u001b[?2004h> "]
[263.528476, "o", "                (\"her home\" in w or \"corwin's home\" in w or \"corwin's home\" in w) and \"sitter\" in w and\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.528624, "o", "> "]
[263.529256, "o", "                (\"father\" in w or \"mr adler\" in w) and \"away\" in w):\r\n\u001b[?2004l\r"]
[263.529571, "o", "\u001b[?2004h> "]
[263.529789, "o", "            return \"VERIFIED\"\r\n\u001b[?2004l\r"]
[263.530029, "o", "\u001b[?2004h> "]
[263.530288, "o", "        return \"AT_ODDS\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[263.530649, "o", "> "]
[263.530901, "o", "    if subject == \"inconsistent_accounts\":\r\n\u001b[?2004l\r"]
[263.531146, "o", "\u001b[?2004h> "]
[263.532173, "o", "        # OI-205: wife to school, resident/person child lives with to clinicians, sitter to sender, partner to neighbours; all four.\r\n\u001b[?2004l\r"]
[263.5324, "o", "\u001b[?2004h> "]
[263.532809, "o", "        school = \"wife\" in w and \"school\" in w\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.53308, "o", "> "]
[263.533862, "o", "        clinicians = \"clinicians\" in w and (\"person\" in w or \"lives with\" in w or \"resident\" in w)\r\n\u001b[?2004l\r"]
[263.534058, "o", "\u001b[?2004h> "]
[263.53482, "o", "        sender = (\"sitter\" in w or \"babysitter\" in w) and (\"me\" in w or \"sender\" in w)\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.535015, "o", "> "]
[263.535811, "o", "        neighbours = \"partner\" in w and (\"neighbour\" in w or \"neighbor\" in w)\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.536042, "o", "> "]
[263.536547, "o", "        if school and clinicians and sender and neighbours:\r\n\u001b[?2004l\r"]
[263.536813, "o", "\u001b[?2004h> "]
[263.537046, "o", "            return \"VERIFIED\"\r\n"]
[263.537317, "o", "\u001b[?2004l\r"]
[263.537568, "o", "\u001b[?2004h> "]
[263.537819, "o", "        return \"AT_ODDS\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[263.538015, "o", "\u001b[?2004h> "]
[263.538353, "o", "    if subject == \"sender_signature\":\r\n\u001b[?2004l\r"]
[263.538649, "o", "\u001b[?2004h"]
[263.538787, "o", "> "]
[263.5393, "o", "        # OI-211: sign in own full name Delphine Marr; not as counsel.\r\n\u001b[?2004l\r"]
[263.539552, "o", "\u001b[?2004h"]
[263.539795, "o", "> "]
[263.540426, "o", "        if \"delphine marr\" in w and \"for delphine\" not in w and \"solicitor\" not in w:\r\n\u001b[?2004l\r"]
[263.540725, "o", "\u001b[?2004h>             return \"VERIFIED\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.540974, "o", ">         return \"AT_ODDS\"\r\n\u001b[?2004l\r"]
[263.541342, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.541734, "o", "    # Subjects neither record speaks to.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.542083, "o", "    return \"NOT_IN_RECORD\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.542307, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[263.542524, "o", "> out_rows = []\r\n\u001b[?2004l\r"]
[263.542782, "o", "\u001b[?2004h> "]
[263.542982, "o", "counts = collections.Counter()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.543203, "o", "for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.543598, "o", "    subject = r[\"subject\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.54387, "o", "> "]
[263.544102, "o", "    entry = governing.get(subject, \"NONE\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.544564, "o", "    verdict = classify(subject, r[\"position\"], r[\"wording\"]) if entry != \"NONE\" else \"NOT_IN_RECORD\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.545076, "o", "    out_rows.append({\"line_id\": r[\"line_id\"], \"verdict\": verdict, \"record_entry\": entry})\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.545341, "o", "> "]
[263.545476, "o", "    counts[verdict] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.545822, "o", "    if entry.startswith(\"CL-\"):\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.546126, "o", "> "]
[263.546394, "o", "        counts[\"clarification_governed\"] += 1\r\n\u001b[?2004l\r"]
[263.546612, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[263.54681, "o", "> "]
[263.547058, "o", "with open(\"letter_line_review.csv\", \"w\", newline=\"\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.547544, "o", "    writer = csv.DictWriter(f, fieldnames=[\"line_id\", \"verdict\", \"record_entry\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.547781, "o", "    writer.writeheader()"]
[263.548039, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.548166, "o", "    writer.writerows(out_rows)\r\n\u001b[?2004l\r"]
[263.548418, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results = {\r\n\u001b[?2004l\r"]
[263.548684, "o", "\u001b[?2004h> "]
[263.548863, "o", "    \"verified_count\": counts[\"VERIFIED\"],"]
[263.549109, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.549417, "o", "    \"at_odds_count\": counts[\"AT_ODDS\"],\r\n\u001b[?2004l\r"]
[263.549645, "o", "\u001b[?2004h> "]
[263.549912, "o", "    \"not_in_record_count\": counts[\"NOT_IN_RECORD\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.550274, "o", "    \"clarification_governed_count\": counts[\"clarification_governed\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.550531, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.55074, "o", "with open(\"results.json\", \"w\") as f:\r\n\u001b[?2004l\r"]
[263.550871, "o", "\u001b[?2004h> "]
[263.551162, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.551303, "o", "> "]
[263.551503, "o", "    f.write(\"\\n\")\r\n\u001b[?2004l\r"]
[263.551737, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[263.551964, "o", "> "]
[263.552451, "o", "answer = f\"\"\"# Review of the draft letter to opposing counsel\r\n\u001b[?2004l\r"]
[263.552738, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.556283, "o", "I reviewed every numbered line in the draft against the client's two messages, applying the review protocol so that the clarification prevails on every subject it addresses and the original instruction governs only where it is left alone. The draft returned addressed to the wrong parent's attorney, so I weighed each line against the record rather than sending any wording that has not been checked. Where a line follows the governing instruction, it is verified; where it takes a different position, a narrower position, or names the wrong person, it is at odds with the record; where neither message speaks to the subject, the record is silent and the line is not in the record at all.\r\n\u001b[?2004l\r"]
[263.556607, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.556967, "o", "Letter lines at odds with the record: {counts[\"AT_ODDS\"]}\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.557395, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.558858, "o", "The table in `letter_line_review.csv` gives the verdict and governing entry for each draft line, and `results.json` carries the four totals. This review is final as to the record supplied; no line was accepted merely because it read reasonably, and every line was weighed against the entry that governs its subject.\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r"]
[263.559154, "o", "\u001b[?2004h> "]
[263.559327, "o", "with open(\"answer.md\", \"w\") as f:\r\n"]
[263.559614, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[263.559856, "o", "    f.write(answer)\r\n"]
[263.560119, "o", "\u001b[?2004l\r\u001b[?2004h"]
[263.560373, "o", "> \r\n\u001b[?2004l\r"]
[263.560635, "o", "\u001b[?2004h> "]
[263.560922, "o", "print(json.dumps(results, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[263.565362, "o", "\u001b[?2004h\u001b[01;32mappuser@fec11b391fbd\u001b[00m:\u001b[01;34m/app\u001b[00m$ python3 /tmp/classify_letter.py"]
[263.565753, "o", "\r\n\u001b[?2004l\r"]
[263.612114, "o", "{\r\n  \"verified_count\": 86,\r\n  \"at_odds_count\": 155,\r\n  \"not_in_record_count\": 49,\r\n  \"clarification_governed_count\": 168\r\n}\r\n"]
[263.618624, "o", "\u001b[?2004h\u001b[01;32mappuser@fec11b391fbd\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[264.362655, "i", "ls -l answer.md letter_line_review.csv results.json\n"]
[264.363237, "o", "ls -l answer.md letter_line_review.csv results.json\r\n\u001b[?2004l\r"]
[264.367867, "o", "-rw-r--r-- 1 appuser appuser 1099 Sep 17 11:15 answer.md\r\n-rw-r--r-- 1 appuser appuser 6982 Sep 17 11:15 letter_line_review.csv\r\n-rw-r--r-- 1 appuser appuser  119 Sep 17 11:15 results.json\r\n"]
[264.368632, "o", "\u001b[?2004h\u001b[01;32mappuser@fec11b391fbd\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[264.804053, "i", "python3 - <<'PY'\nimport csv, json, collections\nrows = list(csv.DictReader(open(\"letter_line_review.csv\")))\nprint(\"csv_rows\", len(rows))\nprint(\"header\", \",\".join(rows[0].keys()) if rows else \"none\")\nprint(json.dumps(json.load(open(\"results.json\")), indent=2))\nprint(\"verdict_counts\", {v: sum(1 for r in rows if r[\"verdict\"] == v) for v in [\"VERIFIED\", \"AT_ODDS\", \"NOT_IN_RECORD\"]})\nprint(\"clarification_governed\", sum(1 for r in rows if r[\"record_entry\"].startswith(\"CL-\")))\nprint(\"first_5\", rows[:5])\nprint(\"last_5\", rows[-5:])\nPY\n"]
[264.804357, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
