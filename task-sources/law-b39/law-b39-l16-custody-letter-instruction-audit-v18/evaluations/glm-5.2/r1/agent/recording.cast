[19.566189, "o", "ial plan | cited=OI-209 | wording=A certified copy of the custodial plan is enclosed.\r\nST-110 | subject=tone | position=firm and detailed | cited=OI-210 | wording=I set out the position firmly and in full detail below.\r\nST-111 | subject=sender_signature | position=the sender's own name | cited=OI-211 | wording=Yours sincerely, Delphine Marr.\r\nST-112 | subject=salutation | position=Dear Counsel | cited=CL-304 | wording=Dear Counsel,\r\nST-113 | subject=copies | position=copied to the father | cited=CL-305 | wording=Copy: Mr Adler.\r\nST-114 | subject=reply_deadline | position=a reply within seven days | cited=OI-299 | wording=I would be grateful for a reply within seven days.\r\nST-115 | subject=school_reference | position=the school principal named | cited=OI-298 | wording=The school principal, Ms Oduya, can confirm the account given to the school.\r\n"]
