[329.013626, "i", "python3 - <<'PY' > /tmp/cross.txt\nimport csv, collections\ndraft=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\nreview=list(csv.DictReader(open('letter_line_review.csv', newline='')))\ndr={r['line_id']:r for r in draft}\npairs=collections.defaultdict(int)\nfor r in review:\n    d=dr[r['line_id']]\n    pairs[(d['subject'], d['position'], r['verdict'], r['record_entry'])]+=1\nfor (subj,pos,verdict,entry),cnt in sorted(pairs.items()):\n    print(f'{subj} | {pos} | {verdict} | {entry} | {cnt}')\nPY\nsed -n '1,70p' /tmp/cross.txt\n"]
