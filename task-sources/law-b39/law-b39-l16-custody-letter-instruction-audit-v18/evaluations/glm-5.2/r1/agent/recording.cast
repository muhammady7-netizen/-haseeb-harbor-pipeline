[139.620325, "o", "\u001b[?2004h\u001b[01;32mappuser@fec11b391fbd\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[140.099771, "i", "python3 - <<'PY'\nimport csv, json\nrows=list(csv.DictReader(open('letter_line_review.csv')))\nprint('csv_rows', len(rows))\nprint('header', ','.join(rows[0].keys()) if rows else 'none')\nprint(json.dumps(json.load(open('results.json')), indent=2))\nprint('verdict_counts', {v: sum(1 for r in rows if r['verdict']==v) for v in ['VERIFIED','AT_ODDS','NOT_IN_RECORD']})\nprint('clarification_governed', sum(1 for r in rows if r['record_entry'].startswith('CL-')))\nPY\n"]
[140.100312, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
