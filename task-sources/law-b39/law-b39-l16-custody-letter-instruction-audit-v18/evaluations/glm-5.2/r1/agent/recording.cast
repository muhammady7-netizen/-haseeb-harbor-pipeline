[314.432271, "i", "python3 - <<'PY'\nimport csv, json, os, re\n\nrequired_files = ['answer.md', 'letter_line_review.csv', 'results.json']\nfor fn in required_files:\n    print(fn, 'exists', os.path.exists(fn), 'size', os.path.getsize(fn) if os.path.exists(fn) else None)\n\ndraft = list(csv.DictReader(open('input/letter_lines.csv', newline='')))\nreview = list(csv.DictReader(open('letter_line_review.csv', newline='')))\nprint('draft_rows', len(draft), 'review_rows', len(review))\nprint('csv_header', review[0].keys() if review else None)\nprint('order_ok', [r['line_id'] for r in review] == [r['line_id'] for r in draft])\nprint('verdict_values', sorted(set(r['verdict'] for r in review)))\nprint('record_entries', sorted(set(r['record_entry'] for r in review)))\n\nresults = json.load(open('results.json'))\nprint('results_keys', sorted(results.keys()))\nprint('results', json.dumps(results, indent=2))\n\nanswer = open('answer.md').read()\nprint('answer_has_required_label', 'Letter lines at odds with the record: 155' in answer)\nprint('answer_word_count', "]
[314.432812, "i", "len(answer.split()))\nPY\n"]
