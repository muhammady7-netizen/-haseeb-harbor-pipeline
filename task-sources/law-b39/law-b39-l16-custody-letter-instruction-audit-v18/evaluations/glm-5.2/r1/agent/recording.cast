[263.438188, "i", "cat > /tmp/classify_letter.py <<'PY'\nimport csv, json, collections\n\nrows = list(csv.DictReader(open(\"input/letter_lines.csv\", newline=\"\")))\n\n# Clarification prevails on any subject it addresses; original governs only where it is left alone.\ngoverning = {\n    \"addressee\": \"CL-301\",\n    \"request\": \"CL-302\",\n    \"enclosure\": \"CL-303\",\n    \"salutation\": \"CL-304\",\n    \"copies\": \"CL-305\",\n    \"delivery\": \"CL-306\",\n    \"tone\": \"CL-307\",\n    \"behavioural_plan\": \"CL-308\",\n    \"concern\": \"CL-309\",\n    \"right_of_first_refusal\": \"OI-202\",\n    \"children_named\": \"OI-203\",\n    \"overnight_stays\": \"OI-204\",\n    \"inconsistent_accounts\": \"OI-205\",\n    \"sender_signature\": \"OI-211\",\n}\n\ndef norm(s):\n    return s.lower().replace(\"\\u2019\", \"'\").replace(\"\\u2018\", \"'\")\n\ndef classify(subject, position, wording):\n    w = norm(wording)\n\n    if subject == \"addressee\":\n        # CL-301: letter goes to Catherine's/Ms Corwin's attorney, the mother's attorney, not Adam's/father's.\n        if \"counsel for ms corwin\" in w or \"mother's attorney\""]
[263.4394, "i", " in w or \"mother’s attorney\" in w or \"catherine's attorney\" in w:\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    if subject == \"request\":\n        # CL-302: neither child overnight in her care unless the father/Mr Adler is present.\n        if (\"overnight\" in w and \"unless\" in w and (\"mr adler\" in w or \"father\" in w) and\n                (\"neither child\" in w or \"no child\" in w or (\"both children\" in w and \"not\" in w))):\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    if subject == \"enclosure\":\n        # CL-303: enclose certified copy of the custodial plan.\n        if \"certified copy\" in w and \"custodial plan\" in w:\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    if subject == \"salutation\":\n        # CL-304: Dear Counsel.\n        if w.strip() == \"dear counsel,\" or w.startswith(\"dear counsel,\"):\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    if subject == \"copies\":\n        # CL-305: do not copy anyone.\n        if \"do not copy anyone\" in w or \"not copy anyone\" in"]
[263.439945, "o", "cat > /tmp/classify_letter.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import csv, json, collections\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[263.440261, "i", " w or \"no copy\" in w or \"nobody is copied\" in w or \"no one is copied\" in w:\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    if subject == \"delivery\":\n        # CL-306: send by post to counsel's office.\n        if \"post\" in w and \"counsel\" in w:\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    if subject == \"tone\":\n        # CL-307: firm, formal and brief; not soft and not long-winded.\n        if \"firm\" in w and \"formal\" in w and \"brief\" in w:\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    if subject == \"behavioural_plan\":\n        # CL-308: plan about confidence, stability and peer relations; stays set back confidence only.\n        if (\"confidence\" in w and \"stability\" in w and \"peer\" in w and \"set back confidence\" in w and\n                \"set it back\" not in w and \"set back her progress\" not in w):\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    if subject == \"concern\":\n        # CL-309: concerned only about the position she has been put in; do not raise apprec"]
[263.44067, "o", "\u001b[?2004h> "]
[263.441074, "i", "iation of violation.\n        if \"position\" in w and \"appreciate\" not in w and \"violate\" not in w and \"violation\" not in w:\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    if subject == \"right_of_first_refusal\":\n        # OI-202: Mr Adler/father agreed; children not left overnight without him present.\n        if (\"right of first refusal\" in w and (\"mr adler\" in w or \"father\" in w) and\n                (\"not to be left overnight\" in w or \"not left overnight\" in w or \"without him\" in w) and\n                \"permitted\" not in w):\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    if subject == \"children_named\":\n        # OI-203: both children named with ages.\n        if \"noor\" in w and \"imogen\" in w and \"seven\" in w and \"twelve\" in w:\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    if subject == \"overnight_stays\":\n        # OI-204: several occasions, both children, her home or sitter, father away.\n        if (\"several occasions\" in w and \"both children\" in w and \"overnight\" in w an"]
[263.441321, "o", "rows = list(csv.DictReader(open(\"input/letter_lines.csv\", newline=\"\")))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.441628, "i", "d\n                (\"her home\" in w or \"corwin's home\" in w or \"corwin's home\" in w) and \"sitter\" in w and\n                (\"father\" in w or \"mr adler\" in w) and \"away\" in w):\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    if subject == \"inconsistent_accounts\":\n        # OI-205: wife to school, resident/person child lives with to clinicians, sitter to sender, partner to neighbours; all four.\n        school = \"wife\" in w and \"school\" in w\n        clinicians = \"clinicians\" in w and (\"person\" in w or \"lives with\" in w or \"resident\" in w)\n        sender = (\"sitter\" in w or \"babysitter\" in w) and (\"me\" in w or \"sender\" in w)\n        neighbours = \"partner\" in w and (\"neighbour\" in w or \"neighbor\" in w)\n        if school and clinicians and sender and neighbours:\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    if subject == \"sender_signature\":\n        # OI-211: sign in own full name Delphine Marr; not as counsel.\n        if \"delphine marr\" in w and \"for delphine\" not in w and \"solicitor\" not i"]
[263.442031, "i", "n w:\n            return \"VERIFIED\"\n        return \"AT_ODDS\"\n\n    # Subjects neither record speaks to.\n    return \"NOT_IN_RECORD\"\n\nout_rows = []\ncounts = collections.Counter()\nfor r in rows:\n    subject = r[\"subject\"]\n    entry = governing.get(subject, \"NONE\")\n    verdict = classify(subject, r[\"position\"], r[\"wording\"]) if entry != \"NONE\" else \"NOT_IN_RECORD\"\n    out_rows.append({\"line_id\": r[\"line_id\"], \"verdict\": verdict, \"record_entry\": entry})\n    counts[verdict] += 1\n    if entry.startswith(\"CL-\"):\n        counts[\"clarification_governed\"] += 1\n\nwith open(\"letter_line_review.csv\", \"w\", newline=\"\") as f:\n    writer = csv.DictWriter(f, fieldnames=[\"line_id\", \"verdict\", \"record_entry\"])\n    writer.writeheader()\n    writer.writerows(out_rows)\n\nresults = {\n    \"verified_count\": counts[\"VERIFIED\"],\n    \"at_odds_count\": counts[\"AT_ODDS\"],\n    \"not_in_record_count\": counts[\"NOT_IN_RECORD\"],\n    \"clarification_governed_count\": counts[\"clarification_governed\"],\n}\nwith open(\"results.json\", \"w\") as f:\n    json.dump(re"]
[263.442157, "i", "sults, f, indent=2)\n    f.write(\"\\n\")\n\nanswer = f\"\"\"# Review of the draft letter to opposing counsel\n\nI reviewed every numbered line in the draft against the client's two messages, applying the review protocol so that the clarification prevails on every subject it addresses and the original instruction governs only where it is left alone. The draft returned addressed to the wrong parent's attorney, so I weighed each line against the record rather than sending any wording that has not been checked. Where a line follows the governing instruction, it is verified; where it takes a different position, a narrower position, or names the wrong person, it is at odds with the record; where neither message speaks to the subject, the record is silent and the line is not in the record at all.\n\nLetter lines at odds with the record: {counts[\"AT_ODDS\"]}\n\nThe table in `letter_line_review.csv` gives the verdict and governing entry for each draft line, and `results.json` carries the four totals. This review is final as to the r"]
[263.442487, "i", "ecord supplied; no line was accepted merely because it read reasonably, and every line was weighed against the entry that governs its subject.\n\"\"\"\nwith open(\"answer.md\", \"w\") as f:\n    f.write(answer)\n\nprint(json.dumps(results, indent=2))\nPY\npython3 /tmp/classify_letter.py\n"]
