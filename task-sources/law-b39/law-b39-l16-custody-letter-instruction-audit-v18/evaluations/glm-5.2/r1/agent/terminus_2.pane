[?2004l[?2004h> 
[?2004l[?2004h>     if subject == "overnight_stays":
[?2004l[?2004h>         # OI-204: several occasions, both children, her home or sitter, father away.
[?2004l[?2004h>         if ("several occasions" in w and "both children" in w and "overnight" in w and
