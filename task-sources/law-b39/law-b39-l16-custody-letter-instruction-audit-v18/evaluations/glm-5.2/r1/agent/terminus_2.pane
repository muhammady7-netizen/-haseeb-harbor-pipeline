[?2004l[?2004h> import csv, collections
[?2004l[?2004h> draft=list(csv.DictReader(open('input/letter_lines.csv', newline='')))
[?2004l[?2004h> review=list(csv.DictReader(open('letter_line_review.csv', newline='')))
[?2004l[?2004h> dr={r['line_id']:r for r in draft}
[?2004l[?2004h> groups=collections.defaultdict(list)
[?2004l[?2004h> for r in review:
[?2004l[?2004h>     d=dr[r['line_id']]
[?2004l[?2004h>     groups[(d['subject'], d['position'])].append(r)
[?2004l[?2004h> mixed=[]
[?2004l[?2004h> for (subj,pos), rs in sorted(groups.items()):
[?2004l[?2004h>     verdicts=set(r['verdict'] for r in rs)
[?2004l[?2004h>     entries=set(r['record_entry'] for r in rs)
[?2004l[?2004h>     if len(verdicts)>1 or len(entries)>1:
[?2004l[?2004h>         mixed.append((subj,pos,verdicts,entries,[(r['line_id'],r['verdict'],r['record_entry'],dr[r['line_id']]['wording']) for r in rs]))
[?2004l[?2004h> print('mixed_groups', len(mixed))
[?2004l[?2004h> for m in mixed:
[?2004l[?2004h>     print(m[:4])
[?2004l[?2004h>     for item in m[4]:
[?2004l[?2004h>         print(' ', item)
[?2004l[?2004h> print('subject_verdict_counts:')
[?2004l[?2004h> svc=collections.defaultdict(collections.Counter)
[?2004l[?2004h> for r in review:
[?2004l[?2004h>     svc[dr[r['line_id']]['subject']][r['verdict']]+=1
[?2004l[?2004h> for subj in sorted(svc):
[?2004l[?2004h>     print(f'{subj}: verified={svc[subj]["VERIFIED"]}, at_odds={svc[subj]["AT_ODDS"]}, not_in_record={svc[subj]["NOT_IN_RECORD"]}')
[?2004l[?2004h> PY
