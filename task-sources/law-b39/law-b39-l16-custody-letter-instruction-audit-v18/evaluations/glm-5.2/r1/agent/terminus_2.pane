[?2004l[?2004h> import csv, collections
[?2004l[?2004h> rows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))
[?2004l[?2004h> d=collections.defaultdict(collections.Counter)
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     d[r['subject']][r['position']]+=1
[?2004l[?2004h> for subj in sorted(d):
[?2004l[?2004h>     print(f"{subj}:")
[?2004l[?2004h>     for pos,cnt in sorted(d[subj].items()):
[?2004l[?2004h>         print(f"  {cnt:2d} {pos}")
[?2004l[?2004h> PY
