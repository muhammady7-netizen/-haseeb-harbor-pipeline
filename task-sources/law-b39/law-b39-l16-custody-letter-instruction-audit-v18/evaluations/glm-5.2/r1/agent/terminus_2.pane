[?2004l[?2004h> import csv
[?2004l[?2004h> draft=list(csv.DictReader(open('input/letter_lines.csv', newline='')))
[?2004l[?2004h> review={r['line_id']:r for r in csv.DictReader(open('letter_line_review.csv', newline=''))}
[?2004l[?2004h> for subj in ['addressee','behavioural_plan','concern','copies','overnight_stays','request']:
[?2004l[?2004h>     print(f'===== {subj} =====')
[?2004l[?2004h>     for d in draft:
[?2004l[?2004h>         if d['subject']==subj:
[?2004l[?2004h>             r=review[d['line_id']]
[?2004l[?2004h>             print(f"{d['line_id']} | {r['verdict']} | {r['record_entry']} | pos={d['position']} | {d['wording']}")
[?2004l[?2004h> PY
