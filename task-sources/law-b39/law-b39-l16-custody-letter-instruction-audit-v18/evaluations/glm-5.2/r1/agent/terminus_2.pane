[?2004l[?2004h>     # Subjects neither record speaks to.
[?2004l[?2004h>     return "NOT_IN_RECORD"
[?2004l[?2004h> 
[?2004l[?2004h> out_rows = []
[?2004l[?2004h> counts = collections.Counter()
