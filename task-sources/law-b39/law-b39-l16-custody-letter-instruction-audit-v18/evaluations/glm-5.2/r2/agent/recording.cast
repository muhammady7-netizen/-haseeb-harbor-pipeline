[636.378512, "i", "python3 - <<'PY'\nimport json, csv, os, re\nfor fn in ['answer.md','letter_line_review.csv','results.json']:\n    print(fn, os.path.getsize(fn))\nwith open('letter_line_review.csv', newline='') as f:\n    rows=list(csv.DictReader(f))\nprint('csv_rows', len(rows), 'header', list(rows[0].keys()))\nwith open('results.json') as f:\n    res=json.load(f)\nprint('json', res)\ntxt=open('answer.md').read()\nprint('answer_sentence_present', bool(re.search(r'Letter lines at odds with the record: 154', txt)))\nprint('answer_word_count', len(txt.split()))\nPY\n"]
