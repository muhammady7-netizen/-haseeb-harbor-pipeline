[366.812444, "i", "python3 - <<'PY'\nfrom collections import Counter, defaultdict\nrows=[line.rstrip('\\n').split('|') for line in open('/tmp/classified.txt')]\ncnt=Counter(r[4] for r in rows)\nprint('total', len(rows))\nprint('counts', dict(cnt))\nprint('clarification_governed_count', sum(1 for r in rows if r[5].startswith('CL-')))\nby=defaultdict(Counter)\nfor r in rows:\n    by[r[1]][r[4]] += 1\nfor s in sorted(by):\n    print(s, dict(by[s]))\nPY\n"]
