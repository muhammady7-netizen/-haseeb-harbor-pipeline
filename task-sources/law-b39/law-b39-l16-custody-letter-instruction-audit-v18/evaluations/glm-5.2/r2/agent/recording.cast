[327.073965, "i", "python3 - <<'PY'\nimport csv\nrows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\nfor s in ['concern','request','behavioural_plan','tone','delivery','copies','addressee','enclosure','salutation','sender_signature']:\n    print(f'\\n### {s}')\n    for r in [x for x in rows if x['subject']==s]:\n        print(f\"{r['line_id']}|{r['position']}|{r['cited_entry']}|{r['wording']}\")\nPY\n"]
