[579.366827, "i", "python3 - <<'PY'\nimport csv\nfrom collections import Counter\n\nrows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\nold={line.rstrip('\\n').split('|')[0]: line.rstrip('\\n').split('|')[4:] for line in open('/tmp/classified.txt')}\n\ndef classify(r):\n    s=r['subject']; w=r['wording'].lower(); p=r['position'].lower()\n    if s not in {'addressee','request','enclosure','salutation','copies','delivery','tone','behavioural_plan','concern','right_of_first_refusal','children_named','overnight_stays','inconsistent_accounts','sender_signature'}:\n        return 'NOT_IN_RECORD','NONE'\n    if s=='addressee':\n        gov='CL-301'\n        if ('mother' in p) or ('catherine' in p) or ('ms corwin' in p):\n            v='VERIFIED' if ('father' not in p and 'adam' not in p) else 'AT_ODDS'\n        else:\n            v='AT_ODDS'\n    elif s=='request':\n        gov='CL-302'\n        if ('overnight' in w and ('her care' in w or 'corwin' in w) and ('father' in w or 'mr adler' in w) and 'present' in w and 'mother is present' n"]
[579.367706, "i", "ot in w and 'ms corwin is present' not in w and 'parent or legal guardian' not in w and 'post to counsel' not in w):\n            v='VERIFIED'\n        else:\n            v='AT_ODDS'\n    elif s=='enclosure':\n        gov='CL-303'\n        v='VERIFIED' if ('certified' in w and 'uncertified' not in w and 'custodial plan' in w and 'enclosed' in w) else 'AT_ODDS'\n    elif s=='salutation':\n        gov='CL-304'; v='VERIFIED' if 'dear counsel' in w else 'AT_ODDS'\n    elif s=='copies':\n        gov='CL-305'\n        v='VERIFIED' if (('do not copy anyone' in w) or ('no copy' in w) or ('nobody' in w) or ('no one' in w) or ('no-one' in w)) else 'AT_ODDS'\n    elif s=='delivery':\n        gov='CL-306'\n        if 'wording' in p or 'salutation' in p: v='AT_ODDS'\n        else: v='VERIFIED' if ('post' in w and ('counsel' in w or 'office' in w or 'opposing counsel' in w)) else 'AT_ODDS'\n    elif s=='tone':\n        gov='CL-307'\n        if 'wording' in p or 'copies' in p: v='AT_ODDS'\n        else: v='VERIFIED' if ('firm' in w and 'forma"]
