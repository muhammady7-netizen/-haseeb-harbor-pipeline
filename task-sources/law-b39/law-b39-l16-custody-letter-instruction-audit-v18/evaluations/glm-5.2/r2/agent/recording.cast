[278.810851, "i", "python3 - <<'PY'\nimport csv\nfrom collections import Counter, defaultdict\n\nrows = list(csv.DictReader(open('input/letter_lines.csv', newline='')))\n\ndef classify(r):\n    s = r['subject']\n    w = r['wording'].lower()\n    p = r['position'].lower()\n\n    if s not in {\n        'addressee','request','enclosure','salutation','copies','delivery','tone','behavioural_plan','concern',\n        'right_of_first_refusal','children_named','overnight_stays','inconsistent_accounts','sender_signature'\n    }:\n        return 'NOT_IN_RECORD', 'NONE'\n\n    if s == 'addressee':\n        gov = 'CL-301'\n        if ('mother' in p) or ('catherine' in p) or ('ms corwin' in p):\n            v = 'VERIFIED' if ('father' not in p and 'adam' not in p) else 'AT_ODDS'\n        else:\n            v = 'AT_ODDS'\n    elif s == 'request':\n        gov = 'CL-302'\n        if ('overnight' in w and ('her care' in w or 'corwin' in w) and\n            ('father' in w or 'mr adler' in w) and 'present' in w and\n            ('mother is present' not in w) and ('ms corw"]
[278.811545, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
