[633.966873, "i", "python3 - <<'PY'\nimport csv\nfrom collections import Counter\nrows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))\ncls={line.rstrip('\\n').split('|')[0]: line.rstrip('\\n').split('|')[4:] for line in open('/tmp/classified2.txt')}\nclar={'addressee','request','enclosure','salutation','copies','delivery','tone','behavioural_plan','concern'}\norig={'right_of_first_refusal','children_named','overnight_stays','inconsistent_accounts','sender_signature'}\nbad=[]\nfor r in rows:\n    v,g=cls[r['line_id']]\n    s=r['subject']\n    if s in clar and not g.startswith('CL-'): bad.append((r['line_id'],s,'expected CL',g))\n    elif s in orig and not g.startswith('OI-'): bad.append((r['line_id'],s,'expected OI',g))\n    elif s not in clar|orig and g!='NONE': bad.append((r['line_id'],s,'expected NONE',g))\nprint('bad_governing_entries', bad)\nprint('counts', dict(Counter(cls[r['line_id']][0] for r in rows)))\nPY\n"]
