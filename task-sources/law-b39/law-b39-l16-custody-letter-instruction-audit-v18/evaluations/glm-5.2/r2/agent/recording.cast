[579.368845, "i", "en' in w and ('her home' in w or 'ms corwin' in w) and 'sitter' in w and ('father' in w or 'mr adler' in w) and 'away' in w) else 'AT_ODDS'\n    elif s=='inconsistent_accounts':\n        gov='OI-205'\n        v='VERIFIED' if ('wife' in w and 'school' in w and 'clinician' in w and ('sitter' in w or 'babysitter' in w) and 'me' in w and 'partner' in w and ('neighbour' in w or 'neighbor' in w)) else 'AT_ODDS'\n    elif s=='sender_signature':\n        gov='OI-211'\n        v='VERIFIED' if ('delphine marr' in w and 'solicitor' not in w and ' for ' not in w) else 'AT_ODDS'\n    else:\n        return 'NOT_IN_RECORD','NONE'\n    return v,gov\n\nnew=[]\nfor r in rows:\n    v,g=classify(r)\n    new.append((r['line_id'],v,g,r['subject']))\ndiffs=[(r[0],old[r[0]][0],r[1],old[r[0]][1],r[2]) for r in new if old[r[0]][0]!=r[1] or old[r[0]][1]!=r[2]]\nprint('diffs', diffs)\ncnt=Counter(r[1] for r in new)\nprint('counts', dict(cnt), 'clar', sum(1 for r in new if r[2].startswith('CL-')))\nwith open('/tmp/classified2.txt','w') as f:\n    for r in n"]
