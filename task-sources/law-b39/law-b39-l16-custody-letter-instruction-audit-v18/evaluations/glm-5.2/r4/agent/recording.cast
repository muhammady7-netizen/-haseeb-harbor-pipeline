[334.520817, "i", "python3 - <<'PY'\nimport csv, json\n\nrows = list(csv.DictReader(open('input/letter_lines.csv')))\n\nclar_subjects = {\n    'addressee': 'CL-301',\n    'request': 'CL-302',\n    'enclosure': 'CL-303',\n    'salutation': 'CL-304',\n    'copies': 'CL-305',\n    'delivery': 'CL-306',\n    'tone': 'CL-307',\n    'behavioural_plan': 'CL-308',\n    'concern': 'CL-309',\n}\norig_subjects = {\n    'right_of_first_refusal': 'OI-202',\n    'children_named': 'OI-203',\n    'overnight_stays': 'OI-204',\n    'inconsistent_accounts': 'OI-205',\n    'sender_signature': 'OI-211',\n}\n\ndef verdict_for(subject, position):\n    if subject in clar_subjects:\n        if subject == 'addressee':\n            return 'VERIFIED' if position in {\"mother\", \"mother's attorney\"} else 'AT_ODDS'\n        if subject == 'request':\n            return 'VERIFIED' if position in {\n                'CL match',\n                'CL wording exact',\n                'CL wording paraphrase',\n                'no overnight stays in her care unless the father is present',\n           "]
[334.52106, "i", "     'no overnight stays unless father present',\n                'no overnight unless father present',\n                'neither child overnight unless father present',\n            } else 'AT_ODDS'\n        if subject == 'enclosure':\n            return 'VERIFIED' if position in {\n                'a certified copy of the custodial plan',\n                'certified',\n                'certified copy',\n                'certified copy enclosed',\n            } else 'AT_ODDS'\n        if subject == 'salutation':\n            return 'VERIFIED' if position == 'Dear Counsel' else 'AT_ODDS'\n        if subject == 'copies':\n            return 'VERIFIED' if position in {'copy nobody', 'nobody'} else 'AT_ODDS'\n        if subject == 'delivery':\n            return 'VERIFIED' if position in {'by post', 'post'} else 'AT_ODDS'\n        if subject == 'tone':\n            return 'VERIFIED' if position == 'firm formal brief' else 'AT_ODDS'\n        if subject == 'behavioural_plan':\n            return 'VERIFIED' if position in {\n          "]
[334.521583, "i", "      'confidence stability peer confidence-only',\n                'full CL match',\n            } else 'AT_ODDS'\n        if subject == 'concern':\n            return 'VERIFIED' if position in {\n                'position only',\n                'position limb only',\n                'narrower concern only position',\n            } else 'AT_ODDS'\n    if subject in orig_subjects:\n        if subject == 'right_of_first_refusal':\n            return 'VERIFIED' if position in {\n                'agreed by the father',\n                'father agreed',\n                'full',\n            } else 'AT_ODDS'\n        if subject == 'children_named':\n            return 'VERIFIED' if position in {\n                'both children, with their ages',\n                'both children with ages',\n                'both with ages',\n            } else 'AT_ODDS'\n        if subject == 'overnight_stays':\n            return 'VERIFIED' if position in {\n                'several occasions at her home or with a sitter',\n                'several occas"]
