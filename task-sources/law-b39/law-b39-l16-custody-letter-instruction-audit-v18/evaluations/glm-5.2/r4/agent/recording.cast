[408.036281, "i", "python3 - <<'PY'\nimport csv, json, os\nfrom collections import Counter\n\nrows = list(csv.DictReader(open('input/letter_lines.csv')))\nout = list(csv.DictReader(open('letter_line_review.csv')))\n\nassert len(rows) == 290, len(rows)\nassert len(out) == 290, len(out)\nassert list(out[0].keys()) == ['line_id', 'verdict', 'record_entry']\nassert all(r['line_id'] == rows[i]['line_id'] for i, r in enumerate(out))\nassert all(r['verdict'] in {'VERIFIED', 'AT_ODDS', 'NOT_IN_RECORD'} for r in out)\nassert all(r['record_entry'] == 'NONE' or r['record_entry'].startswith('OI-') or r['record_entry'].startswith('CL-') for r in out)\n\ncounts = {\n    'verified_count': sum(1 for r in out if r['verdict'] == 'VERIFIED'),\n    'at_odds_count': sum(1 for r in out if r['verdict'] == 'AT_ODDS'),\n    'not_in_record_count': sum(1 for r in out if r['verdict'] == 'NOT_IN_RECORD'),\n    'clarification_governed_count': sum(1 for r in out if r['record_entry'].startswith('CL-')),\n}\njsonobj = json.load(open('results.json'))\nassert set(jsonobj) == {'verif"]
[408.03678, "i", "ied_count', 'at_odds_count', 'not_in_record_count', 'clarification_governed_count'}\nassert jsonobj == counts, (jsonobj, counts)\nassert sum(counts.values()) == 290\n\nans = open('answer.md').read()\nassert 'Letter lines at odds with the record:' in ans\nassert len(ans.split()) >= 60\n\nfor f in ['answer.md', 'letter_line_review.csv', 'results.json']:\n    assert os.path.exists(f) and os.path.getsize(f) > 0, f\n\nprint('VALID')\nprint('verdicts', Counter(r['verdict'] for r in out))\nprint('entries', Counter(r['record_entry'].split('-')[0] if r['record_entry'] != 'NONE' else 'NONE' for r in out))\nprint('counts', counts)\nPY\n"]
