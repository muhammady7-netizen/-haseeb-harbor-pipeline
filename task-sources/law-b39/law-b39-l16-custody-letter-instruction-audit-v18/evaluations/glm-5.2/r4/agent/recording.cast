[129.902388, "i", "python3 - <<'PY'\nimport csv\nfrom collections import defaultdict\nrows=list(csv.DictReader(open('input/letter_lines.csv')))\ngroups=defaultdict(list)\nfor r in rows:\n    groups[(r['subject'],r['position'])].append(r['line_id'])\nfor (s,p),ids in sorted(groups.items()):\n    print(f\"{s}|{p}|{','.join(ids)}\")\nPY\n"]
