[334.655813, "o", "\u001b[?2004h\u001b[01;32mappuser@c2f354c9ce0a\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[371.462703, "i", "python3 - <<'PY'\nimport csv, json, os\nfrom collections import Counter\nrows=list(csv.DictReader(open('input/letter_lines.csv')))\nout=list(csv.DictReader(open('letter_line_review.csv')))\nprint('input_rows', len(rows), 'output_rows', len(out), 'header', out[0].keys() if out else None)\nprint('verdicts', Counter(r['verdict'] for r in out))\nprint('entries', Counter(r['record_entry'].split('-')[0] if r['record_entry']!='NONE' else 'NONE' for r in out))\nprint('subject_counts', Counter(r['subject'] for r in rows))\nprint('out_subject_verdict', Counter((r['subject'], r['verdict']) for r in rows))\njsonobj=json.load(open('results.json'))\nprint('json', jsonobj)\nprint('json_keys', sorted(jsonobj))\nans=open('answer.md').read()\nprint('answer_has_required_sentence', 'Letter lines at odds with the record:' in ans)\nprint('answer_words', len(ans.split()))\nfor f in ['answer.md','letter_line_review.csv','results.json']:\n    print(f, os.path.exists(f), os.path.getsize(f))\nPY\n"]
