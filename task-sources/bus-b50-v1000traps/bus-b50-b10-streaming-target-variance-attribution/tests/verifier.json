    {
      "name": "register_table_trap_ch04",
      "metadata": {
        "how_justification": "Parses shortfall_attribution.csv with csv.read_rows and applies table_equals to every graded cell of the CH-04 row (matched by 'channel_id'); a failure names the exact cell.",
        "why_justification": "Every channel's counted placement count, three parts and shortfall to target are graded, and the row population is locked to the channels in the plan file's order, so a register that drops a channel, duplicates one or invents one cannot pass; the parts re-adding to the shortfall is graded cell by cell rather than as a tolerance. Entailed by: \"One row per channel in `input/channel_plan.csv`, in that file's order. `counted_placements` is a whole number of placements; every other figure is a whole number of streams, a part that is zero written `0` and a part that ran the other way written with a leading minus sign.\"",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "read_rows",
          "arguments": {
            "path": "shortfall_attribution.csv"
          }
        }
      },
