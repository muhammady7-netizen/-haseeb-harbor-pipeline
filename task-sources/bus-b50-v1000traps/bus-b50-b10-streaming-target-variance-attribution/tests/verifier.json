    {
      "name": "memo_exists",
      "metadata": {
        "how_justification": "Checks campaign_review.md is present as a file in the workspace.",
        "why_justification": "The note for the label head is delivered.",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "filesystem",
          "command": "check_path_exists",
          "arguments": {
            "path": "campaign_review.md"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": true,
        "deterministic": {
          "path": "$.is_file",
          "comparison": "equals"
        }
      }
    },
    {
      "name": "memo_prose_floor",
      "metadata": {
        "how_justification": "Opens campaign_review.md with md.extract_text and applies regex_match.",
        "why_justification": "The note is written for a reader, not a dump of the totals the register produced. Requires at least 100 words of substantive prose with domain vocabulary, preventing hollow or fabricated memos.",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "md",
          "command": "extract_text",
          "arguments": {
            "path": "campaign_review.md"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?is)(?=.+\\b(?:conversion|placement|reach|shortfall|channel|stream)\\b)(?:[A-Za-z]+[^A-Za-z]+){100,}",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
    {
      "name": "memo_single_part_channel",
      "metadata": {
        "how_justification": "Opens campaign_review.md with md.extract_text and applies regex_match to verify a channel whose shortfall sits in a single part is named beside that part.",
        "why_justification": "The note names a channel whose whole gap the method leaves in one part of the split, beside the part it leaves it in. Any valid single-part channel is accepted.",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "md",
          "command": "extract_text",
          "arguments": {
            "path": "campaign_review.md"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?is)(?:\\bCH-\\d+\\w{0,}\\b(?:(?!(?:\\n[ \\t]*\\n|\\[Slide \\d)).){0,900}?\\b(?:placements|conversion|residual)(?:\\s+reach)?\\b|\\b(?:placements|conversion|residual)(?:\\s+reach)?\\w{0,}\\b(?:(?!(?:\\n[ \\t]*\\n|\\[Slide \\d)).){0,900}?\\bCH-\\d+)",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
    {
      "name": "memo_conversion_effect",
      "metadata": {
        "how_justification": "Opens campaign_review.md with md.extract_text and applies regex_match to verify the conversion effect figure appears beside its label. Accepts both bare digits and comma-grouped numbers.",
        "why_justification": "The campaign total of the conversion part is a material disclosed requirement the memo must state.",
        "tag": "incidental"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "md",
          "command": "extract_text",
          "arguments": {
            "path": "campaign_review.md"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?is)(?:\\bconversion[\\s*]+effect\\b[\\s\\S]{0,200}?\\b(?:127928|127,928)\\b|\\b(?:127928|127,928)\\b[\\s\\S]{0,200}?\\bconversion[\\s*]+effect\\b)",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
    {
      "name": "memo_counted_placements",
      "metadata": {
        "how_justification": "Opens campaign_review.md with md.extract_text and applies regex_match to verify the counted placements figure appears beside its label. Accepts both bare digits and comma-grouped numbers.",
        "why_justification": "The number of placements counted across every channel is a material disclosed requirement the memo must state.",
        "tag": "incidental"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "md",
          "command": "extract_text",
          "arguments": {
            "path": "campaign_review.md"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?is)(?:\\bcounted[\\s*]+placements\\b[\\s\\S]{0,96}?\\b(?:96)\\b|\\b(?:96)\\b[\\s\\S]{0,96}?\\bcounted[\\s*]+placements\\b)",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
