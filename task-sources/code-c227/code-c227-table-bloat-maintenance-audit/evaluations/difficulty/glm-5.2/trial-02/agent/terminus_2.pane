counts={'flagged_count':0,'autovacuum_disabled_count':0,'bloat_exceeded_count':0,'stale_statistics_count':0,'compliant_count':0}
for x in audit:
    counts['compliant_count'] += x['finding']=='none'
    counts['flagged_count'] += x['finding']!='none'
    counts['autovacuum_disabled_count'] += x['finding']=='AUTOVACUUM_DISABLED'
    counts['bloat_exceeded_count'] += x['finding']=='BLOAT_THRESHOLD_EXCEEDED'
    counts['stale_statistics_count'] += x['finding']=='STALE_STATISTICS'
print(counts)
