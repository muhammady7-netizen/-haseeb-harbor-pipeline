[231.937798, "i", "python3 - <<'PY'\nimport csv, json\nfrom datetime import datetime\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom collections import Counter\n\nrows = {}\nwith open('/app/input/table_health.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        rows.setdefault(r['table_name'], r)\n\nreindex = {}\nwith open('/app/input/reindex_log.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        reindex[r['table_name']] = r\n\nrecords = []\nfor t, r in rows.items():\n    tp = int(r['total_pages'])\n    dp = int(r['dead_pages'])\n    ratio = (Decimal(dp) / Decimal(tp)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    size = 'large' if tp >= 500 else 'small'\n    cap = Decimal('0.2') if size == 'large' else Decimal('0.4')\n    stale = (datetime.fromisoformat(r['audit_date']) - datetime.fromisoformat(r['last_analyzed'])).days > 30\n    if stale:\n        cap -= Decimal('0.05')\n\n    av_disabled = r['vacuum_type'].lower() == 'manual' or r['autovacuum_enabled'].lower() != 'true'\n    ri = reindex.get(t)\n    exempt = (\n    "]
[231.939694, "i", "    r['maintenance_active'].lower() == 'true'\n        and ri is not None\n        and ri['approved'].lower() == 'true'\n        and datetime.fromisoformat(ri['valid_until']) >= datetime.fromisoformat(r['audit_date'])\n    )\n\n    if av_disabled:\n        finding = 'AUTOVACUUM_DISABLED'\n    elif not exempt and ratio > cap:\n        finding = 'BLOAT_THRESHOLD_EXCEEDED'\n    elif stale:\n        finding = 'STALE_STATISTICS'\n    else:\n        finding = 'none'\n\n    records.append({\n        'last_analyzed': r['last_analyzed'],\n        'table_name': t,\n        'size_class': size,\n        'bloat_ratio': f'{ratio:.2f}',\n        'finding': finding,\n    })\n\nrecords.sort(key=lambda x: (x['last_analyzed'], x['table_name']))\n\nwith open('/app/bloat_audit.csv', 'w', newline='') as f:\n    w = csv.DictWriter(f, fieldnames=['table_name', 'size_class', 'bloat_ratio', 'finding'])\n    w.writeheader()\n    for rec in records:\n        w.writerow({k: rec[k] for k in ['table_name', 'size_class', 'bloat_ratio', 'finding']})\n\ncounts = Counter(r["]
[231.940598, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import csv, json\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import datetime\r\n\u001b[?2004l\r\u001b[?2004h> from decimal import Decimal, ROUND_HALF_UP\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.940748, "i", "'finding'] for r in records)\nresults = {\n    'flagged_count': sum(1 for r in records if r['finding'] != 'none'),\n    'autovacuum_disabled_count': counts['AUTOVACUUM_DISABLED'],\n    'bloat_exceeded_count': counts['BLOAT_THRESHOLD_EXCEEDED'],\n    'stale_statistics_count': counts['STALE_STATISTICS'],\n    'compliant_count': counts['none'],\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\n')\n\nprint(json.dumps(results, indent=2))\nprint(f'rows={len(records)}')\nPY\n"]
