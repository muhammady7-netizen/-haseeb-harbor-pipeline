[323.420231, "i", "python3 - <<'PY'\nimport csv, json, os\nfor p in ['bloat_audit.csv', 'bloat_memo.md', 'results.json']:\n    assert os.path.exists('/app/' + p), p\nwith open('/app/bloat_audit.csv', newline='') as f:\n    rows = list(csv.DictReader(f))\nassert list(rows[0].keys()) == ['table_name', 'size_class', 'bloat_ratio', 'finding']\nassert len(rows) == len({r['table_name'] for r in rows})\nwith open('/app/results.json') as f:\n    res = json.load(f)\nassert res['flagged_count'] == sum(1 for r in rows if r['finding'] != 'none')\nassert res['compliant_count'] == sum(1 for r in rows if r['finding'] == 'none')\nprint('OK', len(rows), res)\nPY\n"]
