[352.829663, "o", "> "]
[352.830301, "o", "    for r in csv.DictReader(f):\r\n\u001b[?2004l\r"]
[352.830535, "o", "\u001b[?2004h> "]
[352.831297, "o", "        tables.setdefault(r['table_name'], r)\r\n\u001b[?2004l\r"]
[352.831527, "o", "\u001b[?2004h"]
[352.831766, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.83207, "o", "rows = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.83234, "o", "> "]
[352.832922, "o", "for tn, r in tables.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.833526, "o", "    total = int(r['total_pages'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.833743, "o", "> "]
[352.834699, "o", "    dead = int(r['dead_pages'])\r\n\u001b[?2004l\r"]
[352.834843, "o", "\u001b[?2004h> "]
[352.835977, "o", "    size_class = 'large' if total >= 500 else 'small'\r\n\u001b[?2004l\red"]
[352.836239, "o", "\u001b[?2004h"]
[352.836491, "o", "> "]
[352.837502, "o", "    cap = Decimal('0.2') if size_class == 'large' else Decimal('0.4')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.838807, "o", "    raw = Decimal(dead) / Decimal(total)\r\n"]
[352.839099, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[352.841089, "o", "    ratio = raw.quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.841388, "o", "> "]
[352.843724, "o", "    stale_days = (date.fromisoformat(r['audit_date']) - date.fromisoformat(r['last_analyzed'])).days\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.843907, "o", ">     stale = stale_days > 30"]
[352.844127, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.845886, "o", "    eff_cap = cap - Decimal('0.05') if stale else cap\r\n\u001b[?2004l\r"]
[352.846133, "o", "\u001b[?2004h> "]
[352.847713, "o", "    autovac_disabled = r['autovacuum_enabled'].lower() != 'true' or r['vacuum_type'].lower() == 'manual'\r\n\u001b[?2004l\r"]
[352.847956, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rc\u001b[?2004h"]
[352.848121, "o", "> "]
[352.848332, "o", "    rl = reidx.get(tn)\r\n\u001b[?2004l\r"]
[352.848608, "o", "\u001b[?2004h>     exempt = False\r\n\u001b[?2004l\ra\u001b[?2004h"]
[352.84876, "o", "> "]
[352.849835, "o", "    if r['maintenance_active'].lower() == 'true' and rl is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.852462, "o", "        exempt = rl['approved'].lower() == 'true' and rl['valid_until'] >= r['audit_date']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[352.852917, "o", "\u001b[?2004h> "]
[352.853203, "o", "    if autovac_disabled:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.854371, "o", "        finding = 'AUTOVACUUM_DISABLED'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.855013, "o", "    elif not exempt and ratio > eff_cap:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.85606, "o", "        finding = 'BLOAT_THRESHOLD_EXCEEDED'\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.856375, "o", "> "]
[352.856582, "o", "    elif stale:\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.856915, "o", "> "]
[352.857892, "o", "        finding = 'STALE_STATISTICS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.858203, "o", "> "]
[352.858511, "o", "    else:\r\n\u001b[?2004l\r"]
[352.858709, "o", "\u001b[?2004h> "]
[352.859306, "o", "        finding = 'none'\r\n\u001b[?2004l\r"]
[352.859575, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[352.859829, "o", "> "]
[352.860026, "o", "    rows.append({\r\n\u001b[?2004l\r ove\u001b[?2004h> "]
[352.860289, "o", "        'table_name': tn,\r\n\u001b[?2004l\r"]
[352.86055, "o", "\u001b[?2004h> "]
[352.861433, "o", "        'last_analyzed': r['last_analyzed'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.862549, "o", "        'total_pages': total,\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.862774, "o", "> "]
[352.863604, "o", "        'dead_pages': dead,\r\n\u001b[?2004l\rd\u001b[?2004h> "]
[352.865047, "o", "        'raw': str(raw),\r\n"]
[352.865315, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[352.866337, "o", "        'ratio': str(ratio),\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.86668, "o", "> "]
[352.8682, "o", "        'size_class': size_class,"]
[352.868487, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.8694, "o", "        'cap': str(cap),\r\n\u001b[?2004l\rH\u001b[?2004h"]
[352.86969, "o", "> "]
[352.870141, "o", "        'eff_cap': str(eff_cap),\r\n\u001b[?2004l\r"]
[352.87058, "o", "\u001b[?2004h> "]
[352.870938, "o", "        'stale': stale,\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.871269, "o", "> "]
[352.871506, "o", "        'stale_days': stale_days,\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.871757, "o", "> "]
[352.873938, "o", "        'autovac_disabled': autovac_disabled,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.875099, "o", "        'exempt': exempt,\r\n\u001b[?2004l\r"]
[352.875433, "o", "\u001b[?2004h> "]
[352.875694, "o", "        'finding': finding,\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.87603, "o", ">     })\r\n\u001b[?2004l\r"]
[352.876252, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.877874, "o", "rows.sort(key=lambda x: (x['last_analyzed'], x['table_name']))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.878103, "o", "\r\n\u001b[?2004l\r"]
[352.878505, "o", "\u001b[?2004h> "]
[352.879405, "o", "with open('/app/bloat_audit.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r"]
[352.879627, "o", "\u001b[?2004h> "]
[352.879962, "o", "    w = csv.writer(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.880216, "o", "> "]
[352.881434, "o", "    w.writerow(['table_name', 'size_class', 'bloat_ratio', 'finding'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.882009, "o", "    for x in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.883826, "o", "        w.writerow([x['table_name'], x['size_class'], x['ratio'], x['finding']])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[352.884091, "o", "\u001b[?2004h> counts = {"]
