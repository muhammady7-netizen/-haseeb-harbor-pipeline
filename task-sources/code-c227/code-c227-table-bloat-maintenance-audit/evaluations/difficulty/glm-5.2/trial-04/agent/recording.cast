[352.897351, "o", "bullets = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.903681, "o", "\"T-13 is AUTOVACUUM_DISABLED because autovacuum_enabled is false and checked first; the large class is computed from total_pages 1000, its bloat ratio is 0.50 over cap 0.2, and 50 stale stats days do not override the autovacuum finding.\",\r\n\u001b[?2004l\r"]
[352.904032, "o", "\u001b[?2004h> "]
[352.906425, "o", "\"T-17 is AUTOVACUUM_DISABLED because autovacuum is false and checked first; the large class is computed from total_pages 1000, its bloat ratio is 0.40 over cap 0.2, and 50 stale stats days are not the finding.\",\r\n\u001b[?2004l\r"]
[352.906883, "o", "\u001b[?2004h> "]
[352.909151, "o", "\"T-27 is BLOAT_THRESHOLD_EXCEEDED because stats are stale for 46 days, so the large class computed from total_pages 1000 has a tightened cap of 0.15, and ratio 0.38 is over that effective cap.\",\r\n\u001b[?2004l\r"]
[352.909361, "o", "\u001b[?2004h> "]
[352.912297, "o", "\"T-04 is STALE_STATISTICS because date math gives 45 stale days, ignoring the legacy days_since_analyze field; the large class computed from total_pages 1000 has ratio 0.10 under tightened cap 0.15, so staleness remains.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.915224, "o", "\"T-21 is AUTOVACUUM_DISABLED because manual vacuum overrides autovacuum even though enabled; the large class computed from total_pages 1000 has ratio 0.20 and cap 0.2, but the manual vacuum override is checked first.\",\r\n\u001b[?2004l\r"]
[352.915438, "o", "\u001b[?2004h"]
[352.91573, "o", "> "]
[352.919877, "o", "\"T-26 is BLOAT_THRESHOLD_EXCEEDED since stats are stale for 36 days, the large class computed from total_pages 1000 tightens cap to 0.15, and ratio 0.18 exceeds that effective cap though it is under normal cap 0.2.\",\r\n\u001b[?2004l\r"]
[352.920306, "o", "\u001b[?2004h"]
[352.920607, "o", "> "]
[352.923705, "o", "\"T-30 is BLOAT_THRESHOLD_EXCEEDED because 36 stale days tighten the large cap computed from total_pages 1000 to 0.15, and ratio 0.20 is over that effective cap despite equaling the original 0.2 cap.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.923801, "o", "> "]
[352.926675, "o", "\"T-36 is BLOAT_THRESHOLD_EXCEEDED since 35 stale stats days tighten the large class computed from total_pages 1000 to cap 0.15, and ratio 0.18 is over the effective cap.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.929918, "o", "\"T-40 is STALE_STATISTICS because date computation yields 35 stale days, not the legacy days_since_analyze of 25; its large class computed from total_pages 1000 has ratio 0.05 under tightened cap 0.15, so staleness remains.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.929991, "o", "> "]
[352.933539, "o", "\"T-42 is BLOAT_THRESHOLD_EXCEEDED because 35 stale days tighten the large cap computed from total_pages 1000 to 0.15, so ratio 0.20 is over the effective cap even though it equals the original 0.2 cap.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.933797, "o", "> "]
[352.936742, "o", "\"T-45 is BLOAT_THRESHOLD_EXCEEDED because 33 stale days tighten the large class computed from total_pages 1000 to cap 0.15, and round-half-up makes the dead_pages/total_pages ratio 0.16 from 0.155, which is over the effective cap.\",\r\n\u001b[?2004l\r/bloat_\u001b[?2004h"]
[352.937069, "o", "> "]
[352.939049, "o", "\"T-10 is STALE_STATISTICS because date math gives 31 stale days, ignoring legacy days_since_analyze; its approved active reindex is valid, exempting the bloat check, but the large class computed from total_pages 1000 still has ratio 0.21 over cap 0.2.\",\r\n\u001b[?2004l\r"]
[352.939188, "o", "\u001b[?2004h> "]
[352.94022, "o", "\"T-16 is BLOAT_THRESHOLD_EXCEEDED because its reindex approval expired on 2026-08-25, so bloat applies; 31 stale days tighten the large cap computed from total_pages 1000 to 0.15, and ratio 0.20 is over that effective cap.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.940455, "o", "> "]
[352.941431, "o", "\"T-19 is BLOAT_THRESHOLD_EXCEEDED because the large class computed from total_pages 1000 has cap 0.2, and round-half-up makes the dead_pages/total_pages ratio 0.41 from 0.405, so it is over the cap.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.941513, "o", "> "]
[352.942353, "o", "\"T-06 is BLOAT_THRESHOLD_EXCEEDED because the large class computed from total_pages 1000 has ratio 0.25 over cap 0.2, with no stale stats or reindex exemption.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.942617, "o", "> "]
[352.943389, "o", "\"T-14 is BLOAT_THRESHOLD_EXCEEDED because the large class computed from total_pages 1000 has ratio 0.40 over cap 0.2, and stats are not stale.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.944442, "o", "\"T-18 is BLOAT_THRESHOLD_EXCEEDED because round-half-up raises the dead_pages/total_pages ratio from 0.205 to 0.21, which is over cap 0.2 for the large class computed from total_pages 1000.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.94552, "o", "\"T-20 is AUTOVACUUM_DISABLED because manual vacuum overrides autovacuum even though enabled; the large class computed from total_pages 1000 has ratio 0.10 under cap 0.2, but the manual vacuum override is checked first.\",\r\n\u001b[?2004l\r"]
[352.945747, "o", "\u001b[?2004h> "]
[352.946502, "o", "\"T-29 is BLOAT_THRESHOLD_EXCEEDED because its reindex approval expired on 2026-08-25, so bloat applies; the large class computed from total_pages 1000 has ratio 0.25 over cap 0.2.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.946623, "o", "> "]
[352.947341, "o", "\"T-35 is BLOAT_THRESHOLD_EXCEEDED because total_pages 500 computes a large class with cap 0.2, and ratio 0.22 is over that cap.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.947517, "o", "> "]
[352.948345, "o", "\"T-37 is BLOAT_THRESHOLD_EXCEEDED because its reindex approval expired on 2026-08-25, so bloat applies; the large class computed from total_pages 1000 has ratio 0.25 over cap 0.2.\",\r\n\u001b[?2004l\r"]
[352.948579, "o", "\u001b[?2004h> "]
[352.950024, "o", "\"T-39 is AUTOVACUUM_DISABLED because manual vacuum overrides autovacuum even though enabled; the large class computed from total_pages 1000 has ratio 0.05 under cap 0.2, but the manual vacuum override is checked first.\",\r\n\u001b[?2004l\r"]
[352.950399, "o", "\u001b[?2004h> "]
[352.951357, "o", "\"T-44 is BLOAT_THRESHOLD_EXCEEDED because the export medium trap is ignored and the computed large class comes from total_pages 600 with cap 0.2, so ratio 0.83 is over the cap.\",\r\n\u001b[?2004l\r"]
[352.951618, "o", "\u001b[?2004h> "]
[352.952508, "o", "\"T-08 is BLOAT_THRESHOLD_EXCEEDED because the large class computed from total_pages 1000 has ratio 0.45 over cap 0.2, with no stale stats or reindex exemption.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.952822, "o", "> "]
[352.95415, "o", "\"T-02 is BLOAT_THRESHOLD_EXCEEDED because the large class computed from total_pages 1000 has ratio 0.35 over cap 0.2, and stats are not stale.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.954427, "o", "> "]
[352.955517, "o", "\"T-03 is AUTOVACUUM_DISABLED because autovacuum_enabled is false and checked first; the large class computed from total_pages 1000 has ratio 0.15 under cap 0.2, but the disabled autovacuum overrides.\",\r\n\u001b[?2004l\r"]
[352.95559, "o", "\u001b[?2004h> "]
[352.956395, "o", "\"T-05 is BLOAT_THRESHOLD_EXCEEDED because its reindex is unapproved, so bloat applies; the large class computed from total_pages 1000 has ratio 0.55 over cap 0.2.\",\r\n\u001b[?2004l\r"]
[352.956601, "o", "\u001b[?2004h> "]
[352.957595, "o", "\"T-11 is AUTOVACUUM_DISABLED because autovacuum_enabled is false and checked first; the large class computed from total_pages 1000 has ratio 0.41 over cap 0.2, but the disabled autovacuum overrides.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.957848, "o", "> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[352.958083, "o", "\u001b[?2004h> "]
[352.958351, "o", "memo = \"# Bloat Maintenance Memo\\n\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.959908, "o", "memo += \"The audit computes bloat_ratio as dead_pages/total_pages with round-half-up to two decimals, computes size_class from total_pages, and ignores the export size_class column including the medium trap. Autovacuum is checked first, bloat is checked next with stale-statistics cap tightening, and stale statistics are checked last.\\n\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.960377, "o", "memo += \"## Non-compliant findings\\n\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.96061, "o", "for b in bullets:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.960895, "o", "    memo += \"- \" + b + \"\\n\"\r\n\u001b[?2004l\r"]
[352.961187, "o", "\u001b[?2004h> "]
[352.961569, "o", "memo += \"\\n## Active reindex and cap-equality notes\\n\\n\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.961752, "o", "> "]
[352.962509, "o", "memo += \"- T-28 has an approved active reindex valid through 2026-09-15, so its bloat ratio 0.25 over cap 0.2 is exempt and the finding is none.\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.963658, "o", "memo += \"- A computed ratio exactly equaling its size-class cap is compliant because the policy uses strictly greater than; thus T-12, T-15, T-32, T-34, and T-41 are none, while T-42 is not because stale stats tighten its cap.\\n\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.963877, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[352.964116, "o", "> "]
[352.964283, "o", "with open('/app/bloat_memo.md', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.964489, "o", "    f.write(memo)\r\n\u001b[?2004l\r\u001b[?2004h> PY"]
[352.964637, "o", "\r\n\u001b[?2004l\r"]
[353.023684, "o", "\u001b[?2004h\u001b[01;32mappuser@45d02f43f68b\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[353.771108, "i", "ls -l /app/bloat_audit.csv /app/bloat_memo.md /app/results.json\n"]
[353.771728, "o", "ls -l /app/bloat_audit.csv /app/bloat_memo.md /app/results.json\r\n\u001b[?2004l\r"]
[353.777027, "o", "-rw-r--r-- 1 appuser appuser 1446 Sep 18 13:17 /app/bloat_audit.csv\r\n-rw-r--r-- 1 appuser appuser 6260 Sep 18 13:17 /app/bloat_memo.md\r\n-rw-r--r-- 1 appuser appuser  146 Sep 18 13:17 /app/results.json\r\n"]
[353.777789, "o", "\u001b[?2004h\u001b[01;32mappuser@45d02f43f68b\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[354.197609, "i", "cat /app/results.json\n"]
[354.197963, "o", "cat /app/results.json\r\n\u001b[?2004l\r"]
[354.201628, "o", "{\r\n  \"flagged_count\": 28,\r\n  \"autovacuum_disabled_count\": 7,\r\n  \"bloat_exceeded_count\": 18,\r\n  \"stale_statistics_count\": 3,\r\n  \"compliant_count\": 13\r\n}\r\n"]
[354.20227, "o", "\u001b[?2004h\u001b[01;32mappuser@45d02f43f68b\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[408.127799, "i", "ls -l /app/bloat_audit.csv /app/bloat_memo.md /app/results.json\n"]
[408.128676, "o", "ls -l /app/bloat_audit.csv /app/bloat_memo.md /app/results.json\r\n\u001b[?2004l\r"]
[408.137293, "o", "-rw-r--r-- 1 appuser appuser 1446 Sep 18 13:17 /app/bloat_audit.csv\r\n-rw-r--r-- 1 appuser appuser 6260 Sep 18 13:17 /app/bloat_memo.md\r\n-rw-r--r-- 1 appuser appuser  146 Sep 18 13:17 /app/results.json\r\n"]
[408.138397, "o", "\u001b[?2004h\u001b[01;32mappuser@45d02f43f68b\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
