[352.820362, "i", "last_analyzed'], x['table_name']))\n\nwith open('/app/bloat_audit.csv', 'w', newline='') as f:\n    w = csv.writer(f)\n    w.writerow(['table_name', 'size_class', 'bloat_ratio', 'finding'])\n    for x in rows:\n        w.writerow([x['table_name'], x['size_class'], x['ratio'], x['finding']])\n\ncounts = {\n    'flagged_count': sum(1 for x in rows if x['finding'] != 'none'),\n    'autovacuum_disabled_count': sum(1 for x in rows if x['finding'] == 'AUTOVACUUM_DISABLED'),\n    'bloat_exceeded_count': sum(1 for x in rows if x['finding'] == 'BLOAT_THRESHOLD_EXCEEDED'),\n    'stale_statistics_count': sum(1 for x in rows if x['finding'] == 'STALE_STATISTICS'),\n    'compliant_count': sum(1 for x in rows if x['finding'] == 'none'),\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(counts, f, indent=2)\n    f.write('\\n')\n\nbullets = [\n\"T-13 is AUTOVACUUM_DISABLED because autovacuum_enabled is false and checked first; the large class is computed from total_pages 1000, its bloat ratio is 0.50 over cap 0.2, and 50 stale stats da"]
