[352.818545, "i", "python3 - <<'PY'\nimport csv, json\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom collections import OrderedDict\n\nhealth_path = '/app/input/table_health.csv'\nreindex_path = '/app/input/reindex_log.csv'\n\nreidx = {}\nwith open(reindex_path, newline='') as f:\n    for r in csv.DictReader(f):\n        reidx[r['table_name']] = r\n\ntables = OrderedDict()\nwith open(health_path, newline='') as f:\n    for r in csv.DictReader(f):\n        tables.setdefault(r['table_name'], r)\n\nrows = []\nfor tn, r in tables.items():\n    total = int(r['total_pages'])\n    dead = int(r['dead_pages'])\n    size_class = 'large' if total >= 500 else 'small'\n    cap = Decimal('0.2') if size_class == 'large' else Decimal('0.4')\n    raw = Decimal(dead) / Decimal(total)\n    ratio = raw.quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    stale_days = (date.fromisoformat(r['audit_date']) - date.fromisoformat(r['last_analyzed'])).days\n    stale = stale_days > 30\n    eff_cap = cap - Decimal('0.05') if stale else cap\n    autovac_"]
[352.819668, "i", "disabled = r['autovacuum_enabled'].lower() != 'true' or r['vacuum_type'].lower() == 'manual'\n\n    rl = reidx.get(tn)\n    exempt = False\n    if r['maintenance_active'].lower() == 'true' and rl is not None:\n        exempt = rl['approved'].lower() == 'true' and rl['valid_until'] >= r['audit_date']\n\n    if autovac_disabled:\n        finding = 'AUTOVACUUM_DISABLED'\n    elif not exempt and ratio > eff_cap:\n        finding = 'BLOAT_THRESHOLD_EXCEEDED'\n    elif stale:\n        finding = 'STALE_STATISTICS'\n    else:\n        finding = 'none'\n\n    rows.append({\n        'table_name': tn,\n        'last_analyzed': r['last_analyzed'],\n        'total_pages': total,\n        'dead_pages': dead,\n        'raw': str(raw),\n        'ratio': str(ratio),\n        'size_class': size_class,\n        'cap': str(cap),\n        'eff_cap': str(eff_cap),\n        'stale': stale,\n        'stale_days': stale_days,\n        'autovac_disabled': autovac_disabled,\n        'exempt': exempt,\n        'finding': finding,\n    })\n\nrows.sort(key=lambda x: (x['"]
