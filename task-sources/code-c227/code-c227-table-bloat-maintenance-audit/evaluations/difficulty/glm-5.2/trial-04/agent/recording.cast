[14.120805, "o", "\u001b[?2004h\u001b[01;32mappuser@45d02f43f68b\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[46.300389, "i", "python3 - <<'PY'\nimport csv, json\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom collections import OrderedDict\n\nhealth='/app/input/table_health.csv'\nreindex='/app/input/reindex_log.csv'\n\ndef days_between(a,b):\n    return (date.fromisoformat(a)-date.fromisoformat(b)).days\n\ndef ratio_round_half_up(dead,total):\n    return Decimal(dead)/Decimal(total)\n\ndef fmt_ratio(d):\n    return str(d.quantize(Decimal('0.01'), rounding=ROUND_HALF_UP))\n\n# load reindex\nreidx={}\nwith open(reindex,newline='') as f:\n    for r in csv.DictReader(f):\n        reidx[r['table_name']]=r\n\n# load health dedupe by table_name\ntables=OrderedDict()\nwith open(health,newline='') as f:\n    for r in csv.DictReader(f):\n        tables.setdefault(r['table_name'], r)\n\nrows=[]\nfor tn,r in tables.items():\n    total=int(r['total_pages'])\n    dead=int(r['dead_pages'])\n    size_class='large' if total>=500 else 'small'\n    cap=Decimal('0.2') if size_class=='large' else Decimal('0.4')\n    raw=Decimal(dead)/Decimal(total)\n    ratio=r"]
[46.30223, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[46.302547, "i", "aw.quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    stale=days_between(r['audit_date'], r['last_analyzed']) > 30\n    stale_days=days_between(r['audit_date'], r['last_analyzed'])\n    eff_cap=cap\n    if stale:\n        eff_cap=cap-Decimal('0.05')\n    autovac_disabled = (r['autovacuum_enabled'].lower()!='true') or (r['vacuum_type'].lower()=='manual')\n    # reindex exemption\n    rl=reidx.get(tn)\n    exempt=False\n    if r['maintenance_active'].lower()=='true' and rl is not None:\n        approved=rl['approved'].lower()=='true'\n        valid=rl['valid_until'] >= r['audit_date']\n        exempt=approved and valid\n    if autovac_disabled:\n        finding='AUTOVACUUM_DISABLED'\n    elif (not exempt) and ratio > eff_cap:\n        finding='BLOAT_THRESHOLD_EXCEEDED'\n    elif stale:\n        finding='STALE_STATISTICS'\n    else:\n        finding='none'\n    rows.append({\n        'table_name':tn,\n        'last_analyzed':r['last_analyzed'],\n        'total_pages':total,\n        'dead_pages':dead,\n        'raw':str(raw),\n        "]
[46.302861, "o", "\u001b[?2004h> import csv, json\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.30319, "i", "'ratio':fmt_ratio(ratio),\n        'size_class':size_class,\n        'cap':str(cap),\n        'eff_cap':str(eff_cap),\n        'stale':stale,\n        'stale_days':stale_days,\n        'autovac_disabled':autovac_disabled,\n        'exempt':exempt,\n        'maintenance_active':r['maintenance_active'],\n        'finding':finding\n    })\n\nrows.sort(key=lambda x:(x['last_analyzed'], x['table_name']))\nfor x in rows:\n    print(f\"{x['table_name']} last={x['last_analyzed']} total={x['total_pages']} dead={x['dead_pages']} raw={x['raw']} ratio={x['ratio']} class={x['size_class']} cap={x['cap']} eff={x['eff_cap']} stale={x['stale']} days={x['stale_days']} autodis={x['autovac_disabled']} exempt={x['exempt']} finding={x['finding']}\")\nprint('counts')\nfrom collections import Counter\nc=Counter(x['finding'] for x in rows)\nprint(c)\nprint('flagged', sum(1 for x in rows if x['finding']!='none'))\nprint('rows', len(rows))\nPY\n"]
