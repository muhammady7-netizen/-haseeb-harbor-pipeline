[352.884582, "o", "> "]
[352.885453, "o", "    'flagged_count': sum(1 for x in rows if x['finding'] != 'none'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.887815, "o", "    'autovacuum_disabled_count': sum(1 for x in rows if x['finding'] == 'AUTOVACUUM_DISABLED'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.889544, "o", "    'bloat_exceeded_count': sum(1 for x in rows if x['finding'] == 'BLOAT_THRESHOLD_EXCEEDED'),\r\n\u001b[?2004l\r"]
[352.889868, "o", "\u001b[?2004h> "]
[352.891646, "o", "    'stale_statistics_count': sum(1 for x in rows if x['finding'] == 'STALE_STATISTICS'),\r\n\u001b[?2004l\r"]
[352.891919, "o", "\u001b[?2004h> "]
[352.893808, "o", "    'compliant_count': sum(1 for x in rows if x['finding'] == 'none'),\r\n\u001b[?2004l\r"]
