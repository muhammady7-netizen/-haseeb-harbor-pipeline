[419.568558, "i", "python3 - <<'PY'\nimport csv,datetime\nfrom decimal import Decimal,ROUND_HALF_UP\nfrom collections import OrderedDict\ndef t(v): return v.strip().lower()=='true'\ndef q(x): return Decimal(x).quantize(Decimal('0.01'),rounding=ROUND_HALF_UP)\nrows=OrderedDict()\nfor r in csv.DictReader(open('/app/input/table_health.csv')):\n    if r['table_name'] not in rows: rows[r['table_name']]=r\nrx={}\nfor r in csv.DictReader(open('/app/input/reindex_log.csv')):\n    rx[r['table_name']]=(t(r['approved']),datetime.date.fromisoformat(r['valid_until']))\nfor r in rows.values():\n    tp=int(r['total_pages']); dp=int(r['dead_pages']); ratio=q(Decimal(dp)/Decimal(tp))\n    sc='large' if tp>=500 else 'small'; cap=Decimal('0.20') if sc=='large' else Decimal('0.40')\n    ad=datetime.date.fromisoformat(r['audit_date']); la=datetime.date.fromisoformat(r['last_analyzed']); days=(ad-la).days\n    stale=days>30; ec=cap-Decimal('0.05') if stale else cap\n    auto=(not t(r['autovacuum_enabled'])) or r['vacuum_type'].strip().lower()=='manual'\n    ex=False\n"]
[419.569017, "i", "    if t(r['maintenance_active']):\n        a,v=rx.get(r['table_name'],(False,None))\n        if a and v and v>=ad: ex=True\n    print(f\"{r['table_name']} tp={tp} dp={dp} ratio={ratio} sc={sc} cap={cap} days={days} stale={stale} eff={ec} auto={auto} exempt={ex} vt={r['vacuum_type']} maint={r['maintenance_active']} finding=\")\nPY\n"]
