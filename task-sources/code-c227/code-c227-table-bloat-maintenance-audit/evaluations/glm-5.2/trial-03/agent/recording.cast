[419.643494, "o", "\u001b[?2004h\u001b[01;32mappuser@7174e9fb4e09\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[606.044813, "i", "cat > /app/gen_memo.py <<'PY'\nimport csv, datetime\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom collections import OrderedDict\n\ndef t(v): return v.strip().lower() == 'true'\ndef q(x): return Decimal(x).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n\nrows = OrderedDict()\nfor r in csv.DictReader(open('/app/input/table_health.csv')):\n    if r['table_name'] not in rows:\n        rows[r['table_name']] = r\n\nrx = {}\nfor r in csv.DictReader(open('/app/input/reindex_log.csv')):\n    rx[r['table_name']] = (t(r['approved']), datetime.date.fromisoformat(r['valid_until']))\n\nrecs = []\nfor r in rows.values():\n    tp = int(r['total_pages'])\n    dp = int(r['dead_pages'])\n    ratio = q(Decimal(dp) / Decimal(tp))\n    pre = Decimal(dp) / Decimal(tp)\n    sc = 'large' if tp >= 500 else 'small'\n    cap = Decimal('0.20') if sc == 'large' else Decimal('0.40')\n    ad = datetime.date.fromisoformat(r['audit_date'])\n    la = datetime.date.fromisoformat(r['last_analyzed'])\n    days = (ad - la).days\n    stale = days > 30\n    ec = cap - "]
[606.045031, "i", "Decimal('0.05') if stale else cap\n    auto = (not t(r['autovacuum_enabled'])) or r['vacuum_type'].strip().lower() == 'manual'\n    ex = False\n    approved = False\n    valid_until = None\n    if t(r['maintenance_active']):\n        approved, valid_until = rx.get(r['table_name'], (False, None))\n        if approved and valid_until and valid_until >= ad:\n            ex = True\n    if auto:\n        f = 'AUTOVACUUM_DISABLED'\n    elif ex:\n        f = 'STALE_STATISTICS' if stale else 'none'\n    elif ratio > ec:\n        f = 'BLOAT_THRESHOLD_EXCEEDED'\n    elif stale:\n        f = 'STALE_STATISTICS'\n    else:\n        f = 'none'\n    recs.append(dict(name=r['table_name'], exp_sc=r['size_class'], tp=tp, dp=dp, ratio=ratio,\n                    pre=pre, sc=sc, cap=cap, days=days, stale=stale, ec=ec, auto=auto,\n                    ex=ex, approved=approved, valid_until=valid_until, maint=t(r['maintenance_active']),\n                    vt=r['vacuum_type'], f=f, la=la))\n\nrecs.sort(key=lambda x: (x['la'], x['name']))\n\nlines = []\nlines"]
[606.045809, "i", ".append(\"# Monthly table maintenance audit memo\")\nlines.append(\"\")\nlines.append(\"Audit date: 2026-09-01. Bloat ratios were computed as `dead_pages / total_pages` with round-half-up to 2 decimal places, and `size_class` was computed from `total_pages`, ignoring the export `size_class` column. A computed ratio equal to the size-class cap is compliant because only a ratio strictly over the cap is flagged; for example, a large table with ratio 0.20 or a small table with ratio 0.40 is not over cap.\")\nlines.append(\"\")\nlines.append(\"## Flagged findings\")\n\nfor x in recs:\n    if x['f'] == 'none':\n        continue\n    name = x['name']\n    f = x['f']\n    ratio = x['ratio']\n    cap = x['cap']\n    sc = x['sc']\n    tp = x['tp']\n\n    if f == 'AUTOVACUUM_DISABLED':\n        if x['vt'] == 'manual':\n            reason = \"manual vacuum overrides autovacuum even though autovacuum_enabled=True\"\n        else:\n            reason = \"autovacuum is disabled and overrides every other check\"\n        s = f\"- **{name}**: AUTOVACUUM_DISABLE"]
[606.045925, "o", "cat > /app/gen_memo.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import csv, datetime\r\n\u001b[?2004l\r"]
[606.046004, "i", "D applies because {reason}; computed {sc} from {tp} total_pages, ratio {ratio}, cap {cap}.\"\n\n    elif f == 'BLOAT_THRESHOLD_EXCEEDED':\n        parts = [f\"computed {sc} from {tp} total_pages\", f\"ratio {ratio}\", f\"normal cap {cap}\"]\n        if x['stale']:\n            parts.append(f\"stale stats {x['days']} days tighten the effective cap to {x['ec']}\")\n            parts.append(\"days_since_analyze ignored\")\n        if x['pre'] in (Decimal('0.405'), Decimal('0.205'), Decimal('0.155')):\n            parts.append(f\"round-half-up of {x['pre']} gives {ratio}\")\n        if x['exp_sc'].strip().lower() == 'medium':\n            parts.append(\"export size_class medium trap ignored\")\n        if x['maint']:\n            if not x['approved']:\n                parts.append(\"unapproved reindex does not exempt bloat\")\n            elif x['valid_until'] and not (x['valid_until'] >= datetime.date.fromisoformat('2026-09-01')):\n                parts.append(f\"reindex expired (valid_until {x['valid_until']})\")\n        s = f\"- **{name}**: BLO"]
[606.046347, "o", "\u001b[?2004h> "]
[606.046633, "i", "AT_THRESHOLD_EXCEEDED applies because \" + \"; \".join(parts) + \".\"\n\n    else:  # STALE_STATISTICS\n        parts = [f\"computed {sc} from {tp} total_pages\", f\"ratio {ratio}\", f\"normal cap {cap}\",\n                 f\"stale stats {x['days']} days tighten the effective cap to {x['ec']}\",\n                 \"days_since_analyze ignored\"]\n        if x['ex']:\n            parts.append(f\"approved active reindex exempts bloat (valid_until {x['valid_until']})\")\n        s = f\"- **{name}**: STALE_STATISTICS applies because \" + \"; \".join(parts) + \".\"\n\n    lines.append(s)\n\nopen('/app/bloat_memo.md', 'w').write(\"\\n\".join(lines) + \"\\n\")\nprint(\"wrote memo\", len([x for x in recs if x['f'] != 'none']), \"findings\")\nPY\npython3 /app/gen_memo.py\n"]
[606.04693, "o", "from decimal import Decimal, ROUND_HALF_UP\r\n\u001b[?2004l\r\u001b[?2004h> from collections import OrderedDict\r\n\u001b[?2004l\r"]
[606.047223, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[606.048461, "o", "def t(v): return v.strip().lower() == 'true'\r\n\u001b[?2004l\rno\u001b[?2004h"]
[606.04878, "o", "> "]
[606.050903, "o", "def q(x): return Decimal(x).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> rows = OrderedDict()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[606.051996, "o", "for r in csv.DictReader(open('/app/input/table_health.csv')):\r\n\u001b[?2004l\r\u001b[?2004h"]
[606.052294, "o", "> "]
[606.053239, "o", "    if r['table_name'] not in rows:\r\n\u001b[?2004l\rd(\u001b[?2004h> "]
[606.054049, "o", "        rows[r['table_name']] = r\r\n\u001b[?2004l\r"]
[606.05428, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[606.054533, "o", "rx = {}\r\n\u001b[?2004l\r"]
[606.054847, "o", "\u001b[?2004h> "]
