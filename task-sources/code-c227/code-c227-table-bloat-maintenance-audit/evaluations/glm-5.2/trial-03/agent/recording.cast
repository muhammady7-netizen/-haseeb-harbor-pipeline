[16.02511, "o", "\u001b[?2004h\u001b[01;32mappuser@7174e9fb4e09\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[381.591274, "i", "cat > /app/gen_audit.py <<'PY'\nimport csv,json,datetime\nfrom decimal import Decimal,ROUND_HALF_UP\nfrom collections import OrderedDict\ndef t(v): return v.strip().lower()=='true'\ndef q(x): return Decimal(x).quantize(Decimal('0.01'),rounding=ROUND_HALF_UP)\nrows=OrderedDict()\nfor r in csv.DictReader(open('/app/input/table_health.csv')):\n    if r['table_name'] not in rows: rows[r['table_name']]=r\nrx={}\nfor r in csv.DictReader(open('/app/input/reindex_log.csv')):\n    rx[r['table_name']]=(t(r['approved']),datetime.date.fromisoformat(r['valid_until']))\nrecs=[]\nfor r in rows.values():\n    tp=int(r['total_pages']); dp=int(r['dead_pages'])\n    ratio=q(Decimal(dp)/Decimal(tp))\n    sc='large' if tp>=500 else 'small'\n    cap=Decimal('0.20') if sc=='large' else Decimal('0.40')\n    ad=datetime.date.fromisoformat(r['audit_date']); la=datetime.date.fromisoformat(r['last_analyzed'])\n    days=(ad-la).days; stale=days>30\n    ec=cap-Decimal('0.05') if stale else cap\n    auto=(not t(r['autovacuum_enabled'])) or r['vacuum_type'].str"]
[381.592665, "o", "cat > /app/gen_audit.py <<'PY'\r\n\u001b[?2004l\r"]
[381.593077, "i", "ip().lower()=='manual'\n    ex=False\n    if t(r['maintenance_active']):\n        a,v=rx.get(r['table_name'],(False,None))\n        if a and v and v>=ad: ex=True\n    if auto: f='AUTOVACUUM_DISABLED'\n    elif ex: f='STALE_STATISTICS' if stale else 'none'\n    elif ratio>ec: f='BLOAT_THRESHOLD_EXCEEDED'\n    elif stale: f='STALE_STATISTICS'\n    else: f='none'\n    recs.append((la,r['table_name'],sc,ratio,f))\nrecs.sort(key=lambda x:(x[0],x[1]))\nwith open('/app/bloat_audit.csv','w',newline='') as fo:\n    w=csv.writer(fo); w.writerow(['table_name','size_class','bloat_ratio','finding'])\n    for x in recs: w.writerow([x[1],x[2],x[3],x[4]])\nc={'flagged_count':0,'autovacuum_disabled_count':0,'bloat_exceeded_count':0,'stale_statistics_count':0,'compliant_count':0}\nfor x in recs:\n    f=x[4]\n    if f!='none': c['flagged_count']+=1\n    if f=='AUTOVACUUM_DISABLED': c['autovacuum_disabled_count']+=1\n    if f=='BLOAT_THRESHOLD_EXCEEDED': c['bloat_exceeded_count']+=1\n    if f=='STALE_STATISTICS': c['stale_statistics_count']+=1\n    i"]
[381.593333, "o", "\u001b[?2004h> import csv,json,datetime\r\n\u001b[?2004l\r\u001b[?2004h> from decimal import Decimal,ROUND_HALF_UP\r\n\u001b[?2004l\r\u001b[?2004h> from collections import OrderedDict\r\n\u001b[?2004l\r\u001b[?2004h> def t(v): return v.strip().lower()=='true'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[381.593704, "i", "f f=='none': c['compliant_count']+=1\njson.dump(c,open('/app/results.json','w'),indent=2)\nprint('generated',len(recs),'rows')\nPY\npython3 /app/gen_audit.py\n"]
