[606.056097, "o", "\u001b[?2004h> "]
[606.057521, "o", "    rx[r['table_name']] = (t(r['approved']), datetime.date.fromisoformat(r['valid_until']))\r\n\u001b[?2004l\r"]
[606.057798, "o", "\u001b[?2004h> "]
[606.058103, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> recs = []"]
[606.05848, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> for r in rows.values():\r\n\u001b[?2004l\r"]
[606.05882, "o", "\u001b[?2004h> "]
[606.059415, "o", "    tp = int(r['total_pages'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[606.059692, "o", "    dp = int(r['dead_pages'])\r\n\u001b[?2004l\r"]
[606.059975, "o", "\u001b[?2004h> "]
[606.06075, "o", "    ratio = q(Decimal(dp) / Decimal(tp))\r\n\u001b[?2004l\rn\u001b[?2004h"]
[606.061064, "o", "> "]
[606.061761, "o", "    pre = Decimal(dp) / Decimal(tp)\r\n\u001b[?2004l\r\u001b[?2004h"]
[606.062083, "o", "> "]
[606.062241, "o", "    sc = 'large' if tp >= 500 else 'small'\r\n\u001b[?2004l\r"]
[606.06237, "o", "\u001b[?2004h> "]
[606.062881, "o", "    cap = Decimal('0.20') if sc == 'large' else Decimal('0.40')\r\n\u001b[?2004l\r"]
[606.063128, "o", "\u001b[?2004h> "]
[606.063538, "o", "    ad = datetime.date.fromisoformat(r['audit_date'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[606.063853, "o", "> "]
[606.064126, "o", "    la = datetime.date.fromisoformat(r['last_analyzed'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[606.064379, "o", ">     days = (ad - la).days\r\n\u001b[?2004l\r"]
[606.064737, "o", "\u001b[?2004h"]
[606.065184, "o", ">     stale = days > 30\r\n\u001b[?2004l\r"]
[606.066117, "o", "\u001b[?2004h> "]
[606.06654, "o", "    ec = cap - Decimal('0.05') if stale else cap\r\n\u001b[?2004l\r"]
[606.066867, "o", "\u001b[?2004h> "]
[606.067747, "o", "    auto = (not t(r['autovacuum_enabled'])) or r['vacuum_type'].strip().lower() == 'manual'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[606.068027, "o", "    ex = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
