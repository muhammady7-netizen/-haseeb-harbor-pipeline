[346.291988, "o", "# Monthly Table Maintenance Review Memo\r\n\r\nAudit date: 2026-09-01. The audit computes bloat_ratio as dead_pages / total_pages using round-half-up to 2 decimal places and computes size_class from total_pages only.\r\n\r\n## Findings\r\n\r\n- T-13 is AUTOVACUUM_DISABLED because autovacuum_enabled False disables autovacuum and overrides bloat; computed size class large from total_pages 1000, ratio 0.50 over cap 0.2. Stats are 50 days stale and would tighten cap to 0.15, but autovacuum is checked first.\r\n- T-17 is AUTOVACUUM_DISABLED because autovacuum_enabled False disables autovacuum and overrides bloat; computed size class large from total_pages 1000, ratio 0.40 over cap 0.2. Stats are 50 days stale and would tighten cap to 0.15, but autovacuum is checked first.\r\n- T-27 is BLOAT_THRESHOLD_EXCEEDED because computed size class large from total_pages 1000, dead_pages 380 over total_pages 1000 rounds half-up to ratio 0.38, ratio 0.38 over cap 0.2; stale stats computed as 46 days tighten the effective cap to 0.15, and rati"]
[346.292359, "o", "o 0.38 exceeds the tightened cap; days_since_analyze legacy field ignored\r\n- T-04 is STALE_STATISTICS because computed size class large from total_pages 1000, stale stats computed as 45 days, ratio 0.10 under tightened cap 0.15; days_since_analyze legacy field ignored\r\n- T-21 is AUTOVACUUM_DISABLED because vacuum_type manual overrides autovacuum even with autovacuum_enabled True, so autovacuum is disabled; computed size class large from total_pages 1000, ratio 0.20 over cap 0.2. Stats are 45 days stale and would tighten cap to 0.15, but autovacuum is checked first.\r\n- T-26 is BLOAT_THRESHOLD_EXCEEDED because computed size class large from total_pages 1000, dead_pages 180 over total_pages 1000 rounds half-up to ratio 0.18, ratio 0.18 over cap 0.2; stale stats computed as 36 days tighten the effective cap to 0.15, and ratio 0.18 exceeds the tightened cap; days_since_analyze legacy field ignored\r\n"]
[346.292817, "o", "\u001b[?2004h\u001b[01;32mappuser@470c12ff963c\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[387.791702, "i", "python3 - <<'PY'\nimport csv\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\n\nreidx = {}\nwith open('/app/input/reindex_log.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        reidx[r['table_name']] = (r['approved'].strip().lower() == 'true', date.fromisoformat(r['valid_until']))\n\nrows = {}\nwith open('/app/input/table_health.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        rows.setdefault(r['table_name'], r)\n\naudit = []\nfor tn, r in rows.items():\n    total = int(r['total_pages'])\n    dead = int(r['dead_pages'])\n    ratio = (Decimal(dead) / Decimal(total)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    size_class = 'large' if total >= 500 else 'small'\n    cap = Decimal('0.2') if size_class == 'large' else Decimal('0.4')\n    autovacuum = r['autovacuum_enabled'].strip().lower() == 'true'\n    vacuum_type = r['vacuum_type'].strip()\n    audit_date = date.fromisoformat(r['audit_date'])\n    last_analyzed = date.fromisoformat(r['last_analyzed'])\n    days = (audit_da"]
[387.792067, "i", "te - last_analyzed).days\n    stale = days > 30\n    maint = r['maintenance_active'].strip().lower() == 'true'\n    approved, valid_until = reidx.get(tn, (False, date.min))\n    exempt = maint and approved and valid_until >= audit_date\n    eff_cap = cap - Decimal('0.05') if stale else cap\n\n    if (not autovacuum) or vacuum_type == 'manual':\n        finding = 'AUTOVACUUM_DISABLED'\n    elif not exempt and ratio > eff_cap:\n        finding = 'BLOAT_THRESHOLD_EXCEEDED'\n    elif stale:\n        finding = 'STALE_STATISTICS'\n    else:\n        finding = 'none'\n\n    audit.append({\n        'table_name': tn, 'size_class': size_class, 'bloat_ratio': f'{ratio:.2f}',\n        'finding': finding, 'last_analyzed': last_analyzed, 'total_pages': total,\n        'dead_pages': dead, 'cap': cap, 'eff_cap': eff_cap, 'days': days, 'stale': stale,\n        'exempt': exempt, 'approved': approved, 'valid_until': valid_until,\n        'vacuum_type': vacuum_type, 'autovacuum': autovacuum, 'maint': maint,\n        'export_size_class': r['size_class"]
[387.792343, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r"]
[387.792704, "i", "'], 'audit_date': audit_date,\n    })\n\naudit.sort(key=lambda x: (x['last_analyzed'], x['table_name']))\n\ndef cap_relation(ratio, cap):\n    if ratio > cap:\n        return 'exceeds cap'\n    if ratio == cap:\n        return 'equals cap'\n    return 'is under cap'\n\nmemo = [\n    '# Monthly Table Maintenance Review Memo',\n    '',\n    'Audit date: 2026-09-01. The audit computes bloat_ratio as dead_pages / total_pages using round-half-up to 2 decimal places and computes size_class from total_pages only.',\n    '',\n    '## Findings',\n    '',\n]\n\nfor x in audit:\n    tn = x['table_name']\n    finding = x['finding']\n    if finding == 'none':\n        continue\n    ratio = x['bloat_ratio']\n    cap = x['cap']\n    eff = x['eff_cap']\n    total = x['total_pages']\n    days = x['days']\n    parts = []\n\n    if finding == 'AUTOVACUUM_DISABLED':\n        if x['vacuum_type'] == 'manual':\n            parts.append('vacuum_type manual overrides autovacuum even with autovacuum_enabled True, so autovacuum is disabled')\n        else:\n            pa"]
[387.792989, "o", "\u001b[?2004h> from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.793074, "i", "rts.append('autovacuum_enabled False disables autovacuum and overrides bloat')\n        parts.append(f'computed size class {x[\"size_class\"]} from total_pages {total}')\n        parts.append(f'ratio {ratio} {cap_relation(Decimal(ratio), cap)} {cap}')\n        if x['stale']:\n            parts.append(f'stale stats computed as {days} days would tighten the effective cap to {eff}, but autovacuum is checked first and days_since_analyze legacy field ignored')\n\n    elif finding == 'BLOAT_THRESHOLD_EXCEEDED':\n        parts.append(f'computed size class {x[\"size_class\"]} from total_pages {total}')\n        parts.append(f'dead_pages {x[\"dead_pages\"]} over total_pages {total} rounds half-up to ratio {ratio}')\n        if x['stale']:\n            parts.append(f'ratio {ratio} {cap_relation(Decimal(ratio), cap)} {cap}; stale stats computed as {days} days tighten the effective cap to {eff}, and ratio {ratio} exceeds the tightened cap; days_since_analyze legacy field ignored')\n        else:\n            parts.append(f'ratio {ratio} e"]
