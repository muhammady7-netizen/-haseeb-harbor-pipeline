[413.110745, "i", "python3 - <<'PY'\nimport csv, json\nfrom pathlib import Path\nfor name in ['bloat_audit.csv', 'bloat_memo.md', 'results.json']:\n    path = Path('/app') / name\n    print(name, path.exists(), path.stat().st_size)\nwith open('/app/bloat_audit.csv', newline='') as f:\n    rows = list(csv.DictReader(f))\nprint('csv_rows', len(rows), 'columns', list(rows[0].keys()))\nprint('first_row', rows[0])\nprint('last_row', rows[-1])\nprint(json.load(open('/app/results.json')))\nPY\n"]
