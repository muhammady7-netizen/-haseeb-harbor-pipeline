[206.911597, "i", "_until': valid_until if tn in reidx else None,\n        'vacuum_type': vtype,\n        'autovacuum_enabled': auto,\n        'maintenance_active': maint,\n    })\n\naudit.sort(key=lambda x: (x['last_analyzed'], x['table_name']))\n\nfor x in audit:\n    print(x['table_name'], x['size_class'], x['bloat_ratio'], x['finding'], 'days=',x['stale_days'],'cap=',x['cap'],'eff=',x['effective_cap'],'exempt=',x['exempt'],'auto=',x['autovacuum_enabled'],x['vacuum_type'],'maint=',x['maintenance_active'], 'total=',x['total_pages'],'dead=',x['dead_pages'])\n\ncounts={'flagged_count':0,'autovacuum_disabled_count':0,'bloat_exceeded_count':0,'stale_statistics_count':0,'compliant_count':0}\nfor x in audit:\n    counts['compliant_count'] += x['finding']=='none'\n    counts['flagged_count'] += x['finding']!='none'\n    counts['autovacuum_disabled_count'] += x['finding']=='AUTOVACUUM_DISABLED'\n    counts['bloat_exceeded_count'] += x['finding']=='BLOAT_THRESHOLD_EXCEEDED'\n    counts['stale_statistics_count'] += x['finding']=='STALE_STATISTICS'\nprin"]
