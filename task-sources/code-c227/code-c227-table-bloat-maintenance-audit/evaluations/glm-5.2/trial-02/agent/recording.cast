[344.804664, "i", "f.write('\\n')\n\nmemo = [\n    '# Monthly Table Maintenance Review Memo',\n    '',\n    'Audit date: 2026-09-01. The audit computes bloat_ratio as dead_pages / total_pages using round-half-up to 2 decimal places and computes size_class from total_pages only.',\n    '',\n    '## Findings',\n    '',\n]\nfor x in audit:\n    tn = x['table_name']\n    finding = x['finding']\n    if finding == 'none':\n        continue\n    ratio = x['bloat_ratio']\n    cap = x['cap']\n    eff = x['eff_cap']\n    total = x['total_pages']\n    days = x['days']\n    if finding == 'AUTOVACUUM_DISABLED':\n        if x['vacuum_type'] == 'manual':\n            reason = (f'vacuum_type manual overrides autovacuum even with autovacuum_enabled True, so autovacuum is disabled; '\n                      f'computed size class {x[\"size_class\"]} from total_pages {total}, ratio {ratio} over cap {cap}.')\n        else:\n            reason = (f'autovacuum_enabled False disables autovacuum and overrides bloat; '\n                      f'computed size class {x[\"size_class\"]} f"]
[344.804985, "o", "\u001b[?2004h> "]
[344.805231, "i", "rom total_pages {total}, ratio {ratio} over cap {cap}.')\n        if x['stale']:\n            reason += f' Stats are {days} days stale and would tighten cap to {eff}, but autovacuum is checked first.'\n    elif finding == 'BLOAT_THRESHOLD_EXCEEDED':\n        reason = (f'computed size class {x[\"size_class\"]} from total_pages {total}, '\n                  f'dead_pages {x[\"dead_pages\"]} over total_pages {total} rounds half-up to ratio {ratio}, '\n                  f'ratio {ratio} over cap {cap}')\n        if x['stale']:\n            reason += f'; stale stats computed as {days} days tighten the effective cap to {eff}, and ratio {ratio} exceeds the tightened cap; days_since_analyze legacy field ignored'\n        else:\n            reason += f'; ratio {ratio} exceeds cap {cap}'\n        if tn in reidx:\n            if x['exempt']:\n                reason += f'; approved active reindex valid_until {x[\"valid_until\"]} exempts bloat'\n            elif not x['approved']:\n                reason += f'; reindex is unapproved (approved=F"]
[344.805331, "o", "    for r in csv.DictReader(f):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.80564, "i", "alse), so no bloat exemption'\n            elif x['valid_until'] < date.fromisoformat(r['audit_date']):\n                reason += f'; approved reindex expired on valid_until {x[\"valid_until\"]}, so no bloat exemption'\n        if x['export_size_class'] not in ('large', 'small'):\n            reason += f'; export size_class {x[\"export_size_class\"]} trap ignored'\n    elif finding == 'STALE_STATISTICS':\n        reason = (f'computed size class {x[\"size_class\"]} from total_pages {total}, stale stats computed as {days} days, '\n                  f'ratio {ratio} under tightened cap {eff}; days_since_analyze legacy field ignored')\n        if tn in reidx and x['exempt']:\n            reason += f'; approved active reindex valid_until {x[\"valid_until\"]} exempts bloat'\n    memo.append(f'- {tn} is {finding} because {reason}')\n\nwith open('/app/bloat_memo.md', 'w') as f:\n    f.write('\\n'.join(memo) + '\\n')\nPY\n"]
