[344.799269, "i", "python3 - <<'PY'\nimport csv, json\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\n\nhealth_path = '/app/input/table_health.csv'\nreindex_path = '/app/input/reindex_log.csv'\n\nreidx = {}\nwith open(reindex_path, newline='') as f:\n    for r in csv.DictReader(f):\n        reidx[r['table_name']] = (r['approved'].strip().lower() == 'true', date.fromisoformat(r['valid_until']))\n\nrows = {}\nwith open(health_path, newline='') as f:\n    for r in csv.DictReader(f):\n        rows.setdefault(r['table_name'], r)\n\naudit = []\nfor tn, r in rows.items():\n    total = int(r['total_pages'])\n    dead = int(r['dead_pages'])\n    raw_ratio = Decimal(dead) / Decimal(total)\n    ratio = raw_ratio.quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    size_class = 'large' if total >= 500 else 'small'\n    cap = Decimal('0.2') if size_class == 'large' else Decimal('0.4')\n    autovacuum = r['autovacuum_enabled'].strip().lower() == 'true'\n    vacuum_type = r['vacuum_type'].strip()\n    audit_date = date.fromisoformat(r['audit_da"]
[344.80293, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[344.803396, "i", "te'])\n    last_analyzed = date.fromisoformat(r['last_analyzed'])\n    days = (audit_date - last_analyzed).days\n    stale = days > 30\n    maintenance_active = r['maintenance_active'].strip().lower() == 'true'\n    approved, valid_until = reidx.get(tn, (False, date.min))\n    exempt = maintenance_active and approved and valid_until >= audit_date\n    eff_cap = cap - Decimal('0.05') if stale else cap\n\n    if (not autovacuum) or vacuum_type == 'manual':\n        finding = 'AUTOVACUUM_DISABLED'\n    elif not exempt and ratio > eff_cap:\n        finding = 'BLOAT_THRESHOLD_EXCEEDED'\n    elif stale:\n        finding = 'STALE_STATISTICS'\n    else:\n        finding = 'none'\n\n    audit.append({\n        'table_name': tn, 'size_class': size_class, 'bloat_ratio': f'{ratio:.2f}',\n        'finding': finding, '_last_analyzed': last_analyzed, 'total_pages': total,\n        'dead_pages': dead, 'cap': cap, 'eff_cap': eff_cap, 'days': days, 'stale': stale,\n        'exempt': exempt, 'approved': approved, 'valid_until': valid_until,\n        "]
[344.803817, "o", "\u001b[?2004h> import csv, json\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> from decimal import Decimal, ROUND_HALF_UP\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> health_path = '/app/input/table_health.csv'\r\n\u001b[?2004l\r\u001b[?2004h> reindex_path = '/app/input/reindex_log.csv'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.804092, "i", "'vacuum_type': vacuum_type, 'autovacuum': autovacuum, 'maint': maintenance_active,\n        'export_size_class': r['size_class'],\n    })\n\naudit.sort(key=lambda x: (x['_last_analyzed'], x['table_name']))\n\nwith open('/app/bloat_audit.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['table_name', 'size_class', 'bloat_ratio', 'finding'])\n    writer.writeheader()\n    for x in audit:\n        writer.writerow({k: x[k] for k in ['table_name', 'size_class', 'bloat_ratio', 'finding']})\n\ncounts = {\n    'flagged_count': sum(1 for x in audit if x['finding'] != 'none'),\n    'autovacuum_disabled_count': sum(1 for x in audit if x['finding'] == 'AUTOVACUUM_DISABLED'),\n    'bloat_exceeded_count': sum(1 for x in audit if x['finding'] == 'BLOAT_THRESHOLD_EXCEEDED'),\n    'stale_statistics_count': sum(1 for x in audit if x['finding'] == 'STALE_STATISTICS'),\n    'compliant_count': sum(1 for x in audit if x['finding'] == 'none'),\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(counts, f, indent=2)\n    "]
