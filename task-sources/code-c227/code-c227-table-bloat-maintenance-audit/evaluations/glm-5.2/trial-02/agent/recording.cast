[220.36366, "i", "python3 - <<'PY'\nimport csv\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\n\nreidx={}\nwith open('/app/input/reindex_log.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        reidx[r['table_name']] = (r['approved'].strip().lower()=='true', date.fromisoformat(r['valid_until']))\n\nrows={}\nwith open('/app/input/table_health.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        rows.setdefault(r['table_name'], r)\n\naudit=[]\nfor tn,r in rows.items():\n    total=int(r['total_pages']); dead=int(r['dead_pages'])\n    ratio=(Decimal(dead)/Decimal(total)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    size_class='large' if total>=500 else 'small'\n    cap=Decimal('0.2') if size_class=='large' else Decimal('0.4')\n    auto=r['autovacuum_enabled'].strip().lower()=='true'\n    vtype=r['vacuum_type'].strip()\n    ad=date.fromisoformat(r['audit_date']); la=date.fromisoformat(r['last_analyzed'])\n    days=(ad-la).days; stale=days>30\n    maint=r['maintenance_active'].strip().lower()=='tru"]
[220.364, "i", "e'\n    approved, valid_until = reidx.get(tn, (False, date.min))\n    exempt = maint and approved and valid_until >= ad\n    if (not auto) or vtype=='manual':\n        finding='AUTOVACUUM_DISABLED'\n    else:\n        eff_cap = cap - Decimal('0.05') if stale else cap\n        if not exempt and ratio > eff_cap:\n            finding='BLOAT_THRESHOLD_EXCEEDED'\n        elif stale:\n            finding='STALE_STATISTICS'\n        else:\n            finding='none'\n    audit.append((tn,size_class,ratio,finding,la,days,cap,cap-Decimal('0.05') if stale else cap,exempt,approved,valid_until,vtype,auto,maint,total,dead))\n\naudit.sort(key=lambda x: (x[4], x[0]))\nwith open('/tmp/audit.tsv','w') as out:\n    out.write('table_name\\tsize_class\\tratio\\tfinding\\tlast_analyzed\\tdays\\tcap\\teff_cap\\texempt\\tapproved\\tvalid_until\\tvacuum_type\\tauto\\tmaint\\ttotal_pages\\tdead_pages\\n')\n    for x in audit:\n        out.write('\\t'.join(str(z) for z in x).replace('None','')+'\\n')\nPY\n"]
