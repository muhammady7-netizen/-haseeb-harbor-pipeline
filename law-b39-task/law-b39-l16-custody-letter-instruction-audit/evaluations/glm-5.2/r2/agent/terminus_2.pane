[?2004h[01;32mappuser@0b4912810d46[00m:[01;34m/app[00m$ python3 - <<'PY'
[?2004l[?2004h> import csv, collections, json
[?2004l[?2004h> rows=list(csv.DictReader(open('/app/input/letter_lines.csv')))
[?2004l[?2004h> groups=collections.defaultdict(list)
[?2004l[?2004h> for r in rows: groups[r['subject']].append(r)
[?2004l[?2004h> out={}
[?2004l[?2004h> for s in sorted(groups):
[?2004l[?2004h>     pos=collections.defaultdict(list)
[?2004l[?2004h>     for r in groups[s]:
[?2004l[?2004h>         pos[r['position']].append(r['line_id'])
[?2004l[?2004h>     out[s]={k:ids for k,ids in sorted(pos.items())}
[?2004l[?2004h> print(json.dumps(out, indent=2, sort_keys=True))
[?2004l[?2004h> PY
