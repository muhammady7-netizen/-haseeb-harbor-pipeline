[?2004h[01;32mappuser@efd392b3b2df[00m:[01;34m/app[00m$ python3 - <<'PY'
[?2004l
[?2004h> import csv, json
[?2004l
[?2004h> from collections import defaultdict
[?2004l
[?2004h> rows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))
[?2004l
[?2004h> rev={r['line_id']: r for r in csv.DictReader(open('/app/letter_line_review.csv', newline=''))}
[?2004l
[?2004h> combos=defaultdict(list)
[?2004l
[?2004h> for r in rows:
[?2004l
[?2004h>     g=rev[r['line_id']]
[?2004l
[?2004h>     if g['verdict']=='VERIFIED':
[?2004l
[?2004h>         combos[(r['subject'],r['position'],g['record_entry'])].append(r['line_id'])
[?2004l
[?2004h> print('VERIFIED combos:')
[?2004l
[?2004h> for k,ids in sorted(combos.items()):
[?2004l
[?2004h>     print(f'{k[0]} | {k[1]} | {k[2]} | {len(ids)} | {",".join(ids)}')
[?2004l
[?2004h> print('\\nValidation:')
[?2004l
[?2004h> with open('/app/letter_line_review.csv', newline='') as f:
[?2004l
[?2004h>     reader=csv.DictReader(f)
[?2004l
[?2004h>     assert reader.fieldnames==['line_id','verdict','record_entry'], reader.fieldnames
[?2004l
[?2004h>     rev_rows=list(reader)
[?2004l
[?2004h> assert len(rev_rows)==325
[?2004l
[?2004h> assert all(r['verdict'] in {'VERIFIED','AT_ODDS','NOT_IN_RECORD'} for r in rev_rows)
[?2004l
[?2004h> assert all(r['record_entry'] in {'NONE'} or r['record_entry'].startswith(('OI-','CL-')) for r in rev_rows)
[?2004l
[?2004h> res=json.load(open('/app/results.json'))
[?2004l
[?2004h> assert set(res)=={'verified_count','at_odds_count','not_in_record_count','clarification_governed_count'}
[?2004l
[?2004h> assert res['verified_count']==sum(1 for r in rev_rows if r['verdict']=='VERIFIED')
[?2004l
[?2004h> assert res['at_odds_count']==sum(1 for r in rev_rows if r['verdict']=='AT_ODDS')
[?2004l
[?2004h> assert res['not_in_record_count']==sum(1 for r in rev_rows if r['verdict']=='NOT_IN_RECORD')
[?2004l
[?2004h> assert res['clarification_governed_count']==sum(1 for r in rev_rows if r['record_entry'].startswith('CL-'))
[?2004l
[?2004h> ans=open('/app/answer.md').read()
[?2004l
[?2004h> assert 'Letter lines at odds with the record:' in ans
[?2004l
[?2004h> assert len(ans.split())>=100
[?2004l
[?2004h> print('All validation checks passed.')
[?2004l
[?2004h> print(json.dumps(res, indent=2))
[?2004l
[?2004h> PY
