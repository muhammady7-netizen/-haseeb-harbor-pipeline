[?2004l
[?2004h> import csv
[?2004l
[?2004h> from collections import defaultdict
[?2004l
[?2004h> rows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))
[?2004l
[?2004h> d=defaultdict(list)
[?2004l
[?2004h> for r in rows:
[?2004l
[?2004h>     d[(r['subject'], r['position'], r['cited_entry'])].append(r['line_id'])
[?2004l
[?2004h> with open('/tmp/combos.txt','w') as f:
[?2004l
[?2004h>     for (subj,pos,cite),ids in sorted(d.items()):
[?2004l
[?2004h>         f.write(f'{subj}\t{pos}\t{cite}\t{len(ids)}\t{",".join(ids)}\n')
[?2004l
[?2004h> print('written', len(d), 'combos')
[?2004l
[?2004h> PY
[?2004l
written 286 combos
