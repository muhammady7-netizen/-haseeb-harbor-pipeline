[?2004h[01;32mappuser@0b4912810d46[00m:[01;34m/app[00m$ python3 - <<'PY'
[?2004l[?2004h> import csv, collections
[?2004l[?2004h> rows=list(csv.DictReader(open('/app/input/letter_lines.csv')))
[?2004l[?2004h> rev={r['line_id']:r for r in csv.DictReader(open('letter_line_review.csv'))}
[?2004l[?2004h> pairs=collections.defaultdict(list)
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     pairs[(r['subject'],r['position'])].append(r)
[?2004l[?2004h> with open('/tmp/pairs.tsv','w') as f:
[?2004l[?2004h>     for (s,p),rs in sorted(pairs.items()):
[?2004l[?2004h>         ids=','.join(r['line_id'] for r in rs)
[?2004l[?2004h>         w=rs[0]['wording'].replace('\t',' ').replace('\n',' ')
[?2004l[?2004h>         if len(w)>100: w=w[:97]+'...'
[?2004l[?2004h>         f.write(f"{s}\t{p}\t{rev[rs[0]['line_id']]['verdict']}\t{rev[rs[0]['line_id']]['record_entry']}\t{ids}\t{w}\n")
[?2004l[?2004h> PY
[?2004l[?2004h[01;32mappuser@0b4912810d46[00m:[01;34m/app[00m$ sed -n '1,45p' /tmp/pairs.tsv
