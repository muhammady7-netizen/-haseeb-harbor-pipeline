[?2004l
[?2004h> from collections import Counter
[?2004l
[?2004h> rows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))
[?2004l
[?2004h> pairs=Counter((r['subject'], r['position'], r['cited_entry']) for r in rows)
[?2004l
[?2004h> for (subj,pos,cite),c in sorted(pairs.items()):
[?2004l
[?2004h>     print(f'{subj}\t{pos}\t{cite}\t{c}')
[?2004l
