[?2004h[01;32mappuser@0b4912810d46[00m:[01;34m/app[00m$ nl -ba /app/input/review_protocol.md
[?2004l     1	# Review protocol — letter to opposing counsel
     2	
     3	Governs every line in `letter_lines.csv`, weighed against `original_instruction.md` and
     4	`clarification.md`.
     5	
     6	## RP-401 Which record prevails
     7	
     8	On any subject the clarification speaks to, the clarification prevails. If the original instruction and the clarification take different positions on a subject, the clarification wins and the original falls away, no matter which entry the draft cites or how plainly the original was put: what the client said last is what the client instructs. For a line on a subject the clarification speaks to, the governing entry is always the clarification entry and never the original one (`RP-401`).
     9	
    10	## RP-402 Subjects the clarification repeats
    11	
    12	If the clarification repeats a subject in the very terms the original used, the clarification entry nonetheless governs the line, and the line is weighed against it (`RP-402`).
    13	
    14	## RP-403 Subjects only the original speaks to
    15	
    16	If the clarification leaves a subject alone, the original entry on that subject governs and the line is weighed against it (`RP-403`).
    17	
    18	## RP-404 Subjects neither record speaks to
    19	
    20	If neither record speaks to a subject, nothing governs: the line's verdict is NOT_IN_RECORD and its record entry is `NONE`, however reasonable the line may read (`RP-404`). A cited_entry that exists nowhere does not by itself make a line NOT_IN_RECORD — the governing entry is determined by the line's subject under RP-401 and RP-403, not by the cited_entry. NOT_IN_RECORD applies only when the subject itself is one that neither the original instruction nor the clarification addresses.
    21	
    22	## RP-405 How a line is weighed
    23	
    24	Weighed against its governing entry, a line is VERIFIED when the position it takes is the entry's own, and AT_ODDS when the entry's position differs from it — the reverse, something narrower, or a different person (`RP-405`).
    25	
    26	## RP-406 The review table
    27	
    28	`record_entry` holds the id of the entry that governs the line, spelled as the records spell it, or `NONE` (`RP-406`).
    29	
    30	
    31	## RP-408 Compound positions
    32	
    33	When a governing entry's position has two or more required limbs (for example, a marking and a tone requirement), a line that asserts only one limb and drops the others takes something narrower than the entry's own position, and is AT_ODDS (`RP-408`). The line is VERIFIED only when it takes the entry's full position, including every required limb.
    34	
    35	## Figures
    36	
    37	`verified_count` is the number of lines whose verdict is VERIFIED.
    38	`at_odds_count` is the at odds count: the lines whose verdict is AT_ODDS.
    39	`not_in_record_count` is the number of lines whose verdict is NOT_IN_RECORD.
    40	`clarification_governed_count` is the number of lines whose record entry is a clarification entry (`CL-…`).
    41	In the answer, `Letter lines at odds with the record` is the number of lines whose governing entry takes a position
    42	other than the line's.
[?2004h[01;32mappuser@0b4912810d46[00m:[01;34m/app[00m$ python3 - <<'PY'
[?2004l[?2004h> import csv, json, re
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> 
[?2004l[?2004h> rows = list(csv.DictReader(open('/app/input/letter_lines.csv')))
[?2004l[?2004h> 
[?2004l[?2004h> # Governing entry by subject, per clarification precedence and CL-310/CL-311 special precedence.
[?2004l[?2004h> governing = {
[?2004l[?2004h>     'addressee': 'CL-301',
[?2004l[?2004h>     'right_of_first_refusal': 'OI-202',
[?2004l[?2004h>     'children_named': 'OI-203',
[?2004l[?2004h>     'overnight_stays': 'OI-204',
[?2004l[?2004h>     'inconsistent_accounts': 'OI-205',
[?2004l[?2004h>     'concern': 'CL-309',
[?2004l[?2004h>     'behavioural_plan': 'CL-308',
[?2004l [?2004h>     'request': 'CL-302',
[?2004l[?2004h>     'enclosure': 'CL-303',
[?2004l[?2004h>     'tone': 'CL-307',
[?2004l[?2004h>     'sender_signature': 'OI-211',
[?2004l[?2004h>     'salutation': 'CL-304',
[?2004l[?2004h>     'copies': 'CL-305',
[?2004l[?2004h>     'delivery': 'CL-306',
[?2004l[?2004h>     'interim_contact': 'CL-310',
[?2004l[?2004h>     'without_prejudice': 'CL-311',
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Unrecorded subjects: neither original nor clarification speaks to them.
[?2004l[?2004h> unrecorded = {'reply_deadline','school_reference','mediation_offer','mediation_terms','legal_fees','court_listing','expert_report','hearing_bundle'}
[?2004l[?2004h> 
[?2004l[?2004h> def classify(r):
[?2004l[?2004h>     s = r['subject']
[?2004l[?2004h>     p = r['position']
[?2004ly[?2004h>     w = r['wording']
[?2004l[?2004h>     if s in unrecorded:
[?2004l[?2004h>         return 'NOT_IN_RECORD', 'NONE'
[?2004lo[?2004h> 
[?2004l [?2004h>     # For most subjects, verify against the full required position.
[?2004l[?2004h>     if s == 'addressee':
[?2004l[?2004h>         # CL-301: mother's attorney, not father's/Adam's.
[?2004l[?2004h>         ver = ('mother' in w.lower() or 'catherine' in w.lower() or 'ms corwin' in w.lower()) and 'father' not in w.lower() and 'adam' not in w.lower()
[?2004l[?2004h>         return ('VERIFIED' if ver else 'AT_ODDS'), governing[s]
[?2004l[?2004h> 
[?2004l[?2004h>     if s == 'right_of_first_refusal':
[?2004l[?2004h>         # OI-202: Mr Adler/father agreed; children not left overnight without him present. Both agreement and overnight restriction.
[?2004l[?2004h>         father_agreed = ('adler' in w.lower() or 'father' in w.lower()) and ('agreed' in w.lower() or 'right of first refusal' in w.lower())
[?2004l[?2004h>         restriction = 'overnight' in w.lower() and ('without him' in w.lower() or 'without the father' in w.lower() or 'unless' in w.lower() and ('adler' in w.lower() or 'father' in w.lower()) or 'not to be left overnight without' in w.lower())
[?2004l[?2004h>         # More direct check based on positions.
[?2004l[?2004h>         if p in ('agreed by the father','father agreed'):
[?2004l[?2004h>             ver = 'overnight' in w.lower() and 'without' in w.lower() and ('him' in w.lower() or 'father' in w.lower())
[?2004l[?2004h>         else:
[?2004l[?2004h>             ver = False
[?2004l[?2004h>         return ('VERIFIED' if ver else 'AT_ODDS'), governing[s]
[?2004l[?2004h> 
[?2004l[?2004h>     if s == 'children_named':
[?2004l[?2004h>         # OI-203: both names and both ages.
[?2004l[?2004h>         ver = 'Noor' in w and 'Imogen' in w and 'seven' in w and 'twelve' in w
[?2004l[?2004h>         return ('VERIFIED' if ver else 'AT_ODDS'), governing[s]
[?2004l[?2004h> 
[?2004l[?2004h>     if s == 'overnight_stays':
[?2004l[?2004h>         # OI-204: several occasions, both children, her home and sitter, father away.
[?2004l[?2004h>         ver = ('several' in w.lower() or 'multiple' in w.lower()) and 'both' in w.lower() and ('home' in w.lower() or "corwin's" in w.lower()) and 'sitter' in w.lower() and ('away' in w.lower() or 'while' in w.lower())
[?2004l  [?2004h>         # positions with home only or one child once fail.
[?2004l[?2004h>         if p == 'several occasions at her home or with a sitter':
[?2004l[?2004h>             ver = True
[?2004l[?2004h>         else:
[?2004l[?2004h>             ver = False
[?2004l[?2004h>         return ('VERIFIED' if ver else 'AT_ODDS'), governing[s]
[?2004l[?2004h> 
[?2004l[?2004h>     if s == 'inconsistent_accounts':
[?2004l[?2004h>         # OI-205: all four audiences: school, clinicians, sender, neighbours.
[?2004l[?2004h>         ver = all(x in w.lower() for x in ['school','clinician','sitter' if 'babysitter' in w.lower() or 'sitter' in w.lower() else 'sitter','neighbour'])
[?2004l[?2004h>         # Simpler by position.
[?2004l[?2004h>         if p in ('wife to the school, resident to clinicians, sitter to the sender','all four audiences','three audiences'):
[?2004l[?2004h>             # Need all four; "three audiences" likely missing neighbours.
[?2004l[?2004h>             ver = all(x in w.lower() for x in ['school','clinician','neighbour'])
[?2004l[?2004h>         else:
[?2004l[?2004h>             ver = False
[?2004l[?2004h>         return ('VERIFIED' if ver else 'AT_ODDS'), governing[s]
[?2004l[?2004h> 
[?2004l[?2004h>     if s == 'concern':
[?2004l[?2004h>         # CL-309: only position she has been put in; do not raise violation.
[?2004l[?2004h>         ver = 'position' in w.lower() and ('violate' not in w.lower() and 'contravene' not in w.lower() and 'appreciate' not in w.lower())
[?2004l[?2004h>         return ('VERIFIED' if ver else 'AT_ODDS'), governing[s]
[?2004l[?2004h> 
