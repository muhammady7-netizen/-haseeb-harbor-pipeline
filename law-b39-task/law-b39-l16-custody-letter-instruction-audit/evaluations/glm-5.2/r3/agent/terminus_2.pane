[?2004l[?2004h>     if s=='behavioural_plan':
[?2004l[?2004h>         return 'VERIFIED' if (all(k in w for k in ['confidence','stability','peer']) and ('confidence only' in w or 'confidence alone' in w)) else 'AT_ODDS'
[?2004l[?2004h>     if s=='children_named':
[?2004l[?2004h>         return 'VERIFIED' if all(k in w for k in ['noor','imogen','seven','twelve']) else 'AT_ODDS'
[?2004l[?2004h>     if s=='concern':
[?2004l[?2004h>         return 'VERIFIED' if ('position' in w and not any(k in w for k in ['violate','contravene','appreciate','order'])) else 'AT_ODDS'
[?2004l[?2004h>     if s=='copies':
[?2004l[?2004h>         return 'VERIFIED' if any(k in w for k in ['no copy','do not copy','not copy','no one','nothing','not copied']) else 'AT_ODDS'
[?2004l[?2004h>     if s=='delivery':
