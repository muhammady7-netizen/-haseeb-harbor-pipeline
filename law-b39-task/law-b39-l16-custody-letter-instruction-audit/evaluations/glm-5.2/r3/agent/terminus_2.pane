[?2004l[?2004h>     if s=='interim_contact':
[?2004l[?2004h>         return 'VERIFIED' if (all(k in w for k in ['confidence','stability','peer']) and any(k in w for k in ['all three','all addressed','together','jointly','not one in isolation'])) else 'AT_ODDS'
[?2004l[?2004h>     if s=='request':
