[?2004h[01;32mappuser@b14ff4ba23cc[00m:[01;34m/app[00m$ python3 - <<'PY'
[?2004l[?2004h> import csv, collections, json
[?2004l[?2004h> rows=list(csv.DictReader(open('review_preview.csv', newline='')))
[?2004l[?2004h> counts=collections.Counter(r['verdict'] for r in rows)
[?2004l[?2004h> clar=sum(1 for r in rows if r['record_entry'].startswith('CL-'))
[?2004l[?2004h> print('verified_count', counts['VERIFIED'])
[?2004l[?2004h> print('at_odds_count', counts['AT_ODDS'])
[?2004l[?2004h> print('not_in_record_count', counts['NOT_IN_RECORD'])
[?2004l[?2004h> print('clarification_governed_count', clar)
[?2004l[?2004h> print('row_count', len(rows))
[?2004l[?2004h> PY
[?2004lverified_count 102
at_odds_count 179
not_in_record_count 44
clarification_governed_count 208
row_count 325
[?2004h[01;32mappuser@b14ff4ba23cc[00m:[01;34m/app[00m$ python3 - <<'PY'
[?2004l[?2004h> import csv
[?2004l[?2004h> rows=list(csv.DictReader(open('review_preview.csv', newline='')))
[?2004l[?2004h> lines=list(csv.DictReader(open('input/letter_lines.csv', newline='')))
[?2004l[?2004h> verdicts={r['line_id']:r for r in rows}
[?2004l[?2004h> with open('audit.tsv','w') as f:
[?2004l[?2004h>     f.write('line_id\tsubject\tverdict\tentry\tposition\twording\n')
[?2004l[?2004h>     for r in lines:
[?2004l[?2004h>         v=verdicts[r['line_id']]
[?2004l[?2004h>         f.write(f"{r['line_id']}\t{r['subject']}\t{v['verdict']}\t{v['record_entry']}\t{r['position']}\t{r['wording']}\n")
[?2004l[?2004h> print('wrote audit.tsv')
[?2004l[?2004h> PY
[?2004lwrote audit.tsv
