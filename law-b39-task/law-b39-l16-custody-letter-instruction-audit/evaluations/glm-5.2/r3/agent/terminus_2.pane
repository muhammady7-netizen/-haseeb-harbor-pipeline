[?2004l[?2004h> import csv, collections
[?2004l[?2004h> rows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))
[?2004l[?2004h> groups=collections.defaultdict(list)
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     groups[r['subject']].append(r)
[?2004l[?2004h> with open('analysis_dump.txt','w') as out:
[?2004l[?2004h>     for s in sorted(groups):
[?2004l[?2004h>         out.write(f'\n### SUBJECT {s} ({len(groups[s])})\n')
[?2004l[?2004h>         for r in groups[s]:
[?2004l[?2004h>             out.write(f"{r['line_id']} | cited={r['cited_entry']} | pos={r['position']}\n  {r['wording']}\n")
[?2004l[?2004h> print('wrote analysis_dump.txt')
[?2004l[?2004h> PY
[?2004lwrote analysis_dump.txt
