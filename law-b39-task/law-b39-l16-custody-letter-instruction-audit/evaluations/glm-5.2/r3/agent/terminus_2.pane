[?2004l[?2004h> rows=list(csv.DictReader(open('input/letter_lines.csv', newline='')))
[?2004l[?2004h> print('subjects:', len(collections.Counter(r['subject'] for r in rows)))
[?2004l[?2004h> for s, c in sorted(collections.Counter(r['subject'] for r in rows).items()):
[?2004l[?2004h>     print(f'{s}: {c}')
