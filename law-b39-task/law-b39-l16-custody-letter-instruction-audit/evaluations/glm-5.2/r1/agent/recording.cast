[542.973561, "i", "python3 - <<'PY' > /tmp/position_samples.txt\nimport csv, collections\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\nseen={}\nfor r in rows:\n    key=(r['subject'], r['position'])\n    seen.setdefault(key, r)\nfor (s,p),r in sorted(seen.items()):\n    print(f\"{s}|{p}|{r['line_id']}|{r['cited_entry']}|{r['wording']}\")\nPY\nnl -ba /tmp/position_samples.txt | sed -n '1,70p'\n"]
