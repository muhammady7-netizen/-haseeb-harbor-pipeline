[761.271565, "o", "    if s in not_in_record_subjects:\r\n\u001b[?2004l\rf"]
[761.271852, "o", "\u001b[?2004h> "]
[761.272266, "o", "        return 'NONE'\r\n\u001b[?2004l\r"]
[761.272467, "o", "\u001b[?2004h> "]
[761.275807, "o", "    # RP-407: if cited is an existing CL entry for a different subject, and the line's subject has an original entry, original governs.\r\n\u001b[?2004l\r"]
[761.276098, "o", "\u001b[?2004h> "]
[761.277019, "o", "    if c.startswith('CL-') and c in records and records[c][0] != s and s in subject_to_orig:\r\n\u001b[?2004l\r"]
[761.277238, "o", "\u001b[?2004h> "]
[761.277983, "o", "        return subject_to_orig[s]\r\n\u001b[?2004l\r"]
[761.278231, "o", "\u001b[?2004h> "]
[761.279619, "o", "    # If the clarification speaks to the subject, clarification governs (RP-401/RP-402).\r\n\u001b[?2004l\r"]
[761.279856, "o", "\u001b[?2004h> "]
[761.280159, "o", "    if s in subject_to_clar:\r\n"]
[761.280469, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[761.280761, "o", "        return subject_to_clar[s]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.281364, "o", "    # If only the original speaks to the subject, original governs (RP-403).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.281693, "o", "    if s in subject_to_orig:\r\n\u001b[?2004l\r"]
[761.28195, "o", "\u001b[?2004h"]
[761.282162, "o", "> "]
[761.282423, "o", "        return subject_to_orig[s]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.282681, "o", "    # Neither record speaks to the subject (RP-404).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.28299, "o", "    return 'NONE'"]
[761.283274, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.283577, "o", "def verdict(row, gov):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.283828, "o", "    if gov == 'NONE':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.284052, "o", "        return 'NOT_IN_RECORD'\r\n"]
[761.284317, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[761.284563, "o", "    if row['position'] in verified_by_entry.get(gov, set()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.284812, "o", "        return 'VERIFIED'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.284902, "o", "    return 'AT_ODDS'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[761.285076, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[761.285568, "o", "rows=list(csv.DictReader(open(INPUT, newline='')))\r\n\u001b[?2004l\r\u001b[?2004h> out_rows=[]\r\n\u001b[?2004l\r"]
[761.28587, "o", "\u001b[?2004h> for r in rows:\r\n"]
[761.286089, "o", "\u001b[?2004l\r\u001b[?2004h>     gov=governing_entry(r)\r\n\u001b[?2004l\r"]
[761.286295, "o", "\u001b[?2004h>     v=verdict(r, gov)\r\n\u001b[?2004l\r"]
[761.286469, "o", "\u001b[?2004h> "]
[761.286762, "o", "    out_rows.append({'line_id': r['line_id'], 'verdict': v, 'record_entry': gov})\r\n\u001b[?2004l\r\u001b[?2004h"]
[761.287021, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.287429, "o", "with open('/app/letter_line_review.csv','w',newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.287741, "o", "    w=csv.DictWriter(f, fieldnames=['line_id','verdict','record_entry'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[761.288005, "o", ">     w.writeheader()\r\n\u001b[?2004l\r"]
[761.288274, "o", "\u001b[?2004h>     w.writerows(out_rows)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.28836, "o", "\r\n\u001b[?2004l\r"]
[761.288602, "o", "\u001b[?2004h> "]
[761.288862, "o", "counts=collections.Counter(r['verdict'] for r in out_rows)\r\n"]
[761.289155, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[761.289359, "o", "clar_gov=sum(1 for r in out_rows if r['record_entry'].startswith('CL-'))\r\n\u001b[?2004l\r"]
[761.289566, "o", "\u001b[?2004h> "]
[761.289744, "o", "results={\r\n\u001b[?2004l\r"]
[761.290018, "o", "\u001b[?2004h>     'verified_count': counts['VERIFIED'],\r\n\u001b[?2004l\r"]
[761.290211, "o", "\u001b[?2004h> "]
[761.290424, "o", "    'at_odds_count': counts['AT_ODDS'],\r\n"]
[761.290689, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[761.291022, "o", "    'not_in_record_count': counts['NOT_IN_RECORD'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.291242, "o", "    'clarification_governed_count': clar_gov,\r\n\u001b[?2004l\r"]
[761.291503, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[761.291748, "o", "\u001b[?2004h> "]
[761.292025, "o", "with open('/app/results.json','w') as f:\r\n\u001b[?2004l\r"]
[761.292249, "o", "\u001b[?2004h> "]
[761.292479, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[761.292771, "o", "\u001b[?2004h"]
[761.293003, "o", "> "]
[761.293254, "o", "    f.write('\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[761.293457, "o", "> \r\n\u001b[?2004l\r"]
[761.293603, "o", "\u001b[?2004h> "]
[761.294046, "o", "answer = f\"\"\"# Review of draft letter lines against the client's record\r\n\u001b[?2004l\r"]
[761.294316, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[761.294607, "o", "\u001b[?2004h> "]
[761.298386, "o", "I checked every numbered line in the draft letter against the client's two messages, applying the review protocol exactly. Where the clarification speaks to a subject, it prevails over the original instruction; where the clarification leaves a subject alone, the original entry still governs; where neither record speaks to a subject, the line is not in the record at all. I also followed the cross-subject citation exception: a clarification citation meant for another subject does not displace the original entry for the line's own subject when that original entry exists.\r\n\u001b[?2004l\r\u001b[?2004h"]
[761.2985, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.301988, "o", "The draft contains {len(rows)} numbered lines. After weighing each line against the governing record entry, {counts['VERIFIED']} lines are verified by the record, {counts['NOT_IN_RECORD']} lines are not in the record at all, and {counts['AT_ODDS']} lines take a position that conflicts with or narrows the client's instructions. Letter lines at odds with the record: {counts['AT_ODDS']}. This count is the figure I am relying on; it is not one of two candidates. The remaining lines either match the record entry that governs them or fall outside the record because no entry addresses their subject.\r\n\u001b[?2004l\r"]
[761.302283, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[761.302562, "o", "> "]
[761.306948, "o", "The most common problems are lines that drop required limbs from compound instructions, such as tone entries that keep only part of the required tone, concern entries that raise or omit a limb the client revised, and behavioural-plan entries that do not carry the full position stated in the governing entry. Other lines are at odds because they name the wrong addressee, describe the wrong delivery method, or seek a different overnight condition. Lines on subjects such as legal fees, court listings, expert reports, hearing bundles, mediation terms, reply deadlines, and school references are not in the record at all, because neither the original instruction nor the clarification addresses those subjects.\r\n\u001b[?2004l\r"]
[761.307296, "o", "\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r"]
[761.307554, "o", "\u001b[?2004h> "]
[761.307777, "o", "with open('/app/answer.md','w') as f:\r\n\u001b[?2004l\r"]
[761.308057, "o", "\u001b[?2004h> "]
[761.308299, "o", "    f.write(answer)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.308577, "o", "print('rows', len(rows))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.308887, "o", "print('counts', dict(counts))\r\n\u001b[?2004l\r\u001b[?2004h"]
[761.309069, "o", "> "]
[761.309333, "o", "print('clar_gov', clar_gov)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.30957, "o", "print('results', results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.309788, "o", "print('\\nGoverning entry counts:')"]
[761.310085, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.310771, "o", "for gov,n in sorted(collections.Counter(r['record_entry'] for r in out_rows).items()):\r\n\u001b[?2004l\r"]
[761.311059, "o", "\u001b[?2004h> "]
[761.311403, "o", "    print(gov, n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.31185, "o", "print('\\nAT_ODDS positions by governing entry:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.31264, "o", "for gov in sorted(set(r['record_entry'] for r in out_rows if r['verdict']=='AT_ODDS')):\r\n\u001b[?2004l\r\u001b[?2004h"]
[761.313015, "o", "> "]
[761.316009, "o", "    positions=sorted({row['position'] for row in rows if row['line_id'] in {r['line_id'] for r in out_rows if r['record_entry']==gov and r['verdict']=='AT_ODDS'}})\r\n\u001b[?2004l\r\u001b[?2004h"]
[761.31639, "o", "> "]
[761.316678, "o", "    print(gov, positions)\r\n\u001b[?2004l\r\u001b[?2004h"]
[761.316895, "o", "> "]
[761.317148, "o", "print('\\nNOT_IN_RECORD subjects:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.317711, "o", "for s in sorted(not_in_record_subjects):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[761.318794, "o", "    ids=[r['line_id'] for r in rows if r['subject']==s]\r\n\u001b[?2004l\r"]
[761.31912, "o", "\u001b[?2004h> "]
[761.31956, "o", "    print(s, len(ids), ids)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
