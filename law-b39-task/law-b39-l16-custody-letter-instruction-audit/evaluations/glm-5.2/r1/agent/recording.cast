[104.428316, "i", "python3 - <<'PY'\nimport re, csv\nrecords={}\nfor path, prefix in [('/app/input/original_instruction.md','OI'),('/app/input/clarification.md','CL')]:\n    txt=open(path).read()\n    for m in re.finditer(r'^## (OI-\\d+|CL-\\d+) `([^`]+)`\\n(.*?)(?=\\n## |\\Z)', txt, re.M|re.S):\n        eid, subject, body = m.groups()\n        records[eid]=(subject, body.strip())\nprint('Record entries:')\nfor eid in sorted(records):\n    print(eid, records[eid][0], '::', records[eid][1].replace('\\n',' ')[:120])\nprint('\\nRows with CL cited_entry for different subject (RP-407 candidates):')\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\nfor r in rows:\n    c=r['cited_entry']\n    if c.startswith('CL-') and c in records and records[c][0] != r['subject']:\n        print(r['line_id'], 'subject=', r['subject'], 'cited=', c, 'cited_subject=', records[c][0], 'position=', r['position'])\nPY\n"]
