[643.992663, "o", "ST-302|CL wording paraphrase|OI-211|I ask that neither child remain overnight in Ms Corwin's care unless Mr Adler is present.\r\nST-319|father alone overnight ok|CL-302|Either child may remain overnight in her care even if the father is away.\r\n"]
[643.992969, "o", "ST-415|meeting request not overnight condition|OI-208|I am writing to request a meeting with counsel.\r\nST-214|neither child overnight unless father present|OI-208|Neither child overnight in her care unless the father is present.\r\n"]
[643.993306, "o", "ST-108|no overnight stays in her care unless the father is present|CL-302|I ask that neither child remain overnight in Ms Corwin's care unless Mr Adler is present.\r\nST-117|no overnight stays unless father present|OI-208|I ask that neither child remain overnight in her care unless the father is present.\r\nST-132|no overnight unless accompanied by a parent|CL-302|No child shall remain overnight in Ms Corwin care unless accompanied by a parent or legal guardian.\r\nST-123|no overnight unless father present|CL-302|Neither child should remain overnight in her care unless Mr Adler is present.\r\nST-144|no overnight unless the mother is present|CL-302|I ask that neither child remain overnight in Ms Corwin's care unless Ms Corwin is present.\r\nST-519|unless mother|CL-302|Neither child overnight in her care unless Ms Corwin is present.\r\nST-185|unless mother present|OI-208|Neither child overnight in her care unless Ms Corwin is present."]
