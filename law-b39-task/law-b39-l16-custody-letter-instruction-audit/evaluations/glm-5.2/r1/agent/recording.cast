[48.428301, "i", "python3 - <<'PY'\nimport csv, collections\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\nprint('total rows:', len(rows))\nprint('subjects:')\nfor s,n in collections.Counter(r['subject'] for r in rows).items():\n    print(f'{s}\\t{n}')\nprint('\\nunique cited entries:')\nfor c,n in sorted(collections.Counter(r['cited_entry'] for r in rows).items()):\n    print(f'{c}\\t{n}')\nPY\n"]
