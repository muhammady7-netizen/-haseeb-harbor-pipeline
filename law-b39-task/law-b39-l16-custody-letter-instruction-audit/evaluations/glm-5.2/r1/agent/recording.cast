[159.409885, "i", "python3 - <<'PY' > /tmp/positions_by_subject.txt\nimport csv, collections\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv', newline='')))\nby=collections.defaultdict(list)\nfor r in rows:\n    by[r['subject']].append(r['position'])\nfor s in sorted(by):\n    print(f'### {s} ({len(by[s])})')\n    for p,n in sorted(collections.Counter(by[s]).items()):\n        print(f'{n}\\t{p}')\nPY\nsed -n '1,120p' /tmp/positions_by_subject.txt\n"]
