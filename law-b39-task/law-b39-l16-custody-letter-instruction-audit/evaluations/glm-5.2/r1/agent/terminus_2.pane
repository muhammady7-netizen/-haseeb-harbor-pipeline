            return 'VERIFIED' if position in {'a certified copy of the custodial plan','certified','certified copy','certified copy enclosed'} else 'AT_ODDS'
        if subject=='salutation':
            return 'VERIFIED' if position=='Dear Counsel' else 'AT_ODDS'
        if subject=='copies':
            return 'VERIFIED' if position in {'copy nobody','nobody'} else 'AT_ODDS'
        if subject=='delivery':
            return 'VERIFIED' if position in {'by post','post'} else 'AT_ODDS'
        if subject=='tone':
            return 'VERIFIED' if position=='firm formal brief' else 'AT_ODDS'
        if subject=='concern':
            return 'VERIFIED' if position in {'position only','position limb only','narrower concern only position'} else 'AT_ODDS'
        if subject=='behavioural_plan':
            return 'VERIFIED' if position in {'full CL match','CL match confidence-only setback','confidence stability peer confidence-only'} else 'AT_ODDS'
        if subject=='interim_contact':
            return 'VERIFIED' if ('all three' in position or 'jointly' in position or 'together' in position) else 'AT_ODDS'
        if subject=='without_prejudice':
            return 'VERIFIED' if ('soft' in position or 'conciliatory' in position or 'gentle' in position) else 'AT_ODDS'
    if subject in oi_subjects:
        if subject=='right_of_first_refusal':
            return 'VERIFIED' if position in {'agreed by the father','father agreed','full'} else 'AT_ODDS'
        if subject=='children_named':
            return 'VERIFIED' if position in {'both children, with their ages','both children with ages','both with ages'} else 'AT_ODDS'
        if subject=='overnight_stays':
            return 'VERIFIED' if position in {'several occasions at her home or with a sitter','home or sitter both','full'} else 'AT_ODDS'
        if subject=='inconsistent_accounts':
            return 'VERIFIED' if position in {'all four','all four audiences'} else 'AT_ODDS'
        if subject=='sender_signature':
            return 'VERIFIED' if position in {'own name','full name','the sender\'s own name'} else 'AT_ODDS'
    return 'NOT_IN_RECORD'

counts=Counter()
entry_counts=Counter()
subj_counts=defaultdict(Counter)
for r in rows:
    subject=r['subject']; position=r['position']; wording=r['wording']
    if subject in cl_subjects:
        entry=cl_subjects[subject]
    elif subject in oi_subjects:
        entry=oi_subjects[subject]
    else:
        entry='NONE'
    v=verdict(subject,position,wording)
    counts[v]+=1
    entry_counts[entry]+=1
    subj_counts[subject][v]+=1

print('totals:', dict(counts))
print('clarification_governed_count:', sum(c for e,c in entry_counts.items() if e.startswith('CL-')))
print('original_governed_count:', sum(c for e,c in entry_counts.items() if e.startswith('OI-')))
print('none_count:', entry_counts['NONE'])
print()
for s in sorted(subj_counts):
    print(s, dict(subj_counts[s]))
PY
