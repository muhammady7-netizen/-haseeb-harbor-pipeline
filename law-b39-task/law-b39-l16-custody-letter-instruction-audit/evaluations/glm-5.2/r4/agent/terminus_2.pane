[?2004h[01;32mappuser@7fb41f3b42b4[00m:[01;34m/app[00m$ python3 - <<'PY'
[?2004l[?2004h> import csv
[?2004l[?2004h> rows=list(csv.DictReader(open('input/letter_lines.csv')))
[?2004l[?2004h> labels={'request':['CL wording paraphrase','CL wording exact','CL match','father alone overnight ok','meeting request not overnight condition','wording delivery','unless mother'],
[?2004l[?2004h> 'right_of_first_refusal':['father agreed','full','agreement only no overnight','not overnight with anyone but parents','no overnight restriction'],
[?2004l[?2004h> 'overnight_stays':['home or sitter both','full','home only','one child'],
[?2004l[?2004h> 'enclosure':['certified','certified copy enclosed','a certified copy of the custodial plan','certified copy'],
[?2004l[?2004h> 'delivery':['post','by post'],
[?2004l[?2004h> 'sender_signature':['own name','full name','the sender\'s own name','first name only','signed as counsel','as counsel'],
[?2004l[?2004h> 'without_prejudice':['mark letter','soft conciliatory tone','conciliatory and open','soft and measured']}
[?2004l[?2004h> for s,ps in labels.items():
[?2004l[?2004h>     print(f"===== {s} =====")
[?2004l[?2004h>     for r in rows:
[?2004l[?2004h>         if r['subject']==s and r['position'] in ps:
[?2004l[?2004h>             print(f"{r['line_id']}|{r['position']}|{r['cited_entry']}|{r['wording']}")
[?2004l[?2004h> PY
