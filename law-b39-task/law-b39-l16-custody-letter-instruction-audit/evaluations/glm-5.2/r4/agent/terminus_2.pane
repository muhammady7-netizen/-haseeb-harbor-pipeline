[?2004l[?2004h> import csv, re, collections
[?2004l[?2004h> rows=list(csv.DictReader(open('input/letter_lines.csv')))
[?2004l[?2004h> govern={
[?2004l[?2004h> 'addressee':'CL-301','request':'CL-302','enclosure':'CL-303','salutation':'CL-304',
[?2004l[?2004h> 'copies':'CL-305','delivery':'CL-306','tone':'CL-307','behavioural_plan':'CL-308',
[?2004l[?2004h> 'concern':'CL-309','interim_contact':'CL-310','without_prejudice':'CL-311',
[?2004l[?2004h> 'right_of_first_refusal':'OI-202','children_named':'OI-203','overnight_stays':'OI-204',
[?2004l[?2004h> 'inconsistent_accounts':'OI-205','sender_signature':'OI-211'
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> def verified(r):
[?2004l[?2004h>     s=r['subject']; w=r['wording'].lower(); p=r['position'].lower()
[?2004l[?2004h>     if s=='addressee':
[?2004l[?2004h>         return p=="mother's attorney"
[?2004l[?2004h>     if s=='behavioural_plan':
[?2004l[?2004h>         return p in ('confidence stability peer confidence-only','full CL match','CL match confidence-only setback')
[?2004l[?2004h>     if s=='children_named':
[?2004l[?2004h>         return all(k in w for k in ['noor','imogen','seven','twelve'])
[?2004l[?2004h>     if s=='concern':
[?2004l[?2004h>         pos_terms=['position she has been put in','position she has been placed in','position ms corwin has been placed in','position ms corwin has been put in']
[?2004l[?2004h>         return any(t in w for t in pos_terms) and not any(t in w for t in ['appreciate','violate','contravene','violation','order'])
[?2004l[?2004h>     if s=='copies':
[?2004l[?2004h>         return ('nobody' in w or 'do not copy anyone' in w or 'no copy line' in w) and 'copy:' not in w and 'copy the' not in w and 'copy mr' not in w and 'copy the father' not in w
[?2004l[?2004h>     if s=='delivery':
[?2004l[?2004h>         return 'post' in w and 'counsel' in w and not any(k in w for k in ['courier','email','hand'])
[?2004l[?2004h>     if s=='enclosure':
[?2004l[?2004h>         return 'certified copy' in w and 'custodial plan' in w
[?2004l[?2004h>     if s=='inconsistent_accounts':
[?2004l[?2004h>         return all(k in w for k in ['wife','school','clinicians','neighbour']) and ('sitter' in w or 'babysitter' in w)
[?2004l[?2004h>     if s=='interim_contact':
[?2004l[?2004h>         return all(k in w for k in ['confidence','stability','peer relations']) and any(k in w for k in ['together','jointly','all three'])
[?2004l[?2004h>     if s=='overnight_stays':
[?2004l[?2004h>         return all(k in w for k in ['several','both children','home','sitter','father','away'])
[?2004l[?2004h>     if s=='request':
[?2004l[?2004h>         return ('father' in w or 'mr adler' in w) and 'present' in w and 'overnight' in w and not any(k in w for k in ['mother','parent','meeting']) and ('neither child' in w or 'no overnight' in w or 'no child' in w)
[?2004l[?2004h>     if s=='right_of_first_refusal':
[?2004l[?2004h>         return 'agreed' in w and 'right of first refusal' in w and 'overnight' in w and ('without him present' in w or 'without the father present' in w or 'without mr adler' in w)
[?2004l[?2004h>     if s=='salutation':
[?2004l[?2004h>         return 'dear counsel' in w
[?2004l[?2004h>     if s=='sender_signature':
[?2004l[?2004h>         return 'delphine marr' in w and 'counsel' not in w and 'behalf' not in w
[?2004l[?2004h>     if s=='tone':
[?2004l[?2004h>         return all(k in w for k in ['firm','formal','brief']) and not any(k in w for k in ['long','length','detailed','direct'])
[?2004l[?2004h>     if s=='without_prejudice':
[?2004l[?2004h>         return 'without prejudice' in w and any(k in w for k in ['soft','conciliatory','gentle','measured','without rancour','without assertion']) and not any(k in w for k in ['firm','direct','uncompromising','without concession','at length'])
[?2004l[?2004h>     return False
[?2004l[?2004h> 
[?2004l[?2004h> verdicts=[]
[?2004l[?2004h> counts=collections.Counter()
[?2004l[?2004h> verified_ids=collections.defaultdict(list)
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     if r['subject'] not in govern:
[?2004l[?2004h>         v='NOT_IN_RECORD'; e='NONE'
[?2004l[?2004h>     else:
