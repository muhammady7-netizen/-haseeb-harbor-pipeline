[?2004h[01;32mappuser@0bc9f97c24c8[00m:[01;34m/app[00m$ cat > /tmp/review.py <<'PY'
[?2004l[?2004h> import csv, json, re
[?2004l[?2004h> 
[?2004lject in original:
        return original[subject]
    # RP-401 / RP-403.
    if subject in clarification:
        return clarification[subject]
    if subject in original:
        return original[subject]
    return 'NONE'

def addressee_father_ok(w):
    return (('father' in w or 'mr adler' in w or 'adam' in w) and
            ('attorney' in w or 'counsel' in w) and
            not ('mother' in w or 'ms corwin' in w or 'catherine' in w))

def addressee_mother_ok(w):
    return (('mother' in w or 'ms corwin' in w or 'catherine' in w) and
            ('attorney' in w or 'counsel' in w) and
            not ('father' in w or 'mr adler' in w or 'adam' in w))

def rofr_ok(w):
    return (('agreed' in w or 'agreement' in w) and
            ('mr adler' in w or 'father' in w) and
            ('overnight' in w or 'not to be left' in w) and
            ('without him' in w or 'without mr adler' in w or 'without the father' in w) and
            'mother' not in w and 'ms corwin' not in w and 'her present' not in w and
            'permitted' not in w)

def children_named_ok(w):
    return 'noor' in w and 'imogen' in w and 'seven' in w and 'twelve' in w

def overnight_stays_ok(w):
    return ('several' in w and 'both' in w and 'overnight' in w and
            'home' in w and 'sitter' in w and 'away' in w)

def inconsistent_accounts_ok(w):
    return ('wife' in w and 'school' in w and 'clinician' in w and
            ('sitter' in w or 'babysitter' in w) and 'me' in w and
            ('neighbour' in w or 'neighbor' in w))

def concern_old_ok(w):
    return ('concern' in w and
            ('appreciate' in w or 'violate' in w or 'contravene' in w) and
            'position' in w and ('put in' in w or 'placed in' in w))

def concern_new_ok(w):
    return ('concern' in w and 'position' in w and ('put in' in w or 'placed in' in w) and
            'appreciate' not in w and 'violate' not in w and 'contravene' not in w)

def has_setback(w):
