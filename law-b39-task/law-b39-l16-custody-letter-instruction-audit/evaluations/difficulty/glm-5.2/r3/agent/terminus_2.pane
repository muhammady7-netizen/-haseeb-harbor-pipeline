[?2004l[?2004h> import csv
[?2004l[?2004h> from collections import defaultdict, OrderedDict
[?2004l[?2004h> rows=list(csv.DictReader(open('/app/input/letter_lines.csv')))
[?2004l[?2004h> by=defaultdict(list)
[?2004l[?2004h> for r in rows: by[r['subject']].append(r)
[?2004l[?2004h> for s in sorted(by):
[?2004l[?2004h>     print(f'### {s} ({len(by[s])})')
[?2004l[?2004h>     pos_map=OrderedDict()
[?2004l[?2004h>     for r in by[s]:
[?2004l[?2004h>         pos_map.setdefault(r['position'], []).append(r)
[?2004l[?2004h>     for pos, rs in pos_map.items():
[?2004l[?2004h>         ids=', '.join(r['line_id'] for r in rs)
[?2004l[?2004h>         ces=', '.join(sorted(set(r['cited_entry'] for r in rs)))
[?2004l[?2004h>         w=rs[0]['wording']
[?2004l[?2004h>         print(f'POS: {pos} | IDS: {ids} | CE: {ces} | EX: {w[:120]}')
[?2004l[?2004h>     print()
[?2004l[?2004h> PY
