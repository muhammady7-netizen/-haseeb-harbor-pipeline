[159.700245, "o", "\u001b[?2004h\u001b[01;32mappuser@2cc695c72b41\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[187.779309, "i", "python3 - <<'PY' > /tmp/groups.txt\nimport csv, collections\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\ngroups=collections.defaultdict(list)\nfor r in rows:\n    groups[(r['subject'],r['position'],r['cited_entry'])].append(r['line_id'])\nfor idx,((subj,pos,cite),ids) in enumerate(sorted(groups.items()),1):\n    sample=next(r for r in rows if r['line_id']==ids[0])['wording']\n    if len(sample)>120: sample=sample[:117]+'...'\n    print(f\"{idx:03d}|{subj}|{pos}|{cite}|{','.join(ids)}|{sample}\")\nPY\nwc -l /tmp/groups.txt\n"]
