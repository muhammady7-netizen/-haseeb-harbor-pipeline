[1435.165487, "i", "python3 - <<'PY'\nimport csv, json, collections\n\nrows = list(csv.DictReader(open('/app/input/letter_lines.csv')))\n\norig = {\n    'addressee': 'OI-201',\n    'right_of_first_refusal': 'OI-202',\n    'children_named': 'OI-203',\n    'overnight_stays': 'OI-204',\n    'inconsistent_accounts': 'OI-205',\n    'concern': 'OI-206',\n    'behavioural_plan': 'OI-207',\n    'request': 'OI-208',\n    'enclosure': 'OI-209',\n    'tone': 'OI-210',\n    'sender_signature': 'OI-211',\n}\ncl = {\n    'addressee': 'CL-301',\n    'request': 'CL-302',\n    'enclosure': 'CL-303',\n    'salutation': 'CL-304',\n    'copies': 'CL-305',\n    'delivery': 'CL-306',\n    'tone': 'CL-307',\n    'behavioural_plan': 'CL-308',\n    'concern': 'CL-309',\n    'interim_contact': 'CL-310',\n    'without_prejudice': 'CL-311',\n}\ncl_id_to_subject = {v: k for k, v in cl.items()}\n\ndef governing(subject, cited):\n    if subject not in orig and subject not in cl:\n        return 'NONE'\n    if subject in orig and cited in cl_id_to_subject and cl_id_to_subject[cited] != subject:\n"]
