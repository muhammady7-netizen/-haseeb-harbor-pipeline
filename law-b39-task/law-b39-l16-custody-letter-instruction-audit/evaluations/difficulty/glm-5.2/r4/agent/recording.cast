[394.749188, "i", "python3 - <<'PY'\nimport csv, re\ncl_subject={\n'CL-301':'addressee','CL-302':'request','CL-303':'enclosure','CL-304':'salutation',\n'CL-305':'copies','CL-306':'delivery','CL-307':'tone','CL-308':'behavioural_plan',\n'CL-309':'concern','CL-310':'interim_contact','CL-311':'without_prejudice'\n}\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nprint('cross-subject CL citations:')\nfor i,r in enumerate(rows,1):\n    c=r['cited_entry']\n    if c in cl_subject and cl_subject[c]!=r['subject']:\n        print(f\"{i:03d}|{r['line_id']}|{r['subject']}|{r['position']}|{c}->{cl_subject[c]}|{r['wording']}\")\nPY\n"]
