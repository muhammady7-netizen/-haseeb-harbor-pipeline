[394.809649, "o", "\u001b[?2004h\u001b[01;32mappuser@2cc695c72b41\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[503.690857, "i", "python3 - <<'PY'\nimport csv, collections\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nfor subj in ['addressee','request','enclosure','salutation','copies','delivery','tone','behavioural_plan','concern','interim_contact','without_prejudice','right_of_first_refusal','children_named','overnight_stays','inconsistent_accounts','sender_signature']:\n    print(f'=== {subj} ===')\n    seen=set()\n    for r in rows:\n        if r['subject']!=subj: continue\n        key=(r['position'],r['wording'])\n        if key in seen: continue\n        seen.add(key)\n        w=r['wording']\n        if len(w)>160: w=w[:157]+'...'\n        print(f\"{r['line_id']}|{r['position']}|{r['cited_entry']}|{w}\")\nPY\n"]
[503.694209, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import csv, collections\r\n\u001b[?2004l\r\u001b[?2004h> rows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\r\n\u001b[?2004l\r\u001b[?2004h> "]
