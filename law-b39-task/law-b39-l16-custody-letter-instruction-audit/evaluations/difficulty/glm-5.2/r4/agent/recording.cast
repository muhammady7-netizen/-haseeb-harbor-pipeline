[159.621584, "i", "python3 - <<'PY'\nimport csv, collections\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\ngroups=collections.defaultdict(list)\nfor r in rows:\n    groups[(r['subject'],r['position'],r['cited_entry'])].append(r['line_id'])\nfor (subj,pos,cite),ids in sorted(groups.items()):\n    sample=next(r for r in rows if r['line_id']==ids[0])['wording']\n    if len(sample)>140: sample=sample[:137]+'...'\n    print(f\"{subj}|{pos}|{cite}|{','.join(ids)}|{sample}\")\nPY\n"]
[159.621992, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
