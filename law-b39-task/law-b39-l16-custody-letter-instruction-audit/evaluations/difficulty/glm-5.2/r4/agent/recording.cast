[1653.438536, "i", "python3 - <<'PY'\nimport csv\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nrev={r['line_id']:r for r in csv.DictReader(open('/app/letter_line_review.csv'))}\norig={'addressee':'OI-201','right_of_first_refusal':'OI-202','children_named':'OI-203','overnight_stays':'OI-204','inconsistent_accounts':'OI-205','concern':'OI-206','behavioural_plan':'OI-207','request':'OI-208','enclosure':'OI-209','tone':'OI-210','sender_signature':'OI-211'}\ncl={'addressee':'CL-301','request':'CL-302','enclosure':'CL-303','salutation':'CL-304','copies':'CL-305','delivery':'CL-306','tone':'CL-307','behavioural_plan':'CL-308','concern':'CL-309','interim_contact':'CL-310','without_prejudice':'CL-311'}\ncl_id_to_subject={v:k for k,v in cl.items()}\ndef governing(subject,cited):\n    if subject not in orig and subject not in cl:\n        return 'NONE'\n    if subject in orig and cited in cl_id_to_subject and cl_id_to_subject[cited]!=subject:\n        return orig[subject]\n    return cl[subject] if subject in cl else orig[subject]\nf"]
[1653.439451, "o", "python3 - <<'PY'\r\n"]
[1653.439785, "i", "or r in rows:\n    if r['subject']=='request':\n        rr=rev[r['line_id']]\n        print(f\"{r['line_id']}|cite={r['cited_entry']}|gov={governing(r['subject'],r['cited_entry'])}|csv={rr['record_entry']}|{rr['verdict']}|{r['position']}|{r['wording']}\")\nPY\n"]
