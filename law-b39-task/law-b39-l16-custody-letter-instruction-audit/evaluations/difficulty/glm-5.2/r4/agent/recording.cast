[27.339121, "i", "python3 - <<'PY'\nimport csv, collections\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\nprint('data rows', len(rows))\nprint('subjects:', sorted(collections.Counter(r['subject'] for r in rows).items()))\nprint('positions:', sorted(collections.Counter(r['position'] for r in rows).items()))\nprint('cited_entries:', sorted(collections.Counter(r['cited_entry'] for r in rows).items()))\nPY\n"]
