[679.554734, "i", "python3 - <<'PY'\nimport csv, collections\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\norig={'addressee':'OI-201','right_of_first_refusal':'OI-202','children_named':'OI-203','overnight_stays':'OI-204','inconsistent_accounts':'OI-205','concern':'OI-206','behavioural_plan':'OI-207','request':'OI-208','enclosure':'OI-209','tone':'OI-210','sender_signature':'OI-211'}\ncl={'addressee':'CL-301','request':'CL-302','enclosure':'CL-303','salutation':'CL-304','copies':'CL-305','delivery':'CL-306','tone':'CL-307','behavioural_plan':'CL-308','concern':'CL-309','interim_contact':'CL-310','without_prejudice':'CL-311'}\ndef gov(s,c):\n    if s not in orig and s not in cl: return 'NONE'\n    if c in cl and cl[c]!=s and s in orig: return orig[s]\n    return cl[s] if s in cl else orig[s]\npos=collections.defaultdict(lambda: collections.defaultdict(list))\nfor r in rows:\n    g=gov(r['subject'],r['cited_entry'])\n    pos[g][r['position']].append(r['line_id'])\nfor g in sorted(pos):\n    print('===',g,'===')\n    for p,ids "]
