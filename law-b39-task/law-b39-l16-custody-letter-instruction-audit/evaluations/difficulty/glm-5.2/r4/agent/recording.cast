[1456.528999, "i", "python3 - <<'PY'\nimport csv, json, collections\nrows = list(csv.DictReader(open('/app/letter_line_review.csv')))\ninput_rows = list(csv.DictReader(open('/app/input/letter_lines.csv')))\nassert len(rows) == len(input_rows) == 325\nassert open('/app/letter_line_review.csv').readline().strip() == 'line_id,verdict,record_entry'\nallowed = {'VERIFIED','AT_ODDS','NOT_IN_RECORD'}\nassert all(r['verdict'] in allowed for r in rows)\nres = json.load(open('/app/results.json'))\nassert set(res) == {'verified_count','at_odds_count','not_in_record_count','clarification_governed_count'}\nassert [r['line_id'] for r in rows] == [r['line_id'] for r in input_rows]\nprint('formats OK')\nprint('json:', res)\nby = collections.defaultdict(lambda: collections.defaultdict(list))\nfor ir, r in zip(input_rows, rows):\n    by[(r['record_entry'], r['verdict'], ir['position'])].append(r['line_id'])\nfor (g,v,pos),ids in sorted(by.items()):\n    sample = next(ir for ir in input_rows if ir['line_id']==ids[0])['wording']\n    if len(sample)>90: sample=sample"]
[1456.52928, "i", "[:87]+'...'\n    print(f\"{g}|{v}|{pos}|{len(ids)}|{','.join(ids[:6])}|{sample}\")\nPY\n"]
