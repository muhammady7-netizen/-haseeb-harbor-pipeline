[289.931408, "i", "python3 - <<'PY' > /tmp/subject_positions.txt\nimport csv, collections\nrows=list(csv.DictReader(open('/app/input/letter_lines.csv')))\ngroups=collections.defaultdict(list)\nfor r in rows:\n    groups[(r['subject'],r['position'])].append(r['line_id'])\nfor idx,((subj,pos),ids) in enumerate(sorted(groups.items()),1):\n    sample=next(r for r in rows if r['line_id']==ids[0])['wording']\n    if len(sample)>100: sample=sample[:97]+'...'\n    print(f\"{idx:03d}|{subj}|{pos}|{len(ids)}|{','.join(ids[:6])}|{sample}\")\nPY\nwc -l /tmp/subject_positions.txt\n"]
