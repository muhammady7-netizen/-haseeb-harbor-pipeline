[?2004l[?2004h>     g,v,pos = key
[?2004l[?2004h>     ids = by[key]
[?2004l[?2004h>     sample = next(ir for ir in input_rows if ir['line_id']==ids[0])['wording']
[?2004l[?2004h>     if len(sample)>90: sample=sample[:87]+'...'
[?2004l[?2004h>     print(f"{g}|{v}|{pos}|{len(ids)}|{','.join(ids[:6])}|{sample}")
[?2004l[?2004h> PY
