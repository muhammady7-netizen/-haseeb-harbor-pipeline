[?2004l[?2004h> def gov(s,c):
[?2004l[?2004h>     if s not in orig and s not in cl: return 'NONE'
[?2004l[?2004h>     if c in cl and cl[c]!=s and s in orig: return orig[s]
[?2004l[?2004h>     return cl[s] if s in cl else orig[s]
[?2004l[?2004h> pos=collections.defaultdict(lambda: collections.defaultdict(list))
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     g=gov(r['subject'],r['cited_entry'])
[?2004l[?2004h>     pos[g][r['position']].append(r['line_id'])
[?2004l[?2004h> for g in sorted(pos):
[?2004l[?2004h>     print('===',g,'===')
[?2004l[?2004h>     for p,ids in sorted(pos[g].items()):
[?2004l[?2004h>         sample=next(r for r in rows if r['line_id']==ids[0])['wording']
[?2004l[?2004h>         if len(sample)>100: sample=sample[:97]+'...'
[?2004l[?2004h>         print(f"{p}|{','.join(ids[:8])}|{sample}")
[?2004l[?2004h> PY
