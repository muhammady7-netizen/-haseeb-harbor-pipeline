[?2004h[01;32mappuser@2cc695c72b41[00m:[01;34m/app[00m$ python3 - <<'PY' > /tmp/groups.txt
[?2004l[?2004h> import csv, collections
[?2004l[?2004h> rows=list(csv.DictReader(open('/app/input/letter_lines.csv')))
[?2004l[?2004h> groups=collections.defaultdict(list)
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     groups[(r['subject'],r['position'],r['cited_entry'])].append(r['line_id'])
[?2004l[?2004h> for idx,((subj,pos,cite),ids) in enumerate(sorted(groups.items()),1):
[?2004l[?2004h>     sample=next(r for r in rows if r['line_id']==ids[0])['wording']
[?2004l[?2004h>     if len(sample)>120: sample=sample[:117]+'...'
[?2004l[?2004h>     print(f"{idx:03d}|{subj}|{pos}|{cite}|{','.join(ids)}|{sample}")
[?2004l[?2004h> PY
[?2004l[?2004h[01;32mappuser@2cc695c72b41[00m:[01;34m/app[00m$ wc -l /tmp/groups.txt
