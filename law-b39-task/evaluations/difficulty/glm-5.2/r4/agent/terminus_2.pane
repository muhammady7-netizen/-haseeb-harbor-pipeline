[?2004l[?2004h> import csv, collections
[?2004l[?2004h> rows=list(csv.DictReader(open('/app/input/letter_lines.csv')))
[?2004l[?2004h> for subj in ['addressee','request','enclosure','salutation','copies','delivery','tone','behavioural_plan','concern','interim_contact','without_prejudice','right_of_first_refusal','children_named','overnight_stays','inconsistent_accounts','sender_signature']:
[?2004l[?2004h>     print(f'=== {subj} ===')
[?2004l[?2004h>     seen=set()
[?2004l[?2004h>     for r in rows:
[?2004l[?2004h>         if r['subject']!=subj: continue
[?2004l[?2004h>         key=(r['position'],r['wording'])
[?2004l[?2004h>         if key in seen: continue
[?2004l[?2004h>         seen.add(key)
[?2004l[?2004h>         w=r['wording']
[?2004l[?2004h>         if len(w)>160: w=w[:157]+'...'
[?2004l[?2004h>         print(f"{r['line_id']}|{r['position']}|{r['cited_entry']}|{w}")
[?2004l[?2004h> PY
