[?2004l[?2004h> import csv, json, collections
[?2004l[?2004h> 
[?2004l        return orig[subject]
    return cl[subject] if subject in cl else orig[subject]

def verdict(g, r):
    w = r['wording'].lower()
    if g == 'NONE':
        return 'NOT_IN_RECORD'

    if g == 'OI-201':
        if 'directly' in w:
            return 'AT_ODDS'
        if 'mother' in w or 'catherine' in w or 'ms corwin' in w:
            return 'AT_ODDS'
        if 'father' in w or 'mr adler' in w or 'adler' in w or 'adam' in w:
            return 'VERIFIED'
        return 'AT_ODDS'

    if g == 'CL-301':
        if 'mother' in w or 'catherine' in w or 'ms corwin' in w:
            return 'VERIFIED'
        return 'AT_ODDS'

    if g == 'OI-202':
        if 'ms corwin' in w and 'agreed' in w:
            return 'AT_ODDS'
        if 'but overnight stays without him are still permitted' in w:
            return 'AT_ODDS'
        if 'anyone other than their parents' in w:
            return 'AT_ODDS'
        if ('mr adler' in w or 'father' in w) and 'right of first refusal' in w and (
            'without him present' in w or 'not to be left overnight' in w or 'overnight without' in w
        ):
            return 'VERIFIED'
        return 'AT_ODDS'

    if g == 'OI-203':
        if 'noor' in w and 'imogen' in w and 'seven' in w and 'twelve' in w:
            return 'VERIFIED'
        return 'AT_ODDS'

    if g == 'OI-204':
        if 'several occasions' in w and 'both children' in w and 'home' in w and 'sitter' in w:
            return 'VERIFIED'
        return 'AT_ODDS'

    if g == 'OI-205':
        if 'school' in w and 'clinicians' in w and ('babysitter' in w or 'sitter' in w) and ('neighbour' in w or 'neighbor' in w):
            return 'VERIFIED'
        return 'AT_ODDS'

    if g == 'OI-206':
        if 'position' in w and ('violate' in w or 'contravene' in w or 'appreciate' in w or 'order' in w):
            return 'VERIFIED'
        return 'AT_ODDS'

    if g == 'CL-309':
        if 'violate' in w or 'contravene' in w or 'appreciate' in w or 'no concern' in w or 'not concerned' in w:
            return 'AT_ODDS'
        if 'position' in w:
            return 'VERIFIED'
