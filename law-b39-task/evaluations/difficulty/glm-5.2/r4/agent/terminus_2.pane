[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     groups[(r['subject'],r['position'],r['cited_entry'])].append(r['line_id'])
[?2004l[?2004h> for (subj,pos,cite),ids in sorted(groups.items()):
[?2004l[?2004h>     sample=next(r for r in rows if r['line_id']==ids[0])['wording']
[?2004l[?2004h>     if len(sample)>140: sample=sample[:137]+'...'
[?2004l[?2004h>     print(f"{subj}|{pos}|{cite}|{','.join(ids)}|{sample}")
