[76.411681, "o", "\u001b[?2004h\u001b[01;32mappuser@a448db8cd19c\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[76.823873, "i", "ls -l answer.md letter_line_review.csv results.json\nwc -l letter_line_review.csv\npython3 -m json.tool results.json\npython3 - <<'PY'\nimport csv, json, os\nassert os.path.exists('answer.md') and os.path.getsize('answer.md') > 0\nwith open('letter_line_review.csv', newline='') as f:\n    rows = list(csv.DictReader(f))\nassert len(rows) == 16, len(rows)\nassert [r['line_id'] for r in rows] == ['ST-%03d' % i for i in range(101, 117)]\nassert all(r['verdict'] in {'VERIFIED', 'AT_ODDS', 'NOT_IN_RECORD'} for r in rows)\nwith open('results.json') as f:\n    data = json.load(f)\nassert set(data) == {'verified_count', 'at_odds_count', 'not_in_record_count', 'clarification_governed_count'}\nassert data['verified_count'] == sum(r['verdict'] == 'VERIFIED' for r in rows)\nassert data['at_odds_count'] == sum(r['verdict'] == 'AT_ODDS' for r in rows)\nassert data['not_in_record_count'] == sum(r['verdict'] == 'NOT_IN_RECORD' for r in rows)\nassert data['clarification_governed_count'] == sum(r['record_entry'].startswith('CL-') for r in rows)"]
[76.82421, "i", "\nprint('validated: files exist and totals match')\nPY\n"]
[76.824674, "o", "ls -l answer.md letter_line_review.csv results.json\r\n\u001b[?2004l\r"]
