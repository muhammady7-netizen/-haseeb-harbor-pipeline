[76.928757, "o", "with open('results.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.929062, "o", "    data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.929785, "o", "assert set(data) == {'verified_count', 'at_odds_count', 'not_in_record_count', 'clarification_governed_count'}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.930237, "o", "assert data['verified_count'] == sum(r['verdict'] == 'VERIFIED' for r in rows)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.930681, "o", "assert data['at_odds_count'] == sum(r['verdict'] == 'AT_ODDS' for r in rows)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.931124, "o", "assert data['not_in_record_count'] == sum(r['verdict'] == 'NOT_IN_RECORD' for r in rows)\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.931208, "o", "> "]
[76.93185, "o", "assert data['clarification_governed_count'] == sum(r['record_entry'].startswith('CL-') for r in rows)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.932207, "o", "print('validated: files exist and totals match')\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.932476, "o", "> PY\r\n\u001b[?2004l\r"]
[76.970265, "o", "validated: files exist and totals match\r\n"]
