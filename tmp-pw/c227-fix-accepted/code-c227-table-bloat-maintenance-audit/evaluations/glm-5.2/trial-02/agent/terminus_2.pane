0.10') if sc=='large' else Decimal('0.05'))
    return base

out=[]
for t,r in health.items():
    tp=int(r['total_pages']); dp=int(r['dead_pages']); ratio=rhu(Decimal(dp)/Decimal(tp)); sc=size_cls(tp)
    la=date.fromisoformat(r['last_analyzed']); days=(AUDIT_DATE-la).days; stale=days>=30; cap=cap_for(sc,stale)
    auto= (pb(r['autovacuum_enabled']) is False) or r['vacuum_type']=='manual'
    bloat= ratio>cap
    rex=False; rex_msg='no reindex log'
    if pb(r['maintenance_active']):
        rl=reindex.get(t)
        if not rl: rex_msg='no reindex log entry'
        elif not pb(rl['approved']): rex_msg=f"reindex approved={rl['approved']}"
        elif not (date.fromisoformat(rl['valid_until'])>AUDIT_DATE): rex_msg=f"reindex valid_until {rl['valid_until']} expired"
        else: rex=True; rex_msg=f"reindex valid_until {rl['valid_until']} valid"
    else: rex_msg='maintenance_active not True'
    hold=None; hold_msg='no ticket'
    tk=tickets.get(t)
    if tk:
        if tk['exception_type']!='BLOAT_HOLD': hold_msg=f"ticket {tk['ticket_id']} exception_type {tk['exception_type']}"
        elif tk['status']!='Closed': hold_msg=f"ticket {tk['ticket_id']} status {tk['status']}"
        elif not pb(tk['approved']): hold_msg=f"ticket {tk['ticket_id']} approved={tk['approved']}"
        elif not (date.fromisoformat(tk['valid_until'])>AUDIT_DATE): hold_msg=f"ticket {tk['ticket_id']} valid_until {tk['valid_until']} not after audit"
        else: hold=tk; hold_msg=f"ticket {tk['ticket_id']} qualifying hold"
    suppressed = bloat and (rex or hold is not None)
    if auto: finding='AUTOVACUUM_DISABLED'
    elif bloat and not suppressed: finding='BLOAT_THRESHOLD_EXCEEDED'
    elif stale: finding='STALE_STATISTICS'
    else: finding='none'
    out.append({k:v for k,v in locals().items() if k in ['t','finding','ratio','cap','sc','tp','dp','days','stale','auto','r','rex','rex_msg','hold','hold_msg','suppressed','bloat']})
out.sort(key=lambda x:(health[x['t']]['last_analyzed'], x['t']))
print('COUNTS', Counter(x['finding'] for x in out))
print('NONNONE')
for x in out:
    if x['finding']!='none':
        print(json.dumps({k:x[k] for k in ['t','finding','ratio','cap','sc','tp','dp','days','stale','bloat','suppressed','rex','rex_msg','hold','hold_msg']}, sort_keys=True))
