[62.59814, "i", "isabled = (parse_bool(r['autovacuum_enabled']) is False) or (r['vacuum_type'] == 'manual')\n    bloat_exceeded = ratio > cap\n    rex, rex_msg = reindex_exempt(r)\n    hold, hold_msg = qualifying_hold(table)\n    if auto_disabled:\n        finding = 'AUTOVACUUM_DISABLED'\n    elif bloat_exceeded:\n        if rex:\n            finding = 'none'  # exempt from bloat check\n            bloat_note = f'reindex exempt ({rex_msg})'\n        elif hold:\n            finding = 'none' if not stale else 'STALE_STATISTICS'\n            bloat_note = f'hold suppressed ({hold_msg})'\n        else:\n            finding = 'BLOAT_THRESHOLD_EXCEEDED'\n            bloat_note = 'no hold/exemption'\n    elif stale:\n        finding = 'STALE_STATISTICS'\n        bloat_note = 'not bloated'\n    else:\n        finding = 'none'\n        bloat_note = 'not bloated'\n    audit.append({\n        'table_name': table,\n        'last_analyzed': r['last_analyzed'],\n        'total_pages': total_pages,\n        'dead_pages': dead_pages,\n        'ratio': str(ratio),\n     "]
