[427.576719, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('/app/bloat_memo.md')\ntext=p.read_text()\nold=None\nfor line in text.splitlines():\n    if line.startswith('T-130 '):\n        old=line\n        break\nnew=('T-130 has STALE_STATISTICS because computed 40 days since last_analyzed is at least 30, not legacy days_since_analyze value 1; '\n     'computed small class is derived from total_pages 400 with dead_pages 160, ratio 0.40, and tightened cap 0.35. '\n     'Export size_class medium is a trap, so computed class is used. Bloat over cap was suppressed by ticket CH-2210 qualifying hold, so stale stats remains.')\nprint('old len', len(old), old)\nprint('new len', len(new), new)\ntext=text.replace(old, new)\np.write_text(text)\nPY\n"]
