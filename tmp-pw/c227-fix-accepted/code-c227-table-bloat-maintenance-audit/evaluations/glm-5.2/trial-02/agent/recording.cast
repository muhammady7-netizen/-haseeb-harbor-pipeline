[413.958768, "i", "      'finding': finding,\n    })\n\nout.sort(key=lambda x: (health[x['table_name']]['last_analyzed'], x['table_name']))\n\n# Write CSV\nwith open('/app/bloat_audit.csv', 'w', newline='') as f:\n    w = csv.writer(f)\n    w.writerow(['table_name','size_class','bloat_ratio','finding'])\n    for x in out:\n        w.writerow([x['table_name'], x['size_class'], str(x['ratio']), x['finding']])\n\n# Write results JSON\ncounts = Counter(x['finding'] for x in out)\nresults = {\n    'flagged_count': sum(1 for x in out if x['finding'] != 'none'),\n    'autovacuum_disabled_count': counts.get('AUTOVACUUM_DISABLED', 0),\n    'bloat_exceeded_count': counts.get('BLOAT_THRESHOLD_EXCEEDED', 0),\n    'stale_statistics_count': counts.get('STALE_STATISTICS', 0),\n    'compliant_count': counts.get('none', 0),\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\n')\n\n# Memo\ndef medium_trap(x):\n    return 'export size_class medium is a trap, ' if x['export_size_class'].lower() == 'medium' else ''\n\ndef stale_cl"]
