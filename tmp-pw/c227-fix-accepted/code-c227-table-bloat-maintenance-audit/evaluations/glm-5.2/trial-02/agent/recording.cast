[428.56661, "i", "python3 - <<'PY'\nimport csv, json, re\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\n\nrows=list(csv.DictReader(open('/app/bloat_audit.csv')))\nhealth={}\nwith open('/app/input/table_health.csv', newline='') as f:\n    for r in csv.DictReader(f): health[r['table_name']]=r\nalias={}\nwith open('/app/input/table_aliases.csv', newline='') as f:\n    for r in csv.DictReader(f): alias[r['alias']]=r['table_name']\nreindex={}\nwith open('/app/input/reindex_log.csv', newline='') as f:\n    for r in csv.DictReader(f): reindex[r['table_name']]=r\ntickets={}\nwith open('/app/input/change_control_tickets.csv', newline='') as f:\n    for r in csv.DictReader(f): tickets[alias.get(r['table_ref'], r['table_ref'])]=r\n\ndef rhu(n): return Decimal(str(n)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\nlines={}\nfor line in open('/app/bloat_memo.md'):\n    line=line.rstrip('\\n')\n    if line.startswith('T-'):\n        t=line.split()[0]\n        lines[t]=line\n\nprint('CSV columns', list(rows[0].keys()))\nprint('CSV rows', len"]
[428.566994, "i", "(rows))\nexpected=sorted(rows, key=lambda r:(health[r['table_name']]['last_analyzed'], r['table_name']))\nprint('sort ok', rows==expected)\nprint('counts', {f:sum(1 for r in rows if r['finding']==f) for f in ['AUTOVACUUM_DISABLED','BLOAT_THRESHOLD_EXCEEDED','STALE_STATISTICS','none']})\nprint('results', json.load(open('/app/results.json')))\nprint('memo nonnone lines', len(lines))\nissues=[]\nfor r in rows:\n    t=r['table_name']; finding=r['finding']; line=lines.get(t,'')\n    if finding=='none': continue\n    h=health[t]; tp=int(h['total_pages']); dp=int(h['dead_pages']); ratio=str(rhu(Decimal(dp)/Decimal(tp)))\n    days=(date(2026,9,1)-date.fromisoformat(h['last_analyzed'])).days\n    stale=days>=30\n    sc=r['size_class']\n    if t not in lines: issues.append((t,'no memo line'))\n    if finding not in line: issues.append((t,'finding keyword missing'))\n    if ratio not in line: issues.append((t,'ratio missing'))\n    if str(tp) not in line: issues.append((t,'total_pages digits missing'))\n    if str(dp) not in line: issues"]
[428.567074, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
