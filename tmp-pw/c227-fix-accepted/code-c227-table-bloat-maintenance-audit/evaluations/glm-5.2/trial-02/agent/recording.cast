[169.954194, "o", "memo.append('Audit date is 2026-09-01. Bloat ratio was computed as dead_pages / total_pages with round-half-up to 2 decimal places, and size class was computed from total_pages only. Findings follow autovacuum, then bloat, then stale-statistics precedence. Approved active reindex operations and qualifying BLOAT_HOLD tickets suppress bloat findings only, never autovacuum or stale findings.')\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.95448, "o", "> memo.append('')\r\n\u001b[?2004l\r\u001b[?2004h> for x in out:\r\n\u001b[?2004l\r"]
[169.95468, "o", "\u001b[?2004h> "]
[169.95488, "o", "    if x['finding'] == 'none':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.955085, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.9554, "o", "    t = x['table_name']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.955624, "o", "    ratio = str(x['ratio'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.955888, "o", ">     cap = str(x['cap'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.956126, "o", "    tp = x['total_pages']\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.956416, "o", "> "]
