[414.128106, "o", "> "]
[414.134283, "o", "memo.append('Audit date is 2026-09-01. Bloat ratio was computed as dead_pages / total_pages with round-half-up to 2 decimal places, and size class was computed from total_pages only. Findings follow autovacuum, then bloat, then stale-statistics precedence. An approved active reindex operation exempts only the bloat check, and a qualifying BLOAT_HOLD ticket suppresses only a bloat finding, never autovacuum or stale findings. A computed bloat ratio exactly equal to its cap is compliant because the policy flags only a ratio strictly over the cap.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[414.134588, "o", "memo.append('')\r\n\u001b[?2004l\r"]
