[169.968894, "o", "> "]
[169.969231, "o", "    elif x['finding'] == 'STALE_STATISTICS':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.970253, "o", "        s = f\"{t} has STALE_STATISTICS because {days} days since last_analyzed is at least 30; its computed {sc} class is derived from total_pages {tp}, dead_pages {dp}, bloat ratio {ratio}, and cap {cap}.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.97039, "o", "> "]
[169.97062, "o", "        if x['suppressed']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.970819, "o", "> "]
[169.971309, "o", "            s += f\" A bloat ratio {ratio} over the cap was suppressed by {x['hold_msg'] if x['hold'] else x['reindex_msg']}, so stale stats remains the finding.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.971604, "o", "    else:\r\n\u001b[?2004l\r"]
[169.971923, "o", "\u001b[?2004h>         s = f\"{t} is compliant.\""]
[169.972188, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
