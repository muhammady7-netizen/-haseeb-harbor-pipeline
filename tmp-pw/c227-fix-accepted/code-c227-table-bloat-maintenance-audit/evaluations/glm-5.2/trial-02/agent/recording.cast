[413.956651, "i", "python3 - <<'PY'\nimport csv, json, re\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom collections import Counter\nfrom pathlib import Path\n\nAUDIT_DATE = date(2026,9,1)\n\ndef parse_bool(s):\n    return s.strip().lower() == 'true'\n\ndef rhu(n):\n    return Decimal(str(n)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n\ndef sdec(d):\n    return str(d)\n\n# Parse inputs; last occurrence wins for duplicates.\nhealth = {}\nwith open('/app/input/table_health.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        health[r['table_name']] = r\n\nalias = {}\nwith open('/app/input/table_aliases.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        alias[r['alias']] = r['table_name']\n\nreindex = {}\nwith open('/app/input/reindex_log.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        reindex[r['table_name']] = r\n\ntickets = {}\nwith open('/app/input/change_control_tickets.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        tickets[alias.get(r['table_ref'], r['table_re"]
[413.957481, "i", "f'])] = r\n\ndef size_class(tp):\n    return 'large' if tp >= 500 else 'small'\n\ndef cap_for(sc, stale):\n    base = Decimal('0.2') if sc == 'large' else Decimal('0.4')\n    if stale:\n        return base - (Decimal('0.10') if sc == 'large' else Decimal('0.05'))\n    return base\n\ndef reindex_status(r):\n    if not parse_bool(r['maintenance_active']):\n        return False, 'maintenance_active is False'\n    rl = reindex.get(r['table_name'])\n    if not rl:\n        return False, 'no reindex log entry'\n    if not parse_bool(rl['approved']):\n        return False, f\"reindex approved={rl['approved']}\"\n    if not (date.fromisoformat(rl['valid_until']) > AUDIT_DATE):\n        return False, f\"reindex valid_until {rl['valid_until']} expired\"\n    return True, f\"reindex valid_until {rl['valid_until']} is valid\"\n\ndef hold_status(t):\n    tk = tickets.get(t)\n    if not tk:\n        return None, 'no BLOAT_HOLD ticket'\n    if tk['exception_type'] != 'BLOAT_HOLD':\n        return None, f\"ticket {tk['ticket_id']} exception_type {tk['exceptio"]
[413.957717, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import csv, json, re\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.957921, "i", "n_type']} is not BLOAT_HOLD\"\n    if tk['status'] != 'Closed':\n        return None, f\"ticket {tk['ticket_id']} status {tk['status']} is not Closed\"\n    if not parse_bool(tk['approved']):\n        return None, f\"ticket {tk['ticket_id']} approved={tk['approved']} is not approved\"\n    if not (date.fromisoformat(tk['valid_until']) > AUDIT_DATE):\n        return None, f\"ticket {tk['ticket_id']} valid_until {tk['valid_until']} is not after 2026-09-01\"\n    return tk, f\"ticket {tk['ticket_id']} qualifying hold\"\n\nout = []\nfor t, r in health.items():\n    tp = int(r['total_pages'])\n    dp = int(r['dead_pages'])\n    ratio = rhu(Decimal(dp) / Decimal(tp))\n    sc = size_class(tp)\n    la = date.fromisoformat(r['last_analyzed'])\n    days = (AUDIT_DATE - la).days\n    stale = days >= 30\n    cap = cap_for(sc, stale)\n    auto_disabled = (parse_bool(r['autovacuum_enabled']) is False) or (r['vacuum_type'] == 'manual')\n    bloat = ratio > cap\n    rex, rex_msg = reindex_status(r)\n    hold, hold_msg = hold_status(t)\n    bloat_suppressed"]
[413.958144, "o", "from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.958407, "i", " = bloat and (rex or hold is not None)\n\n    if auto_disabled:\n        finding = 'AUTOVACUUM_DISABLED'\n    elif bloat and not bloat_suppressed:\n        finding = 'BLOAT_THRESHOLD_EXCEEDED'\n    elif stale:\n        finding = 'STALE_STATISTICS'\n    else:\n        finding = 'none'\n\n    out.append({\n        'table_name': t,\n        'last_analyzed': r['last_analyzed'],\n        'days': days,\n        'legacy_days': r['days_since_analyze'],\n        'export_size_class': r['size_class'],\n        'size_class': sc,\n        'total_pages': tp,\n        'dead_pages': dp,\n        'ratio': ratio,\n        'cap': cap,\n        'stale': stale,\n        'autovacuum_enabled': r['autovacuum_enabled'],\n        'vacuum_type': r['vacuum_type'],\n        'maintenance_active': r['maintenance_active'],\n        'bloat': bloat,\n        'suppressed': bloat_suppressed,\n        'reindex': rex,\n        'reindex_msg': rex_msg,\n        'hold': hold,\n        'hold_msg': hold_msg,\n        'ticket_id': tickets[t]['ticket_id'] if t in tickets else None,\n  "]
