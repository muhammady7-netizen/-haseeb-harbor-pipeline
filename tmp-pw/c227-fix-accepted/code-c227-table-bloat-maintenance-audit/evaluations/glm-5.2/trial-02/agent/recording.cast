[169.96731, "o", "> "]
[169.967529, "o", "            s += f\" Change-control ticket note: {x['hold_msg']}.\"\r\n"]
[169.967749, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.96799, "o", "        if x['stale']:\r\n\u001b[?2004l\r"]
[169.968231, "o", "\u001b[?2004h> "]
