[169.956834, "o", "> "]
[169.957041, "o", "    sc = x['size_class']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.9573, "o", "    days = x['days']\r\n\u001b[?2004l\r"]
[169.957498, "o", "\u001b[?2004h> "]
[169.957783, "o", "    if x['finding'] == 'AUTOVACUUM_DISABLED':\r\n\u001b[?2004l\r"]
[169.9581, "o", "\u001b[?2004h> "]
[169.958341, "o", "        if x['vacuum_type'] == 'manual':"]
[169.958585, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.959978, "o", "            s = f\"{t} has AUTOVACUUM_DISABLED because vacuum_type is manual, which overrides autovacuum even though autovacuum_enabled={x['autovacuum_enabled']}; its computed {sc} class is derived from total_pages {tp} with dead_pages {dp}, bloat ratio {ratio}, and cap {cap}.\"\r\n\u001b[?2004l\r"]
[169.960213, "o", "\u001b[?2004h>         else:"]
[169.96032, "o", "\r\n\u001b[?2004l\r"]
[169.960557, "o", "\u001b[?2004h> "]
