[62.616349, "o", "reindex = {}\r\n\u001b[?2004l\r"]
[62.616561, "o", "\u001b[?2004h> "]
[62.617025, "o", "with Path('/app/input/reindex_log.csv').open(newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.617391, "o", "    for r in csv.DictReader(f):\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.617678, "o", "> "]
[62.618372, "o", "        reindex[r['table_name']] = r\r\n\u001b[?2004l\r"]
[62.618691, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.619637, "o", "# change tickets last row per resolved table\r\n\u001b[?2004l\rl\u001b[?2004h"]
[62.619895, "o", "> "]
[62.620154, "o", "tickets = {}\r\n\u001b[?2004l\r1\u001b[?2004h> "]
[62.621786, "o", "with Path('/app/input/change_control_tickets.csv').open(newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.622561, "o", "    for r in csv.DictReader(f):\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.622831, "o", "> "]
[62.623209, "o", "        ref = r['table_ref']\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.623455, "o", "> "]
[62.62418, "o", "        table = alias_to_table.get(ref, ref)\r\n\u001b[?2004l\r"]
[62.624442, "o", "\u001b[?2004h> "]
[62.624954, "o", "        r['_resolved_table'] = table\r\n\u001b[?2004l\r"]
[62.625209, "o", "\u001b[?2004h>         tickets[table] = r\r\n\u001b[?2004l\r"]
[62.625592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.625919, "o", "def size_class(total_pages):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.626251, "o", "    return 'large' if total_pages >= 500 else 'small'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.626529, "o", "def cap_for(size_cls, stale):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.626953, "o", "    base = Decimal('0.2') if size_cls == 'large' else Decimal('0.4')\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.627239, "o", ">     if stale:\r\n\u001b[?2004l\r"]
[62.6275, "o", "\u001b[?2004h> "]
[62.62792, "o", "        red = Decimal('0.10') if size_cls == 'large' else Decimal('0.05')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.628201, "o", "        return base - red\r\n\u001b[?2004l\r\u001b[?2004h>     return base\r\n\u001b[?2004l\r"]
[62.62844, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.628526, "o", "def reindex_exempt(r):\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.628809, "o", "> "]
[62.629074, "o", "    if parse_bool(r['maintenance_active']) is not True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.629318, "o", "        return False, 'maintenance_active not True'\r\n\u001b[?2004l\r"]
[62.629658, "o", "\u001b[?2004h> "]
[62.62996, "o", "    rl = reindex.get(r['table_name'])\r\n\u001b[?2004l\r\u001b[?2004h>     if not rl:\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.630133, "o", "> "]
[62.630415, "o", "        return False, 'no reindex log entry'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.630593, "o", "    if parse_bool(rl['approved']) is not True:\r\n\u001b[?2004l\r"]
[62.63086, "o", "\u001b[?2004h> "]
[62.631098, "o", "        return False, f\"approved={rl['approved']}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.631425, "o", "    vu = date.fromisoformat(rl['valid_until'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.631629, "o", "    if not (vu > AUDIT_DATE):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.632033, "o", "        return False, f\"valid_until {rl['valid_until']} not > 2026-09-01\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.63229, "o", "> "]
[62.632562, "o", "    return True, f\"valid_until {rl['valid_until']} > 2026-09-01\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.632817, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[62.633049, "o", "> def qualifying_hold(table):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.633409, "o", "    t = tickets.get(table)\r\n\u001b[?2004l\r\u001b[?2004h>     if not t:\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.633618, "o", "> "]
[62.633776, "o", "        return None, 'no ticket'\r\n\u001b[?2004l\r"]
[62.633911, "o", "\u001b[?2004h> "]
[62.634233, "o", "    if t['exception_type'] != 'BLOAT_HOLD':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.634575, "o", "        return None, f\"exception_type {t['exception_type']}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.634893, "o", "    if t['status'] != 'Closed':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.634981, "o", "        return None, f\"status {t['status']}\"\r\n\u001b[?2004l\r"]
[62.635289, "o", "\u001b[?2004h>     if parse_bool(t['approved']) is not True:\r\n\u001b[?2004l\r"]
[62.63552, "o", "\u001b[?2004h> "]
[62.635792, "o", "        return None, f\"approved {t['approved']}\"\r\n\u001b[?2004l\r"]
[62.636072, "o", "\u001b[?2004h> "]
[62.636292, "o", "    vu = date.fromisoformat(t['valid_until'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.636533, "o", "    if not (vu > AUDIT_DATE):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.636879, "o", "        return None, f\"valid_until {t['valid_until']} not > 2026-09-01\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.637167, "o", "> "]
[62.637487, "o", "    return t, f\"qualifying {t['ticket_id']}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[62.637688, "o", "\u001b[?2004h> "]
[62.638435, "o", "audit = []\r\n\u001b[?2004l\r"]
[62.63878, "o", "\u001b[?2004h> "]
[62.639211, "o", "for table, r in health.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.639485, "o", "    total_pages = int(r['total_pages'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.639789, "o", "    dead_pages = int(r['dead_pages'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.640344, "o", "    ratio = round_half_up2(Decimal(dead_pages) / Decimal(total_pages))\r\n\u001b[?2004l\r"]
[62.640652, "o", "\u001b[?2004h> "]
[62.640967, "o", "    size_cls = size_class(total_pages)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.641455, "o", "    last_analyzed = date.fromisoformat(r['last_analyzed'])\r\n\u001b[?2004l\r"]
[62.641747, "o", "\u001b[?2004h> "]
[62.642123, "o", "    days = (AUDIT_DATE - last_analyzed).days\r\n\u001b[?2004l\r"]
[62.642498, "o", "\u001b[?2004h> "]
[62.642643, "o", "    stale = days >= 30\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.642813, "o", "    cap = cap_for(size_cls, stale)\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.643042, "o", "> "]
[62.643315, "o", "    auto_disabled = (parse_bool(r['autovacuum_enabled']) is False) or (r['vacuum_type'] == 'manual')\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.643563, "o", ">     bloat_exceeded = ratio > cap\r\n\u001b[?2004l\r"]
[62.643821, "o", "\u001b[?2004h> "]
[62.644043, "o", "    rex, rex_msg = reindex_exempt(r)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.644318, "o", "    hold, hold_msg = qualifying_hold(table)\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.644556, "o", "> "]
[62.644823, "o", "    if auto_disabled:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.645186, "o", "        finding = 'AUTOVACUUM_DISABLED'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.645443, "o", "    elif bloat_exceeded:"]
[62.645731, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.646032, "o", "        if rex:\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.646279, "o", ">             finding = 'none'  # exempt from bloat check\r\n\u001b[?2004l\r"]
[62.646555, "o", "\u001b[?2004h> "]
[62.646876, "o", "            bloat_note = f'reindex exempt ({rex_msg})'\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.647112, "o", ">         elif hold:\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.647326, "o", "> "]
[62.647563, "o", "            finding = 'none' if not stale else 'STALE_STATISTICS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.647931, "o", "            bloat_note = f'hold suppressed ({hold_msg})'\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.648167, "o", ">         else:\r\n\u001b[?2004l\r"]
[62.64847, "o", "\u001b[?2004h> "]
[62.648622, "o", "            finding = 'BLOAT_THRESHOLD_EXCEEDED'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.648844, "o", "            bloat_note = 'no hold/exemption'\r\n\u001b[?2004l\r"]
[62.649039, "o", "\u001b[?2004h> "]
[62.649285, "o", "    elif stale:\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.649508, "o", "> "]
[62.649772, "o", "        finding = 'STALE_STATISTICS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.650067, "o", "        bloat_note = 'not bloated'\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.65029, "o", ">     else:\r\n\u001b[?2004l\r"]
[62.650435, "o", "\u001b[?2004h> "]
[62.650676, "o", "        finding = 'none'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.650945, "o", "        bloat_note = 'not bloated'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.651095, "o", "    audit.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.651328, "o", "        'table_name': table,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.651492, "o", "        'last_analyzed': r['last_analyzed'],\r\n\u001b[?2004l\r"]
[62.651568, "o", "\u001b[?2004h> "]
[62.651841, "o", "        'total_pages': total_pages,\r\n\u001b[?2004l\r"]
[62.651917, "o", "\u001b[?2004h> "]
[62.652279, "o", "        'dead_pages': dead_pages,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.652531, "o", "        'ratio': str(ratio),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.65274, "o", "        'size_class': size_cls,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.653175, "o", "        'cap': str(cap),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.653485, "o", "        'stale': stale,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.653676, "o", "        'days': days,\r\n\u001b[?2004l\r"]
[62.653933, "o", "\u001b[?2004h"]
[62.654091, "o", "> "]
[62.654712, "o", "        'autovacuum_enabled': r['autovacuum_enabled'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.655131, "o", "        'vacuum_type': r['vacuum_type'],\r\n\u001b[?2004l\r"]
[62.655423, "o", "\u001b[?2004h> "]
[62.655868, "o", "        'maintenance_active': r['maintenance_active'],\r\n\u001b[?2004l\r"]
[62.655958, "o", "\u001b[?2004h> "]
[62.656341, "o", "        'finding': finding,\r\n\u001b[?2004l\r"]
[62.656591, "o", "\u001b[?2004h> "]
[62.656833, "o", "        'bloat_exceeded_raw': bloat_exceeded,\r\n\u001b[?2004l\r"]
[62.657015, "o", "\u001b[?2004h> "]
[62.657343, "o", "        'reindex': rex_msg,\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.657702, "o", "> "]
[62.65817, "o", "        'hold': hold_msg,\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[62.658416, "o", "\u001b[?2004h> "]
[62.658743, "o", "audit.sort(key=lambda x: (x['last_analyzed'], x['table_name']))\r\n\u001b[?2004l\r"]
[62.65896, "o", "\u001b[?2004h"]
[62.659197, "o", "> "]
[62.659442, "o", "print('unique tables:', len(audit))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.659685, "o", "for x in audit:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.661346, "o", "    print(f\"{x['table_name']:5} last={x['last_analyzed']} days={x['days']:3} size={x['size_class']:5} total={x['total_pages']:4} dead={x['dead_pages']:4} ratio={x['ratio']:4} cap={x['cap']:4} auto={x['autovacuum_enabled']:5} vac={x['vacuum_type']!r:9} maint={x['maintenance_active']:5} bloat={x['bloat_exceeded_raw']!s:5} rex={x['reindex']:30} hold={x['hold']:35} finding={x['finding']}\")\r\n\u001b[?2004l\r"]
[62.661638, "o", "\u001b[?2004h> "]
[62.661931, "o", "from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.662395, "o", "c=Counter(x['finding'] for x in audit)\r\n\u001b[?2004l\r"]
[62.66263, "o", "\u001b[?2004h> "]
[62.662845, "o", "print(c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.663209, "o", "print('flagged', sum(1 for x in audit if x['finding']!='none'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.663464, "o", "print('autovacuum', c.get('AUTOVACUUM_DISABLED',0))\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.663728, "o", "> "]
[62.663923, "o", "print('bloat', c.get('BLOAT_THRESHOLD_EXCEEDED',0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.664144, "o", "print('stale', c.get('STALE_STATISTICS',0))\r\n"]
[62.664402, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[62.664601, "o", "print('none', c.get('none',0))\r\n\u001b[?2004l\r"]
[62.664798, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
