[62.596592, "i", "python3 - <<'PY'\nimport csv\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom pathlib import Path\n\nAUDIT_DATE = date(2026,9,1)\n\ndef parse_bool(s):\n    return s.strip().lower() == 'true'\n\ndef round_half_up2(num):\n    d = Decimal(str(num))\n    return d.quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n\n# table_health last row per table\nhealth_path = Path('/app/input/table_health.csv')\nrows = []\nwith health_path.open(newline='') as f:\n    for r in csv.DictReader(f):\n        rows.append(r)\nhealth = {}\nfor r in rows:\n    health[r['table_name']] = r\n\n# aliases\nalias_to_table = {}\nwith Path('/app/input/table_aliases.csv').open(newline='') as f:\n    for r in csv.DictReader(f):\n        alias_to_table[r['alias']] = r['table_name']\n\n# reindex log last row per table\nreindex = {}\nwith Path('/app/input/reindex_log.csv').open(newline='') as f:\n    for r in csv.DictReader(f):\n        reindex[r['table_name']] = r\n\n# change tickets last row per resolved table\ntickets = {}\nwith Path('/app/input/change_co"]
[62.597339, "i", "ntrol_tickets.csv').open(newline='') as f:\n    for r in csv.DictReader(f):\n        ref = r['table_ref']\n        table = alias_to_table.get(ref, ref)\n        r['_resolved_table'] = table\n        tickets[table] = r\n\ndef size_class(total_pages):\n    return 'large' if total_pages >= 500 else 'small'\n\ndef cap_for(size_cls, stale):\n    base = Decimal('0.2') if size_cls == 'large' else Decimal('0.4')\n    if stale:\n        red = Decimal('0.10') if size_cls == 'large' else Decimal('0.05')\n        return base - red\n    return base\n\ndef reindex_exempt(r):\n    if parse_bool(r['maintenance_active']) is not True:\n        return False, 'maintenance_active not True'\n    rl = reindex.get(r['table_name'])\n    if not rl:\n        return False, 'no reindex log entry'\n    if parse_bool(rl['approved']) is not True:\n        return False, f\"approved={rl['approved']}\"\n    vu = date.fromisoformat(rl['valid_until'])\n    if not (vu > AUDIT_DATE):\n        return False, f\"valid_until {rl['valid_until']} not > 2026-09-01\"\n    return True, f"]
[62.597375, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r"]
[62.597773, "i", "\"valid_until {rl['valid_until']} > 2026-09-01\"\n\ndef qualifying_hold(table):\n    t = tickets.get(table)\n    if not t:\n        return None, 'no ticket'\n    if t['exception_type'] != 'BLOAT_HOLD':\n        return None, f\"exception_type {t['exception_type']}\"\n    if t['status'] != 'Closed':\n        return None, f\"status {t['status']}\"\n    if parse_bool(t['approved']) is not True:\n        return None, f\"approved {t['approved']}\"\n    vu = date.fromisoformat(t['valid_until'])\n    if not (vu > AUDIT_DATE):\n        return None, f\"valid_until {t['valid_until']} not > 2026-09-01\"\n    return t, f\"qualifying {t['ticket_id']}\"\n\naudit = []\nfor table, r in health.items():\n    total_pages = int(r['total_pages'])\n    dead_pages = int(r['dead_pages'])\n    ratio = round_half_up2(Decimal(dead_pages) / Decimal(total_pages))\n    size_cls = size_class(total_pages)\n    last_analyzed = date.fromisoformat(r['last_analyzed'])\n    days = (AUDIT_DATE - last_analyzed).days\n    stale = days >= 30\n    cap = cap_for(size_cls, stale)\n    auto_d"]
