[169.869663, "i", "e'], x['size_class'], str(x['ratio']), x['finding']])\n\ncounts = Counter(x['finding'] for x in out)\nresults = {\n    'flagged_count': sum(1 for x in out if x['finding'] != 'none'),\n    'autovacuum_disabled_count': counts.get('AUTOVACUUM_DISABLED', 0),\n    'bloat_exceeded_count': counts.get('BLOAT_THRESHOLD_EXCEEDED', 0),\n    'stale_statistics_count': counts.get('STALE_STATISTICS', 0),\n    'compliant_count': counts.get('none', 0),\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\n')\n\n# Memo lines\nmemo = []\nmemo.append('# Monthly table maintenance review memo')\nmemo.append('')\nmemo.append('Audit date is 2026-09-01. Bloat ratio was computed as dead_pages / total_pages with round-half-up to 2 decimal places, and size class was computed from total_pages only. Findings follow autovacuum, then bloat, then stale-statistics precedence. Approved active reindex operations and qualifying BLOAT_HOLD tickets suppress bloat findings only, never autovacuum or stale findings.')\nmemo."]
[169.869941, "o", "from decimal import Decimal, ROUND_HALF_UP\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.870187, "i", "append('')\nfor x in out:\n    if x['finding'] == 'none':\n        continue\n    t = x['table_name']\n    ratio = str(x['ratio'])\n    cap = str(x['cap'])\n    tp = x['total_pages']\n    dp = x['dead_pages']\n    sc = x['size_class']\n    days = x['days']\n    if x['finding'] == 'AUTOVACUUM_DISABLED':\n        if x['vacuum_type'] == 'manual':\n            s = f\"{t} has AUTOVACUUM_DISABLED because vacuum_type is manual, which overrides autovacuum even though autovacuum_enabled={x['autovacuum_enabled']}; its computed {sc} class is derived from total_pages {tp} with dead_pages {dp}, bloat ratio {ratio}, and cap {cap}.\"\n        else:\n            s = f\"{t} has AUTOVACUUM_DISABLED because autovacuum_enabled={x['autovacuum_enabled']}; its computed {sc} class is derived from total_pages {tp} with dead_pages {dp}, bloat ratio {ratio}, and cap {cap}.\"\n    elif x['finding'] == 'BLOAT_THRESHOLD_EXCEEDED':\n        s = f\"{t} has BLOAT_THRESHOLD_EXCEEDED because computed bloat ratio {ratio} from dead_pages {dp} / total_pages {tp} exceed"]
[169.870428, "o", "from collections import Counter\r\n\u001b[?2004l\ru\u001b[?2004h> "]
[169.870609, "i", "s its {sc} cap {cap}; the {sc} class was computed from total_pages, and no qualifying reindex or BLOAT_HOLD ticket suppresses this bloat finding.\"\n        if x['reindex_msg'] != 'no reindex log' and x['reindex_msg'] != 'no reindex log entry' and x['reindex_msg'] != 'maintenance_active not True':\n            s += f\" Reindex was not exempt since {x['reindex_msg']}.\"\n        if x['hold_msg'] != 'no ticket':\n            s += f\" Change-control ticket note: {x['hold_msg']}.\"\n        if x['stale']:\n            s += f\" Stats are stale at {days} days, which tightened the cap to {cap}.\"\n    elif x['finding'] == 'STALE_STATISTICS':\n        s = f\"{t} has STALE_STATISTICS because {days} days since last_analyzed is at least 30; its computed {sc} class is derived from total_pages {tp}, dead_pages {dp}, bloat ratio {ratio}, and cap {cap}.\"\n        if x['suppressed']:\n            s += f\" A bloat ratio {ratio} over the cap was suppressed by {x['hold_msg'] if x['hold'] else x['reindex_msg']}, so stale stats remains the finding."]
[169.870706, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[169.870782, "i", "\"\n    else:\n        s = f\"{t} is compliant.\"\n    memo.append(s)\n    memo.append('')\n\nwith open('/app/bloat_memo.md', 'w') as f:\n    f.write('\\n'.join(memo))\n\nprint('COUNTS', counts)\nprint('RESULTS', json.dumps(results))\nprint('FILES')\nfor p in ['/app/bloat_audit.csv','/app/results.json','/app/bloat_memo.md']:\n    print(p, Path(p).exists(), Path(p).stat().st_size)\nPY\n"]
