[169.962041, "o", "> "]
[169.962328, "o", "    elif x['finding'] == 'BLOAT_THRESHOLD_EXCEEDED':\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.962639, "o", "> "]
[169.964271, "o", "        s = f\"{t} has BLOAT_THRESHOLD_EXCEEDED because computed bloat ratio {ratio} from dead_pages {dp} / total_pages {tp} exceeds its {sc} cap {cap}; the {sc} class was computed from total_pages, and no qualifying reindex or BLOAT_HOLD ticket suppresses this bloat finding.\"\r\n\u001b[?2004l\r"]
[169.964533, "o", "\u001b[?2004h> "]
[169.965562, "o", "        if x['reindex_msg'] != 'no reindex log' and x['reindex_msg'] != 'no reindex log entry' and x['reindex_msg'] != 'maintenance_active not True':\r\n\u001b[?2004l\r"]
[169.965862, "o", "\u001b[?2004h> "]
[169.966193, "o", "            s += f\" Reindex was not exempt since {x['reindex_msg']}.\"\r\n\u001b[?2004l\r"]
[169.966337, "o", "\u001b[?2004h> "]
[169.966813, "o", "        if x['hold_msg'] != 'no ticket':\r\n\u001b[?2004l\r"]
