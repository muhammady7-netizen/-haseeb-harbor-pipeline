[100.394072, "o", "    return True, f\"reindex valid_until {rl['valid_until']} > 2026-09-01\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.394662, "o", "def qualifying_hold(table):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.394937, "o", "    t = tickets.get(table)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.395158, "o", "    if not t:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.39541, "o", "        return None, 'no ticket'\r\n\u001b[?2004l\r"]
[100.395703, "o", "\u001b[?2004h> "]
[100.396055, "o", "    if t['exception_type'] != 'BLOAT_HOLD':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.396492, "o", "        return None, f\"exception_type {t['exception_type']}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.396834, "o", "    if t['status'] != 'Closed':\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.397099, "o", "> "]
[100.39737, "o", "        return None, f\"status {t['status']}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.397764, "o", "    if parse_bool(t['approved']) is not True:\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.398008, "o", "> "]
[100.398266, "o", "        return None, f\"approved={t['approved']}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.398418, "o", "> "]
[100.398858, "o", "    vu = date.fromisoformat(t['valid_until'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.399159, "o", "    if not (vu > AUDIT_DATE):\r\n\u001b[?2004l\r"]
[100.399307, "o", "\u001b[?2004h> "]
[100.399889, "o", "        return None, f\"valid_until {t['valid_until']} not > 2026-09-01\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.400485, "o", "    return t, f\"qualifying hold {t['ticket_id']}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.400647, "o", "> "]
[100.400842, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.401118, "o", "> "]
[100.401474, "o", "audit = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.401728, "o", "for table, r in health.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.402503, "o", "    total_pages = int(r['total_pages'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.403007, "o", "> "]
[100.403332, "o", "    dead_pages = int(r['dead_pages'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.40361, "o", "> "]
[100.404588, "o", "    ratio = round_half_up2(Decimal(dead_pages) / Decimal(total_pages))\r\n\u001b[?2004l\r"]
[100.405402, "o", "\u001b[?2004h> "]
[100.406569, "o", "    size_cls = size_class(total_pages)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.409747, "o", "    last_analyzed = date.fromisoformat(r['last_analyzed'])\r\n\u001b[?2004l\r"]
[100.410099, "o", "\u001b[?2004h>     days = (AUDIT_DATE - last_analyzed).days\r\n\u001b[?2004l\r\u001b[?2004h>     stale = days >= 30\r\n\u001b[?2004l\r\u001b[?2004h>     cap = cap_for(size_cls, stale)\r\n\u001b[?2004l\r\u001b[?2004h>     auto_disabled = (parse_bool(r['autovacuum_enabled']) is False) or (r['vacuum_type'] == 'manual')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.410385, "o", "    bloat_exceeded = ratio > cap\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.410847, "o", "    rex, rex_msg = reindex_exempt(r)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.411319, "o", "    hold, hold_msg = qualifying_hold(table)\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.411736, "o", ">     bloat_suppressed = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.412021, "o", "> "]
[100.412783, "o", "    if bloat_exceeded:\r\n\u001b[?2004l\r\u001b[?2004h>         if rex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.413197, "o", "            bloat_suppressed = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.413435, "o", "            suppression = rex_msg\r\n\u001b[?2004l\r"]
[100.413573, "o", "\u001b[?2004h> "]
[100.413903, "o", "        elif hold:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.414343, "o", "            bloat_suppressed = True\r\n\u001b[?2004l\r"]
[100.414589, "o", "\u001b[?2004h>             suppression = hold_msg\r\n"]
[100.414869, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[100.415099, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.415351, "o", "            suppression = 'not suppressed'\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.415537, "o", "> "]
[100.415617, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.415697, "o", "> "]
[100.416106, "o", "        suppression = 'not bloated'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.416258, "o", "    if auto_disabled:"]
[100.416339, "o", "\r\n\u001b[?2004l\r"]
[100.416726, "o", "\u001b[?2004h> "]
[100.41685, "o", "        finding = 'AUTOVACUUM_DISABLED'\r\n\u001b[?2004l\r"]
[100.417046, "o", "\u001b[?2004h"]
[100.417573, "o", ">     elif bloat_exceeded and not bloat_suppressed:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.418158, "o", "        finding = 'BLOAT_THRESHOLD_EXCEEDED'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.418483, "o", "    elif stale:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.418858, "o", "        finding = 'STALE_STATISTICS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.420323, "o", ">     else:"]
[100.420956, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.421596, "o", "        finding = 'none'"]
[100.421787, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.422056, "o", "> "]
[100.422154, "o", "    audit.append({\r\n\u001b[?2004l\r"]
[100.422471, "o", "\u001b[?2004h"]
[100.42281, "o", ">         'table_name': table,\r\n\u001b[?2004l\r"]
[100.423146, "o", "\u001b[?2004h> "]
[100.425085, "o", "        'last_analyzed': r['last_analyzed'],\r\n\u001b[?2004l\r\u001b[?2004h>         'days': days,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.425694, "o", "        'size_class': size_cls,\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.426043, "o", "> "]
[100.426344, "o", "        'total_pages': total_pages,\r\n\u001b[?2004l\r"]
[100.426507, "o", "\u001b[?2004h> "]
[100.427032, "o", "        'dead_pages': dead_pages,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.427499, "o", "        'ratio': str(ratio),\r\n\u001b[?2004l\r"]
[100.428163, "o", "\u001b[?2004h> "]
[100.428579, "o", "        'cap': str(cap),\r\n\u001b[?2004l\r\u001b[?2004h>         'stale': stale,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.428863, "o", "        'autovacuum_enabled': r['autovacuum_enabled'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.429268, "o", "        'vacuum_type': r['vacuum_type'],\r\n\u001b[?2004l\r"]
[100.429569, "o", "\u001b[?2004h> "]
[100.429963, "o", "        'maintenance_active': r['maintenance_active'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.43039, "o", "        'bloat_exceeded': bloat_exceeded,\r\n\u001b[?2004l\r"]
[100.431052, "o", "\u001b[?2004h>         'reindex': rex_msg,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.431359, "o", "        'hold': hold_msg,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.431823, "o", "        'suppression': suppression,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.432158, "o", "        'finding': finding,\r\n\u001b[?2004l\r"]
[100.432449, "o", "\u001b[?2004h>     })\r\n"]
[100.432751, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[100.433009, "o", "> "]
