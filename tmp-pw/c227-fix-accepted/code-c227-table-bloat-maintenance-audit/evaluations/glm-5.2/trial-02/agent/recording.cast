[169.867681, "i", "python3 - <<'PY'\nimport csv, json\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom collections import Counter\nfrom pathlib import Path\n\nAUDIT_DATE = date(2026,9,1)\n\ndef pb(s): return s.strip().lower() == 'true'\ndef rhu(n): return Decimal(str(n)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\ndef dec2str(d): return str(d)\n\nhealth = {}\nwith open('/app/input/table_health.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        health[r['table_name']] = r\n\nalias = {}\nwith open('/app/input/table_aliases.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        alias[r['alias']] = r['table_name']\n\nreindex = {}\nwith open('/app/input/reindex_log.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        reindex[r['table_name']] = r\n\ntickets = {}\nwith open('/app/input/change_control_tickets.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        tickets[alias.get(r['table_ref'], r['table_ref'])] = r\n\ndef size_cls(tp): return 'large' if tp >= 500 else 'small'\ndef ca"]
[169.868103, "i", "p_for(sc, stale):\n    base = Decimal('0.2') if sc == 'large' else Decimal('0.4')\n    if stale:\n        return base - (Decimal('0.10') if sc == 'large' else Decimal('0.05'))\n    return base\n\nout = []\nfor t, r in health.items():\n    tp = int(r['total_pages'])\n    dp = int(r['dead_pages'])\n    ratio = rhu(Decimal(dp) / Decimal(tp))\n    sc = size_cls(tp)\n    la = date.fromisoformat(r['last_analyzed'])\n    days = (AUDIT_DATE - la).days\n    stale = days >= 30\n    cap = cap_for(sc, stale)\n    auto = (pb(r['autovacuum_enabled']) is False) or (r['vacuum_type'] == 'manual')\n    bloat = ratio > cap\n\n    rex = False\n    rex_msg = 'no reindex log'\n    if pb(r['maintenance_active']):\n        rl = reindex.get(t)\n        if not rl:\n            rex_msg = 'no reindex log entry'\n        elif not pb(rl['approved']):\n            rex_msg = f\"reindex approved={rl['approved']}\"\n        elif not (date.fromisoformat(rl['valid_until']) > AUDIT_DATE):\n            rex_msg = f\"reindex valid_until {rl['valid_until']} expired\"\n        else:"]
[169.868337, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[169.868507, "i", "\n            rex = True\n            rex_msg = f\"reindex valid_until {rl['valid_until']} valid\"\n    else:\n        rex_msg = 'maintenance_active not True'\n\n    hold = None\n    hold_msg = 'no ticket'\n    tk = tickets.get(t)\n    if tk:\n        if tk['exception_type'] != 'BLOAT_HOLD':\n            hold_msg = f\"ticket {tk['ticket_id']} exception_type {tk['exception_type']}\"\n        elif tk['status'] != 'Closed':\n            hold_msg = f\"ticket {tk['ticket_id']} status {tk['status']}\"\n        elif not pb(tk['approved']):\n            hold_msg = f\"ticket {tk['ticket_id']} approved={tk['approved']}\"\n        elif not (date.fromisoformat(tk['valid_until']) > AUDIT_DATE):\n            hold_msg = f\"ticket {tk['ticket_id']} valid_until {tk['valid_until']} not after audit\"\n        else:\n            hold = tk\n            hold_msg = f\"ticket {tk['ticket_id']} qualifying hold\"\n\n    suppressed = bloat and (rex or hold is not None)\n    if auto:\n        finding = 'AUTOVACUUM_DISABLED'\n    elif bloat and not suppressed:\n        findi"]
[169.868742, "o", "\u001b[?2004h> import csv, json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.869125, "i", "ng = 'BLOAT_THRESHOLD_EXCEEDED'\n    elif stale:\n        finding = 'STALE_STATISTICS'\n    else:\n        finding = 'none'\n\n    out.append({\n        'table_name': t,\n        'last_analyzed': r['last_analyzed'],\n        'days': days,\n        'size_class': sc,\n        'total_pages': tp,\n        'dead_pages': dp,\n        'ratio': ratio,\n        'cap': cap,\n        'stale': stale,\n        'autovacuum_enabled': r['autovacuum_enabled'],\n        'vacuum_type': r['vacuum_type'],\n        'maintenance_active': r['maintenance_active'],\n        'bloat': bloat,\n        'suppressed': suppressed,\n        'reindex': rex,\n        'reindex_msg': rex_msg,\n        'hold': hold,\n        'hold_msg': hold_msg,\n        'finding': finding,\n    })\n\nout.sort(key=lambda x: (health[x['table_name']]['last_analyzed'], x['table_name']))\n\n# Write CSV\nwith open('/app/bloat_audit.csv', 'w', newline='') as f:\n    w = csv.writer(f)\n    w.writerow(['table_name','size_class','bloat_ratio','finding'])\n    for x in out:\n        w.writerow([x['table_nam"]
