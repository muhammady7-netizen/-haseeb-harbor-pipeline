[413.960623, "i", "{tp} computes a {sc} class and \"\n             f\"ratio {ratio} with round-half-up, which is over cap {cap}.\")\n        if trap:\n            s += f\" The {trap}computed class is used instead of the export size_class.\"\n        if x['stale']:\n            s += f\" Stats are {days} days stale, so the cap is tightened to {cap}.\"\n        if x['maintenance_active'].lower() == 'true' and reindex.get(t):\n            s += f\" Maintenance_active is True, but {x['reindex_msg']}, so the reindex exemption does not apply.\"\n        if x['ticket_id']:\n            s += f\" Change-control {x['hold_msg']}, so the bloat finding is not suppressed.\"\n        else:\n            s += \" No BLOAT_HOLD ticket suppresses this bloat finding.\"\n    elif x['finding'] == 'STALE_STATISTICS':\n        s = (f\"{t} has STALE_STATISTICS because computed {days} days since last_analyzed is at least 30, not the legacy \"\n             f\"days_since_analyze field value {legacy}; the computed {sc} class is derived from total_pages {tp} with \"\n             f\"dead_pag"]
[413.960974, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.961242, "i", "es {dp}, ratio {ratio}, and tightened cap {cap}.\")\n        if trap:\n            s += f\" The {trap}computed class is used instead of the export size_class.\"\n        if x['suppressed']:\n            if x['hold']:\n                s += f\" The bloat ratio over cap was suppressed by {x['hold_msg']}, so stale stats remains the finding.\"\n            elif x['reindex']:\n                s += f\" The bloat ratio over cap was suppressed by {x['reindex_msg']}, so stale stats remains the finding.\"\n        else:\n            s += \" The ratio is not over the tightened cap, so stale stats is the finding.\"\n    else:\n        s = f\"{t} is compliant.\"\n    memo.append(s)\n    memo.append('')\n\nwith open('/app/bloat_memo.md', 'w') as f:\n    f.write('\\n'.join(memo))\n\nprint('WROTE deliverables')\nprint('rows', len(out))\nprint('counts', counts)\nprint('results', results)\nfor p in ['/app/bloat_audit.csv','/app/results.json','/app/bloat_memo.md']:\n    print(p, Path(p).exists(), Path(p).stat().st_size)\nPY\n"]
