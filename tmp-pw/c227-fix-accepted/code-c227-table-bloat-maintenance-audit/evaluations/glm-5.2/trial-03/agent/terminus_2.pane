    size_class = 'large' if total >= 500 else 'small'
    base_cap = Decimal('0.2') if size_class == 'large' else Decimal('0.4')
    last_analyzed = date.fromisoformat(r['last_analyzed'])
    days = (AUDIT - last_analyzed).days
    stale = days >= 30
    cap = base_cap
