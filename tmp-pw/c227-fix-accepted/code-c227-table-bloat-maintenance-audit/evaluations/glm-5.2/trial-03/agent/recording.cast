[295.295982, "i", "python3 - <<'PY'\nimport csv, json, os\nrows = list(csv.DictReader(open('bloat_audit.csv')))\nprint('exists', all(os.path.exists(f) for f in ['bloat_audit.csv','bloat_memo.md','results.json']))\nprint('audit_rows', len(rows))\nprint('columns', list(rows[0].keys()) if rows else [])\nprint('json', json.load(open('results.json')))\nprint('json_matches_csv', {\n    'flagged_count': sum(1 for r in rows if r['finding'] != 'none'),\n    'autovacuum_disabled_count': sum(1 for r in rows if r['finding'] == 'AUTOVACUUM_DISABLED'),\n    'bloat_exceeded_count': sum(1 for r in rows if r['finding'] == 'BLOAT_THRESHOLD_EXCEEDED'),\n    'stale_statistics_count': sum(1 for r in rows if r['finding'] == 'STALE_STATISTICS'),\n    'compliant_count': sum(1 for r in rows if r['finding'] == 'none'),\n} == json.load(open('results.json')))\nPY\n"]
