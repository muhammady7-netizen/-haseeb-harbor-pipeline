[216.084383, "o", "\u001b[?2004h> "]
[216.085282, "o", "        return f\"legacy {r['legacy_size_class']} ignored\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.085659, "o", "> "]
[216.086433, "o", "    return f\"legacy {r['legacy_size_class']} matched\"\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[216.086763, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
