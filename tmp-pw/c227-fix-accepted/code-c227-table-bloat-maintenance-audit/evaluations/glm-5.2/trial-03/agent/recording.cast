[217.379682, "i", "wc -l bloat_audit.csv bloat_memo.md && python3 - <<'PY'\nimport csv, json\nrows = list(csv.DictReader(open('bloat_audit.csv')))\nprint('audit_rows', len(rows))\nprint('columns', rows[0].keys() if rows else [])\nprint('json', json.load(open('results.json')))\nprint('memo_bullets', sum(1 for line in open('bloat_memo.md') if line.startswith('- ')))\nPY\n"]
