[215.977818, "i", "python3 - <<'PY'\nimport csv, json\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\n\nAUDIT = date(2026, 9, 1)\n\ndef parse_bool(s):\n    return str(s).strip().lower() == 'true'\n\ndef round2(x):\n    return Decimal(x).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n\ndef cap_str(cap):\n    return str(cap.quantize(Decimal('0.01')))\n\n# Dedupe table_health: last row per table_name wins.\nrows = list(csv.DictReader(open('input/table_health.csv')))\nlast = {}\nfor i, r in enumerate(rows):\n    last[r['table_name']] = (i, r)\n\naliases = {r['alias']: r['table_name'] for r in csv.DictReader(open('input/table_aliases.csv'))}\n\n# Reindex log: last row per table_name wins.\nreindex = {}\nfor i, r in enumerate(csv.DictReader(open('input/reindex_log.csv'))):\n    reindex[r['table_name']] = (i, r)\n\n# Change-control tickets: last row resolving to a table wins.\ntickets = {}\nfor i, r in enumerate(csv.DictReader(open('input/change_control_tickets.csv'))):\n    target = aliases.get(r['table_ref'], r['table_ref'])\n    r['_tar"]
