[85.17513, "o", "\u001b[?2004hroot@6d0ca90e8b59:/app# "]
[102.692264, "i", "python3 - <<'PY'\nimport csv, json\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\n\nAUDIT = date(2026,9,1)\n\ndef parse_bool(s): return str(s).strip().lower() == 'true'\ndef round2(x): return Decimal(x).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n\nrows = list(csv.DictReader(open('input/table_health.csv')))\nlast = {}\nfor i,r in enumerate(rows): last[r['table_name']] = (i,r)\n\naliases = {r['alias']: r['table_name'] for r in csv.DictReader(open('input/table_aliases.csv'))}\nreindex = {}\nfor i,r in enumerate(csv.DictReader(open('input/reindex_log.csv'))): reindex[r['table_name']] = (i,r)\ntickets = {}\nfor i,r in enumerate(csv.DictReader(open('input/change_control_tickets.csv'))):\n    target = aliases.get(r['table_ref'], r['table_ref'])\n    r['_target'] = target\n    tickets[target] = (i,r)\n\nrecords = []\nfor name,(i,r) in sorted(last.items(), key=lambda kv: (kv[1][1]['last_analyzed'], kv[0])):\n    total = int(r['total_pages']); dead = int(r['dead_pages'])\n    ratio = round2(Decimal(dead)/Decimal"]
[102.692649, "i", "(total))\n    size_class = 'large' if total >= 500 else 'small'\n    base_cap = Decimal('0.2') if size_class == 'large' else Decimal('0.4')\n    last_analyzed = date.fromisoformat(r['last_analyzed'])\n    days = (AUDIT - last_analyzed).days\n    stale = days >= 30\n    cap = base_cap - (Decimal('0.10') if size_class == 'large' else Decimal('0.05')) if stale else base_cap\n    autovac_disabled = (not parse_bool(r['autovacuum_enabled'])) or (r['vacuum_type'] == 'manual')\n    reind = reindex.get(name)\n    reindex_exempt = False\n    if parse_bool(r['maintenance_active']) and reind:\n        ri = reind[1]\n        if parse_bool(ri['approved']) and date.fromisoformat(ri['valid_until']) > AUDIT:\n            reindex_exempt = True\n    bloat_exceeded = ratio > cap\n    ticket = tickets.get(name)\n    hold_qual = False\n    if ticket:\n        t = ticket[1]\n        hold_qual = (t['exception_type'] == 'BLOAT_HOLD' and t['status'] == 'Closed' and parse_bool(t['approved']) and date.fromisoformat(t['valid_until']) > AUDIT)\n    if autova"]
[102.692969, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[102.693299, "i", "c_disabled:\n        finding = 'AUTOVACUUM_DISABLED'\n    elif bloat_exceeded and not reindex_exempt:\n        finding = 'STALE_STATISTICS' if stale and hold_qual else ('none' if hold_qual else 'BLOAT_THRESHOLD_EXCEEDED')\n    elif stale:\n        finding = 'STALE_STATISTICS'\n    else:\n        finding = 'none'\n    rec = dict(table_name=name, rownum=i+2, size_class=size_class, total_pages=total, dead_pages=dead,\n               ratio=str(ratio), base_cap=str(base_cap), effective_cap=str(cap), days=days, stale=stale,\n               autovac_disabled=autovac_disabled, autovacuum_enabled=r['autovacuum_enabled'], vacuum_type=r['vacuum_type'],\n               maintenance_active=r['maintenance_active'], reindex_exempt=reindex_exempt,\n               reindex=ri if (reind and reindex_exempt) else None, bloat_exceeded=bloat_exceeded,\n               ticket=ticket[1] if ticket else None, hold_qual=hold_qual, finding=finding, last_analyzed=r['last_analyzed'])\n    records.append(rec)\n\njson.dump(records, open('audit_debug.json','w')"]
[102.693515, "o", "\u001b[?2004h> import csv, json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.693784, "i", ", indent=2, default=str)\nprint('unique', len(records))\nprint('counts', {f: sum(1 for r in records if r['finding']==f) for f in ['AUTOVACUUM_DISABLED','BLOAT_THRESHOLD_EXCEEDED','STALE_STATISTICS','none']})\nprint('flagged', sum(1 for r in records if r['finding']!='none'))\nprint('--- non-none ---')\nfor r in records:\n    if r['finding']!='none':\n        print(json.dumps(r, default=str))\nPY\n"]
