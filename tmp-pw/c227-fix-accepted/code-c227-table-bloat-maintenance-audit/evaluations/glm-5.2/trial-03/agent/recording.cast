[216.087642, "o", "> "]
[216.088229, "o", "    t = r['ticket_rec']\r\n\u001b[?2004l\rp\u001b[?2004h"]
[216.08842, "o", "> "]
[216.088544, "o", "    if not t:\r\n\u001b[?2004l\r"]
[216.088695, "o", "\u001b[?2004h> "]
[216.089206, "o", "        return ''\r\n\u001b[?2004l\r"]
[216.089576, "o", "\u001b[?2004h> "]
[216.090172, "o", "    tid = t['ticket_id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.09037, "o", "> "]
[216.090742, "o", "    if r['hold_qual']:\r\n\u001b[?2004l\r"]
[216.090984, "o", "\u001b[?2004h"]
[216.091228, "o", "> "]
[216.091648, "o", "        if r['finding'] == 'AUTOVACUUM_DISABLED':\r\n\u001b[?2004l\r"]
[216.091978, "o", "\u001b[?2004h> "]
[216.093378, "o", "            return f\"{tid} BLOAT_HOLD ticket exists, but a hold never clears autovacuum.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.093807, "o", "        if r['finding'] == 'STALE_STATISTICS':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.094826, "o", "            return f\"{tid} BLOAT_HOLD ticket is a qualifying hold, so bloat is suppressed but stale stats remain.\"\r\n\u001b[?2004l\r"]
[216.094992, "o", "\u001b[?2004h> "]
[216.095546, "o", "        return f\"{tid} BLOAT_HOLD ticket is a qualifying hold, so bloat is suppressed.\"\r\n\u001b[?2004l\r"]
[216.095871, "o", "\u001b[?2004h>     if t['exception_type'] != 'BLOAT_HOLD':\r\n\u001b[?2004l\r"]
[216.096153, "o", "\u001b[?2004h> "]
[216.096849, "o", "        return f\"{tid} {t['exception_type']} ticket does not qualify as a bloat hold.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.097076, "o", "> "]
[216.097419, "o", "    if t['status'] != 'Closed':\r\n\u001b[?2004l\r"]
[216.097661, "o", "\u001b[?2004h"]
[216.097878, "o", "> "]
[216.098207, "o", "        return f\"{tid} BLOAT_HOLD ticket is rejected because status {t['status']} is not Closed.\"\r\n\u001b[?2004l\r"]
[216.098404, "o", "\u001b[?2004h> "]
[216.098715, "o", "    if not parse_bool(t['approved']):\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.098961, "o", "> "]
[216.099536, "o", "        return f\"{tid} BLOAT_HOLD ticket is rejected because approved is {t['approved']}.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.099865, "o", "    if not date.fromisoformat(t['valid_until']) > AUDIT:\r\n\u001b[?2004l\r"]
[216.100126, "o", "\u001b[?2004h> "]
[216.100832, "o", "        return f\"{tid} BLOAT_HOLD ticket is rejected because valid_until {t['valid_until']} is not after 2026-09-01.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.101122, "o", "> "]
[216.101678, "o", "    return f\"{tid} BLOAT_HOLD ticket was checked but does not change this finding.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.10191, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.102167, "o", "def reindex_note(r):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.102717, "o", "    if not (r['maintenance_active'] == 'True' or r['reindex_rec']):\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.102857, "o", "> "]
[216.103121, "o", "        return ''\r\n\u001b[?2004l\r"]
[216.103473, "o", "\u001b[?2004h>     if r['reindex_exempt']:\r\n\u001b[?2004l\r"]
[216.10372, "o", "\u001b[?2004h> "]
[216.104187, "o", "        return f\"reindex valid_until {r['reindex_rec']['valid_until']} is valid after 2026-09-01, so bloat is exempt.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.10451, "o", "> "]
[216.104897, "o", "    if r['reindex_rec'] and not parse_bool(r['reindex_rec']['approved']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.105434, "o", "        return f\"unapproved reindex approved={r['reindex_rec']['approved']} does not exempt bloat.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.105688, "o", "> "]
[216.105968, "o", "    if r['reindex_rec'] and not date.fromisoformat(r['reindex_rec']['valid_until']) > AUDIT:\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.10617, "o", "> "]
[216.106741, "o", "        return f\"reindex valid_until {r['reindex_rec']['valid_until']} is no longer valid because it is not after 2026-09-01.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.107089, "o", "    return \"maintenance_active=True has no valid reindex exemption.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.107457, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> memo_lines = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.10777, "o", "memo_lines.append('# Monthly Table Maintenance Review Memo')\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.107999, "o", "> "]
[216.108314, "o", "memo_lines.append('')\r\n\u001b[?2004l\r"]
[216.108524, "o", "\u001b[?2004h> "]
[216.110278, "o", "memo_lines.append('Audit date: 2026-09-01. Size class is computed from total_pages only (>=500 large, <500 small), ignoring the legacy size_class column including medium traps. Bloat ratio is computed as dead_pages / total_pages with round-half-up to 2 decimal places. A ratio exactly equal to the applicable cap is compliant because the policy flags only ratios strictly over the cap; when stats are stale, the effective tightened cap governs the comparison.')\r\n"]
[216.1106, "o", "\u001b[?2004l\r\u001b[?2004h"]
[216.110963, "o", "> memo_lines.append('')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.111397, "o", "memo_lines.append('## Non-compliant findings')\r\n\u001b[?2004l\r"]
[216.11178, "o", "\u001b[?2004h> "]
[216.112052, "o", "memo_lines.append('')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[216.112317, "o", "> for r in records:\r\n\u001b[?2004l\r"]
[216.112621, "o", "\u001b[?2004h>     if r['finding'] == 'none':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.112871, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.113137, "o", "    parts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.113499, "o", "    parts.append(f\"{r['table_name']} is {r['finding']}\")\r\n\u001b[?2004l\r"]
[216.113817, "o", "\u001b[?2004h> "]
[216.114292, "o", "    parts.append(f\"computed size_class {r['size_class']} from total_pages {r['total_pages']}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.114379, "o", "> "]
[216.114977, "o", "    if r['legacy_size_class'] != r['size_class'] or r['legacy_size_class'] == 'medium':\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.115183, "o", "> "]
[216.115395, "o", "        parts.append(legacy_size_note(r))\r\n\u001b[?2004l\r"]
[216.115641, "o", "\u001b[?2004h> "]
[216.116309, "o", "    parts.append(f\"dead_pages {r['dead_pages']} and total_pages {r['total_pages']} give computed round-half-up ratio {r['ratio']}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.116561, "o", "> "]
[216.116869, "o", "    if r['stale']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.117717, "o", "        parts.append(f\"stats are stale at {r['days']} days, which tightened cap to {r['effective_cap']}; legacy days_since_analyze field ignored\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.117972, "o", ">     else:\r\n\u001b[?2004l\r"]
[216.118248, "o", "\u001b[?2004h> "]
[216.11865, "o", "        parts.append(f\"cap is {r['effective_cap']}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.118961, "o", "    if r['finding'] == 'AUTOVACUUM_DISABLED':\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.119102, "o", "> "]
[216.119448, "o", "        if r['vacuum_type'] == 'manual':\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.119706, "o", "> "]
[216.120332, "o", "            parts.append(f\"manual vacuum override disables autovacuum even though autovacuum_enabled is {r['autovacuum_enabled']}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.120613, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.121104, "o", "            parts.append(f\"autovacuum_enabled is {r['autovacuum_enabled']}, so autovacuum is disabled\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.121254, "o", "> "]
[216.12148, "o", "    elif r['finding'] == 'BLOAT_THRESHOLD_EXCEEDED':\r\n"]
[216.121785, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[216.122041, "o", "        if r['bloat_exceeded']:\r\n\u001b[?2004l\r"]
[216.122261, "o", "\u001b[?2004h> "]
[216.122528, "o", "            parts.append(f\"ratio exceeds the cap\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.122995, "o", "    elif r['finding'] == 'STALE_STATISTICS':\r\n\u001b[?2004l\r"]
[216.123183, "o", "\u001b[?2004h> "]
[216.123522, "o", "        if r['bloat_exceeded']:\r\n"]
[216.123719, "o", "\u001b[?2004l\r\u001b[?2004h"]
[216.124086, "o", "> "]
[216.124384, "o", "            parts.append(\"bloat was checked before staleness\")\r\n\u001b[?2004l\r"]
[216.124652, "o", "\u001b[?2004h> "]
[216.12481, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.125479, "o", "            parts.append(\"ratio does not exceed the cap\")\r\n\u001b[?2004l\r"]
[216.125773, "o", "\u001b[?2004h>     rn = reindex_note(r)\r\n\u001b[?2004l\r"]
[216.125953, "o", "\u001b[?2004h>     if rn:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.12629, "o", "        parts.append(rn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.126561, "o", "    tn = ticket_note(r)\r\n\u001b[?2004l\r\u001b[?2004h>     if tn:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.12686, "o", "        parts.append(tn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.126939, "o", "> "]
[216.127366, "o", "    # Join into one prose sentence/bullet.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.127924, "o", "    bullet = '- ' + ', '.join(parts) + '.'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.128204, "o", "    memo_lines.append(bullet)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[216.12852, "o", "\u001b[?2004h> "]
[216.128843, "o", "with open('bloat_memo.md', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.129159, "o", ">     f.write('\\n'.join(memo_lines) + '\\n')"]
[216.129449, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
