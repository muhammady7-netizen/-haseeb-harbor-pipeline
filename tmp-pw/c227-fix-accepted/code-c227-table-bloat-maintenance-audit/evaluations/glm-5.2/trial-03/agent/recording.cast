[69.420013, "i", "python3 - <<'PY'\nimport csv, json, os\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\n\nAUDIT = date(2026,9,1)\n\ndef parse_bool(s):\n    return str(s).strip().lower() == 'true'\n\ndef round2(x):\n    return Decimal(x).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n\nrows = list(csv.DictReader(open('input/table_health.csv')))\nlast = {}\nfor i,r in enumerate(rows):\n    last[r['table_name']] = (i,r)\n\naliases = {}\nfor r in csv.DictReader(open('input/table_aliases.csv')):\n    aliases[r['alias']] = r['table_name']\n\nreindex = {}\nfor i,r in enumerate(csv.DictReader(open('input/reindex_log.csv'))):\n    reindex[r['table_name']] = (i,r)\n\ntickets = {}\nfor i,r in enumerate(csv.DictReader(open('input/change_control_tickets.csv'))):\n    ref = r['table_ref']\n    target = aliases.get(ref, ref)\n    r['_target'] = target\n    r['_rownum'] = i\n    tickets[target] = (i,r)\n\nrecords = []\nfor name,(i,r) in sorted(last.items(), key=lambda kv: (kv[1][1]['last_analyzed'], kv[0])):\n    total = int(r['total_pages'])\n    de"]
[69.420389, "o", "python3 - <<'PY'\r\n"]
[69.420788, "i", "ad = int(r['dead_pages'])\n    ratio = round2(Decimal(dead)/Decimal(total))\n    size_class = 'large' if total >= 500 else 'small'\n    base_cap = Decimal('0.2') if size_class == 'large' else Decimal('0.4')\n    last_analyzed = date.fromisoformat(r['last_analyzed'])\n    days = (AUDIT - last_analyzed).days\n    stale = days >= 30\n    cap = base_cap\n    if stale:\n        cap = base_cap - (Decimal('0.10') if size_class == 'large' else Decimal('0.05')\n    autovac_disabled = (not parse_bool(r['autovacuum_enabled'])) or (r['vacuum_type'] == 'manual')\n    reind = reindex.get(name)\n    reindex_exempt = False\n    if parse_bool(r['maintenance_active']) and reind:\n        ri = reind[1]\n        if parse_bool(ri['approved']) and date.fromisoformat(ri['valid_until']) > AUDIT:\n            reindex_exempt = True\n    bloat_exceeded = ratio > cap\n    ticket = tickets.get(name)\n    hold_qual = False\n    if ticket:\n        t = ticket[1]\n        hold_qual = (t['exception_type'] == 'BLOAT_HOLD' and t['status'] == 'Closed' and parse_bool"]
