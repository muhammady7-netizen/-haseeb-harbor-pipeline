[81.37649, "i", "python3 - <<'PY'\nimport csv\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom datetime import date\n\naudit_date = date(2026,9,1)\n\nrows = []\nwith open('/app/input/table_health.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        rows.append(r)\nlast = {}\nfor r in rows:\n    last[r['table_name']] = r\n\ndef round2(x):\n    return Decimal(x).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n\ndef boolval(s):\n    return s.strip().lower() == 'true'\n\nreindex = {}\nwith open('/app/input/reindex_log.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        reindex[r['table_name']] = r\n\nalias_to_table = {}\nwith open('/app/input/table_aliases.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        alias_to_table[r['alias']] = r['table_name']\n\ntickets_by_table = {}\nwith open('/app/input/change_control_tickets.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        ref = r['table_ref']\n        tbl = ref if ref in last else alias_to_table.get(ref, ref)\n        tickets_by_table.setdefault(tbl, []).ap"]
[81.376831, "i", "pend(r)\n\ndef qualifying_hold(tbl):\n    if tbl not in tickets_by_table:\n        return None, None\n    last_r = tickets_by_table[tbl][-1]\n    q = (\n        last_r['exception_type'] == 'BLOAT_HOLD'\n        and last_r['status'] == 'Closed'\n        and boolval(last_r['approved'])\n        and date.fromisoformat(last_r['valid_until']) > audit_date\n    )\n    return (last_r if q else None), last_r\n\nsummary = []\nfor tbl, r in last.items():\n    total = int(r['total_pages'])\n    dead = int(r['dead_pages'])\n    ratio = round2(Decimal(dead)/Decimal(total))\n    size_class = 'large' if total >= 500 else 'small'\n    cap = Decimal('0.20') if size_class == 'large' else Decimal('0.40'\n    stale_days = (audit_date - date.fromisoformat(r['last_analyzed'])).days\n    stale = stale_days >= 30\n    eff_cap = cap\n    if stale:\n        eff_cap = cap - (Decimal('0.10') if size_class == 'large' else Decimal('0.05'))\n    bloat_exceeded = ratio > eff_cap\n    autovac_disabled = (not boolval(r['autovacuum_enabled'])) or (r['vacuum_type'] == 'm"]
