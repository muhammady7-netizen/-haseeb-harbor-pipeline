[1322.908993, "o", "    for r in csv.DictReader(f): last[r['table_name']]=r\r\n\u001b[?2004l\r"]
[1322.909197, "o", "\u001b[?2004h> "]
[1322.910901, "o", "def r2(x): return Decimal(x).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\r\n\u001b[?2004l\r"]
[1322.911206, "o", "\u001b[?2004h> "]
[1322.911791, "o", "def bv(s): return s.strip().lower()=='true'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.912117, "o", "reindex={}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.913048, "o", "with open('/app/input/reindex_log.csv', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.91432, "o", "    for r in csv.DictReader(f): reindex[r['table_name']]=r\r\n\u001b[?2004l\r"]
[1322.914656, "o", "\u001b[?2004h> alias={}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.915479, "o", "with open('/app/input/table_aliases.csv', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.915561, "o", "> "]
[1322.916085, "o", "    for r in csv.DictReader(f): alias[r['alias']]=r['table_name']\r\n\u001b[?2004l\r\u001b[?2004h> tickets={}\r\n\u001b[?2004l\r"]
[1322.916332, "o", "\u001b[?2004h> "]
[1322.917097, "o", "with open('/app/input/change_control_tickets.csv', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.91718, "o", "> "]
[1322.91805, "o", "    for r in csv.DictReader(f):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.91827, "o", "> "]
[1322.918631, "o", "        ref=r['table_ref']; tbl=ref if ref in last else alias.get(ref,ref)\r\n\u001b[?2004l\r"]
[1322.918888, "o", "\u001b[?2004h> "]
[1322.91938, "o", "        tickets.setdefault(tbl,[]).append(r)\r\n\u001b[?2004l\r"]
[1322.919468, "o", "\u001b[?2004h> "]
[1322.91987, "o", "def hold(tbl):\r\n\u001b[?2004l\r"]
[1322.920218, "o", "\u001b[?2004h> "]
[1322.920509, "o", "    if tbl not in tickets: return None,None\r\n\u001b[?2004l\r"]
[1322.920762, "o", "\u001b[?2004h> "]
[1322.921275, "o", "    t=tickets[tbl][-1]\r\n\u001b[?2004l\r"]
[1322.921615, "o", "\u001b[?2004h> "]
[1322.924167, "o", "    q=t['exception_type']=='BLOAT_HOLD' and t['status']=='Closed' and bv(t['approved']) and date.fromisoformat(t['valid_until'])>A\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.92449, "o", "> "]
[1322.925422, "o", "    return (t if q else None),t\r\n\u001b[?2004l\r \u001b[?2004h"]
[1322.925793, "o", "> out=[]\r\n\u001b[?2004l\rpolicy \u001b[?2004h"]
[1322.9261, "o", "> "]
[1322.926393, "o", "for tbl,r in last.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.9297, "o", "    total=int(r['total_pages']); dead=int(r['dead_pages'])\r\n\u001b[?2004l\r"]
[1322.930091, "o", "\u001b[?2004h> "]
[1322.931897, "o", "    ratio=r2(Decimal(dead)/Decimal(total))\r\n\u001b[?2004l\r"]
[1322.932289, "o", "\u001b[?2004h> "]
[1322.933666, "o", "    sc='large' if total>=500 else 'small'\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.934289, "o", "> "]
[1322.935256, "o", "    cap=Decimal('0.20') if sc=='large' else Decimal('0.40')\r\n\u001b[?2004l\r |T-96\u001b[?2004h> "]
[1322.936605, "o", "    days=(A-date.fromisoformat(r['last_analyzed'])).days\r\n"]
[1322.936912, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1322.937615, "o", "    stale=days>=30\r\n\u001b[?2004l\r"]
[1322.937849, "o", "\u001b[?2004h> "]
[1322.940063, "o", "    eff=cap-(Decimal('0.10') if sc=='large' else Decimal('0.05')) if stale else cap\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.940305, "o", "> "]
[1322.940436, "o", "    bex=ratio>eff\r\n\u001b[?2004l\r"]
[1322.940657, "o", "\u001b[?2004h> "]
[1322.940981, "o", "    ad=(not bv(r['autovacuum_enabled'])) or (r['vacuum_type']=='manual')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.941206, "o", "> "]
[1322.941453, "o", "    ma=bv(r['maintenance_active'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.941939, "o", "    rei=reindex.get(tbl); rex=False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.942431, "o", "    if rei: rex=ma and bv(rei['approved']) and date.fromisoformat(rei['valid_until'])>A\r\n\u001b[?2004l\r"]
[1322.942692, "o", "\u001b[?2004h> "]
[1322.943136, "o", "    h,lt=hold(tbl)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.943405, "o", "    if ad: f='AUTOVACUUM_DISABLED'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.943841, "o", "    elif bex and not rex and not h: f='BLOAT_THRESHOLD_EXCEEDED'\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.944139, "o", "> "]
[1322.94451, "o", "    elif stale: f='STALE_STATISTICS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.944761, "o", "    else: f='none'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.945285, "o", "    out.append((r['last_analyzed'],tbl,r['size_class'],sc,total,dead,ratio,cap,eff,days,stale,bex,ad,ma,r['vacuum_type'],r['autovacuum_enabled'],rei,rex,h,lt,f))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.945511, "o", "> "]
[1322.945784, "o", "out.sort(key=lambda x:(x[0],x[1]))\r\n\u001b[?2004l\r\u001b[?2004h> def trap(x):\r\n\u001b[?2004l\r"]
[1322.946068, "o", "\u001b[?2004h"]
[1322.946376, "o", ">     exp=x[2]; sc=x[3]; total=x[4]\r\n\u001b[?2004l\r"]
[1322.946618, "o", "\u001b[?2004h> "]
[1322.947223, "o", "    if exp!=sc: return f\"export size_class {exp} ignored; computed size_class is {sc} from total_pages {total}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.947559, "o", "> "]
[1322.947998, "o", "    return f\"computed size_class is {sc} from total_pages {total}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.94851, "o", "lines=['# Monthly table maintenance review memo','',\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.948777, "o", "> "]
[1322.949778, "o", "'Audit date 2026-09-01; size_class is computed from total_pages, bloat_ratio is computed as dead_pages / total_pages rounded half-up to 2 decimals, and findings follow autovacuum, bloat, then stale precedence.','']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.950155, "o", "for x in out:"]
[1322.950276, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.950577, "o", "    if x[-1]=='none': continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.951091, "o", "    la,t,exp,sc,total,dead,ratio,cap,eff,days,stale,bex,ad,ma,vt,ae,rei,rex,h,lt,f=x\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.951715, "o", ">     tr=trap(x)\r\n\u001b[?2004l\r\u001b[?2004h>     if f=='AUTOVACUUM_DISABLED':\r\n\u001b[?2004l\r"]
[1322.95199, "o", "\u001b[?2004h> "]
[1322.95246, "o", "        reason='vacuum_type manual overrides autovacuum' if vt=='manual' else f'autovacuum_enabled {ae} disables autovacuum'\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.952641, "o", "> "]
[1322.953606, "o", "        lines.append(f\"- {t} is AUTOVACUUM_DISABLED because {reason} for its {tr}; autovacuum is checked first, so ratio {ratio} from dead_pages {dead} and total_pages {total} is not the finding even against cap {eff}.\")\r\n\u001b[?2004l\r"]
[1322.953897, "o", "\u001b[?2004h> "]
[1322.954023, "o", "    elif f=='BLOAT_THRESHOLD_EXCEEDED':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.954855, "o", "        parts=[f\"{t} is BLOAT_THRESHOLD_EXCEEDED because computed and rounded half-up ratio {ratio} from dead_pages {dead} / total_pages {total} exceeds the {sc} cap {eff}\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.955354, "o", "        if stale: parts.append(f\"stats are stale at {days} days, so the cap was tightened from {cap} to {eff}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.955588, "o", "        if rei and not rex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.955864, "o", "            vu=rei['valid_until']; app=rei['approved']\r\n\u001b[?2004l\r"]
[1322.95611, "o", "\u001b[?2004h> "]
[1322.956523, "o", "            if not bv(app): parts.append(f\"reindex is unapproved because approved={app} and valid_until={vu}, not exempt\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.956775, "o", "> "]
[1322.957335, "o", "            elif not date.fromisoformat(vu)>A: parts.append(f\"reindex expired because valid_until={vu} is not after 2026-09-01, not exempt\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.957772, "o", "            else: parts.append(f\"reindex with valid_until={vu} is not exempt\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.959097, "o", "        if lt and not h: parts.append(f\"ticket {lt['ticket_id']} does not suppress bloat because it is {lt['exception_type']}/{lt['status']} with approved={lt['approved']} and valid_until={lt['valid_until']}\")\r\n\u001b[?2004l\r"]
[1322.959317, "o", "\u001b[?2004h> "]
[1322.959558, "o", "        parts.append(tr)\r\n\u001b[?2004l\r"]
[1322.959791, "o", "\u001b[?2004h> "]
[1322.960122, "o", "        lines.append('; '.join(parts)+'.')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.960266, "o", "> "]
[1322.960596, "o", "    elif f=='STALE_STATISTICS':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.961806, "o", "        parts=[f\"{t} is STALE_STATISTICS because last_analyzed is {days} days before audit date 2026-09-01, which meets the >=30 staleness rule, and the legacy days_since_analyze field is ignored\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.961958, "o", "> "]
[1322.963022, "o", "        if bex and rex: parts.append(f\"computed ratio {ratio} from dead_pages {dead} / total_pages {total} would exceed tightened {sc} cap {eff}, but approved active reindex with valid_until={rei['valid_until']} exempts bloat, so stale stats remains\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.963177, "o", "> "]
[1322.964128, "o", "        elif bex and h: parts.append(f\"computed ratio {ratio} from dead_pages {dead} / total_pages {total} would exceed tightened {sc} cap {eff}, but qualifying hold ticket {h['ticket_id']} suppresses bloat, so stale stats remains\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.964485, "o", "> "]
[1322.964918, "o", "        else: parts.append(f\"computed ratio {ratio} from dead_pages {dead} / total_pages {total} is within tightened {sc} cap {eff}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.965147, "o", "        parts.append(tr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.96542, "o", "        lines.append('; '.join(parts)+'.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.965688, "o", "lines.append('')\r\n\u001b[?2004l\r"]
[1322.96603, "o", "\u001b[?2004h> "]
[1322.966557, "o", "lines.append('Tables whose computed ratio exactly equals their cap are compliant because the policy flags bloat only when the ratio is strictly greater than the cap.')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.966817, "o", "> "]
[1322.966977, "o", "open('/app/bloat_memo.md','w').write('\\n'.join(lines)+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1322.967299, "o", "print('regenerated /app/bloat_memo.md')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1322.967381, "o", "> PY"]
