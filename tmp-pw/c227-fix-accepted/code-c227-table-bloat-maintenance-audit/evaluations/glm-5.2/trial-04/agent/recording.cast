[1273.434287, "i", "python3 - <<'PY'\nimport csv\nlast={}\nwith open('/app/input/table_health.csv', newline='') as f:\n    for r in csv.DictReader(f): last[r['table_name']]=r\nlines=open('/app/bloat_memo.md').read().splitlines()\nnew=[]\npatched=0\nfor line in lines:\n    if line.startswith('- ') and 'BLOAT_THRESHOLD_EXCEEDED' in line and 'computed size_class is' not in line:\n        tbl=line.split()[1]\n        r=last[tbl]\n        total=int(r['total_pages'])\n        sc='large' if total>=500 else 'small'\n        if r['size_class']!=sc:\n            clause=f\"export size_class {r['size_class']} ignored; computed size_class is {sc} from total_pages {total}\"\n        else:\n            clause=f\"computed size_class is {sc} from total_pages {total}\"\n        line=line.rstrip('.') + f\"; {clause}.\"\n        patched+=1\n    new.append(line)\nopen('/app/bloat_memo.md','w').write('\\n'.join(new)+'\\n')\nprint('patched', patched, 'bloat bullets')\nPY\ngrep -E 'T-75 |T-102 |T-108 |T-96 |T-05 ' /app/bloat_memo.md\ngrep 'BLOAT_THRESHOLD_EXCEEDED' /app/bloat_memo.md "]
[1273.434734, "i", "| grep -vc 'computed size_class is'\nwc -l /app/bloat_audit.csv\nls -l /app/bloat_audit.csv /app/bloat_memo.md /app/results.json\n"]
