[1322.903633, "i", "t['valid_until']}\")\n        parts.append(tr)\n        lines.append('; '.join(parts)+'.')\n    elif f=='STALE_STATISTICS':\n        parts=[f\"{t} is STALE_STATISTICS because last_analyzed is {days} days before audit date 2026-09-01, which meets the >=30 staleness rule, and the legacy days_since_analyze field is ignored\"]\n        if bex and rex: parts.append(f\"computed ratio {ratio} from dead_pages {dead} / total_pages {total} would exceed tightened {sc} cap {eff}, but approved active reindex with valid_until={rei['valid_until']} exempts bloat, so stale stats remains\")\n        elif bex and h: parts.append(f\"computed ratio {ratio} from dead_pages {dead} / total_pages {total} would exceed tightened {sc} cap {eff}, but qualifying hold ticket {h['ticket_id']} suppresses bloat, so stale stats remains\")\n        else: parts.append(f\"computed ratio {ratio} from dead_pages {dead} / total_pages {total} is within tightened {sc} cap {eff}\")\n        parts.append(tr)\n        lines.append('; '.join(parts)+'.')\nlines.append('')\nli"]
