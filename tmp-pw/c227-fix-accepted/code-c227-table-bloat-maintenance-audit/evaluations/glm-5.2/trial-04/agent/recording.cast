[62.367545, "i", "python3 - <<'PY'\nimport csv\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom datetime import date\nfrom pathlib import Path\n\naudit_date = date(2026,9,1)\n\n# Parse table_health, last occurrence wins\nrows = []\nwith open('/app/input/table_health.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        rows.append(r)\nlast = {}\nfor r in rows:\n    last[r['table_name']] = r\n\ndef round2(x):\n    return Decimal(x).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n\ndef boolval(s):\n    return s.strip().lower() == 'true'\n\n# reindex log last per table\nreindex = {}\nwith open('/app/input/reindex_log.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        reindex[r['table_name']] = r\n\n# aliases\nalias_to_table = {}\nwith open('/app/input/table_aliases.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        alias_to_table[r['alias']] = r['table_name']\n\n# change control tickets: last row resolving to each table authoritative\ntickets_by_table = {}\nwith open('/app/input/change_control_tickets.csv', newline='') a"]
[62.368021, "i", "s f:\n    for r in csv.DictReader(f):\n        ref = r['table_ref']\n        tbl = ref if ref in last else alias_to_table.get(ref, ref)\n        tickets_by_table.setdefault(tbl, []).append(r)\n\ndef qualifying_hold(tbl):\n    if tbl not in tickets_by_table:\n        return None, None, []\n    candidates = tickets_by_table[tbl]\n    # last row authoritative\n    last_r = candidates[-1]\n    reasons = []\n    q = (\n        last_r['exception_type'] == 'BLOAT_HOLD'\n        and last_r['status'] == 'Closed'\n        and boolval(last_r['approved'])\n        and date.fromisoformat(last_r['valid_until']) > audit_date\n    )\n    return (last_r if q else None), last_r, candidates\n\nsummary = []\nfor tbl, r in last.items():\n    total = int(r['total_pages'])\n    dead = int(r['dead_pages'])\n    ratio = round2(Decimal(dead)/Decimal(total))\n    size_class = 'large' if total >= 500 else 'small'\n    cap = Decimal('0.20') if size_class == 'large' else Decimal('0.40')\n    stale_days = (audit_date - date.fromisoformat(r['last_analyzed'])).days\n   "]
[62.368351, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[62.368535, "i", " stale = stale_days >= 30\n    eff_cap = cap\n    if stale:\n        eff_cap = cap - (Decimal('0.10') if size_class == 'large' else Decimal('0.05'))\n    bloat_exceeded = ratio > eff_cap\n    autovac_disabled = (not boolval(r['autovacuum_enabled'])) or (r['vacuum_type'] == 'manual')\n    maint_active = boolval(r['maintenance_active'])\n    rei = reindex.get(tbl)\n    reindex_exempt = False\n    reindex_info = None\n    if rei:\n        approved = boolval(rei['approved'])\n        valid = date.fromisoformat(rei['valid_until']) > audit_date\n        reindex_exempt = maint_active and approved and valid\n        reindex_info = (rei['approved'], rei['valid_until'], valid, maint_active)\n    hold, last_ticket, all_tickets = qualifying_hold(tbl)\n    bloat_decision = bloat_exceeded and not reindex_exempt and not hold\n    if autovac_disabled:\n        finding = 'AUTOVACUUM_DISABLED'\n    elif bloat_decision:\n        finding = 'BLOAT_THRESHOLD_EXCEEDED'\n    elif stale:\n        finding = 'STALE_STATISTICS'\n    else:\n        finding = 'n"]
[62.36879, "o", "\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.369098, "i", "one'\n    summary.append((r['last_analyzed'], tbl, size_class, total, dead, ratio, cap, eff_cap, stale_days, stale, bloat_exceeded, autovac_disabled, maint_active, reindex_info, reindex_exempt, last_ticket, hold, finding))\n\nsummary.sort(key=lambda x: (x[0], x[1]))\nprint('last_analyzed|table|size|total|dead|ratio|cap|eff_cap|days|stale|bloat_exceeded|autovac_disabled|maint_active|reindex|hold|finding')\nfor row in summary:\n    last_analyzed, tbl, sc, total, dead, ratio, cap, eff_cap, days, stale, be, ad, ma, rei, rex, ticket, hold, finding = row\n    print(f'{last_analyzed}|{tbl}|{sc}|{total}|{dead}|{ratio}|{cap}|{eff_cap}|{days}|{stale}|{be}|{ad}|{ma}|{rei}|{ticket[\"ticket_id\"] if ticket else None}|{finding}')\n\nprint('\\\\nCounts:')\nfrom collections import Counter\nc = Counter(r[-1] for r in summary)\nprint(c)\nprint('total rows', len(summary))\nprint('flagged', sum(1 for r in summary if r[-1] != 'none'))\nprint('autovac', sum(1 for r in summary if r[-1]=='AUTOVACUUM_DISABLED'))\nprint('bloat', sum(1 for r in summary if"]
