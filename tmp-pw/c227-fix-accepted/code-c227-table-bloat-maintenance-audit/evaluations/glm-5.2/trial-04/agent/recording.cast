[81.377519, "i", "anual')\n    maint_active = boolval(r['maintenance_active'])\n    rei = reindex.get(tbl)\n    reindex_exempt = False\n    reindex_info = 'none'\n    if rei:\n        approved = boolval(rei['approved'])\n        valid = date.fromisoformat(rei['valid_until']) > audit_date\n        reindex_exempt = maint_active and approved and valid\n        reindex_info = f\"approved={rei['approved']},valid_until={rei['valid_until']},valid={valid},maint={maint_active}\"\n    hold, last_ticket = qualifying_hold(tbl)\n    ticket_info = 'none'\n    if last_ticket:\n        ticket_info = f\"{last_ticket['ticket_id']}:{last_ticket['exception_type']}:{last_ticket['status']}:approved={last_ticket['approved']}:valid_until={last_ticket['valid_until']}:qual={hold is not None}\"\n    bloat_decision = bloat_exceeded and not reindex_exempt and not hold\n    if autovac_disabled:\n        finding = 'AUTOVACUUM_DISABLED'\n    elif bloat_decision:\n        finding = 'BLOAT_THRESHOLD_EXCEEDED'\n    elif stale:\n        finding = 'STALE_STATISTICS'\n    else:\n        fi"]
