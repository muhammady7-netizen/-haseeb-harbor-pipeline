[1064.332706, "o", "{\r\n  \"flagged_count\": 94,\r\n  \"autovacuum_disabled_count\": 13,\r\n  \"bloat_exceeded_count\": 64,\r\n  \"stale_statistics_count\": 17,\r\n  \"compliant_count\": 32\r\n}"]
[1064.338344, "o", "T-128 is STALE_STATISTICS because last_analyzed is 45 days before audit date 2026-09-01, which meets the >=30 staleness rule, and the legacy days_since_analyze field is ignored; computed ratio 0.28 from dead_pages 280 / total_pages 1000 would exceed tightened large cap 0.10, but qualifying hold ticket CH-2208b suppresses bloat, so stale stats remains; computed size_class is large from total_pages 1000.\r\nT-122 is STALE_STATISTICS because last_analyzed is 40 days before audit date 2026-09-01, which meets the >=30 staleness rule, and the legacy days_since_analyze field is ignored; computed ratio 0.35 from dead_pages 350 / total_pages 1000 would exceed tightened large cap 0.10, but qualifying hold ticket CH-2202 suppresses bloat, so stale stats remains; computed size_class is large from total_pages 1000.\r\nT-50 is STALE_STATISTICS because last_analyzed is 33 days before audit date 2026-09-01, which meets the >=30 staleness rule, and the legacy days_since_analyze field is ignored; computed ratio 0.16 from dead_page"]
[1064.338741, "o", "s 155 / total_pages 1000 would exceed tightened large cap 0.10, but qualifying hold ticket CH-2213 suppresses bloat, so stale stats remains; computed size_class is large from total_pages 1000.\r\nT-10 is STALE_STATISTICS because last_analyzed is 31 days before audit date 2026-09-01, which meets the >=30 staleness rule, and the legacy days_since_analyze field is ignored; computed ratio 0.21 from dead_pages 210 / total_pages 1000 would exceed tightened large cap 0.10, but approved active reindex with valid_until=2026-09-15 exempts bloat, so stale stats remains; computed size_class is large from total_pages 1000.\r\nT-75 is BLOAT_THRESHOLD_EXCEEDED because computed and rounded half-up ratio 0.21 from dead_pages 168 / total_pages 800 exceeds the large cap 0.20.\r\nT-96 is BLOAT_THRESHOLD_EXCEEDED because computed and rounded half-up ratio 0.21 from dead_pages 205 / total_pages 1000 exceeds the large cap 0.20.\r\n"]
[1064.339424, "o", "\u001b[?2004hroot@89f5f31a11f9:/app# "]
[1130.300758, "i", "python3 - <<'PY'\nimport csv\nfrom datetime import date\nlast={}\nwith open('/app/input/table_health.csv', newline='') as f:\n    for r in csv.DictReader(f): last[r['table_name']]=r\ndef trap(tbl):\n    r=last[tbl]; total=int(r['total_pages']); sc='large' if total>=500 else 'small'\n    if r['size_class']!=sc:\n        return f\"export size_class {r['size_class']} ignored; computed {sc} from total_pages {total}\"\n    return f\"computed {sc} from total_pages {total}\"\nlines=open('/app/bloat_memo.md').read().splitlines()\nnew=[]\nfor line in lines:\n    if line.startswith('- ') and 'BLOAT_THRESHOLD_EXCEEDED' in line:\n        tbl=line.split()[0][2:]\n        if 'computed large' not in line and 'computed small' not in line:\n            line=line.rstrip('.')\n            line += f\"; {trap(tbl)}.\"\n    new.append(line)\nopen('/app/bloat_memo.md','w').write('\\n'.join(new)+'\\n')\nprint('patched bloat_memo.md')\nPY\n"]
