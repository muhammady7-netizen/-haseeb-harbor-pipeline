[62.370616, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> audit_date = date(2026,9,1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Parse table_health, last occurrence wins\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.371541, "o", "rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.373429, "o", "with open('/app/input/table_health.csv', newline='') as f:\r\n\u001b[?2004l\r"]
[62.373852, "o", "\u001b[?2004h> "]
[62.374182, "o", "    for r in csv.DictReader(f):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.374688, "o", "        rows.append(r)\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.374972, "o", "> "]
[62.37552, "o", "last = {}\r\n"]
[62.375906, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[62.37638, "o", "for r in rows:\r\n\u001b[?2004l\r"]
[62.376973, "o", "\u001b[?2004h> "]
[62.377374, "o", "    last[r['table_name']] = r\r\n\u001b[?2004l\r"]
[62.377565, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[62.377861, "o", "\u001b[?2004h"]
[62.37824, "o", "> def round2(x):\r\n\u001b[?2004l\r"]
[62.378625, "o", "\u001b[?2004h> "]
[62.379294, "o", "    return Decimal(x).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.379606, "o", "> \r\n\u001b[?2004l\r"]
[62.379935, "o", "\u001b[?2004h> "]
[62.380223, "o", "def boolval(s):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.380564, "o", "    return s.strip().lower() == 'true'\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.380651, "o", "> \r\n\u001b[?2004l\r"]
[62.380823, "o", "\u001b[?2004h> "]
[62.381183, "o", "# reindex log last per table\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.381633, "o", "> reindex = {}"]
[62.381907, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.382665, "o", "with open('/app/input/reindex_log.csv', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.382984, "o", "> "]
[62.383372, "o", "    for r in csv.DictReader(f):"]
[62.383625, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.383841, "o", "> "]
[62.38437, "o", "        reindex[r['table_name']] = r\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.384611, "o", "> \r\n\u001b[?2004l\r"]
[62.384781, "o", "\u001b[?2004h> "]
[62.385061, "o", "# aliases\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.385423, "o", "alias_to_table = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.385575, "o", "> "]
[62.385956, "o", "with open('/app/input/table_aliases.csv', newline='') as f:\r\n\u001b[?2004l\r"]
[62.386209, "o", "\u001b[?2004h> "]
[62.386534, "o", "    for r in csv.DictReader(f):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.386962, "o", "        alias_to_table[r['alias']] = r['table_name']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[62.387366, "o", "\u001b[?2004h> "]
[62.387686, "o", "# change control tickets: last row resolving to each table authoritative\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.387983, "o", "> "]
[62.388268, "o", "tickets_by_table = {}\r\n\u001b[?2004l\r"]
[62.388521, "o", "\u001b[?2004h> "]
[62.388829, "o", "with open('/app/input/change_control_tickets.csv', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.389324, "o", "    for r in csv.DictReader(f):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.389615, "o", "        ref = r['table_ref']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.390064, "o", "        tbl = ref if ref in last else alias_to_table.get(ref, ref)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.390466, "o", "        tickets_by_table.setdefault(tbl, []).append(r)\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.390821, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[62.391105, "o", "> "]
[62.391426, "o", "def qualifying_hold(tbl):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.392005, "o", "    if tbl not in tickets_by_table:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.392447, "o", "        return None, None, []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.392771, "o", "    candidates = tickets_by_table[tbl]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.393201, "o", "    # last row authoritative\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.393732, "o", "    last_r = candidates[-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.39423, "o", "    reasons = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.394477, "o", "    q = (\r\n\u001b[?2004l\r"]
[62.394725, "o", "\u001b[?2004h> "]
[62.395169, "o", "        last_r['exception_type'] == 'BLOAT_HOLD'\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.395394, "o", "> "]
[62.39561, "o", "        and last_r['status'] == 'Closed'\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.396012, "o", "> "]
[62.396353, "o", "        and boolval(last_r['approved'])\r\n\u001b[?2004l\r"]
[62.396629, "o", "\u001b[?2004h> "]
[62.397115, "o", "        and date.fromisoformat(last_r['valid_until']) > audit_date\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.397378, "o", ">     )\r\n\u001b[?2004l\r"]
[62.397631, "o", "\u001b[?2004h> "]
[62.397795, "o", "    return (last_r if q else None), last_r, candidates\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[62.397884, "o", "> summary = []\r\n\u001b[?2004l\r"]
[62.398314, "o", "\u001b[?2004h> "]
[62.3986, "o", "for tbl, r in last.items():"]
[62.398923, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.399232, "o", "    total = int(r['total_pages'])\r\n\u001b[?2004l\r"]
[62.399541, "o", "\u001b[?2004h> "]
[62.399793, "o", "    dead = int(r['dead_pages'])\r\n\u001b[?2004l\r"]
[62.400182, "o", "\u001b[?2004h> "]
[62.400622, "o", "    ratio = round2(Decimal(dead)/Decimal(total))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.401002, "o", "    size_class = 'large' if total >= 500 else 'small'\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.401269, "o", "> "]
[62.401792, "o", "    cap = Decimal('0.20') if size_class == 'large' else Decimal('0.40')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.402296, "o", "    stale_days = (audit_date - date.fromisoformat(r['last_analyzed'])).days\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.402609, "o", ">     stale = stale_days >= 30\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.402829, "o", ">     eff_cap = cap\r\n\u001b[?2004l\r"]
[62.403089, "o", "\u001b[?2004h> "]
[62.403392, "o", "    if stale:\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.403686, "o", "> "]
[62.404069, "o", "        eff_cap = cap - (Decimal('0.10') if size_class == 'large' else Decimal('0.05'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.404435, "o", "> "]
[62.404753, "o", "    bloat_exceeded = ratio > eff_cap\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.405166, "o", "    autovac_disabled = (not boolval(r['autovacuum_enabled'])) or (r['vacuum_type'] == 'manual')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.40575, "o", "    maint_active = boolval(r['maintenance_active'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.406363, "o", "    rei = reindex.get(tbl)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.407099, "o", "    reindex_exempt = False\r\n\u001b[?2004l\r\u001b[?2004h>     reindex_info = None\r\n\u001b[?2004l\r\u001b[?2004h>     if rei:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.407583, "o", "        approved = boolval(rei['approved'])\r\n\u001b[?2004l\r"]
[62.407913, "o", "\u001b[?2004h> "]
[62.408479, "o", "        valid = date.fromisoformat(rei['valid_until']) > audit_date\r\n\u001b[?2004l\r"]
[62.408804, "o", "\u001b[?2004h> "]
[62.409222, "o", "        reindex_exempt = maint_active and approved and valid\r\n\u001b[?2004l\r"]
[62.409304, "o", "\u001b[?2004h"]
[62.409654, "o", "> "]
[62.410106, "o", "        reindex_info = (rei['approved'], rei['valid_until'], valid, maint_active)\r\n\u001b[?2004l\r"]
[62.410379, "o", "\u001b[?2004h> "]
[62.410771, "o", "    hold, last_ticket, all_tickets = qualifying_hold(tbl)\r\n\u001b[?2004l\r"]
[62.410974, "o", "\u001b[?2004h> "]
[62.41158, "o", "    bloat_decision = bloat_exceeded and not reindex_exempt and not hold\r\n\u001b[?2004l\r"]
[62.411944, "o", "\u001b[?2004h> "]
[62.41217, "o", "    if autovac_disabled:\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.412594, "o", "> "]
[62.4129, "o", "        finding = 'AUTOVACUUM_DISABLED'\r\n\u001b[?2004l\r"]
[62.413161, "o", "\u001b[?2004h> "]
[62.413398, "o", "    elif bloat_decision:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.413856, "o", "        finding = 'BLOAT_THRESHOLD_EXCEEDED'\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.414157, "o", ">     elif stale:"]
[62.414283, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.414551, "o", "        finding = 'STALE_STATISTICS'\r\n\u001b[?2004l\r"]
[62.414705, "o", "\u001b[?2004h"]
[62.415361, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.415919, "o", "        finding = 'none'\r\n\u001b[?2004l\r"]
[62.416199, "o", "\u001b[?2004h> "]
[62.417996, "o", "    summary.append((r['last_analyzed'], tbl, size_class, total, dead, ratio, cap, eff_cap, stale_days, stale, bloat_exceeded, autovac_disabled, maint_active, reindex_info, reindex_exempt, last_ticket, hold, finding))\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.418803, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.419688, "o", "summary.sort(key=lambda x: (x[0], x[1]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.420231, "o", "> "]
[62.421009, "o", "print('last_analyzed|table|size|total|dead|ratio|cap|eff_cap|days|stale|bloat_exceeded|autovac_disabled|maint_active|reindex|hold|finding')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.421321, "o", "for row in summary:\r\n\u001b[?2004l\r"]
[62.421697, "o", "\u001b[?2004h"]
[62.422404, "o", "> "]
[62.42283, "o", "    last_analyzed, tbl, sc, total, dead, ratio, cap, eff_cap, days, stale, be, ad, ma, rei, rex, ticket, hold, finding = row\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.423122, "o", "> "]
[62.424539, "o", "    print(f'{last_analyzed}|{tbl}|{sc}|{total}|{dead}|{ratio}|{cap}|{eff_cap}|{days}|{stale}|{be}|{ad}|{ma}|{rei}|{ticket[\"ticket_id\"] if ticket else None}|{finding}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.425285, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> print('\\\\nCounts:')\r\n\u001b[?2004l\r"]
[62.425812, "o", "\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.426392, "o", "c = Counter(r[-1] for r in summary)\r\n\u001b[?2004l\r\u001b[?2004h> print(c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.426833, "o", "print('total rows', len(summary))\r\n\u001b[?2004l\r"]
[62.427056, "o", "\u001b[?2004h> "]
[62.427902, "o", "print('flagged', sum(1 for r in summary if r[-1] != 'none'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.428324, "o", "print('autovac', sum(1 for r in summary if r[-1]=='AUTOVACUUM_DISABLED'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.428772, "o", "print('bloat', sum(1 for r in summary if r[-1]=='BLOAT_THRESHOLD_EXCEEDED'))\r\n\u001b[?2004l\r"]
[62.429027, "o", "\u001b[?2004h> "]
[62.429451, "o", "print('stale', sum(1 for r in summary if r[-1]=='STALE_STATISTICS'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.4297, "o", "> "]
[62.430022, "o", "print('none', sum(1 for r in summary if r[-1]=='none'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.430271, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[62.430591, "o", "> print('\\\\nNon-none details:')\r\n"]
[62.430756, "o", "\u001b[?2004l\r\u001b[?2004h> for r in summary:\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.431007, "o", "> "]
[62.431217, "o", "    if r[-1] != 'none':\r\n\u001b[?2004l\r"]
[62.431491, "o", "\u001b[?2004h>         print(r)\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.431692, "o", "> PY\r\n\u001b[?2004l\r"]
