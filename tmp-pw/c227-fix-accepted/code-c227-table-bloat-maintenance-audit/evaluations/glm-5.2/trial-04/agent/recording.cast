[133.90912, "o", "\u001b[?2004hroot@89f5f31a11f9:/app# "]
[739.328403, "i", "cat > /tmp/write_deliverables.py <<'PY'\nimport csv, json\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom datetime import date\n\nA = date(2026,9,1)\nrows=[]\nwith open('/app/input/table_health.csv', newline='') as f:\n    for r in csv.DictReader(f): rows.append(r)\nlast={}\nfor r in rows: last[r['table_name']]=r\n\ndef r2(x): return Decimal(x).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\ndef bv(s): return s.strip().lower()=='true'\n\nreindex={}\nwith open('/app/input/reindex_log.csv', newline='') as f:\n    for r in csv.DictReader(f): reindex[r['table_name']]=r\n\nalias={}\nwith open('/app/input/table_aliases.csv', newline='') as f:\n    for r in csv.DictReader(f): alias[r['alias']]=r['table_name']\n\ntickets={}\nwith open('/app/input/change_control_tickets.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        ref=r['table_ref']\n        tbl=ref if ref in last else alias.get(ref, ref)\n        tickets.setdefault(tbl,[]).append(r)\n\ndef hold(tbl):\n    if tbl not in tickets: return None,None\n    t=tickets[tbl][-1]\n    "]
[739.331681, "o", "cat > /tmp/write_deliverables.py <<'PY'\r\n"]
[739.33223, "i", "q = t['exception_type']=='BLOAT_HOLD' and t['status']=='Closed' and bv(t['approved']) and date.fromisoformat(t['valid_until'])>A\n    return (t if q else None), t\n\nout=[]\nfor tbl,r in last.items():\n    total=int(r['total_pages']); dead=int(r['dead_pages'])\n    ratio=r2(Decimal(dead)/Decimal(total))\n    sc='large' if total>=500 else 'small'\n    cap=Decimal('0.20') if sc=='large' else Decimal('0.40')\n    days=(A - date.fromisoformat(r['last_analyzed'])).days\n    stale = days >= 30\n    eff=cap - (Decimal('0.10') if sc=='large' else Decimal('0.05')) if stale else cap\n    bex = ratio > eff\n    ad = (not bv(r['autovacuum_enabled'])) or (r['vacuum_type']=='manual')\n    ma=bv(r['maintenance_active'])\n    rei=reindex.get(tbl)\n    rex=False\n    if rei:\n        rex = ma and bv(rei['approved']) and date.fromisoformat(rei['valid_until'])>A\n    h,lt=hold(tbl)\n    bd = bex and not rex and not h\n    if ad: f='AUTOVACUUM_DISABLED'\n    elif bd: f='BLOAT_THRESHOLD_EXCEEDED'\n    elif stale: f='STALE_STATISTICS'\n    else: f='none'"]
[739.332594, "o", "\u001b[?2004l\r\u001b[?2004h> import csv, json\r\n\u001b[?2004l\r\u001b[?2004h> from decimal import Decimal, ROUND_HALF_UP\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> "]
[739.332993, "i", "\n    out.append({'last_analyzed':r['last_analyzed'],'table_name':tbl,'size_class':sc,'total_pages':total,'dead_pages':dead,'ratio':ratio,'cap':cap,'eff_cap':eff,'days':days,'stale':stale,'bex':bex,'ad':ad,'ma':ma,'rei':rei,'rex':rex,'hold':h,'last_ticket':lt,'finding':f})\n\nout.sort(key=lambda x:(x['last_analyzed'], x['table_name']))\n\nwith open('/app/bloat_audit.csv','w',newline='') as f:\n    w=csv.writer(f)\n    w.writerow(['table_name','size_class','bloat_ratio','finding'])\n    for x in out:\n        w.writerow([x['table_name'], x['size_class'], x['ratio'], x['finding']])\n\ncounts={'flagged_count':0,'autovacuum_disabled_count':0,'bloat_exceeded_count':0,'stale_statistics_count':0,'compliant_count':0}\nfor x in out:\n    if x['finding']!='none': counts['flagged_count']+=1\n    if x['finding']=='AUTOVACUUM_DISABLED': counts['autovacuum_disabled_count']+=1\n    if x['finding']=='BLOAT_THRESHOLD_EXCEEDED': counts['bloat_exceeded_count']+=1\n    if x['finding']=='STALE_STATISTICS': counts['stale_statistics_count']+=1\n   "]
[739.333135, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> A = date(2026,9,1)\r\n\u001b[?2004l\r\u001b[?2004h> rows=[]\r\n\u001b[?2004l\r"]
[739.333399, "i", " if x['finding']=='none': counts['compliant_count']+=1\nwith open('/app/results.json','w') as f:\n    json.dump(counts, f, indent=2)\n\n# Memo: non-none only, concise prose per table.\nlines=[]\nlines.append('# Monthly table maintenance review memo')\nlines.append('')\nlines.append('Audit date 2026-09-01; size_class is computed from total_pages, bloat_ratio is computed as dead_pages / total_pages rounded half-up to 2 decimals, and findings follow autovacuum, bloat, then stale precedence.')\nlines.append('')\nfor x in out:\n    if x['finding']=='none': continue\n    t=x['table_name']; total=x['total_pages']; dead=x['dead_pages']; ratio=x['ratio']; sc=x['size_class']; cap=x['cap']; eff=x['eff_cap']; days=x['days']; f=x['finding']\n    if f=='AUTOVACUUM_DISABLED':\n        if x['ad'] and not x['stale']:\n            lines.append(f\"- {t} is AUTOVACUUM_DISABLED because autovacuum protection is disabled for its computed {sc} table with total_pages {total} and dead_pages {dead}; the manual vacuum override or disabled autovacuum is"]
[739.333698, "o", "\u001b[?2004h> "]
[739.333958, "i", " checked first, so ratio {ratio} against cap {cap} is not the finding.\")\n        else:\n            lines.append(f\"- {t} is AUTOVACUUM_DISABLED because autovacuum protection is disabled for its computed {sc} table with total_pages {total} and dead_pages {dead}; this override is checked first, so ratio {ratio} against cap {cap} is not the finding.\")\n    elif f=='BLOAT_THRESHOLD_EXCEEDED':\n        if x['rex']:\n            pass\n        if x['hold']:\n            pass\n        if x['rei'] and not x['rex']:\n            vu=x['rei']['valid_until']\n            app=bv(x['rei']['approved'])\n            lines.append(f\"- {t} is BLOAT_THRESHOLD_EXCEEDED because computed ratio {ratio} from dead_pages {dead} / total_pages {total} exceeds the {sc} cap {eff}; reindex is not exempt since approved={app}, valid_until={vu}, maintenance_active={x['ma']}, and amendment validity requires valid_until > 2026-09-01.\")\n        elif x['last_ticket'] and not x['hold']:\n            lt=x['last_ticket']\n            lines.append(f\"- {t} is BLOAT"]
[739.334291, "o", "with open('/app/input/table_health.csv', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[739.334595, "i", "_THRESHOLD_EXCEEDED because computed ratio {ratio} from dead_pages {dead} / total_pages {total} exceeds the {sc} cap {eff}; ticket {lt['ticket_id']} does not qualify as a hold because it is {lt['exception_type']}/{lt['status']} with approved={lt['approved']} and valid_until={lt['valid_until']}.\")\n        elif x['stale']:\n            lines.append(f\"- {t} is BLOAT_THRESHOLD_EXCEEDED because computed ratio {ratio} from dead_pages {dead} / total_pages {total} exceeds the tightened {sc} cap {eff}; stats are stale at {days} days, so the cap was reduced from {cap} to {eff}.\")\n        else:\n            lines.append(f\"- {t} is BLOAT_THRESHOLD_EXCEEDED because computed ratio {ratio} from dead_pages {dead} / total_pages {total} exceeds the {sc} cap {eff}.\")\n    elif f=='STALE_STATISTICS':\n        lines.append(f\"- {t} is STALE_STATISTICS because last_analyzed is {days} days before audit date 2026-09-01, which meets the >=30 staleness rule; computed {sc} ratio {ratio} from dead_pages {dead} / total_pages {total} is within"]
[739.334851, "i", " cap {eff}, so stale stats is the finding.\")\n\nlines.append('')\nlines.append('Tables whose computed ratio exactly equals their cap are compliant because the policy flags bloat only when the ratio is strictly greater than the cap.')\nwith open('/app/bloat_memo.md','w') as f:\n    f.write('\\\\n'.join(lines)+'\\\\n')\nprint('wrote deliverables')\nprint(json.dumps(counts, indent=2))\nPY\npython3 /tmp/write_deliverables.py\n"]
