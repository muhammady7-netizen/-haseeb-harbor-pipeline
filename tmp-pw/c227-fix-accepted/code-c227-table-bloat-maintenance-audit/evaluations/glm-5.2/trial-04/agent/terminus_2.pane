[?2004l
[?2004h> import csv, json
[?2004l
[?2004h> from decimal import Decimal, ROUND_HALF_UP
[?2004l
[?2004h> from datetime import date
[?2004l
[?2004h> 
[?2004l
[?2004h> A = date(2026,9,1)
[?2004l
[?2004h> rows=[]
[?2004l
[?2004h> with open('/app/input/table_health.csv', newline='') as f:
[?2004l
[?2004h>     for r in csv.DictReader(f): rows.append(r)
[?2004l
[?2004h> last={}
[?2004l
[?2004h> for r in rows: last[r['table_name']]=r
[?2004l
[?2004h> 
[?2004l
[?2004h> def r2(x): return Decimal(x).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)
[?2004l
[?2004h> def bv(s): return s.strip().lower()=='true'
[?2004l
[?2004h> 
[?2004l
[?2004h> reindex={}
[?2004l
[?2004h> with open('/app/input/reindex_log.csv', newline='') as f:
[?2004l
[?2004h>     for r in csv.DictReader(f): reindex[r['table_name']]=r
[?2004l
[?2004h> 
[?2004l
[?2004h> alias={}
[?2004l
[?2004h> with open('/app/input/table_aliases.csv', newline='') as f:
[?2004l
[?2004h>     for r in csv.DictReader(f): alias[r['alias']]=r['table_name']
[?2004l
[?2004h> 
[?2004l
e[?2004h> tickets={}
[?2004l
[?2004h> with open('/app/input/change_control_tickets.csv', newline='') as f:
[?2004l
[?2004h>     for r in csv.DictReader(f):
[?2004l
[?2004h>         ref=r['table_ref']
[?2004l
[?2004h>         tbl=ref if ref in last else alias.get(ref, ref)
[?2004l
[?2004h>         tickets.setdefault(tbl,[]).append(r)
[?2004l
[?2004h> 
[?2004l
[?2004h> def hold(tbl):
[?2004l
[?2004h>     if tbl not in tickets: return None,None
[?2004l
[?2004h>     t=tickets[tbl][-1]
[?2004l
[?2004h>     q = t['exception_type']=='BLOAT_HOLD' and t['status']=='Closed' and bv(t['approved']) and date.fromisoformat(t['valid_until'])>A
[?2004l
[?2004h>     return (t if q else None), t
[?2004l
[?2004h> 
[?2004l
[?2004h> out=[]
[?2004l
 [?2004h> for tbl,r in last.items():
[?2004l
[?2004h>     total=int(r['total_pages']); dead=int(r['dead_pages'])
[?2004l
[?2004h>     ratio=r2(Decimal(dead)/Decimal(total))
[?2004l
[?2004h>     sc='large' if total>=500 else 'small'
[?2004l
[?2004h>     cap=Decimal('0.20') if sc=='large' else Decimal('0.40')
[?2004l
[?2004h>     days=(A - date.fromisoformat(r['last_analyzed'])).days
[?2004l
[?2004h>     stale = days >= 30
[?2004l
[?2004h>     eff=cap - (Decimal('0.10') if sc=='large' else Decimal('0.05')) if stale else cap
[?2004l
[?2004h>     bex = ratio > eff
[?2004l
[?2004h>     ad = (not bv(r['autovacuum_enabled'])) or (r['vacuum_type']=='manual')
[?2004l
[?2004h>     ma=bv(r['maintenance_active'])
[?2004l
[?2004h>     rei=reindex.get(tbl)
[?2004l
[?2004h>     rex=False
[?2004l
[?2004h>     if rei:
[?2004l
[?2004h>         rex = ma and bv(rei['approved']) and date.fromisoformat(rei['valid_until'])>A
[?2004l
S[?2004h>     h,lt=hold(tbl)
[?2004l
[?2004h>     bd = bex and not rex and not h
[?2004l
[?2004h>     if ad: f='AUTOVACUUM_DISABLED'
[?2004l
[?2004h>     elif bd: f='BLOAT_THRESHOLD_EXCEEDED'
[?2004l
tio[?2004h>     elif stale: f='STALE_STATISTICS'
[?2004l
[?2004h>     else: f='none'
[?2004l
n[?2004h>     out.append({'last_analyzed':r['last_analyzed'],'table_name':tbl,'size_class':sc,'total_pages':total,'dead_pages':dead,'ratio':ratio,'cap':cap,'eff_cap':eff,'days':days,'stale':stale,'bex':bex,'ad':ad,'ma':ma,'rei':rei,'rex':rex,'hold':h,'last_ticket':lt,'finding':f})
[?2004l
[?2004h> 
[?2004l
[?2004h> out.sort(key=lambda x:(x['last_analyzed'], x['table_name']))
[?2004l
[?2004h> 
[?2004l
[?2004h> with open('/app/bloat_audit.csv','w',newline='') as f:
[?2004l
[?2004h>     w=csv.writer(f)
[?2004l
[?2004h>     w.writerow(['table_name','size_class','bloat_ratio','finding'])
[?2004l
[?2004h>     for x in out:
[?2004l
[?2004h>         w.writerow([x['table_name'], x['size_class'], x['ratio'], x['finding']])
[?2004l
