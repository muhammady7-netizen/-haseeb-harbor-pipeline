def qualifying_hold(tbl):
    if tbl not in tickets_by_table:
        return None, None
    last_r = tickets_by_table[tbl][-1]
    q = (
        last_r['exception_type'] == 'BLOAT_HOLD'
        and last_r['status'] == 'Closed'
        and boolval(last_r['approved'])
        and date.fromisoformat(last_r['valid_until']) > audit_date
    )
    return (last_r if q else None), last_r

summary = []
for tbl, r in last.items():
    total = int(r['total_pages'])
    dead = int(r['dead_pages'])
    ratio = round2(Decimal(dead)/Decimal(total))
    size_class = 'large' if total >= 500 else 'small'
    cap = Decimal('0.20') if size_class == 'large' else Decimal('0.40'
    stale_days = (audit_date - date.fromisoformat(r['last_analyzed'])).days
    stale = stale_days >= 30
    eff_cap = cap
    if stale:
        eff_cap = cap - (Decimal('0.10') if size_class == 'large' else Decimal('0.05'))
    bloat_exceeded = ratio > eff_cap
    autovac_disabled = (not boolval(r['autovacuum_enabled'])) or (r['vacuum_type'] == 'manual')
    maint_active = boolval(r['maintenance_active'])
    rei = reindex.get(tbl)
    reindex_exempt = False
    reindex_info = 'none'
    if rei:
        approved = boolval(rei['approved'])
        valid = date.fromisoformat(rei['valid_until']) > audit_date
        reindex_exempt = maint_active and approved and valid
        reindex_info = f"approved={rei['approved']},valid_until={rei['valid_until']},valid={valid},maint={maint_active}"
    hold, last_ticket = qualifying_hold(tbl)
    ticket_info = 'none'
    if last_ticket:
        ticket_info = f"{last_ticket['ticket_id']}:{last_ticket['exception_type']}:{last_ticket['status']}:approved={last_ticket['approved']}:valid_until={last_ticket['valid_until']}:qual={hold is not None}"
    bloat_decision = bloat_exceeded and not reindex_exempt and not hold
    if autovac_disabled:
        finding = 'AUTOVACUUM_DISABLED'
    elif bloat_decision:
        finding = 'BLOAT_THRESHOLD_EXCEEDED'
    elif stale:
        finding = 'STALE_STATISTICS'
    else:
