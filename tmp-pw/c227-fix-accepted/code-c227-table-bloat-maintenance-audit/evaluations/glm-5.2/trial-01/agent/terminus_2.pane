print('row|table|last_analyzed|total|dead|ratio|size|vac|autovac|maint|reindex|ticket|stale_days|stale|cap|eff_cap|bloat_over|exempt|hold|finding')
for i,tn in enumerate(order,1):
    row=by_table[tn]
    total=int(row['total_pages']); dead=int(row['dead_pages'])
    ratio=round_half_up(Decimal(dead)/Decimal(total))
    size='large' if total>=500 else 'small'
    cap=Decimal('0.2') if size=='large' else Decimal('0.4')
    last=date.fromisoformat(row['last_analyzed'])
    stale_days=(audit_date-last).days
    stale=stale_days>=30
    eff_cap=cap
    if stale:
        eff_cap=cap - (Decimal('0.10') if size=='large' else Decimal('0.05'))
    vac=row['vacuum_type']
    autovac_disabled = (row['autovacuum_enabled']!='True') or (vac=='manual')
    ri=reindex.get(tn)
    exempt=False
    ri_note=''
    if ri:
        approved=ri['approved']=='True'
        valid=ri['valid_until'] > '2026-09-01'
        exempt = row['maintenance_active']=='True' and approved and valid
        ri_note=f"{ri['approved']},{ri['valid_until']},active={row['maintenance_active']},exempt={exempt}"
    tk=tickets.get(tn)
    hold=False
    tk_note=''
    if tk:
        hold = (tk['exception_type']=='BLOAT_HOLD' and tk['status']=='Closed' and tk['approved'].lower()=='true' and tk['valid_until'] > '2026-09-01')
        tk_note=f"{tk['ticket_id']},{tk['exception_type']},{tk['status']},{tk['approved']},{tk['valid_until']},hold={hold}"
    bloat_over = ratio > eff_cap
    finding='none'
    if autovac_disabled:
        finding='AUTOVACUUM_DISABLED'
    elif bloat_over and not exempt:
        if hold:
            finding='STALE_STATISTICS' if stale else 'none'
            tk_note += ',SUPPRESSED'
        else:
            finding='BLOAT_THRESHOLD_EXCEEDED'
    elif stale:
        finding='STALE_STATISTICS'
    print(f"{i}|{tn}|{row['last_analyzed']}|{total}|{dead}|{ratio}|{size}|{vac}|{row['autovacuum_enabled']}|{row['maintenance_active']}|{ri_note}|{tk_note}|{stale_days}|{stale}|{cap}|{eff_cap}|{bloat_over}|{exempt}|{hold}|{finding}")
