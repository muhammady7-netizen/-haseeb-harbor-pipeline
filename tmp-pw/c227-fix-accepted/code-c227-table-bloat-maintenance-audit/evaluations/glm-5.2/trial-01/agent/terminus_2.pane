.05'))

    autovac_disabled = (row['autovacuum_enabled'] != 'True') or (row['vacuum_type'] == 'manual')

    ri = reindex.get(tn)
    reindex_exempt = False
    if ri:
        approved = ri['approved'] == 'True'
        valid = ri['valid_until'] > '2026-09-01'
        reindex_exempt = (row['maintenance_active'] == 'True' and approved and valid)

    tk = tickets.get(tn)
    qualifying_hold = False
    if tk:
        qualifying_hold = (
            tk['exception_type'] == 'BLOAT_HOLD'
            and tk['status'] == 'Closed'
            and tk['approved'].lower() == 'true'
            and tk['valid_until'] > '2026-09-01'
        )

    bloat_over = ratio > effective_cap

    finding = 'none'
    if autovac_disabled:
        finding = 'AUTOVACUUM_DISABLED'
    elif bloat_over and not reindex_exempt:
        if qualifying_hold:
            finding = 'STALE_STATISTICS' if stale else 'none'
        else:
            finding = 'BLOAT_THRESHOLD_EXCEEDED'
    elif stale:
        finding = 'STALE_STATISTICS'

    audit_rows.append({
        'table_name': tn,
        'last_analyzed': row['last_analyzed'],
        'total_pages': total_pages,
        'dead_pages': dead_pages,
        'ratio': ratio,
        'size_class': size_class,
        'base_cap': base_cap,
        'effective_cap': effective_cap,
