[127.783152, "i", ".05'))\n\n    autovac_disabled = (row['autovacuum_enabled'] != 'True') or (row['vacuum_type'] == 'manual')\n\n    ri = reindex.get(tn)\n    reindex_exempt = False\n    if ri:\n        approved = ri['approved'] == 'True'\n        valid = ri['valid_until'] > '2026-09-01'\n        reindex_exempt = (row['maintenance_active'] == 'True' and approved and valid)\n\n    tk = tickets.get(tn)\n    qualifying_hold = False\n    if tk:\n        qualifying_hold = (\n            tk['exception_type'] == 'BLOAT_HOLD'\n            and tk['status'] == 'Closed'\n            and tk['approved'].lower() == 'true'\n            and tk['valid_until'] > '2026-09-01'\n        )\n\n    bloat_over = ratio > effective_cap\n\n    finding = 'none'\n    if autovac_disabled:\n        finding = 'AUTOVACUUM_DISABLED'\n    elif bloat_over and not reindex_exempt:\n        if qualifying_hold:\n            finding = 'STALE_STATISTICS' if stale else 'none'\n        else:\n            finding = 'BLOAT_THRESHOLD_EXCEEDED'\n    elif stale:\n        finding = 'STALE_STATISTICS'\n\n    aud"]
