[127.78229, "i", "cat > /tmp/generate_audit.py <<'PY'\nimport csv\nimport json\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom pathlib import Path\n\nIN = Path('/app/input')\nOUT = Path('/app')\naudit_date = date(2026, 9, 1)\n\ndef round_half_up(value: Decimal) -> Decimal:\n    return value.quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n\n# Read table_health and keep last occurrence per table_name.\nhealth_rows = []\nwith (IN / 'table_health.csv').open(newline='') as f:\n    for row in csv.DictReader(f):\n        health_rows.append(row)\n\nby_table = {}\norder_seen = []\nfor row in health_rows:\n    tn = row['table_name']\n    if tn not in by_table:\n        order_seen.append(tn)\n    by_table[tn] = row\n\n# Aliases: alias -> canonical table_name.\nalias_to_table = {}\nwith (IN / 'table_aliases.csv').open(newline='') as f:\n    for row in csv.DictReader(f):\n        alias_to_table[row['alias']] = row['table_name']\n\n# Reindex log: last row per table_name wins.\nreindex = {}\nwith (IN / 'reindex_log.csv').open(newline='') as f:\n "]
[127.782775, "i", "   for row in csv.DictReader(f):\n        reindex[row['table_name']] = row\n\n# Change-control tickets: resolve aliases and keep last row per canonical table.\ntickets = {}\nwith (IN / 'change_control_tickets.csv').open(newline='') as f:\n    for row in csv.DictReader(f):\n        ref = row['table_ref']\n        table = ref if ref in by_table else alias_to_table.get(ref, ref)\n        tickets[table] = row\n\naudit_rows = []\nfor tn in by_table:\n    row = by_table[tn]\n    total_pages = int(row['total_pages'])\n    dead_pages = int(row['dead_pages'])\n    ratio = round_half_up(Decimal(dead_pages) / Decimal(total_pages))\n    size_class = 'large' if total_pages >= 500 else 'small'\n    base_cap = Decimal('0.2') if size_class == 'large' else Decimal('0.4')\n\n    last_analyzed = date.fromisoformat(row['last_analyzed'])\n    stale_days = (audit_date - last_analyzed).days\n    stale = stale_days >= 30\n    effective_cap = base_cap\n    if stale:\n        effective_cap = base_cap - (Decimal('0.10') if size_class == 'large' else Decimal('0"]
