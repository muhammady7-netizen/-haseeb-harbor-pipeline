[68.471724, "o", "    last=date.fromisoformat(row['last_analyzed'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.472224, "o", "    stale_days=(audit_date-last).days\r\n"]
[68.472449, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[68.472672, "o", "    stale=stale_days>=30\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.472886, "o", ">     eff_cap=cap"]
[68.473178, "o", "\r\n\u001b[?2004l\r"]
[68.473451, "o", "\u001b[?2004h>     if stale:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.473996, "o", "        eff_cap=cap - (Decimal('0.10') if size=='large' else Decimal('0.05'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.474227, "o", "> "]
[68.474494, "o", "    vac=row['vacuum_type']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.474975, "o", "    autovac_disabled = (row['autovacuum_enabled']!='True') or (vac=='manual')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.475332, "o", "    ri=reindex.get(tn)\r\n\u001b[?2004l\r\u001b[?2004h>     exempt=False\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.475576, "o", "> "]
[68.475846, "o", "    ri_note=''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.476122, "o", "    if ri:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.476358, "o", "        approved=ri['approved']=='True'\r\n"]
[68.476541, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[68.476944, "o", "        valid=ri['valid_until'] > '2026-09-01'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.477402, "o", "        exempt = row['maintenance_active']=='True' and approved and valid\r\n\u001b[?2004l\r"]
[68.477755, "o", "\u001b[?2004h> "]
[68.478273, "o", "        ri_note=f\"{ri['approved']},{ri['valid_until']},active={row['maintenance_active']},exempt={exempt}\"\r\n\u001b[?2004l\r"]
[68.478465, "o", "\u001b[?2004h> "]
[68.478625, "o", "    tk=tickets.get(tn)\r\n\u001b[?2004l\r"]
[68.478865, "o", "\u001b[?2004h>     hold=False\r\n\u001b[?2004l\r"]
[68.479177, "o", "\u001b[?2004h>     tk_note=''\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.479414, "o", ">     if tk:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.480475, "o", "        hold = (tk['exception_type']=='BLOAT_HOLD' and tk['status']=='Closed' and tk['approved'].lower()=='true' and tk['valid_until'] > '2026-09-01')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.481593, "o", "        tk_note=f\"{tk['ticket_id']},{tk['exception_type']},{tk['status']},{tk['approved']},{tk['valid_until']},hold={hold}\"\r\n\u001b[?2004l\r"]
[68.481859, "o", "\u001b[?2004h> "]
[68.482033, "o", "    bloat_over = ratio > eff_cap\r\n"]
[68.482271, "o", "\u001b[?2004l\r\u001b[?2004h"]
[68.482528, "o", ">     finding='none'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.482967, "o", "    if autovac_disabled:\r\n\u001b[?2004l\r"]
[68.483439, "o", "\u001b[?2004h> "]
[68.483668, "o", "        finding='AUTOVACUUM_DISABLED'\r\n\u001b[?2004l\r"]
[68.484032, "o", "\u001b[?2004h> "]
[68.485783, "o", "    elif bloat_over and not exempt:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.486181, "o", "        if hold:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.48655, "o", "            finding='STALE_STATISTICS' if stale else 'none'\r\n\u001b[?2004l\r"]
[68.486705, "o", "\u001b[?2004h> "]
[68.487049, "o", "            tk_note += ',SUPPRESSED'\r\n\u001b[?2004l\r"]
[68.487328, "o", "\u001b[?2004h> "]
[68.487858, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.488582, "o", "            finding='BLOAT_THRESHOLD_EXCEEDED'\r\n\u001b[?2004l\r\u001b[?2004h>     elif stale:\r\n\u001b[?2004l\r"]
[68.488866, "o", "\u001b[?2004h> "]
[68.489123, "o", "        finding='STALE_STATISTICS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.490634, "o", "    lines.append(f\"{i}\\t{tn}\\t{row['last_analyzed']}\\t{total}\\t{dead}\\t{ratio}\\t{size}\\t{vac}\\t{row['autovacuum_enabled']}\\t{row['maintenance_active']}\\t{ri_note}\\t{tk_note}\\t{stale_days}\\t{stale}\\t{cap}\\t{eff_cap}\\t{bloat_over}\\t{exempt}\\t{hold}\\t{finding}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[68.490923, "o", "\u001b[?2004l\r\u001b[?2004h"]
[68.491028, "o", "> "]
[68.491546, "o", "Path('/tmp/audit.tsv').write_text('\\n'.join(lines)+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.49191, "o", "print('wrote /tmp/audit.tsv with', len(lines)-1, 'unique tables')\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.492184, "o", "> "]
[68.492385, "o", "print('\\nDUPLICATES:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.492608, "o", "for d in duplicates:\r\n"]
[68.492795, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[68.493046, "o", "    print(d[0], 'line', d[3], 'last=', d[2])\r\n\u001b[?2004l\r"]
[68.493235, "o", "\u001b[?2004h> "]
[68.493512, "o", "print('\\nNON-NONE FINDINGS:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.493727, "o", "for line in lines[1:]:\r\n\u001b[?2004l\r\u001b[?2004h>     parts=line.split('\\t')\r\n\u001b[?2004l\r"]
[68.494008, "o", "\u001b[?2004h> "]
[68.494248, "o", "    if parts[-1] != 'none':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.494472, "o", "        print('\\t'.join(parts[:13]) + ' ... ' + '\\t'.join(parts[13:]))\r\n\u001b[?2004l\r"]
[68.494704, "o", "\u001b[?2004h> "]
[68.494905, "o", "PY\r\n\u001b[?2004l\r"]
