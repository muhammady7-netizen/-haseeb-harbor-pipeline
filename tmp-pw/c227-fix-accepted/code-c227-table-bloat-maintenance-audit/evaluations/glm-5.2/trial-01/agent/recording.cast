[159.003773, "o", "\u001b[?2004h> "]
[159.004161, "o", "print('\\nNON-NONE MEMO BULLETS:')\r\n\u001b[?2004l\r\u001b[?2004h> for line in memo.splitlines():\r\n\u001b[?2004l\r\u001b[?2004h"]
