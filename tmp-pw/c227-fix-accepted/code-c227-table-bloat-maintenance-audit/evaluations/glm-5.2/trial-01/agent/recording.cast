[68.444559, "i", "python3 - <<'PY'\nimport csv\nfrom datetime import date\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom pathlib import Path\n\nIN=Path('/app/input')\naudit_date=date(2026,9,1)\n\ndef round_half_up(n):\n    return Decimal(n).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n\nhealth_rows=[]\nwith (IN/'table_health.csv').open() as f:\n    for row in csv.DictReader(f):\n        health_rows.append(row)\n\nby_table={}\norder=[]\nduplicates=[]\nseen=set()\nfor idx,row in enumerate(health_rows,1):\n    tn=row['table_name']\n    if tn in by_table:\n        duplicates.append((tn, by_table[tn], row, idx))\n    if tn not in by_table:\n        order.append(tn)\n    by_table[tn]=row\n\nalias_to_table={}\nwith (IN/'table_aliases.csv').open() as f:\n    for row in csv.DictReader(f):\n        alias_to_table[row['alias']]=row['table_name']\n\nreindex={}\nwith (IN/'reindex_log.csv').open() as f:\n    for row in csv.DictReader(f):\n        reindex[row['table_name']]=row\n\ntickets={}\nwith (IN/'change_control_tickets.csv').open() as f:\n    for row in csv.DictReade"]
[68.444981, "i", "r(f):\n        ref=row['table_ref']\n        table=ref if ref in by_table else alias_to_table.get(ref, ref)\n        tickets[table]=row\n\nlines=[]\nlines.append('row\\ttable\\tlast_analyzed\\ttotal_pages\\tdead_pages\\tratio\\tsize_class\\tvacuum_type\\tautovacuum_enabled\\tmaintenance_active\\treindex\\tticket\\tstale_days\\tstale\\tcap\\teff_cap\\tbloat_over\\texempt\\thold\\tfinding')\nfor i,tn in enumerate(order,1):\n    row=by_table[tn]\n    total=int(row['total_pages']); dead=int(row['dead_pages'])\n    ratio=round_half_up(Decimal(dead)/Decimal(total))\n    size='large' if total>=500 else 'small'\n    cap=Decimal('0.2') if size=='large' else Decimal('0.4')\n    last=date.fromisoformat(row['last_analyzed'])\n    stale_days=(audit_date-last).days\n    stale=stale_days>=30\n    eff_cap=cap\n    if stale:\n        eff_cap=cap - (Decimal('0.10') if size=='large' else Decimal('0.05'))\n    vac=row['vacuum_type']\n    autovac_disabled = (row['autovacuum_enabled']!='True') or (vac=='manual')\n    ri=reindex.get(tn)\n    exempt=False\n    ri_note=''\n  "]
[68.445236, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.445484, "i", "  if ri:\n        approved=ri['approved']=='True'\n        valid=ri['valid_until'] > '2026-09-01'\n        exempt = row['maintenance_active']=='True' and approved and valid\n        ri_note=f\"{ri['approved']},{ri['valid_until']},active={row['maintenance_active']},exempt={exempt}\"\n    tk=tickets.get(tn)\n    hold=False\n    tk_note=''\n    if tk:\n        hold = (tk['exception_type']=='BLOAT_HOLD' and tk['status']=='Closed' and tk['approved'].lower()=='true' and tk['valid_until'] > '2026-09-01')\n        tk_note=f\"{tk['ticket_id']},{tk['exception_type']},{tk['status']},{tk['approved']},{tk['valid_until']},hold={hold}\"\n    bloat_over = ratio > eff_cap\n    finding='none'\n    if autovac_disabled:\n        finding='AUTOVACUUM_DISABLED'\n    elif bloat_over and not exempt:\n        if hold:\n            finding='STALE_STATISTICS' if stale else 'none'\n            tk_note += ',SUPPRESSED'\n        else:\n            finding='BLOAT_THRESHOLD_EXCEEDED'\n    elif stale:\n        finding='STALE_STATISTICS'\n    lines.append(f\"{i}\\t{tn}\\t{"]
