[127.809536, "o", "\u001b[?2004h> "]
[127.809743, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.810315, "o", "# Reindex log: last row per table_name wins.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.810625, "o", "reindex = {}\r\n\u001b[?2004l\r"]
[127.810853, "o", "\u001b[?2004h> "]
[127.811167, "o", "with (IN / 'reindex_log.csv').open(newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.811586, "o", "    for row in csv.DictReader(f):\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.811816, "o", "> "]
[127.812074, "o", "        reindex[row['table_name']] = row\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.812271, "o", "> \r\n\u001b[?2004l\ru\u001b[?2004h> "]
[127.812715, "o", "# Change-control tickets: resolve aliases and keep last row per canonical table.\r\n\u001b[?2004l\ry\u001b[?2004h"]
[127.812988, "o", "> "]
[127.813059, "o", "tickets = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.813543, "o", "with (IN / 'change_control_tickets.csv').open(newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.813856, "o", "    for row in csv.DictReader(f):\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.814211, "o", "> "]
[127.814423, "o", "        ref = row['table_ref']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.81548, "o", "        table = ref if ref in by_table else alias_to_table.get(ref, ref)\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.815663, "o", "> "]
[127.816133, "o", "        tickets[table] = row\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.816389, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[127.816572, "o", "> audit_rows = []\r\n\u001b[?2004l\r"]
[127.816816, "o", "\u001b[?2004h> "]
[127.817054, "o", "for tn in by_table:\r\n\u001b[?2004l\r\u001b[?2004h>     row = by_table[tn]\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.817246, "o", "> "]
[127.81859, "o", "    total_pages = int(row['total_pages'])\r\n\u001b[?2004l\r"]
[127.818862, "o", "\u001b[?2004h> "]
[127.819398, "o", "    dead_pages = int(row['dead_pages'])\r\n\u001b[?2004l\r"]
[127.819849, "o", "\u001b[?2004h> "]
[127.820987, "o", "    ratio = round_half_up(Decimal(dead_pages) / Decimal(total_pages))\r\n\u001b[?2004l\r"]
[127.821239, "o", "\u001b[?2004h> "]
[127.822611, "o", "    size_class = 'large' if total_pages >= 500 else 'small'\r\n\u001b[?2004l\r"]
[127.822853, "o", "\u001b[?2004h> "]
[127.823556, "o", "    base_cap = Decimal('0.2') if size_class == 'large' else Decimal('0.4')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rot\u001b[?2004h"]
[127.823722, "o", "> "]
[127.824251, "o", "    last_analyzed = date.fromisoformat(row['last_analyzed'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.82494, "o", "    stale_days = (audit_date - last_analyzed).days\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.825202, "o", "    stale = stale_days >= 30\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.825961, "o", "    effective_cap = base_cap\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.82615, "o", "    if stale:\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.82637, "o", "> "]
[127.827657, "o", "        effective_cap = base_cap - (Decimal('0.10') if size_class == 'large' else Decimal('0.05'))\r\n\u001b[?2004l\r"]
[127.827874, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.82938, "o", "    autovac_disabled = (row['autovacuum_enabled'] != 'True') or (row['vacuum_type'] == 'manual')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[127.829754, "o", ">     ri = reindex.get(tn)\r\n\u001b[?2004l\r"]
[127.829933, "o", "\u001b[?2004h> "]
[127.830171, "o", "    reindex_exempt = False\r\n\u001b[?2004l\r':\u001b[?2004h> "]
[127.830423, "o", "    if ri:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.831424, "o", "        approved = ri['approved'] == 'True'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.832118, "o", "        valid = ri['valid_until'] > '2026-09-01'\r\n\u001b[?2004l\r'a\u001b[?2004h> "]
[127.833236, "o", "        reindex_exempt = (row['maintenance_active'] == 'True' and approved and valid)\r\n\u001b[?2004l\r"]
[127.833493, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.833646, "o", "    tk = tickets.get(tn)"]
[127.833823, "o", "\r\n\u001b[?2004l\r"]
[127.834028, "o", "\u001b[?2004h> "]
[127.834432, "o", "    qualifying_hold = False\r\n\u001b[?2004l\r\u001b[?2004h>     if tk:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.835334, "o", "        qualifying_hold = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.836767, "o", "            tk['exception_type'] == 'BLOAT_HOLD'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.837633, "o", "            and tk['status'] == 'Closed'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.838015, "o", "            and tk['approved'].lower() == 'true'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.839338, "o", "            and tk['valid_until'] > '2026-09-01'\r\n\u001b[?2004l\r"]
[127.839589, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[127.839769, "o", "\u001b[?2004h> "]
[127.839965, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.840607, "o", "    bloat_over = ratio > effective_cap\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.840842, "o", "    finding = 'none'\r\n\u001b[?2004l\r"]
[127.841023, "o", "\u001b[?2004h> "]
[127.841855, "o", "    if autovac_disabled:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.84234, "o", "        finding = 'AUTOVACUUM_DISABLED'\r\n\u001b[?2004l\r"]
[127.842547, "o", "\u001b[?2004h> "]
[127.843003, "o", "    elif bloat_over and not reindex_exempt:\r\n\u001b[?2004l\r"]
[127.843141, "o", "\u001b[?2004h> "]
[127.843509, "o", "        if qualifying_hold:\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.843713, "o", "> "]
[127.844761, "o", "            finding = 'STALE_STATISTICS' if stale else 'none'\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.844972, "o", "> "]
[127.845099, "o", "        else:\r\n\u001b[?2004l\r"]
[127.845336, "o", "\u001b[?2004h> "]
[127.846192, "o", "            finding = 'BLOAT_THRESHOLD_EXCEEDED'\r\n\u001b[?2004l\r"]
[127.846449, "o", "\u001b[?2004h>     elif stale:\r\n\u001b[?2004l\r"]
[127.846715, "o", "\u001b[?2004h> "]
[127.847367, "o", "        finding = 'STALE_STATISTICS'\r\n\u001b[?2004l\r"]
[127.847539, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[127.847719, "o", "> "]
[127.847882, "o", "    audit_rows.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.847949, "o", "> "]
[127.84827, "o", "        'table_name': tn,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.848449, "o", "        'last_analyzed': row['last_analyzed'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.848796, "o", "        'total_pages': total_pages,\r\n\u001b[?2004l\r"]
[127.848861, "o", "\u001b[?2004h"]
[127.84903, "o", ">         'dead_pages': dead_pages,\r\n\u001b[?2004l\r"]
[127.849222, "o", "\u001b[?2004h> "]
[127.849429, "o", "        'ratio': ratio,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.850152, "o", "        'size_class': size_class,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.850743, "o", "        'base_cap': base_cap,\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.850989, "o", "> "]
[127.851419, "o", "        'effective_cap': effective_cap,\r\n\u001b[?2004l\r"]
[127.851632, "o", "\u001b[?2004h"]
[127.85185, "o", ">         'stale_days': stale_days,\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.852097, "o", ">         'stale': stale,\r\n\u001b[?2004l\r"]
[127.852334, "o", "\u001b[?2004h> "]
[127.852904, "o", "        'vacuum_type': row['vacuum_type'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.853134, "o", "> "]
[127.85417, "o", "        'autovacuum_enabled': row['autovacuum_enabled'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.854869, "o", "        'maintenance_active': row['maintenance_active'],\r\n\u001b[?2004l\r"]
[127.854957, "o", "\u001b[?2004h> "]
[127.855299, "o", "        'reindex': ri,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.856093, "o", "        'reindex_exempt': reindex_exempt,\r\n\u001b[?2004l\r"]
[127.856342, "o", "\u001b[?2004h> "]
[127.856578, "o", "        'ticket': tk,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.856821, "o", "        'qualifying_hold': qualifying_hold,\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.856998, "o", ">         'finding': finding,\r\n\u001b[?2004l\r"]
[127.857225, "o", "\u001b[?2004h> "]
[127.857387, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.858005, "o", "audit_rows.sort(key=lambda r: (r['last_analyzed'], r['table_name']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.8582, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[127.858376, "o", "> # Write CSV.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.858946, "o", "with (OUT / 'bloat_audit.csv').open('w', newline='') as f:\r\n\u001b[?2004l\r"]
[127.859182, "o", "\u001b[?2004h> "]
[127.860653, "o", "    writer = csv.DictWriter(f, fieldnames=['table_name', 'size_class', 'bloat_ratio', 'finding'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.860889, "o", "> "]
[127.861396, "o", "    writer.writeheader()\r\n\u001b[?2004l\r"]
[127.861588, "o", "\u001b[?2004h> "]
[127.861998, "o", "    for r in audit_rows:\r\n\u001b[?2004l\r"]
[127.862241, "o", "\u001b[?2004h> "]
[127.862407, "o", "        writer.writerow({\r\n\u001b[?2004l\r"]
[127.862633, "o", "\u001b[?2004h> "]
[127.863116, "o", "            'table_name': r['table_name'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.863614, "o", "            'size_class': r['size_class'],\r\n\u001b[?2004l\r"]
[127.863896, "o", "\u001b[?2004h> "]
[127.864286, "o", "            'bloat_ratio': f\"{r['ratio']:.2f}\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.865671, "o", "            'finding': r['finding'],\r\n\u001b[?2004l\r"]
[127.865847, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.866041, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[127.86624, "o", "> "]
[127.866541, "o", "# Write results.json.\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.866734, "o", "> counts = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.868114, "o", "    'flagged_count': sum(1 for r in audit_rows if r['finding'] != 'none'),\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.868332, "o", "> "]
[127.869703, "o", "    'autovacuum_disabled_count': sum(1 for r in audit_rows if r['finding'] == 'AUTOVACUUM_DISABLED'),\r\n\u001b[?2004l\r"]
[127.869929, "o", "\u001b[?2004h> "]
[127.871001, "o", "    'bloat_exceeded_count': sum(1 for r in audit_rows if r['finding'] == 'BLOAT_THRESHOLD_EXCEEDED'),\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.871298, "o", "> "]
[127.872134, "o", "    'stale_statistics_count': sum(1 for r in audit_rows if r['finding'] == 'STALE_STATISTICS'),\r\n\u001b[?2004l\r"]
[127.872358, "o", "\u001b[?2004h> "]
[127.873039, "o", "    'compliant_count': sum(1 for r in audit_rows if r['finding'] == 'none'),\r\n\u001b[?2004l\r"]
[127.873203, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.873399, "o", "> "]
[127.873823, "o", "with (OUT / 'results.json').open('w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.87393, "o", "> "]
[127.874422, "o", "    json.dump(counts, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.874619, "o", "> "]
[127.874825, "o", "    f.write('\\n')\r\n\u001b[?2004l\r"]
[127.875015, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.875304, "o", "def fmt_cap(cap: Decimal) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.875495, "o", "    return f\"{cap:.2f}\"\r\n\u001b[?2004l\r"]
[127.875671, "o", "\u001b[?2004h> "]
[127.875865, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.87615, "o", "> "]
[127.876468, "o", "# Memo: local prose units for non-none findings only.\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.876714, "o", "> memo = []\r\n\u001b[?2004l\r"]
[127.876874, "o", "\u001b[?2004h> "]
[127.877463, "o", "memo.append('# Monthly table maintenance review memo')\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.877638, "o", "> "]
[127.877872, "o", "memo.append('')\r\n\u001b[?2004l\r"]
[127.878085, "o", "\u001b[?2004h> "]
[127.884701, "o", "memo.append('Audit date 2026-09-01 was used for staleness, reindex validity, and change-control hold validity. Bloat ratios were computed as dead_pages / total_pages with round-half-up to 2 decimal places, and size_class was computed from total_pages only.')\r\n\u001b[?2004l\r"]
[127.885068, "o", "\u001b[?2004h> "]
[127.885265, "o", "memo.append('')\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.885543, "o", "> "]
[127.88577, "o", "\r\n\u001b[?2004l\r"]
[127.886041, "o", "\u001b[?2004h> "]
[127.886312, "o", "for r in audit_rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.886806, "o", "    if r['finding'] == 'none':\r\n\u001b[?2004l\r"]
[127.887017, "o", "\u001b[?2004h> "]
[127.887326, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.887607, "o", "> "]
[127.887871, "o", "    tn = r['table_name']\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.888085, "o", "> "]
[127.888295, "o", "    total = r['total_pages']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.8888, "o", "    dead = r['dead_pages']\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.889079, "o", "> "]
[127.889327, "o", "    ratio = r['ratio']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.889629, "o", "    size = r['size_class']\r\n\u001b[?2004l\r"]
[127.889854, "o", "\u001b[?2004h> "]
[127.890263, "o", "    base_cap = r['base_cap']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.890851, "o", "    eff_cap = r['effective_cap']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.891069, "o", "    days = r['stale_days']\r\n\u001b[?2004l\r"]
[127.891371, "o", "\u001b[?2004h> "]
[127.891663, "o", "    finding = r['finding']\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.891818, "o", ">     parts = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.892019, "o", "> \r\n\u001b[?2004l\r]"]
[127.892219, "o", "\u001b[?2004h> "]
[127.893059, "o", "    if finding == 'AUTOVACUUM_DISABLED':\r\n\u001b[?2004l\r"]
[127.893379, "o", "\u001b[?2004h> "]
[127.893614, "o", "        vac = r['vacuum_type']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.893842, "o", "        if r['autovacuum_enabled'] != 'True':\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.894145, "o", "> "]
[127.896259, "o", "            parts.append(f\"{tn} is AUTOVACUUM_DISABLED because autovacuum is disabled, with computed {size} size from total_pages {total} and dead_pages {dead} producing ratio {ratio:.2f} against cap {fmt_cap(base_cap)}.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.896468, "o", "> "]
[127.896671, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.901564, "o", "            parts.append(f\"{tn} is AUTOVACUUM_DISABLED because manual vacuum overrides autovacuum even though autovacuum_enabled=True, with computed {size} size from total_pages {total} and dead_pages {dead} producing ratio {ratio:.2f} against cap {fmt_cap(base_cap)}.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.901794, "o", "> "]
[127.902362, "o", "    elif finding == 'BLOAT_THRESHOLD_EXCEEDED':\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.902627, "o", "> "]
[127.903468, "o", "        if r['reindex'] and not r['reindex_exempt']:\r\n\u001b[?2004l\r"]
[127.90365, "o", "\u001b[?2004h> "]
[127.903907, "o", "            ri = r['reindex']\r\n\u001b[?2004l\r"]
[127.904196, "o", "\u001b[?2004h> "]
[127.904591, "o", "            if ri['approved'] != 'True':\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.904807, "o", "> "]
[127.905579, "o", "                ri_reason = f\"reindex is unapproved because approved={ri['approved']}\"\r\n\u001b[?2004l\r"]
[127.905799, "o", "\u001b[?2004h> "]
[127.906197, "o", "            elif ri['valid_until'] <= '2026-09-01':\r\n\u001b[?2004l\rv\u001b[?2004h> "]
