[158.993312, "o", "# Verify sort by last_analyzed then table_name by reconstructing from input.\r\n\u001b[?2004l\r\u001b[?2004h"]
[158.993598, "o", "> import csv as _csv\r\n\u001b[?2004l\r"]
[158.993738, "o", "\u001b[?2004h> "]
[158.994105, "o", "from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h"]
[158.994346, "o", "> "]
[158.994599, "o", "from decimal import Decimal, ROUND_HALF_UP\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.99486, "o", "IN=Path('/app/input')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.995105, "o", "by={}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.995347, "o", "for row in _csv.DictReader(open('/app/input/table_health.csv')):\r\n"]
[158.995728, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[158.996027, "o", "    by[row['table_name']]=row\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.996525, "o", "expected_order=sorted(by.values(), key=lambda r:(r['last_analyzed'], r['table_name']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[158.996906, "o", "> "]
[158.997145, "o", "actual_order=[r['table_name'] for r in audit]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.997687, "o", "exp_order=[r['table_name'] for r in expected_order]\r\n\u001b[?2004l\r\u001b[?2004h"]
[158.998019, "o", "> "]
[158.998284, "o", "print('sort_match', actual_order == exp_order)\r\n\u001b[?2004l\r\u001b[?2004h"]
[158.998686, "o", "> "]
[158.998917, "o", "if actual_order != exp_order:\r\n\u001b[?2004l\r"]
[158.999174, "o", "\u001b[?2004h> "]
[158.999342, "o", "    for i,(a,b) in enumerate(zip(actual_order,exp_order)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.99963, "o", "        if a!=b:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.999953, "o", "            print('first mismatch', i, a, b)\r\n\u001b[?2004l\r"]
[159.000331, "o", "\u001b[?2004h> "]
[159.000613, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.000905, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> memo = open('/app/bloat_memo.md').read()\r\n"]
[159.001237, "o", "\u001b[?2004l\r\u001b[?2004h> missing=[]\r\n\u001b[?2004l\r"]
[159.001308, "o", "\u001b[?2004h> "]
[159.001747, "o", "for r in audit:\r\n"]
[159.00193, "o", "\u001b[?2004l\r\u001b[?2004h>     if r['finding'] != 'none':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.002157, "o", "        if r['table_name'] not in memo:\r\n\u001b[?2004l\r"]
[159.002403, "o", "\u001b[?2004h> "]
[159.002474, "o", "            missing.append(r['table_name'])\r\n\u001b[?2004l\r"]
[159.002694, "o", "\u001b[?2004h> "]
[159.002868, "o", "print('missing_memo_for_non_none', missing)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
