[51.222772, "o", "for i,tn in enumerate(order,1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.22304, "o", "> "]
[51.223282, "o", "    row=by_table[tn]"]
[51.223541, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.224225, "o", "    total=int(row['total_pages']); dead=int(row['dead_pages'])\r\n\u001b[?2004l\r"]
[51.224677, "o", "\u001b[?2004h> "]
[51.225373, "o", "    ratio=round_half_up(Decimal(dead)/Decimal(total))"]
[51.225647, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.225909, "o", "    size='large' if total>=500 else 'small'\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.226178, "o", "> "]
[51.22689, "o", "    cap=Decimal('0.2') if size=='large' else Decimal('0.4')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.227423, "o", "    last=date.fromisoformat(row['last_analyzed'])\r\n\u001b[?2004l\r"]
[51.227502, "o", "\u001b[?2004h> "]
[51.227788, "o", "    stale_days=(audit_date-last).days\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.228029, "o", "> "]
[51.228148, "o", "    stale=stale_days>=30\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.22831, "o", "    eff_cap=cap"]
[51.228518, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.228775, "o", "    if stale:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.229211, "o", "        eff_cap=cap - (Decimal('0.10') if size=='large' else Decimal('0.05'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.229285, "o", "> "]
[51.229528, "o", "    vac=row['vacuum_type']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.230142, "o", "    autovac_disabled = (row['autovacuum_enabled']!='True') or (vac=='manual')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.230372, "o", "    ri=reindex.get(tn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.23064, "o", "    exempt=False\r\n\u001b[?2004l\r"]
[51.23082, "o", "\u001b[?2004h> "]
[51.231028, "o", "    ri_note=''\r\n\u001b[?2004l\r\u001b[?2004h>     if ri:\r\n\u001b[?2004l\r"]
[51.231098, "o", "\u001b[?2004h> "]
[51.231509, "o", "        approved=ri['approved']=='True'\r\n"]
[51.231714, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[51.231888, "o", "        valid=ri['valid_until'] > '2026-09-01'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.232584, "o", "        exempt = row['maintenance_active']=='True' and approved and valid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.233348, "o", "        ri_note=f\"{ri['approved']},{ri['valid_until']},active={row['maintenance_active']},exempt={exempt}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.233544, "o", "> "]
[51.233755, "o", "    tk=tickets.get(tn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.234066, "o", ">     hold=False\r\n\u001b[?2004l\r"]
[51.234348, "o", "\u001b[?2004h>     tk_note=''\r\n\u001b[?2004l\r"]
[51.234597, "o", "\u001b[?2004h>     if tk:\r\n\u001b[?2004l\r"]
[51.234879, "o", "\u001b[?2004h> "]
[51.235566, "o", "        hold = (tk['exception_type']=='BLOAT_HOLD' and tk['status']=='Closed' and tk['approved'].lower()=='true' and tk['valid_until'] > '2026-09-01')\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.235836, "o", "> "]
[51.236932, "o", "        tk_note=f\"{tk['ticket_id']},{tk['exception_type']},{tk['status']},{tk['approved']},{tk['valid_until']},hold={hold}\"\r\n\u001b[?2004l\r"]
[51.237569, "o", "\u001b[?2004h> "]
[51.237943, "o", "    bloat_over = ratio > eff_cap\r\n\u001b[?2004l\r"]
[51.238216, "o", "\u001b[?2004h> "]
[51.238919, "o", "    finding='none'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.239249, "o", "    if autovac_disabled:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.239668, "o", "        finding='AUTOVACUUM_DISABLED'\r\n\u001b[?2004l\r"]
[51.239927, "o", "\u001b[?2004h> "]
[51.240198, "o", "    elif bloat_over and not exempt:\r\n\u001b[?2004l\r"]
[51.24054, "o", "\u001b[?2004h> "]
[51.240762, "o", "        if hold:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.241177, "o", "            finding='STALE_STATISTICS' if stale else 'none'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.241514, "o", "            tk_note += ',SUPPRESSED'\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.241786, "o", ">         else:"]
[51.242008, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.242234, "o", "> "]
[51.242608, "o", "            finding='BLOAT_THRESHOLD_EXCEEDED'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.242855, "o", "    elif stale:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.243069, "o", "        finding='STALE_STATISTICS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.243387, "o", "> "]
[51.244211, "o", "    print(f\"{i}|{tn}|{row['last_analyzed']}|{total}|{dead}|{ratio}|{size}|{vac}|{row['autovacuum_enabled']}|{row['maintenance_active']}|{ri_note}|{tk_note}|{stale_days}|{stale}|{cap}|{eff_cap}|{bloat_over}|{exempt}|{hold}|{finding}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.244481, "o", "> PY\r\n\u001b[?2004l\r"]
