=== entrypoint env (filtered) ===
HARBOR_MCP_MODE=docker
PROXY_HOST=0.0.0.0
PROXY_PORT=7000
PROXY_PYTHON=/opt/proxy-venv/bin/python3
SLACK_GYM_MCP_REMOTE_URL=
SLACK_GYM_MCP_REMOTE_URL_TOKEN=
TASK_DIR=/app
=== entrypoint args ===
sh -c sleep infinity
=== task.toml mcp_servers_extended (secrets redacted) ===
[[metadata.mcp_servers_extended]]
name = "slack-gym"
image = "us-central1-docker.pkg.dev/delivery-g-obi/connectors-rl-gym/connectors-harness@sha256:1cb77ee036676d6789a086919dfa3d1023df4f4b718d2f8fd443663ee2d87db4"
host_port = 8008
container_port = 8008
remote_url_env = "SLACK_GYM_MCP_REMOTE_URL"
auth_header_name = "x-slack-user-token"
access_token = "<redacted>"
db_id_header_name = "x-database-id"
reset_on_run = true

[verifier]
timeout_sec = 1500.0

[agent]
timeout_sec = 4800.0
# Non-root agent user; /app is root-only so the agent can't read
# task.toml/solution/tests off disk.
user = "rlgymagent"

[environment]
build_timeout_sec = 1200.0
cpus = 2
memory_mb = 4096
storage_mb = 65536
gpus = 0
allow_internet = true

[[environment.mcp_servers]]
name = "slack-gym"
transport = "streamable-http"
url = "http://localhost:7000/mcp/slack-gym"
args = []

[metadata.verifier_judge]
# The deployment picks the judge; the bundle must not. Leave the default alone.
model = "${JUDGE_MODEL:-openai/zai-org/GLM-5.2}"
api_key_env = "OPENAI_API_KEY"
temperature = 0.0
max_tokens = 65536

[verifier.env]
OPENAI_API_KEY = "${OPENAI_API_KEY:-}"
OPENAI_BASE_URL = "${OPENAI_BASE_URL:-}"
JUDGE_MODEL = "${JUDGE_MODEL:-openai/zai-org/GLM-5.2}"

[environment.healthcheck]
command = "curl -fsS http://localhost:7000/health"
interval_sec = 15.0
timeout_sec = 5.0
retries = 40
start_period_sec = 30.0
start_interval_sec = 15.0

[environment.env]
HARBOR_MCP_MODE = "${HARBOR_MCP_MODE:-docker}"
GYM_DATASET = "${GYM_DATASET:-synthetic}"
OPENAI_API_KEY = "${OPENAI_API_KEY:-}"
GEMINI_API_KEY = "${GEMINI_API_KEY:-}"
SLACK_GYM_MCP_REMOTE_URL = "${SLACK_GYM_MCP_REMOTE_URL:-}"
SLACK_GYM_MCP_REMOTE_URL_TOKEN = "${SLACK_GYM_MCP_REMOTE_URL_TOKEN:-}"
