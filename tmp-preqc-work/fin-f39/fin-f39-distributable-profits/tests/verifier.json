    {
      "name": "schedule_no_duplicate_items",
      "metadata": {
        "how_justification": "csv.extract_text; negative lookahead verifies 'Profits available for distribution' appears at most once. Combined with the per-item checks, this rejects any duplicated-row submission.",
        "why_justification": "A duplicated-row CSV would contain two copies of the summary line; this check rejects it."
      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "extract_text",
          "arguments": {
            "path": "distributable_profits.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?s)^(?:(?!Profits available for distribution.*Profits available for distribution).)*$",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    }
